<?php
/* Dashboard tile: what is waiting, whether anything needs attention, when it last ran and runs next. Reads only the plugin's own state, never calls Docker.
   The Unraid OS version is deliberately not shown here. Can be switched off in Settings > Appearance. */
try {
  $dau_on = true;
  $dau_cf = @json_decode((string)@file_get_contents('/boot/config/plugins/unraid-autoupdater/config.json'), true);
  if (is_array($dau_cf) && isset($dau_cf['ui']['widget']) && !$dau_cf['ui']['widget']) $dau_on = false;
  if ($dau_on) {
    $dau_csrf = json_encode($var['csrf_token'] ?? '');
    $mytiles['unraid-autoupdater']['column2'] = <<<EOT
<tbody title="Unraid Swiss Manager" id="dau-tile">
<tr><td>
<img id="dau-w-logo" class="img" src="/plugins/unraid-autoupdater/images/unraid-autoupdater.png" alt="" width="32" height="32" style="object-fit:contain" onerror="this.outerHTML='<i class=&quot;fa fa-refresh f32&quot;></i>'">
<div class="section">Unraid Swiss Manager<br><span id="dau-w-sum" class="dau-w">Checking&hellip;</span></div>
<a href="/Settings/UnraidAutoUpdater" title="Open Unraid Swiss Manager"><i class="fa fa-fw fa-cog chevron"></i></a>
</td></tr>
<tr id="dau-r-docker"><td><span class="w25">Docker</span><span id="dau-w-docker">-</span></td></tr>
<tr id="dau-r-plugins"><td><span class="w25">Plugins</span><span id="dau-w-plugins">-</span></td></tr>
<tr id="dau-r-os" style="display:none"><td><span class="w25">Unraid OS</span><span id="dau-w-os">-</span></td></tr>
<tr id="dau-r-fail" style="display:none"><td><span class="w25">Attention</span><span id="dau-w-fail">-</span></td></tr>
<tr><td><span class="w25">Last check</span><span id="dau-w-last">-</span></td></tr>
<tr><td><span class="w25">Next run</span><span id="dau-w-next">-</span></td></tr>
<script>
(function(){
  function s(id,t){var e=document.getElementById(id); if(e) e.textContent=t;}
  function show(id,on){var e=document.getElementById(id); if(e) e.style.display=on?'':'none';}
  function ago(ts,now){ if(!ts) return 'never'; var d=Math.max(0,now-ts); if(d<90) return 'just now'; if(d<5400) return Math.round(d/60)+' min ago'; if(d<129600) return Math.round(d/3600)+' h ago'; return Math.round(d/86400)+' d ago'; }
  function inn(ts,now){ if(!ts) return 'not scheduled'; var d=ts-now; if(d<=60) return 'within a minute'; if(d<5400) return 'in '+Math.round(d/60)+' min'; if(d<86400) return 'in '+Math.round(d/3600)+' h'; return new Date(ts*1000).toLocaleString([],{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}); }
  function n(c){ return c? c+' update'+(c>1?'s':'')+' available' : 'Up to date'; }
  var b=new URLSearchParams(); b.append('action','widget'); b.append('csrf_token',$dau_csrf);
  fetch('/plugins/unraid-autoupdater/include/api.php',{method:'POST',body:b,credentials:'same-origin'}).then(function(r){return r.json();}).then(function(j){
    if(!j||j.error) throw 0;
    var total=(j.docker||0)+(j.plugins||0)+(j.os_update?1:0);
    s('dau-w-sum', j.running? 'Working…' : j.failures? 'Needs attention' : total? total+' update'+(total>1?'s':'')+' waiting' : 'Everything is up to date');
    s('dau-w-docker', j.at? n(j.docker)+' · '+j.containers+' containers' : 'Not checked yet');
    s('dau-w-plugins', n(j.plugins));
    show('dau-r-os', !!j.os_update); s('dau-w-os','Update available');
    show('dau-r-fail', !!j.failures); s('dau-w-fail', j.failures+' recent failure'+(j.failures>1?'s':'')+' – see Activity');
    s('dau-w-last', ago(j.last_run,j.now)+(j.last_status? ' ('+j.last_status+')':'')+(j.queued? ' · '+j.queued+' notification(s) on hold':''));
    s('dau-w-next', inn(j.next,j.now));
  }).catch(function(){ s('dau-w-sum','Status not available'); });
})();
</script>
</tbody>
EOT;
  }
} catch (Throwable $e) { /* never break the Dashboard */ }
?>
