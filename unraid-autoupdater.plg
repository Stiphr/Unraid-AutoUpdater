<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name    "unraid-autoupdater">
<!ENTITY author  "Stiphr">
<!ENTITY version "2026.11.03">
<!ENTITY pluginURL "https://raw.githubusercontent.com/Stiphr/Unraid-Swiss-Manager/refs/heads/stable/unraid-autoupdater.plg">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" launch="Settings/UnraidSwissManager" min="6.9.0" icon="refresh">

<CHANGES>
###2026.11.03
- Renamed: Unraid AutoUpdater is now Unraid Swiss Manager (unraid-swiss-manager). Updating installs the new plugin, keeps your settings, history and webhook, and removes this old entry.
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[echo "Unraid AutoUpdater is now Unraid Swiss Manager. Installing the new plugin..."
/usr/local/sbin/plugin install https://raw.githubusercontent.com/Stiphr/Unraid-Swiss-Manager/refs/heads/stable/unraid-swiss-manager.plg
# this entry is registered by the update that is running right now, so it is removed a moment later
nohup setsid bash -c 'sleep 20; /usr/local/sbin/plugin remove unraid-autoupdater.plg' > /dev/null 2>&1 &
echo "The old unraid-autoupdater entry will disappear in a few seconds."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[echo "Old unraid-autoupdater entry removed. Unraid Swiss Manager and its settings are untouched."
]]></INLINE>
</FILE>

</PLUGIN>
