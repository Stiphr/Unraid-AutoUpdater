<FILE Name="&emhttp;/include/config.php" Mode="0644">
<INLINE><![CDATA[<?php
/* Unraid Swiss Manager - configuration: defaults, validation, v1 -> v2 migration, secrets. */

define('DAU_CFG_VERSION', 2);

const DAU_FREQS    = ['6h', '12h', 'daily', 'weekly', 'biweekly', 'monthly'];
const DAU_POLICIES = ['auto', 'notify', 'ignore'];

function dau_sched_spec() {
  return [
    'frequency' => ['enum', DAU_FREQS],
    'time'      => ['time'],
    'weekday'   => ['int', 0, 6],
    'monthday'  => ['int', 1, 28],
  ];
}

function dau_window_spec() {
  return ['enabled' => ['bool'], 'days' => ['days'], 'start' => ['time'], 'end' => ['time']];
}

function dau_window_default() {
  return ['enabled' => false, 'days' => [0, 1, 2, 3, 4, 5, 6], 'start' => '02:00', 'end' => '06:00'];
}

function dau_defaults() {
  $sched = ['frequency' => 'daily', 'time' => '04:00', 'weekday' => 0, 'monthday' => 1];
  return [
    'version' => DAU_CFG_VERSION,
    /* Docker defaults. The v1 keys (enabled, frequency, time, weekday, monthday, notify, skip_stopped, delay) keep their meaning. */
    'global' => $sched + [
      'enabled'            => false,   // default schedule on/off; containers with their own schedule run regardless
      'notify'             => true,    // Unraid notifications for Docker (per-container toggle still applies)
      'skip_stopped'       => true,
      'delay'              => 10,      // seconds between container updates
      'update_delay_hours' => 0,       // default hold-back after an update is first seen (0 = immediate)
      'window'             => dau_window_default(),
      'retry'              => ['max' => 2, 'interval_min' => 30],
      'verify'             => ['enabled' => true, 'timeout' => 90],
      'cleanup'            => true,    // remove the one replaced image after a verified update (never forced)
      'disk_check'         => true,
      'min_free_gb'        => 5,
      'backup'             => [
        'enabled' => false, 'dest' => '', 'retention' => 3,
        'config' => true, 'image' => false, 'appdata' => false, 'required' => false,
      ],
    ],
    'containers' => [],
    'plugins' => $sched + [
      'check_enabled' => true,          // scheduled detection + notifications
      'auto_update'   => false,         // MASTER SWITCH: automatic installation is opt-in
      'default_policy' => 'notify',
      'delay_hours'   => 24,
      'delay'         => 30,            // seconds between plugin updates
      'window'        => dau_window_default(),
      'items'         => [],            // "name.plg" => {policy}
    ],
    'os' => $sched + [
      'check_enabled' => true,
      'time'          => '05:30',
      /* OS updates are NEVER installed unless mode is changed AND confirmed. Default: check and notify only. */
      'mode'          => 'notify',      // notify | install | install_reboot
      'confirmed'     => '',            // the install mode the person explicitly confirmed in the UI; a mode without a matching confirmation is ignored
      'delay_days'    => 7,             // wait this long after a release is first seen
      'stable_only'   => true,          // never auto-install -rc / beta / next releases
      'window'        => ['enabled' => true, 'days' => [0], 'start' => '03:00', 'end' => '05:00'],
      'pre'           => ['plugins' => true, 'docker' => false, 'require_plugins' => true, 'require_docker' => true, 'confirm' => false, 'notify' => true, 'scope' => 'auto'],   // pre-OS workflow, see workflow.php
    ],
    'discord' => [
      'enabled'    => false,
      'events'     => ['docker' => true, 'plugins' => true, 'os' => true],
      'types'      => ['success' => true, 'failed' => true, 'available' => true, 'summary' => true],
      'batching'   => 'combine',        // combine | separate
      'max_messages' => 5,
      'icon_url'   => '',               // optional https image for the webhook avatar; empty = bundled default
    ],
    'notify_unraid' => ['docker' => true, 'plugins' => false, 'os' => false],
    'history' => ['max_entries' => 200],
    'log'     => ['max_kb' => 1024],
  ];
}

function dau_container_spec() {
  return [
    'policy'      => ['enum', DAU_POLICIES],
    'notify'      => ['bool'],
    'critical'    => ['bool'],        // needs explicit approval before an automatic update
    'delay_hours' => ['int_or_null', 0, 720],
    'backup'      => ['bool'],
    'schedule'    => ['obj_or_null', dau_sched_spec()],
  ];
}

/* ---------- schema-driven sanitising ---------- */

function dau_valid_time($t) { return is_string($t) && preg_match('/^([01]\d|2[0-3]):[0-5]\d$/', $t) === 1; }

function dau_clean_value($spec, $v, $cur) {
  switch ($spec[0]) {
    case 'bool':  $b = filter_var($v, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE); return $b === null ? $cur : $b;
    case 'enum':  return (is_string($v) && in_array($v, $spec[1], true)) ? $v : $cur;
    case 'time':  return dau_valid_time($v) ? $v : $cur;
    case 'int':   return is_numeric($v) ? max($spec[1], min($spec[2], (int)$v)) : $cur;
    case 'int_or_null':
      if ($v === null || $v === '' || $v === 'inherit') return null;
      return is_numeric($v) ? max($spec[1], min($spec[2], (int)$v)) : $cur;
    case 'days':
      if (!is_array($v)) return $cur;
      $d = array_values(array_unique(array_filter(array_map('intval', $v), function ($x) { return $x >= 0 && $x <= 6; })));
      sort($d);
      return $d ?: $cur;
    case 'path': // absolute path under /mnt, no traversal, no control characters
      if ($v === '' || $v === null) return '';
      return dau_valid_dest($v) ? rtrim($v, '/') : $cur;
    case 'icon':  return ($v === '' || $v === null) ? '' : (dau_icon_url_valid($v) ? $v : $cur);
    case 'obj':   return is_array($v) ? dau_apply_spec(is_array($cur) ? $cur : [], $v, $spec[1]) : $cur;
    case 'obj_or_null':
      if ($v === null) return null;
      return is_array($v) ? dau_apply_spec(is_array($cur) ? $cur : dau_spec_defaults($spec[1]), $v, $spec[1]) : $cur;
  }
  return $cur;
}

function dau_spec_defaults($spec) {
  $o = ['frequency' => 'daily', 'time' => '04:00', 'weekday' => 0, 'monthday' => 1];
  return array_intersect_key($o, $spec);
}

/** Apply $in over $cur, keeping only keys present in $spec. Unknown keys are dropped, bad values keep the old value. */
function dau_apply_spec(array $cur, array $in, array $spec) {
  foreach ($spec as $k => $s) {
    if (!array_key_exists($k, $in)) continue;
    $cur[$k] = dau_clean_value($s, $in[$k], $cur[$k] ?? null);
  }
  return $cur;
}

function dau_valid_dest($p) {
  if (!is_string($p) || $p === '' || strlen($p) > 200) return false;
  if (preg_match('/[\x00-\x1F\x7F]/', $p) || dau_has($p, '..')) return false;
  return preg_match('#^/mnt/[A-Za-z0-9._ /+-]+$#', $p) === 1;
}

function dau_global_spec() {
  return dau_sched_spec() + [
    'enabled' => ['bool'], 'notify' => ['bool'], 'skip_stopped' => ['bool'],
    'delay' => ['int', 0, 600], 'update_delay_hours' => ['int', 0, 720],
    'window' => ['obj', dau_window_spec()],
    'retry'  => ['obj', ['max' => ['int', 0, 5], 'interval_min' => ['int', 5, 1440]]],
    'verify' => ['obj', ['enabled' => ['bool'], 'timeout' => ['int', 10, 900]]],
    'cleanup' => ['bool'], 'disk_check' => ['bool'], 'min_free_gb' => ['int', 0, 4096],
    'backup' => ['obj', [
      'enabled' => ['bool'], 'dest' => ['path'], 'retention' => ['int', 1, 20],
      'config' => ['bool'], 'image' => ['bool'], 'appdata' => ['bool'], 'required' => ['bool'],
    ]],
  ];
}

function dau_plugins_spec() {
  return dau_sched_spec() + [
    'check_enabled' => ['bool'], 'auto_update' => ['bool'], 'default_policy' => ['enum', DAU_POLICIES],
    'delay_hours' => ['int', 0, 720], 'delay' => ['int', 0, 600],
    'window' => ['obj', dau_window_spec()],
  ];
}

function dau_os_spec() {
  return dau_sched_spec() + [
    'check_enabled' => ['bool'], 'mode' => ['enum', ['notify', 'install', 'install_reboot']], 'confirmed' => ['enum', ['', 'install', 'install_reboot']],
    'delay_days' => ['int', 0, 90], 'stable_only' => ['bool'], 'window' => ['obj', dau_window_spec()],
    'pre' => ['obj', ['plugins' => ['bool'], 'docker' => ['bool'], 'require_plugins' => ['bool'], 'require_docker' => ['bool'], 'confirm' => ['bool'], 'notify' => ['bool'], 'scope' => ['enum', ['auto', 'all']]]],
  ];
}

/** https only, no credentials, no whitespace or quotes: used for the Discord avatar. */
function dau_icon_url_valid($u) {
  return is_string($u) && strlen($u) <= 300 && preg_match('#^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/[A-Za-z0-9._~%/+-]*(\?[A-Za-z0-9._~%=&+-]*)?$#', $u) === 1;
}

function dau_discord_spec() {
  return [
    'enabled' => ['bool'],
    'events'  => ['obj', ['docker' => ['bool'], 'plugins' => ['bool'], 'os' => ['bool']]],
    'types'   => ['obj', ['success' => ['bool'], 'failed' => ['bool'], 'available' => ['bool'], 'summary' => ['bool']]],
    'batching' => ['enum', ['combine', 'separate']],
    'max_messages' => ['int', 1, 20],
    'icon_url' => ['icon'],
  ];
}

/** Clean a user-supplied configuration fragment into a full, valid configuration. Never throws. */
function dau_sanitize_config(array $in, array $cur) {
  if (isset($in['global']) && is_array($in['global'])) $cur['global'] = dau_apply_spec($cur['global'], $in['global'], dau_global_spec());
  if (isset($in['plugins']) && is_array($in['plugins'])) $cur['plugins'] = dau_apply_spec($cur['plugins'], $in['plugins'], dau_plugins_spec());
  if (isset($in['os']) && is_array($in['os'])) {
    $cur['os'] = dau_apply_spec($cur['os'], $in['os'], dau_os_spec());
    /* An install mode only counts when the person confirmed exactly that mode. Anything else falls back to notify-only. */
    if ($cur['os']['mode'] !== 'notify' && $cur['os']['confirmed'] !== $cur['os']['mode']) $cur['os']['mode'] = 'notify';
    if ($cur['os']['mode'] === 'notify') $cur['os']['confirmed'] = '';
  }
  if (isset($in['discord']) && is_array($in['discord'])) $cur['discord'] = dau_apply_spec($cur['discord'], $in['discord'], dau_discord_spec());
  if (isset($in['notify_unraid']) && is_array($in['notify_unraid'])) {
    $cur['notify_unraid'] = dau_apply_spec($cur['notify_unraid'], $in['notify_unraid'], ['docker' => ['bool'], 'plugins' => ['bool'], 'os' => ['bool']]);
  }
  if (isset($in['history']) && is_array($in['history'])) $cur['history'] = dau_apply_spec($cur['history'], $in['history'], ['max_entries' => ['int', 20, 1000]]);
  if (isset($in['log']) && is_array($in['log'])) $cur['log'] = dau_apply_spec($cur['log'], $in['log'], ['max_kb' => ['int', 64, 8192]]);
  if (isset($in['containers']) && is_array($in['containers'])) {
    $n = 0;
    foreach ($in['containers'] as $name => $c) {
      if (!dau_valid_name((string)$name) || !is_array($c) || ++$n > 1000) continue;
      $base = is_array($cur['containers'][$name] ?? null) ? $cur['containers'][$name] : ['policy' => 'ignore'];
      $cur['containers'][$name] = dau_apply_spec($base, $c, dau_container_spec());
    }
  }
  if (isset($in['plugin_items']) && is_array($in['plugin_items'])) {
    foreach ($in['plugin_items'] as $f => $c) {
      if (!dau_valid_plg((string)$f) || !is_array($c) || $f === DAU_SELF_PLG) continue;
      $cur['plugins']['items'][$f] = dau_apply_spec(is_array($cur['plugins']['items'][$f] ?? null) ? $cur['plugins']['items'][$f] : [], $c, ['policy' => ['enum', DAU_POLICIES]]);
    }
  }
  return $cur;
}

/* ---------- v1 -> v2 migration ---------- */

/**
 * v1 stored {global:{...,check_only,prune}, containers:{name:{auto,notify,schedule}}}.
 * Mapping: auto:true -> policy auto (policy notify when v1 "notify only" was on); auto:false or absent -> ignore.
 * Schedules, notify toggles and every global setting carry over unchanged.
 */
function dau_migrate_v1(array $old) {
  $cfg = dau_defaults();
  $g = is_array($old['global'] ?? null) ? $old['global'] : [];
  $cfg['global'] = dau_apply_spec($cfg['global'], $g, dau_global_spec());
  $checkOnly = !empty($g['check_only']);
  foreach ((is_array($old['containers'] ?? null) ? $old['containers'] : []) as $name => $c) {
    if (!dau_valid_name((string)$name) || !is_array($c)) continue;
    $n = ['policy' => !empty($c['auto']) ? ($checkOnly ? 'notify' : 'auto') : 'ignore'];
    if (array_key_exists('notify', $c)) $n['notify'] = (bool)$c['notify'];
    if (isset($c['schedule']) && is_array($c['schedule'])) $n['schedule'] = $c['schedule'];
    $cfg['containers'][$name] = dau_apply_spec(['policy' => 'ignore'], $n, dau_container_spec());
  }
  return $cfg;
}

/* ---------- load / save ---------- */

/**
 * Load the configuration. A damaged file never crashes a job and never enables anything:
 * it is kept as config.corrupt-<time>.json and the safe defaults (everything off) are used.
 */
function dau_load_config(&$status = null) {
  $status = 'ok';
  $def = dau_defaults();
  if (!is_file(DAU_CFG)) return $def;
  $raw = @file_get_contents(DAU_CFG);
  $c = json_decode((string)$raw, true);
  if (!is_array($c)) {
    @copy(DAU_CFG, DAU_DIR . '/config.corrupt-' . date('Ymd-His', dau_now()) . '.json');
    $status = 'corrupt';
    dau_log('error', 'config', '-', 'load', 'fail', 'config.json is not valid JSON; using safe defaults (nothing automatic). The damaged file was kept.');
    return $def;
  }
  if ((int)($c['version'] ?? 1) < DAU_CFG_VERSION) {
    @copy(DAU_CFG, DAU_DIR . '/config.v1.backup.json');
    $c = dau_migrate_v1($c);
    dau_save_config($c);
    dau_log('info', 'config', '-', 'migrate', 'ok', 'configuration migrated from v1 to v' . DAU_CFG_VERSION . ' (backup: config.v1.backup.json)');
    $status = 'migrated';
  }
  $cfg = dau_sanitize_config($c, $def);
  /* sanitize ignores unknown top-level keys; carry the plugin per-item map through explicitly */
  if (is_array($c['plugins']['items'] ?? null)) {
    foreach ($c['plugins']['items'] as $f => $v) {
      if (dau_valid_plg((string)$f) && $f !== DAU_SELF_PLG && is_array($v)) $cfg['plugins']['items'][$f] = dau_apply_spec([], $v, ['policy' => ['enum', DAU_POLICIES]]);
    }
  }
  return $cfg;
}

function dau_save_config(array $cfg) {
  $out = $cfg;
  $out['version'] = DAU_CFG_VERSION;
  $out['containers'] = (object)($cfg['containers'] ?? []);
  $out['plugins']['items'] = (object)($cfg['plugins']['items'] ?? []);
  return dau_write_json(DAU_CFG, $out);
}

/* ---------- per-component effective settings ---------- */

function dau_container_cfg(array $cfg, $name) {
  $c = is_array($cfg['containers'][$name] ?? null) ? $cfg['containers'][$name] : [];
  return $c + ['policy' => 'ignore', 'notify' => true, 'critical' => false, 'delay_hours' => null, 'backup' => false, 'schedule' => null];
}

function dau_container_delay_hours(array $cfg, $name) {
  $c = dau_container_cfg($cfg, $name);
  return $c['delay_hours'] === null ? (int)$cfg['global']['update_delay_hours'] : (int)$c['delay_hours'];
}

function dau_plugin_policy(array $cfg, $file) {
  $p = $cfg['plugins']['items'][$file]['policy'] ?? null;
  return in_array($p, DAU_POLICIES, true) ? $p : $cfg['plugins']['default_policy'];
}

/* ---------- secrets (webhook URL) ---------- */

/**
 * The webhook URL lives in its own file, is never returned by the API and never written to a log.
 * The flash drive is FAT-formatted, so file permissions cannot protect it; /boot is not web-accessible
 * and is only exposed if the user shares it. See the README for the exact limitation.
 */
function dau_secret_get($key) {
  $s = dau_read_json(DAU_SECRETS, []);
  return is_string($s[$key] ?? null) ? $s[$key] : '';
}

function dau_secret_set($key, $value) {
  $s = dau_read_json(DAU_SECRETS, []);
  if ($value === '' || $value === null) unset($s[$key]); else $s[$key] = (string)$value;
  return dau_write_json(DAU_SECRETS, $s, true);
}

function dau_webhook_valid($u) {
  return is_string($u) && strlen($u) <= 300
      && preg_match('#^https://(?:(?:ptb|canary)\.)?discord(?:app)?\.com/api/(?:v\d+/)?webhooks/\d{15,22}/[A-Za-z0-9._-]{20,100}$#', $u) === 1;
}

/** Config exported for backup: everything except secrets. */
function dau_export_config() {
  $cfg = dau_load_config();
  $cfg['containers'] = (object)$cfg['containers'];
  $cfg['plugins']['items'] = (object)$cfg['plugins']['items'];
  return ['exported_at' => dau_ts_iso(dau_now()), 'plugin_version' => DAU_VERSION, 'secrets_included' => false, 'config' => $cfg];
}
]]></INLINE>
<SHA256>234c5f831e748c0a87669b63c02aaaa6ddf1aad72e2f8c209e270810d53108a0</SHA256>
</FILE>

<FILE Name="&emhttp;/include/schedule.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - schedule maths.
 * All times are the server's local time zone (Settings > Date and Time), exactly like Unraid's own schedules.
 * The dispatcher ("tick") runs every DAU_TICK_MIN minutes; a schedule is "due" when its latest occurrence has
 * passed, has not run yet and is not older than DAU_CATCHUP (so a reboot over 04:00 still runs at 04:07, but a
 * server that was off all day does not run yesterday's job at midnight).
 */

/** Normalise a schedule array or return null if it is not a valid schedule. */
function dau_clean_schedule($in) {
  if (!is_array($in)) return null;
  $f = $in['frequency'] ?? 'daily';
  if (!is_string($f) || !in_array($f, DAU_FREQS, true)) return null;
  return [
    'frequency' => $f,
    'time'      => dau_valid_time($in['time'] ?? null) ? $in['time'] : '04:00',
    'weekday'   => max(0, min(6, (int)($in['weekday'] ?? 0))),
    'monthday'  => max(1, min(28, (int)($in['monthday'] ?? 1))),
  ];
}

function dau_sched_of(array $a) { return dau_clean_schedule($a); }

/** Containers/categories with an identical schedule share one slot. */
function dau_slot_key(array $s) {
  $sig = $s['frequency'] . '|' . $s['time']
       . '|' . (in_array($s['frequency'], ['weekly', 'biweekly'], true) ? (int)$s['weekday'] : '')
       . '|' . ($s['frequency'] === 'monthly' ? (int)$s['monthday'] : '');
  return 'c' . substr(md5($sig), 0, 8);
}

function dau_dt($ts) {
  $d = new DateTime('@' . (int)$ts);
  $d->setTimezone(new DateTimeZone(date_default_timezone_get()));
  return $d;
}

/** Latest scheduled occurrence at or before $ts, or null. */
function dau_occ_before(array $s, $ts) {
  list($h, $m) = array_map('intval', explode(':', $s['time']));
  $d = dau_dt($ts);
  switch ($s['frequency']) {
    case '6h':
    case '12h':
      /* anchored on the configured time: 04:15 with "every 6 hours" runs at 04:15, 10:15, 16:15, 22:15 */
      $n = $s['frequency'] === '6h' ? 6 : 12;
      $anchor = dau_dt($ts); $anchor->setTime($h, $m, 0);
      $base = $anchor->getTimestamp();
      return $base + (int)floor(($ts - $base) / ($n * 3600)) * $n * 3600;
    case 'weekly':
    case 'biweekly':
      for ($i = 0; $i < 8; $i++) {
        $c = clone $d; $c->setTime($h, $m, 0);
        if ($i) $c->modify('-' . $i . ' day');
        $c->setTime($h, $m, 0);
        if ((int)$c->format('w') === (int)$s['weekday'] && $c->getTimestamp() <= $ts) return $c->getTimestamp();
      }
      return null;
    case 'monthly':
      for ($i = 0; $i < 3; $i++) {
        $c = clone $d; $c->setDate((int)$d->format('Y'), (int)$d->format('n') - $i, (int)$s['monthday']); $c->setTime($h, $m, 0);
        if ($c->getTimestamp() <= $ts) return $c->getTimestamp();
      }
      return null;
    default: // daily
      $c = clone $d; $c->setTime($h, $m, 0);
      if ($c->getTimestamp() > $ts) { $c->modify('-1 day'); $c->setTime($h, $m, 0); }
      return $c->getTimestamp();
  }
}

/** First scheduled occurrence strictly after $ts. */
function dau_occ_after(array $s, $ts) {
  list($h, $m) = array_map('intval', explode(':', $s['time']));
  $d = dau_dt($ts);
  switch ($s['frequency']) {
    case '6h':
    case '12h':
      $b = dau_occ_before($s, $ts);
      return $b + ($s['frequency'] === '6h' ? 6 : 12) * 3600;
    case 'weekly':
    case 'biweekly':
      for ($i = 0; $i < 9; $i++) {
        $c = clone $d; if ($i) $c->modify('+' . $i . ' day'); $c->setTime($h, $m, 0);
        if ((int)$c->format('w') === (int)$s['weekday'] && $c->getTimestamp() > $ts) return $c->getTimestamp();
      }
      return null;
    case 'monthly':
      for ($i = 0; $i < 3; $i++) {
        $c = clone $d; $c->setDate((int)$d->format('Y'), (int)$d->format('n') + $i, (int)$s['monthday']); $c->setTime($h, $m, 0);
        if ($c->getTimestamp() > $ts) return $c->getTimestamp();
      }
      return null;
    default:
      $c = clone $d; $c->setTime($h, $m, 0);
      if ($c->getTimestamp() <= $ts) { $c->modify('+1 day'); $c->setTime($h, $m, 0); }
      return $c->getTimestamp();
  }
}

/**
 * Is this schedule due now?
 * $rec = ['seen'=>ts first time this slot existed, 'last'=>ts of its last real run]
 */
function dau_slot_due(array $s, array $rec, $now) {
  $occ = dau_occ_before($s, $now);
  if ($occ === null) return false;
  $since = max((int)($rec['seen'] ?? 0), (int)($rec['last'] ?? 0));
  if ($occ <= $since) return false;                      // already handled, or the slot is newer than this occurrence
  if ($now - $occ > DAU_CATCHUP) return false;           // too late; wait for the next occurrence
  if ($s['frequency'] === 'biweekly' && !empty($rec['last']) && $occ - (int)$rec['last'] < 12 * 86400) return false;
  return true;
}

/** Next time this schedule will run, honouring bi-weekly gating. */
function dau_next_run(array $s, array $rec, $now) {
  $t = $now;
  for ($i = 0; $i < 6; $i++) {
    $n = dau_occ_after($s, $t);
    if ($n === null) return null;
    if ($s['frequency'] === 'biweekly' && !empty($rec['last']) && $n - (int)$rec['last'] < 12 * 86400) { $t = $n; continue; }
    return $n;
  }
  return null;
}

/* ---------- maintenance window ---------- */

/** Is $ts inside the window? Days refer to the day the window opens; an overnight window (22:00-04:00) belongs to its start day. */
function dau_window_open(array $w, $ts) {
  if (empty($w['enabled'])) return true;
  $d = dau_dt($ts);
  $mins = (int)$d->format('G') * 60 + (int)$d->format('i');
  $dow = (int)$d->format('w');
  list($sh, $sm) = array_map('intval', explode(':', $w['start']));
  list($eh, $em) = array_map('intval', explode(':', $w['end']));
  $s = $sh * 60 + $sm; $e = $eh * 60 + $em;
  $days = $w['days'];
  if ($s === $e) return in_array($dow, $days, true);
  if ($s < $e) return in_array($dow, $days, true) && $mins >= $s && $mins < $e;
  if ($mins >= $s) return in_array($dow, $days, true);
  return $mins < $e && in_array(($dow + 6) % 7, $days, true);
}

/** Next time the window is open (now if already open), searched in 5 minute steps over 8 days. */
function dau_window_next_open(array $w, $ts) {
  if (dau_window_open($w, $ts)) return $ts;
  for ($t = $ts - ($ts % 300) + 300, $i = 0; $i < 8 * 288; $i++, $t += 300) if (dau_window_open($w, $t)) return $t;
  return null;
}

function dau_window_text(array $w) {
  if (empty($w['enabled'])) return 'any time';
  $n = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  $days = count($w['days']) === 7 ? 'every day' : implode(', ', array_map(function ($d) use ($n) { return $n[$d]; }, $w['days']));
  return $days . ' ' . $w['start'] . '-' . $w['end'];
}

function dau_sched_text(array $s) {
  $n = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  switch ($s['frequency']) {
    case '6h':  return 'Every 6 hours (:' . substr($s['time'], 3) . ')';
    case '12h': return 'Every 12 hours (:' . substr($s['time'], 3) . ')';
    case 'weekly':   return 'Weekly, ' . $n[$s['weekday']] . ' ' . $s['time'];
    case 'biweekly': return 'Every two weeks, ' . $n[$s['weekday']] . ' ' . $s['time'];
    case 'monthly':  return 'Monthly, day ' . $s['monthday'] . ' ' . $s['time'];
    default: return 'Daily ' . $s['time'];
  }
}
]]></INLINE>
<SHA256>11f7f366e24e9f76b29f657efc21b57cdfe875a10f4d794a768a78d80d2e8a77</SHA256>
</FILE>

<FILE Name="&emhttp;/include/state.php" Mode="0644">
<INLINE><![CDATA[<?php
/* Unraid Swiss Manager - persistent state, history and statistics (all bounded). */

function dau_state_defaults() {
  $stat = ['ok' => 0, 'failed' => 0, 'dur' => 0];
  return [
    'version'      => 2,
    'slots'        => [],      // slot => ['seen'=>ts,'last'=>ts]
    'last_run'     => 0,
    'last_trigger' => '',
    'last_result'  => [],
    'current'      => null,    // component being changed right now (detects interrupted jobs after a reboot/kill)
    'docker'  => ['seen' => [], 'retry' => [], 'approved' => [], 'notified' => [], 'deferred' => []],
    'plugins' => ['deferred_at' => 0, 'seen' => [], 'notified' => [], 'blocked' => [], 'available' => [], 'last_check' => 0, 'last_check_ok' => 0, 'last_error' => ''],
    'os'      => ['installed' => null, 'available' => null, 'first_seen' => 0, 'notified' => null, 'withdrawn_notified' => false,
                  'last_check' => 0, 'last_check_ok' => 0, 'last_error' => '', 'notes' => '', 'error_notified' => false,
                  'pending' => null,        // ['from','to','at','reboot'] installed, waiting for a reboot
                  'attempted' => null,      // ['version','result','reason','at']: one automatic attempt per version
                  'rebooted_for' => '',     // target version an automatic reboot was already started for
                  'deferred_at' => 0, 'reboot_notified' => '', 'boot_result' => null,
                  'workflow' => null,       // pre-OS workflow in progress / waiting for a confirmation (see workflow.php)
                  'last_report' => null],
    'stats'   => ['docker' => $stat, 'plugin' => $stat, 'os' => $stat],
    'discord' => ['last_ok' => 0, 'last_attempt' => 0, 'last_error' => '', 'invalid' => false],
  ];
}

function dau_state_load() {
  $d = dau_state_defaults();
  $s = dau_read_json(DAU_STATE, []);
  foreach (['docker', 'plugins', 'os', 'stats', 'discord'] as $k) {
    if (isset($s[$k]) && is_array($s[$k])) $d[$k] = array_replace_recursive($d[$k], $s[$k]);
  }
  foreach (['slots', 'last_run', 'last_trigger', 'last_result', 'current'] as $k) {
    if (array_key_exists($k, $s) && (is_array($s[$k]) || !is_array($d[$k]))) $d[$k] = $s[$k];
  }
  if (!is_array($d['slots'])) $d['slots'] = [];
  return $d;
}

function dau_state_save(array $st) {
  /* keep the maps bounded */
  foreach (['seen', 'retry', 'approved', 'notified', 'deferred'] as $k) {
    if (count($st['docker'][$k]) > 1000) $st['docker'][$k] = array_slice($st['docker'][$k], -1000, null, true);
  }
  foreach (['seen', 'notified', 'blocked', 'available'] as $k) {
    if (count($st['plugins'][$k]) > 1000) $st['plugins'][$k] = array_slice($st['plugins'][$k], -1000, null, true);
  }
  return dau_write_json(DAU_STATE, $st);
}

/* ---------- schedule slots ---------- */

function dau_slot_rec(array $st, $slot) { return is_array($st['slots'][$slot] ?? null) ? $st['slots'][$slot] : ['seen' => 0, 'last' => 0]; }

/** A slot that is new starts counting now, so enabling a schedule at 10:00 never runs "this morning's" job retroactively. */
function dau_slots_register(array &$st, array $slots, $now) {
  $changed = false;
  foreach ($slots as $slot) {
    if (!isset($st['slots'][$slot])) { $st['slots'][$slot] = ['seen' => $now, 'last' => 0]; $changed = true; }
  }
  foreach (array_keys($st['slots']) as $k) if (!in_array($k, $slots, true)) { unset($st['slots'][$k]); $changed = true; }
  return $changed;
}

/* ---------- history ---------- */

function dau_history_normalize(array $e) {
  if (isset($e['container']) && !isset($e['name'])) {       // v1 entry
    $e['name'] = $e['container']; $e['type'] = 'docker';
    $e['action'] = 'update'; $e['started'] = $e['ts'] ?? 0; $e['finished'] = $e['ts'] ?? 0;
    $e['error'] = ($e['result'] ?? '') === 'failed' ? ($e['message'] ?? '') : '';
  }
  return $e + ['type' => 'docker', 'name' => '', 'action' => 'update', 'result' => '', 'started' => 0, 'finished' => 0,
               'duration' => 0, 'prev' => null, 'new' => null, 'verification' => null, 'attempts' => 1, 'error' => '',
               'trigger' => '', 'message' => '', 'ts' => $e['finished'] ?? 0];
}

function dau_history_load() {
  return array_map('dau_history_normalize', array_values(array_filter(dau_read_json(DAU_HIST, []), 'is_array')));
}

/**
 * $e: type, name, action, result, started, finished, prev{version,id,digest}, new{...}, verification{result,detail},
 *     attempts, error, trigger, message. Newest first; capped to history.max_entries.
 */
function dau_history_add(array $e, $max = 200) {
  $e = dau_history_normalize($e);
  $e['id'] = bin2hex(random_bytes(4));
  $e['ts'] = $e['finished'] ?: dau_now();
  $e['duration'] = max(0, (int)$e['finished'] - (int)$e['started']);
  $e['error'] = dau_clip(dau_redact($e['error']), 500);
  $e['message'] = dau_clip(dau_redact($e['message']), 300);
  $h = dau_history_load();
  array_unshift($h, $e);
  dau_write_json(DAU_HIST, array_slice($h, 0, max(20, (int)$max)));
  return $e;
}

/** Last entry per component, for the tables. Returns name => entry for entries that changed or tried to change something. */
function dau_history_last_by_name($type) {
  $out = [];
  foreach (dau_history_load() as $e) {
    if ($e['type'] !== $type || !in_array($e['result'], ['updated', 'failed', 'interrupted'], true)) continue;
    if (!isset($out[$e['name']])) $out[$e['name']] = $e;
  }
  return $out;
}

/* ---------- statistics (persistent counters; history alone is bounded) ---------- */

function dau_stats_record(array &$st, $type, $ok, $duration) {
  if (!isset($st['stats'][$type])) $st['stats'][$type] = ['ok' => 0, 'failed' => 0, 'dur' => 0];
  $st['stats'][$type][$ok ? 'ok' : 'failed']++;
  if ($ok) $st['stats'][$type]['dur'] += max(0, (int)$duration);
}

function dau_stats_summary(array $st) {
  $out = ['total_ok' => 0, 'total_failed' => 0, 'by_type' => [], 'avg_duration' => 0];
  $dur = 0; $n = 0;
  foreach ($st['stats'] as $t => $s) {
    $out['by_type'][$t] = ['ok' => (int)$s['ok'], 'failed' => (int)$s['failed'], 'avg_duration' => $s['ok'] ? (int)round($s['dur'] / $s['ok']) : 0];
    $out['total_ok'] += (int)$s['ok']; $out['total_failed'] += (int)$s['failed'];
    $dur += (int)$s['dur']; $n += (int)$s['ok'];
  }
  $out['avg_duration'] = $n ? (int)round($dur / $n) : 0;
  return $out;
}

/* ---------- interrupted jobs ---------- */

function dau_mark_current(array &$st, $type, $name, $started) {
  $st['current'] = ['type' => $type, 'name' => $name, 'started' => $started];
  dau_state_save($st);
}

function dau_clear_current(array &$st) {
  if ($st['current'] !== null) { $st['current'] = null; dau_state_save($st); }
}

/**
 * Called once we hold the job lock. If a previous job died while changing a component (power loss, kill),
 * record it. We never retry such a component blindly: the next normal run starts from a fresh status check.
 */
function dau_recover_interrupted(array &$st, $max) {
  $c = $st['current'];
  if (!is_array($c)) return null;
  dau_history_add(['type' => $c['type'], 'name' => $c['name'], 'action' => 'update', 'result' => 'interrupted',
                   'started' => (int)$c['started'], 'finished' => dau_now(), 'trigger' => 'recovery',
                   'error' => 'The previous run ended while this component was being updated. Check it manually; the next run starts from a fresh status check.'], $max);
  dau_log('warn', $c['type'], $c['name'], 'update', 'interrupted', 'previous run ended mid-update; no automatic retry, fresh check required');
  $st['current'] = null;
  dau_state_save($st);
  return $c;
}
]]></INLINE>
