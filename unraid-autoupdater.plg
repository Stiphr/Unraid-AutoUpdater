7tvJfb0hfI7KAPz/TFDvWuZkvHcAAAAASUVORK5CYII=' | base64 -d > /tmp/dau-icon.png 2>/dev/null
if [ "$(sha256sum /tmp/dau-icon.png | cut -d' ' -f1)" = "21534bc25167a35036f951c8803762d2ee153621b9f208ce204e93c6bbc9e9d4" ]; then mv -f /tmp/dau-icon.png &emhttp;/images/unraid-autoupdater.png; chmod 644 &emhttp;/images/unraid-autoupdater.png; else echo "icon check failed, skipped"; fi
rm -f /tmp/dau-icon.png
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
mkdir -p &flash;
chmod 755 &emhttp;/scripts/run.php
# migrates settings from an older version, rebuilds the schedule and removes leftovers (runs at every boot too)
/usr/bin/php &emhttp;/scripts/run.php --install
echo ""
echo "----------------------------------------------------"
echo " Unraid Swiss Manager &version; installed"
echo " Open it from Settings > User Utilities > Unraid Swiss Manager"
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
/usr/bin/php &emhttp;/scripts/run.php --uninstall 2>/dev/null
rm -f &flash;/unraid-autoupdater.cron
/usr/local/sbin/update_cron 2>/dev/null
rm -rf &emhttp;
rm -f /var/run/unraid-autoupdater.lock /var/run/unraid-autoupdater.progress /var/run/unraid-autoupdater.stop
echo "Unraid Swiss Manager removed. Settings, history and backups were kept in &flash;"
</INLINE>
</FILE>

</PLUGIN>
