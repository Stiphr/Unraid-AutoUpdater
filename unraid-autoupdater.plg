<FILE Name="&emhttp;/include/backup.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - optional pre-update backups.
 * Three DIFFERENT things, never conflated:
 *   config  = the container's Unraid template (my-NAME.xml) + `docker inspect` JSON. Small, enough to recreate the container.
 *   image   = `docker save` of the image currently in use (lets you go back to the exact old version offline). Large.
 *   appdata = tar of the container's bind-mounted host paths under /mnt. NOT application-consistent: the container
 *             is not stopped for it, so databases may be captured mid-write. Use a proper backup plugin for those.
 * The flash drive is FAT: file permissions cannot be enforced there, which is why no secrets are ever put in a backup.
 */

function dau_backup_dir_for($dest, $name) { return rtrim($dest, '/') . '/' . $name; }

function dau_backup_free($dest) { $f = @disk_free_space($dest); return $f === false ? null : (float)$f; }

/** @return array ['ok'=>bool,'error'=>string,'files'=>[],'kinds'=>[...],'skipped'=>[reason,...]] */
function dau_backup_run(array $cfg, $name, array $inspect) {
  $b = $cfg['global']['backup'];
  $res = ['ok' => false, 'error' => '', 'files' => [], 'kinds' => [], 'skipped' => []];
  if (!dau_valid_name($name)) { $res['error'] = 'invalid container name'; return $res; }
  if (!dau_valid_dest($b['dest'] ?? '')) { $res['error'] = 'backup destination is not set to a valid path under /mnt'; return $res; }
  $dir = dau_backup_dir_for($b['dest'], $name);
  if (!is_dir($dir) && !@mkdir($dir, 0700, true)) { $res['error'] = "cannot create $dir"; return $res; }
  $stamp = date('Ymd-His', dau_now());
  $free = dau_backup_free($dir);

  $need = function ($bytes, $what) use ($free, &$res) {
    if ($free !== null && $bytes * 1.2 > $free) { $res['skipped'][] = "$what: not enough free space at the destination"; return false; }
    return true;
  };

  if (!empty($b['config'])) {
    $f = "$dir/$stamp-config.json";
    $tpl = DAU_TEMPLATES . "/my-$name.xml";
    $payload = ['container' => $name, 'time' => dau_ts_iso(dau_now()), 'template_xml' => is_file($tpl) ? (string)@file_get_contents($tpl) : null, 'inspect' => $inspect];
    // environment variables can hold passwords: strip values from the inspect copy; the template keeps what the user configured
    if (isset($payload['inspect']['Config']['Env'])) $payload['inspect']['Config']['Env'] = array_map(function ($e) { return preg_replace('/=.*/s', '=<omitted>', $e); }, $payload['inspect']['Config']['Env']);
    if (dau_write_json($f, $payload, true)) { $res['files'][] = $f; $res['kinds'][] = 'config'; } else $res['skipped'][] = 'config: write failed';
  }
  if (!empty($b['image'])) {
    $img = (string)($inspect['Image'] ?? '');
    $r = dau_docker(['image', 'inspect', '--format', '{{.Size}}', $img], 30);
    $size = (float)trim($r['out']);
    if ($need($size, 'image') && $img !== '') {
      $f = "$dir/$stamp-image.tar";
      $s = dau_docker(['save', '-o', $f, $img], 1800);
      if ($s['code'] === 0 && !$s['timeout']) { $res['files'][] = $f; $res['kinds'][] = 'image'; }
      else { @unlink($f); $res['skipped'][] = 'image: docker save failed'; }
    }
  }
  if (!empty($b['appdata'])) {
    $paths = [];
    foreach (($inspect['Mounts'] ?? []) as $m) {
      $src = (string)($m['Source'] ?? '');
      if (($m['Type'] ?? '') === 'bind' && preg_match('#^/mnt/[^\x00-\x1F]+$#', $src) && !dau_has($src, '..') && strpos($src . '/', rtrim($b['dest'], '/') . '/') !== 0 && is_dir($src)) $paths[] = $src;
    }
    if (!$paths) $res['skipped'][] = 'appdata: this container has no host folders under /mnt';
    else {
      $size = 0.0;
      foreach ($paths as $p) { $r = dau_run([dau_bin('du'), '-sb', $p], 600); $size += (float)preg_replace('/\s.*/s', '', trim($r['out'])); }
      if ($need($size, 'appdata')) {
        $f = "$dir/$stamp-appdata.tar.gz";
        $t = dau_run(array_merge([dau_bin('tar'), '-czf', $f, '--'], $paths), 3600);
        if ($t['code'] === 0 || $t['code'] === 1) { $res['files'][] = $f; $res['kinds'][] = 'appdata'; }   // 1 = files changed while reading (expected, container is running)
        else { @unlink($f); $res['skipped'][] = 'appdata: tar failed'; }
      }
    }
  }
  dau_backup_prune($dir, (int)$b['retention']);
  $wanted = array_filter([!empty($b['config']) ? 'config' : null, !empty($b['image']) ? 'image' : null, !empty($b['appdata']) ? 'appdata' : null]);
  $missing = array_diff($wanted, $res['kinds']);
  $res['ok'] = !$missing && $res['kinds'];
  if (!$res['ok']) $res['error'] = $res['skipped'] ? implode('; ', $res['skipped']) : 'no backup type selected';
  return $res;
}

/** Keep the newest $keep backup sets (a set = all files sharing one timestamp prefix). */
function dau_backup_prune($dir, $keep) {
  if ($keep < 1) return;
  $sets = [];
  foreach (glob($dir . '/*') ?: [] as $f) if (preg_match('#/(\d{8}-\d{6})-(config\.json|image\.tar|appdata\.tar\.gz)$#', $f, $m)) $sets[$m[1]][] = $f;
  krsort($sets);
  foreach (array_slice($sets, $keep, null, true) as $files) foreach ($files as $f) @unlink($f);
}
]]></INLINE>
<SHA256>29c49a74a5e7f3b5d58b82e90b601f1ff3fa37d6025e9e7605166494e47735e6</SHA256>
</FILE>

<FILE Name="&emhttp;/include/docker.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - Docker containers.
 *
 * Update flow (per container), every step verified on its own; exit codes are never trusted alone:
 *   disk check -> optional backups -> docker pull (classified) -> compare image ids -> Unraid's update_container
 *   -> verify (image id, state, health) -> targeted removal of the one replaced image.
 * A failed pull leaves the container untouched, so only pull failures are ever retried automatically.
 */

const DAU_PULL_TIMEOUT   = 1800;
const DAU_APPLY_TIMEOUT  = 900;
const DAU_MIN_FREE_BYTES = 536870912;   // below 512 MB free we do not even try to pull

function dau_docker(array $args, $timeout = 60) {
  return dau_run(array_merge([dau_bin('docker')], $args), $timeout);
}

/* ---------- update status (Unraid's own data) ---------- */

function dau_image_key($img) {
  if (strpos($img, '@') !== false) return $img;
  $pos = strrpos($img, '/');
  $last = $pos === false ? $img : substr($img, $pos + 1);
  return strpos($last, ':') === false ? $img . ':latest' : $img;
}

/** ['flag'=>true (update available)|false (up to date)|null (unknown), 'local'=>digest|null, 'remote'=>digest|null] */
function dau_update_info($img, array $map) {
  $k = dau_image_key($img);
  $nodocker = preg_replace('#^docker\.io/#', '', $k);
  foreach (array_unique([$k, $nodocker, preg_replace('#^library/#', '', $nodocker)]) as $cand) {
    if (!isset($map[$cand]) || !is_array($map[$cand])) continue;
    $e = $map[$cand];
    $local = !empty($e['local']) ? (string)$e['local'] : null;
    $remote = !empty($e['remote']) ? (string)$e['remote'] : null;
    $status = $e['status'] ?? null;
    if ($status === 'undef') return ['flag' => null, 'local' => $local, 'remote' => $remote];
    if ($local && $remote) return ['flag' => $local !== $remote, 'local' => $local, 'remote' => $remote];
    return ['flag' => null, 'local' => $local, 'remote' => $remote];
  }
  return ['flag' => null, 'local' => null, 'remote' => null];
}

/** Ask Unraid to re-check every image against its registry. nonotify: our own notifications replace the native ones. */
function dau_docker_refresh() {
  $p = DAU_DM . '/scripts/dockerupdate';
  if (!is_file($p)) return false;
  $r = dau_run([DAU_PHP, $p, 'check', 'nonotify'], 900);
  return !$r['timeout'] && $r['code'] === 0;
}

/* ---------- containers ---------- */

/** Returns the list of containers, or null when the Docker service is not running. */
function dau_containers() {
  $r = dau_docker(['ps', '-aq', '--no-trunc'], 30);
  if ($r['code'] !== 0) return null;
  $ids = array_values(array_filter(preg_split('/\s+/', trim($r['out']))));
  if (!$ids) return [];
  $r = dau_docker(array_merge(['inspect'], $ids), 90);
  $data = json_decode($r['out'], true);
  if (!is_array($data)) return [];
  $map = dau_read_json(DAU_UPDSTATUS, []);
  $out = [];
  foreach ($data as $c) {
    $name = ltrim($c['Name'] ?? '', '/');
    if ($name === '') continue;
    $labels = $c['Config']['Labels'] ?? [];
    $img = $c['Config']['Image'] ?? '';
    $u = dau_update_info($img, $map);
    $out[] = [
      'name'     => $name,
      'image'    => $img,
      'image_id' => (string)($c['Image'] ?? ''),
      'state'    => $c['State']['Status'] ?? 'unknown',
      'health'   => $c['State']['Health']['Status'] ?? null,
      'icon'     => $labels['net.unraid.docker.icon'] ?? '',
      'managed'  => dau_valid_name($name) && is_file(DAU_TEMPLATES . "/my-$name.xml") && (($labels['net.unraid.docker.managed'] ?? '') !== 'composeman'),
      'update'   => $u['flag'], 'local' => $u['local'], 'remote' => $u['remote'],
    ];
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  return $out;
}

function dau_inspect_one($name) {
  if (!dau_valid_name($name)) return null;
  $r = dau_docker(['inspect', $name], 30);
  if ($r['code'] !== 0) return null;
  $d = json_decode($r['out'], true);
  return is_array($d) && isset($d[0]) ? $d[0] : null;
}

function dau_short_id($id) { return substr(preg_replace('/^sha256:/', '', (string)$id), 0, 12); }
function dau_short_digest($d) { return $d ? 'sha256:' . substr(preg_replace('/^sha256:/', '', (string)$d), 0, 12) : ''; }

/* ---------- delay tracking ---------- */

/**
 * Remember WHEN each distinct remote image was first seen. The same digest never restarts its delay; a new digest does.
 * Containers whose update is gone (updated by hand, image removed) are forgotten so the maps stay small.
 */
function dau_docker_track(array &$st, array $containers, $now) {
  $names = [];
  foreach ($containers as $c) {
    $names[$c['name']] = true;
    $n = $c['name'];
    if ($c['update'] === true && $c['remote']) {
      $rec = $st['docker']['seen'][$n] ?? null;
      if (!is_array($rec) || ($rec['remote'] ?? '') !== $c['remote']) {
        $st['docker']['seen'][$n] = ['remote' => $c['remote'], 'local' => $c['local'], 'first' => $now, 'last' => $now];
        unset($st['docker']['retry'][$n], $st['docker']['deferred'][$n]);       // a different image: old retry/approval state is void
        if (($st['docker']['approved'][$n] ?? '') !== $c['remote']) unset($st['docker']['approved'][$n]);
      } else {
        $st['docker']['seen'][$n]['last'] = $now;
      }
    } elseif ($c['update'] === false) {
      foreach (['seen', 'retry', 'approved', 'notified', 'deferred'] as $k) unset($st['docker'][$k][$n]);
    }
  }
  foreach (['seen', 'retry', 'approved', 'notified', 'deferred'] as $k) {
    foreach (array_keys($st['docker'][$k]) as $n) if (!isset($names[$n])) unset($st['docker'][$k][$n]);
  }
}

/* ---------- eligibility ---------- */

/**
 * Decide what may happen to one container right now.
 * state: external | unknown | up_to_date | ignored | notify_only | stopped | approval | no_identity |
 *        waiting_delay | retry_wait | retry_exhausted | window_closed | ready
 * $manual = the user asked for it explicitly: policy, delay, approval and window are overridden (never "external").
 */
function dau_docker_eval(array $cfg, array $st, array $c, $now, $manual = false) {
  $cc = dau_container_cfg($cfg, $c['name']);
  $g = $cfg['global'];
  $r = ['state' => 'ready', 'reason' => '', 'eta' => null, 'delay_hours' => dau_container_delay_hours($cfg, $c['name'])];
  if (!$c['managed']) return ['state' => 'external', 'reason' => 'Not created from an Unraid template, so Unraid cannot update it from here.'] + $r;
  if ($c['update'] === null) return ['state' => 'unknown', 'reason' => 'Update status not available yet. Run a check.'] + $r;
  if ($c['update'] === false) return ['state' => 'up_to_date', 'reason' => ''] + $r;
  if ($manual) return $r;
  if ($cc['policy'] === 'ignore') return ['state' => 'ignored', 'reason' => 'Policy is "ignore": no automatic action.'] + $r;
  if ($cc['policy'] === 'notify') return ['state' => 'notify_only', 'reason' => 'Policy is "notify only".'] + $r;
  if (!empty($g['skip_stopped']) && $c['state'] !== 'running') return ['state' => 'stopped', 'reason' => 'Container is not running and "skip stopped containers" is on.'] + $r;
  if (!empty($cc['critical']) && ($st['docker']['approved'][$c['name']] ?? '') !== (string)$c['remote']) {
    return ['state' => 'approval', 'reason' => 'Marked critical: waiting for your approval of this specific image.'] + $r;
  }
  $hours = $r['delay_hours'];
  if ($hours > 0) {
    $seen = $st['docker']['seen'][$c['name']] ?? null;
    if (!$c['remote'] || !is_array($seen) || ($seen['remote'] ?? '') !== $c['remote']) {
      return ['state' => 'no_identity', 'reason' => 'An update delay is set but this image\'s digest is not available, so the update is not applied automatically.'] + $r;
    }
    $eta = (int)$seen['first'] + $hours * 3600;
    if ($now < $eta) return ['state' => 'waiting_delay', 'reason' => "Waiting for the $hours h update delay.", 'eta' => $eta] + $r;
  }
  $rt = $st['docker']['retry'][$c['name']] ?? null;
  if (is_array($rt) && ($rt['digest'] ?? '') === (string)$c['remote']) {
    if (!empty($rt['exhausted'])) return ['state' => 'retry_exhausted', 'reason' => 'Automatic retries are used up for this image. Update manually or change the policy.'] + $r;
    if ($now < (int)($rt['next_at'] ?? 0)) return ['state' => 'retry_wait', 'reason' => 'A retry is scheduled.', 'eta' => (int)$rt['next_at']] + $r;
  }
  if (!dau_window_open($g['window'], $now)) return ['state' => 'window_closed', 'reason' => 'Outside the maintenance window (' . dau_window_text($g['window']) . ').'] + $r;
  return $r;
}

/** Slots (distinct schedules) of the Docker category: slot => ['sched'=>..., 'names'=>[...]]. Containers with policy ignore are not scheduled. */
function dau_docker_slots(array $cfg) {
  $slots = [];
  $def = dau_clean_schedule($cfg['global']);
  foreach ($cfg['containers'] as $name => $c) {
    $name = (string)$name;
    $cc = dau_container_cfg($cfg, $name);
    if ($cc['policy'] === 'ignore') continue;
    $own = dau_clean_schedule($cc['schedule']);
    if ($own) { $k = dau_slot_key($own); $s = $own; }
    elseif (!empty($cfg['global']['enabled'])) { $k = 'global'; $s = $def; }
    else continue;
    if (!isset($slots[$k])) $slots[$k] = ['sched' => $s, 'names' => []];
    $slots[$k]['names'][] = $name;
  }
  return $slots;
}

/* ---------- pull error classification ---------- */

/** @return array [class('transient'|'permanent'), friendly text, suggested next step] */
function dau_classify_pull_error($text) {
  $t = strtolower($text);
  foreach (['unauthorized', 'denied', 'manifest unknown', 'not found', 'no such image', 'invalid reference', 'repository does not exist', 'no matching manifest', 'authentication required'] as $p) {
    if (strpos($t, $p) !== false) {
      return ['permanent', 'The registry rejected the pull (' . $p . ').', 'Check the image name and tag in the container\'s settings, and registry credentials if the image is private. The container was not touched.'];
    }
  }
  foreach (['toomanyrequests', 'rate limit'] as $p) if (strpos($t, $p) !== false) return ['transient', 'The registry rate limit was reached.', 'Wait, or sign in to the registry. The container was not touched.'];
  foreach (['timeout', 'timed out', 'tls handshake', 'connection refused', 'connection reset', 'no such host', 'temporary failure', 'eof', 'network is unreachable', 'context deadline', '502', '503', '504', 'unexpected status'] as $p) {
    if (strpos($t, $p) !== false) return ['transient', 'Network or registry problem while pulling (' . $p . ').', 'Usually temporary. The container was not touched.'];
  }
  return ['transient', 'The image could not be pulled.', 'The container was not touched. Check the log for details.'];
}

/* ---------- verification ---------- */

/**
 * Verify a container after the update. Distinguishes: healthy, running_no_healthcheck (no health check configured -
 * NOT a failure), not_running_expected (it was stopped before), timeout (still starting), and the failures
 * image_mismatch, not_found, failed_to_start, restart_loop, unhealthy.
 * @return array ['result'=>string,'ok'=>bool,'detail'=>string]
 */
function dau_docker_verify($name, $expectedImageId, $expectRunning, $timeout) {
  $start = dau_now(); $deadline = $start + max(5, (int)$timeout);
  $stable = min(10, max(3, (int)($timeout / 6)));
  $runningSince = null; $firstRestarts = null; $startedAt = null; $lastHealth = null; $lastStatus = '';
  while (true) {
    $i = dau_inspect_one($name);
    if ($i === null) {
      if (dau_now() >= $deadline) return ['result' => 'not_found', 'ok' => false, 'detail' => 'The container does not exist after the update.'];
      dau_sleep(2); continue;
    }
    $now = dau_now();
    if ($expectedImageId && (string)($i['Image'] ?? '') !== $expectedImageId) {
      return ['result' => 'image_mismatch', 'ok' => false, 'detail' => 'The container is not using the new image (' . dau_short_id($i['Image'] ?? '') . ' instead of ' . dau_short_id($expectedImageId) . ').'];
    }
    $status = $i['State']['Status'] ?? 'unknown';
    $health = $i['State']['Health']['Status'] ?? null;
    $restarts = (int)($i['RestartCount'] ?? 0);
    $lastHealth = $health; $lastStatus = $status;
    if (!$expectRunning) {
      if (in_array($status, ['created', 'exited'], true)) return ['result' => 'not_running_expected', 'ok' => true, 'detail' => 'The container was stopped before the update and was left stopped.'];
      if ($status === 'running') return ['result' => 'running_no_healthcheck', 'ok' => true, 'detail' => 'The container is running.'];
    }
    if (in_array($status, ['exited', 'dead'], true)) {
      return ['result' => 'failed_to_start', 'ok' => false, 'detail' => "The container stopped right after the update (status $status, exit code " . (int)($i['State']['ExitCode'] ?? 0) . ').'];
    }
    if ($status === 'restarting') {
      if ($firstRestarts === null) $firstRestarts = $restarts;
      if ($restarts - $firstRestarts >= 2) return ['result' => 'restart_loop', 'ok' => false, 'detail' => 'The container keeps restarting.'];
      $runningSince = null;
    } elseif ($status === 'running') {
      if ($health === 'healthy') return ['result' => 'healthy', 'ok' => true, 'detail' => 'The container reports healthy.'];
      if ($health === 'unhealthy') return ['result' => 'unhealthy', 'ok' => false, 'detail' => 'The container health check reports unhealthy.'];
      $sa = $i['State']['StartedAt'] ?? '';
      if ($startedAt !== $sa) { $startedAt = $sa; $runningSince = $now; if ($firstRestarts === null) $firstRestarts = $restarts; }
      if ($health === null && $runningSince !== null && $now - $runningSince >= $stable && $restarts === $firstRestarts) {
        return ['result' => 'running_no_healthcheck', 'ok' => true, 'detail' => 'Running and stable for ' . $stable . ' s. This container has no health check, so health could not be confirmed.'];
      }
    }
    if ($now >= $deadline) {
      $d = $health === 'starting' ? 'The health check is still "starting" after ' . (int)$timeout . ' s.' : "Status \"$lastStatus\" after " . (int)$timeout . ' s.';
      return ['result' => 'timeout', 'ok' => false, 'detail' => $d . ' The update was applied; verification could not finish in time.'];
    }
    dau_sleep(2);
  }
}

/* ---------- the update ---------- */

function dau_docker_free_bytes() {
  $p = is_dir('/var/lib/docker') ? '/var/lib/docker' : '/';
  $f = @disk_free_space($p);
  return $f === false ? null : (float)$f;
}

/**
 * Update one container. Returns:
 *  result: updated | unchanged | failed | blocked      stage: precheck|disk|backup|pull|apply|verify
 *  transient: bool (safe to retry automatically; only ever true when the container was not touched)
 *  verification: ['result','ok','detail'] | null      prev/new: ['id','digest']      warnings: [...]
 */
function dau_docker_update(array $cfg, $name, array $c) {
  $g = $cfg['global'];
  $out = ['result' => 'failed', 'stage' => 'precheck', 'error' => '', 'transient' => false, 'verification' => null, 'next' => '', 'warnings' => [],
          'prev' => ['id' => dau_short_id($c['image_id']), 'digest' => $c['local']], 'new' => ['id' => '', 'digest' => $c['remote']],
          'backup' => null, 'cleanup' => null, 'started' => dau_now(), 'finished' => 0];
  $done = function () use (&$out) { $out['finished'] = dau_now(); return $out; };

  if (!dau_valid_name($name) || empty($c['managed'])) { $out['error'] = 'Not an Unraid-managed container.'; $out['result'] = 'blocked'; return $done(); }
  $script = DAU_DM . '/scripts/update_container';
  if (!is_file($script)) { $out['error'] = 'Unraid\'s update_container script was not found.'; $out['result'] = 'blocked'; return $done(); }
  $before = dau_inspect_one($name);
  if ($before === null) { $out['error'] = 'The container does not exist.'; $out['result'] = 'blocked'; return $done(); }
  $wasRunning = !empty($before['State']['Running']);
  $oldId = (string)($before['Image'] ?? '');
  $image = (string)($before['Config']['Image'] ?? $c['image']);
  $out['prev']['id'] = dau_short_id($oldId);
  $r = dau_docker(['image', 'inspect', '--format', '{{json .RepoDigests}}', $oldId], 30);
  $rd = json_decode($r['out'], true);
  if (is_array($rd) && $rd) $out['prev']['digest'] = preg_replace('/^.*@/', '', $rd[0]);

  /* disk space */
  if (!empty($g['disk_check'])) {
    $free = dau_docker_free_bytes();
    if ($free !== null) {
      if ($free < DAU_MIN_FREE_BYTES) { $out['stage'] = 'disk'; $out['result'] = 'blocked'; $out['error'] = 'Only ' . round($free / 1048576) . ' MB free for Docker; not pulling.'; $out['next'] = 'Free up space on the cache/docker.img, then update again.'; return $done(); }
      if ($free < (float)$g['min_free_gb'] * 1073741824) $out['warnings'][] = 'Low disk space for Docker: ' . round($free / 1073741824, 1) . ' GB free (warning level ' . (int)$g['min_free_gb'] . ' GB).';
    }
  }

  /* backups (optional) */
  $cc = dau_container_cfg($cfg, $name);
  if (!empty($g['backup']['enabled']) && !empty($cc['backup'])) {
    $b = dau_backup_run($cfg, $name, $before);
    $out['backup'] = $b;
    if (!$b['ok']) {
      if (!empty($g['backup']['required'])) { $out['stage'] = 'backup'; $out['result'] = 'blocked'; $out['error'] = 'Required backup failed: ' . $b['error']; $out['next'] = 'The container was not touched. Fix the backup destination or turn "backup required" off.'; return $done(); }
      $out['warnings'][] = 'Backup failed, updating anyway (backup is not required): ' . $b['error'];
    }
  }

  /* pull. A failure here leaves the container untouched. */
  $out['stage'] = 'pull';
  $p = dau_docker(['pull', $image], DAU_PULL_TIMEOUT);
  if ($p['timeout'] || $p['code'] !== 0) {
    $text = $p['timeout'] ? 'pull timed out' : trim($p['err'] . "\n" . $p['out']);
    list($class, $why, $next) = $p['timeout'] ? ['transient', 'The pull took too long and was stopped.', 'The container was not touched.'] : dau_classify_pull_error($text);
    $out['error'] = $why . ' ' . dau_clip(dau_redact($text), 300);
    $out['transient'] = $class === 'transient'; $out['next'] = $next;
    return $done();
  }
  $r = dau_docker(['image', 'inspect', '--format', '{{.Id}}', $image], 30);
  $newId = trim($r['out']);
  if ($r['code'] !== 0 || $newId === '') { $out['error'] = 'The image was pulled but cannot be inspected.'; $out['transient'] = true; return $done(); }
  $out['new']['id'] = dau_short_id($newId);
  if ($newId === $oldId) { $out['result'] = 'unchanged'; $out['stage'] = ''; return $done(); }   // already running the newest image: do not restart it for nothing

  /* apply with Unraid's own routine (keeps the template, network and extra settings). From here on, never auto-retry. */
  $out['stage'] = 'apply';
  $a = dau_run([DAU_PHP, $script, rawurlencode($name)], DAU_APPLY_TIMEOUT);
  if ($a['timeout']) { $out['error'] = 'Unraid\'s update routine did not finish in ' . DAU_APPLY_TIMEOUT . ' s.'; $out['next'] = 'Check the container in the Docker tab before doing anything else.'; }

  /* verify, independent of the exit code */
  $out['stage'] = 'verify';
  $vt = !empty($g['verify']['enabled']) ? (int)$g['verify']['timeout'] : 10;
  $v = dau_docker_verify($name, $newId, $wasRunning, $vt);
  $out['verification'] = $v;
  if (empty($g['verify']['enabled']) && $v['ok']) $out['verification']['detail'] = 'Health verification is switched off; only the image and container state were checked. ' . $v['detail'];

  $prevRef = $image . ($out['prev']['digest'] ? '@' . $out['prev']['digest'] : '');
  if ($v['ok'] || $v['result'] === 'timeout') {
    $out['result'] = 'updated'; $out['stage'] = '';
    if ($v['result'] === 'timeout') $out['next'] = 'Check the container\'s logs; it may simply need longer to become healthy. Increase the verification timeout in Settings if this is normal.';
    /* targeted cleanup: only the replaced image, never forced, so Docker itself refuses if anything still uses it */
    if (!empty($g['cleanup']) && $v['ok'] && $oldId !== '' && $oldId !== $newId) {
      $rm = dau_docker(['image', 'rm', $oldId], 120);
      $out['cleanup'] = $rm['code'] === 0 ? 'removed' : 'kept (still in use or already removed)';
    }
    return $done();
  }
  $out['result'] = 'failed';
  $out['error'] = $v['detail'];
  $out['next'] = 'The previous image was kept. Check the container\'s logs. To go back: edit the container, set Repository to "' . $prevRef . '" and apply. See the README section on recovery.';
  return $done();
}

/** Remove the retry record for a container that has finished (or whose image changed). */
function dau_docker_retry_clear(array &$st, $name) { unset($st['docker']['retry'][$name]); }

/**
 * Decide retry behaviour after a failure. Only a failure that left the container untouched (transient pull error)
 * is retried, at most retry.max times, retry.interval_min apart. Returns 'scheduled' | 'exhausted' | 'none'.
 */
function dau_docker_retry_after_failure(array $cfg, array &$st, $name, array $c, array $res, $now) {
  $max = (int)$cfg['global']['retry']['max'];
  if (!$res['transient'] || $max <= 0) return 'none';
  $rt = $st['docker']['retry'][$name] ?? null;
  if (!is_array($rt) || ($rt['digest'] ?? '') !== (string)$c['remote']) $rt = ['digest' => (string)$c['remote'], 'attempts' => 0];
  $rt['attempts'] = (int)$rt['attempts'] + 1;
  $rt['error'] = dau_clip($res['error'], 200);
  if ($rt['attempts'] > $max) { $rt['exhausted'] = true; unset($rt['next_at']); $st['docker']['retry'][$name] = $rt; return 'exhausted'; }
  $rt['next_at'] = $now + (int)$cfg['global']['retry']['interval_min'] * 60;
  $st['docker']['retry'][$name] = $rt;
  return 'scheduled';
}
]]></INLINE>
<SHA256>f8a36ba9be3322b74be857616873ef50429ff7549a346bfb7dd61f51203bf38a</SHA256>
</FILE>

<FILE Name="&emhttp;/include/plugins.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - Unraid plugins.
 * Only Unraid's own `plugin` tool ever installs anything: `plugin check` downloads the plg the plugin itself points
 * to, `plugin update` installs that downloaded file. This module adds the safety net around it (opt-in, policies,
 * delay, validation, pinning, verification). It never disables a check Unraid does and never auto-rolls back.
 */

const DAU_PLG_MAX_BYTES = 2097152;

function dau_plugin_bin() { return dau_bin('plugin'); }

function dau_plg_attr($path, $attr) {
  $r = dau_run([dau_plugin_bin(), $attr, $path], 30);
  return $r['code'] === 0 ? trim($r['out']) : '';
}

/** Installed plugins (never Unraid itself). */
function dau_plugins_installed() {
  $out = [];
  foreach (glob(DAU_PLUGLINKS . '/*.plg') ?: [] as $link) {
    $f = basename($link);
    if (!dau_valid_plg($f) || $f === 'unRAIDServer.plg' || strpos($f, 'unRAIDServer-') === 0) continue;
    $path = DAU_PLUGBOOT . '/' . $f;
    if (!is_file($path)) continue;
    $out[$f] = [
      'file' => $f, 'path' => $path, 'self' => $f === DAU_SELF_PLG,
      'name' => preg_replace('/\.plg$/', '', $f),
      'version' => dau_plg_attr($path, 'version'),
      'url' => dau_plg_attr($path, 'pluginURL'),
      'min' => dau_plg_attr($path, 'min'), 'max' => dau_plg_attr($path, 'max'),
    ];
  }
  ksort($out);
  return $out;
}

/**
 * Ask the plugin's own server for its current version. `plugin check` downloads the new plg to /tmp/plugins and prints
 * progress and hook-script lines around the version, so stdout is NOT parsed: the version is read from the downloaded file.
 */
function dau_plugin_check($file) {
  if (!dau_valid_plg($file)) return ['ok' => false, 'error' => 'invalid plugin name'];
  $tmp = DAU_PLUGTMP . '/' . $file;
  if (is_file($tmp)) @unlink($tmp);                      // never trust a stale download
  $r = dau_run([dau_plugin_bin(), 'check', $file], 120);
  if ($r['timeout']) return ['ok' => false, 'error' => 'check timed out'];
  $err = function () use ($r) { return dau_clip(dau_redact(trim(preg_replace('/[\r\n]+/', ' ', $r['err'] . ' ' . $r['out']))), 200) ?: 'no version returned'; };
  if ($r['code'] !== 0 || !is_file($tmp)) return ['ok' => false, 'error' => $err()];
  $v = dau_plg_attr($tmp, 'version');
  if ($v === '' || !preg_match('/^[A-Za-z0-9._+-]{1,40}$/', $v)) return ['ok' => false, 'error' => 'the downloaded plugin file has no valid version'];
  return ['ok' => true, 'latest' => $v];
}

/** Mirrors Unraid's own comparison (string compare of the version names). */
function dau_version_newer($latest, $installed) { return $latest !== '' && strcmp($latest, $installed) > 0; }

function dau_url_hosts($text) {
  $h = [];
  if (preg_match_all('#https?://([^/\s"\'<>:]+)#i', $text, $m)) foreach ($m[1] as $x) $h[strtolower($x)] = true;
  return array_keys($h);
}

/** Parse a plg safely: refuse external entities, no network. Returns SimpleXMLElement|null. */
function dau_plg_parse($text) {
  if (preg_match('/<!ENTITY\s+\S+\s+(SYSTEM|PUBLIC)\b/i', $text)) return null;
  $prev = libxml_use_internal_errors(true);
  if (PHP_VERSION_ID < 80000) libxml_disable_entity_loader(true);
  $x = @simplexml_load_string($text, 'SimpleXMLElement', LIBXML_NONET | LIBXML_NOENT);
  libxml_clear_errors(); libxml_use_internal_errors($prev);
  return $x instanceof SimpleXMLElement && $x->getName() === 'PLUGIN' ? $x : null;
}

function dau_unraid_version_ok($min, $max) {
  $cur = dau_os_version();
  if ($cur === '') return true;
  if ($min !== '' && version_compare($cur, $min, '<')) return false;
  if ($max !== '' && version_compare($cur, $max, '>')) return false;
  return true;
}

/**
 * Validate the downloaded update before it may be applied automatically.
 * @return array ['ok'=>bool,'reason'=>string,'sha'=>string]
 */
function dau_plugin_validate(array $p, $latest) {
  $no = function ($why) { return ['ok' => false, 'reason' => $why, 'sha' => '']; };
  if ($p['self']) return $no('This plugin never updates itself automatically.');
  $url = $p['url'];
  if ($url === '' || !preg_match('~^https://[A-Za-z0-9.-]+(:\d+)?/[A-Za-z0-9._%/+@:=?&#-]*$~', $url) || strlen($url) > 400) {
    return $no('Plugin source URL is not a plain https:// address (' . dau_clip($url, 80) . ').');
  }
  $tmp = DAU_PLUGTMP . '/' . $p['file'];
  if (!is_file($tmp)) return $no('The downloaded update file is missing.');
  $size = filesize($tmp);
  if ($size === false || $size < 50 || $size > DAU_PLG_MAX_BYTES) return $no('The downloaded update file has an unexpected size.');
  $text = (string)file_get_contents($tmp);
  $x = dau_plg_parse($text);
  if ($x === null) return $no('The downloaded update is not a valid plugin file (or uses external XML entities).');
  if ((string)$x['pluginURL'] !== '' && (string)$x['pluginURL'] !== $url) return $no('The update changes the plugin\'s source URL; install it manually after reviewing.');
  if ((string)$x['name'] !== '' && (string)$x['name'] !== $p['name']) return $no('The update changes the plugin name.');
  $ver = (string)$x['version'];
  if ($ver !== $latest) return $no("Downloaded version ($ver) differs from the announced version ($latest).");
  if (!dau_version_newer($ver, $p['version'])) return $no('Not newer than the installed version.');
  if (!dau_unraid_version_ok((string)$x['min'], (string)$x['max'])) return $no('Not compatible with this Unraid version (min ' . (string)$x['min'] . ', max ' . (string)$x['max'] . ').');
  $oldText = (string)@file_get_contents($p['path']);
  $allowed = array_merge(dau_url_hosts($oldText), dau_url_hosts($url));
  $new = array_diff(dau_url_hosts($text), $allowed);
  if ($new) return $no('The update downloads from a new host (' . implode(', ', array_slice($new, 0, 3)) . '); review and install it manually.');
  return ['ok' => true, 'reason' => '', 'sha' => hash('sha256', $text)];
}

/** Eligibility (same vocabulary as containers). */
function dau_plugin_eval(array $cfg, array $st, array $p, $latest, $now, $manual = false) {
  $pc = $cfg['plugins'];
  if ($p['self'] && $manual) return ['state' => 'self', 'reason' => 'Update this plugin from Plugins > Unraid Swiss Manager.', 'eta' => null];
  if ($p['self']) return ['state' => 'self', 'reason' => 'This plugin never updates itself automatically.', 'eta' => null];
  if (!dau_version_newer($latest, $p['version'])) return ['state' => 'up_to_date', 'reason' => '', 'eta' => null];
  if ($manual) return ['state' => 'ready', 'reason' => '', 'eta' => null];
  $policy = dau_plugin_policy($cfg, $p['file']);
  if (empty($pc['auto_update'])) return ['state' => $policy === 'ignore' ? 'ignored' : 'notify_only', 'reason' => 'Automatic plugin updates are switched off globally.', 'eta' => null];
  if ($policy === 'ignore') return ['state' => 'ignored', 'reason' => 'Policy is "ignore".', 'eta' => null];
  if ($policy === 'notify') return ['state' => 'notify_only', 'reason' => 'Policy is "notify only".', 'eta' => null];
  $seen = $st['plugins']['seen'][$p['file']] ?? null;
  $hours = (int)$pc['delay_hours'];
  if ($hours > 0) {
    if (!is_array($seen) || ($seen['version'] ?? '') !== $latest) return ['state' => 'no_identity', 'reason' => 'Version not tracked yet.', 'eta' => null];
    $eta = (int)$seen['first'] + $hours * 3600;
    if ($now < $eta) return ['state' => 'waiting_delay', 'reason' => "Waiting for the $hours h delay.", 'eta' => $eta];
  }
  $bl = $st['plugins']['blocked'][$p['file']] ?? null;
  if (is_array($bl) && ($bl['version'] ?? '') === $latest) return ['state' => 'blocked', 'reason' => $bl['reason'] ?? 'Blocked by a safety check.', 'eta' => null];
  if (!dau_window_open($pc['window'], $now)) return ['state' => 'window_closed', 'reason' => 'Outside the maintenance window.', 'eta' => null];
  return ['state' => 'ready', 'reason' => '', 'eta' => null];
}

/** Record when each available version was first seen. */
function dau_plugins_track(array &$st, array $avail, $now) {
  $seen = [];
  foreach ($avail as $f => $latest) {
    $r = $st['plugins']['seen'][$f] ?? null;
    $seen[$f] = (is_array($r) && ($r['version'] ?? '') === $latest) ? ['version' => $latest, 'first' => $r['first'], 'last' => $now] : ['version' => $latest, 'first' => $now, 'last' => $now];
  }
  $st['plugins']['seen'] = $seen;
  foreach (['notified', 'blocked'] as $k) foreach (array_keys($st['plugins'][$k]) as $f) if (!isset($avail[$f])) unset($st['plugins'][$k][$f]);
}

function dau_plugin_recovery_copy($p) {
  if (!is_dir(DAU_RECOVERY)) @mkdir(DAU_RECOVERY, 0755, true);
  $dst = DAU_RECOVERY . '/' . $p['name'] . '-' . preg_replace('/[^A-Za-z0-9._-]/', '_', $p['version']) . '.plg';
  if (!@copy($p['path'], $dst)) return null;
  $all = glob(DAU_RECOVERY . '/' . $p['name'] . '-*.plg') ?: [];
  usort($all, function ($a, $b) { return filemtime($b) <=> filemtime($a); });
  foreach (array_slice($all, 3) as $old) @unlink($old);
  return $dst;
}

/**
 * Apply one plugin update. Result: updated | failed | blocked, with stage and recovery guidance (no rollback is attempted).
 */
function dau_plugin_update(array $cfg, array $p, $latest) {
  $res = ['result' => 'failed', 'stage' => 'validate', 'error' => '', 'next' => '', 'prev' => ['version' => $p['version']], 'new' => ['version' => $latest], 'started' => dau_now(), 'finished' => 0, 'verification' => null, 'warnings' => []];
  $done = function () use (&$res) { $res['finished'] = dau_now(); return $res; };
  $v = dau_plugin_validate($p, $latest);
  if (!$v['ok']) { $res['result'] = 'blocked'; $res['error'] = $v['reason']; $res['next'] = 'Review the change and update from the Plugins page if you trust it.'; return $done(); }
  $rec = dau_plugin_recovery_copy($p);
  if ($rec === null) $res['warnings'][] = 'Could not save a recovery copy of the current plugin file.';
  // re-check the file has not changed between validation and install
  $tmp = DAU_PLUGTMP . '/' . $p['file'];
  if (hash('sha256', (string)@file_get_contents($tmp)) !== $v['sha']) { $res['result'] = 'blocked'; $res['error'] = 'The downloaded file changed after validation.'; return $done(); }
  $res['stage'] = 'install';
  $r = dau_run([dau_plugin_bin(), 'update', $p['file']], 900);
  $res['stage'] = 'verify';
  $now = dau_plg_attr($p['path'], 'version');
  if ($now === $latest) {
    $res['result'] = 'updated'; $res['stage'] = '';
    $res['verification'] = ['result' => 'version_matches', 'ok' => true, 'detail' => "Installed plugin file now reports version $latest."];
    return $done();
  }
  $res['error'] = $r['timeout'] ? 'The install did not finish in time.' : 'After the install the plugin still reports version ' . ($now ?: 'unknown') . ' (expected ' . $latest . '). ' . dau_clip(dau_redact(trim($r['err'] . ' ' . $r['out'])), 200);
  $res['next'] = 'Not rolled back automatically. Check Plugins for the plugin\'s state' . ($rec ? '; the previous plugin file is saved in ' . $rec . ' (copy it over /boot/config/plugins/' . $p['file'] . ' and reboot to restore it)' : '') . '.';
  return $done();
}

/** Check all installed plugins. Returns ['avail'=>[file=>latest], 'errors'=>[file=>msg]]. */
function dau_plugins_check_all(array $cfg, array $installed) {
  $avail = []; $errors = [];
  foreach ($installed as $f => $p) {
    if (dau_stop_requested()) break;
    $c = dau_plugin_check($f);
    if (!$c['ok']) { $errors[$f] = $c['error']; continue; }
    if (dau_version_newer($c['latest'], $p['version'])) $avail[$f] = $c['latest'];
  }
  return ['avail' => $avail, 'errors' => $errors];
}

function dau_plugin_slots(array $cfg) {
  $pc = $cfg['plugins'];
  if (empty($pc['check_enabled']) && empty($pc['auto_update'])) return [];
  $s = dau_clean_schedule($pc);
  return $s ? ['plugins' => ['sched' => $s, 'names' => ['*']]] : [];
}
]]></INLINE>
<SHA256>e07771bfc3c2783fa0a68f2868558c0d74e0c91ee2311953e28493bd04a0cdb5</SHA256>
</FILE>

<FILE Name="&emhttp;/include/os.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - Unraid OS.
 * DEFAULT: check and notify only. Installing an OS update (mode "install") and rebooting afterwards (mode "install_reboot")
 * are opt-in, need an explicit confirmation in the UI, a maintenance window and a waiting period, and use only Unraid's own
 * `plugin update unRAIDServer.plg` (the same thing Tools > Update OS runs) and the stock reboot command. Nothing is rolled back
 * automatically: Unraid keeps the previous release on the flash drive (Tools > Update OS > Restore).
 */

function dau_os_check() {
  $res = dau_plugin_check('unRAIDServer.plg');
  if (!$res['ok']) return $res;
  if (!preg_match('/^[0-9][A-Za-z0-9._+-]{0,30}$/', $res['latest'])) return ['ok' => false, 'error' => 'The OS update check returned an unexpected version.'];
  return $res;
}

function dau_os_notes() {
  $r = dau_run([dau_plugin_bin(), 'changes', DAU_PLUGTMP . '/unRAIDServer.plg'], 60);
  return $r['code'] === 0 ? dau_clip(dau_redact(trim($r['out'])), 900) : '';
}

/**
 * Update the OS block of the state from a check result and return the events that should be announced (each only once).
 * Events: available, os_withdrawn, os_check_failed, os_installed.
 */
function dau_os_process(array &$st, array $check, $now) {
  $os =& $st['os'];
  $events = [];
  $installed = dau_os_version();
  $os['last_check'] = $now;
  $prev = $os['installed'];
  if ($prev !== null && $installed !== '' && $prev !== $installed && ($os['notified'] === $installed || $os['available'] === $installed)) {
    $events[] = ['kind' => 'os_installed', 'installed' => $prev, 'available' => $installed];
  }
  $os['installed'] = $installed;
  if (!$check['ok']) {
    $os['last_error'] = $check['error'];
    if (empty($os['error_notified'])) { $events[] = ['kind' => 'os_check_failed', 'installed' => $installed, 'error' => $check['error']]; $os['error_notified'] = true; }
    return $events;
  }
  $os['error_notified'] = false; $os['last_error'] = ''; $os['last_check_ok'] = $now;
  $latest = $check['latest'];
  if (dau_version_newer($latest, $installed)) {
    if ($os['available'] !== $latest) { $os['available'] = $latest; $os['first_seen'] = $now; $os['withdrawn_notified'] = false; $os['notes'] = dau_os_notes(); }
    if ($os['notified'] !== $latest) {
      $events[] = ['kind' => 'available', 'installed' => $installed, 'available' => $latest, 'reason' => $os['notes']];
      $os['notified'] = $latest;
    }
  } else {
    if ($os['available'] !== null && $os['available'] !== $installed && $os['notified'] === $os['available'] && empty($os['withdrawn_notified'])) {
      $events[] = ['kind' => 'os_withdrawn', 'installed' => $installed, 'available' => $os['available']];
      $os['withdrawn_notified'] = true;
    }
    if ($os['available'] === $installed || $os['available'] === null) { $os['available'] = null; }
    else $os['available'] = null;
    $os['notes'] = '';
  }
  return $events;
}

/* ---------------- policy ---------------- */

function dau_os_is_stable($v) { return preg_match('/^[0-9]+\.[0-9]+\.[0-9]+$/', (string)$v) === 1; }

/** Array state from Unraid's own var.ini. */
function dau_os_array_state() {
  $v = @parse_ini_file(DAU_VARINI);
  if (!is_array($v) || empty($v['mdState'])) return ['ok' => false, 'state' => '', 'resync' => 0];
  return ['ok' => true, 'state' => strtoupper((string)$v['mdState']), 'resync' => (int)($v['mdResync'] ?? 0)];
}

/** May the server be rebooted right now without interrupting something important? */
function dau_os_reboot_safe() {
  $a = dau_os_array_state();
  if (!$a['ok']) return ['ok' => false, 'reason' => 'The array state could not be read.'];
  if (!in_array($a['state'], ['STARTED', 'STOPPED'], true)) return ['ok' => false, 'reason' => 'The array is in state ' . $a['state'] . ' (not a plain started or stopped array).'];
  if ($a['resync'] > 0) return ['ok' => false, 'reason' => 'A parity check, sync or rebuild is running.'];
  return ['ok' => true, 'reason' => ''];
}

function dau_os_boot_free_mb() {
  if (isset($GLOBALS['DAU_BOOTFREE'])) return (int)$GLOBALS['DAU_BOOTFREE'];
  $f = @disk_free_space(DAU_BOOT);
  return $f === false ? 0 : (int)($f / 1048576);
}

/** The installed OS plugin file, shaped like a plugin entry so the plugin safety checks can be reused. */
function dau_os_plugin_entry() {
  $path = DAU_PLUGBOOT . '/unRAIDServer.plg';
  if (!is_file($path)) $path = DAU_PLUGLINKS . '/unRAIDServer.plg';
  return ['file' => 'unRAIDServer.plg', 'path' => $path, 'self' => false, 'name' => 'unRAIDServer', 'version' => dau_os_version() ?: '',
          'url' => dau_plg_attr($path, 'pluginURL'), 'min' => dau_plg_attr($path, 'min'), 'max' => dau_plg_attr($path, 'max')];
}

/**
 * What would happen to the available OS version right now?
 * state: up_to_date | awaiting_confirmation | notify_only | not_confirmed | prerelease | blocked | waiting_delay | window_closed | staged | ready
 */
function dau_os_eval(array $cfg, array $st, $now, $manual = false) {
  $o = $cfg['os']; $os = $st['os'];
  $latest = $os['available'];
  if ($latest === null || $latest === '') return ['state' => 'up_to_date', 'reason' => '', 'eta' => null];
  $pend = $os['pending'] ?? null;
  if (is_array($pend) && ($pend['to'] ?? '') === $latest) return ['state' => 'staged', 'reason' => 'Installed, waiting for a reboot.', 'eta' => null];
  $wf = $os['workflow'] ?? null;
  if (is_array($wf) && ($wf['state'] ?? '') === 'awaiting_confirmation' && ($wf['version'] ?? '') === $latest) return ['state' => 'awaiting_confirmation', 'reason' => 'Prerequisites passed; waiting for your confirmation.', 'eta' => null];
  if ($manual) return ['state' => 'ready', 'reason' => '', 'eta' => null];
  if ($o['mode'] === 'notify') return ['state' => 'notify_only', 'reason' => 'Automatic installation is off (notify only).', 'eta' => null];
  if ($o['confirmed'] !== $o['mode']) return ['state' => 'not_confirmed', 'reason' => 'The automatic mode was not confirmed.', 'eta' => null];
  if (!empty($o['stable_only']) && !dau_os_is_stable($latest)) return ['state' => 'prerelease', 'reason' => 'Only stable releases are installed automatically.', 'eta' => null];
  $at = $os['attempted'] ?? null;
  if (is_array($at) && ($at['version'] ?? '') === $latest) return ['state' => 'blocked', 'reason' => 'The last attempt for this version did not succeed: ' . ($at['reason'] ?? ''), 'eta' => null];
  if (empty($o['window']['enabled'])) return ['state' => 'blocked', 'reason' => 'Automatic OS installs need a maintenance window.', 'eta' => null];
  $eta = (int)$os['first_seen'] + (int)$o['delay_days'] * 86400;
  if ($now < $eta) return ['state' => 'waiting_delay', 'reason' => 'Waiting ' . (int)$o['delay_days'] . ' day(s) after the release was first seen.', 'eta' => $eta];
  if (!dau_window_open($o['window'], $now)) return ['state' => 'window_closed', 'reason' => 'Outside the maintenance window.', 'eta' => null];
  return ['state' => 'ready', 'reason' => '', 'eta' => null];
}

/* ---------------- install + reboot ---------------- */

/**
 * Install the OS update through `plugin update unRAIDServer.plg` after a fresh check and the standard plugin validation.
 * The new release only becomes active after a reboot. Result: staged | failed | blocked.
 */
function dau_os_install(array $cfg, $latest) {
  $installed = dau_os_version() ?: '';
  $res = ['result' => 'failed', 'stage' => 'check', 'error' => '', 'next' => '', 'prev' => ['version' => $installed], 'new' => ['version' => $latest], 'started' => dau_now(), 'finished' => 0, 'verification' => null];
  $done = function () use (&$res) { $res['finished'] = dau_now(); return $res; };
  $res['next'] = 'Nothing was changed.';
  $chk = dau_os_check();
  if (!$chk['ok']) { $res['error'] = 'Fresh update check failed: ' . $chk['error']; return $done(); }
  if ($chk['latest'] !== $latest) { $res['result'] = 'blocked'; $res['error'] = 'The offered version changed from ' . $latest . ' to ' . $chk['latest'] . ' during the check.'; return $done(); }
  $res['stage'] = 'validate';
  $p = dau_os_plugin_entry();
  $v = dau_plugin_validate($p, $latest);
  if (!$v['ok']) { $res['result'] = 'blocked'; $res['error'] = $v['reason']; $res['next'] = 'Install it yourself from Tools > Update OS after reading the release notes.'; return $done(); }
  $res['stage'] = 'space';
  $free = dau_os_boot_free_mb();
  if ($free < 600) { $res['result'] = 'blocked'; $res['error'] = 'Only ' . $free . ' MB free on the flash drive (600 MB needed).'; $res['next'] = 'Free up space on the flash drive and try again.'; return $done(); }
  $tmp = DAU_PLUGTMP . '/unRAIDServer.plg';
  if (hash('sha256', (string)@file_get_contents($tmp)) !== $v['sha']) { $res['result'] = 'blocked'; $res['error'] = 'The downloaded file changed after validation.'; return $done(); }
  $res['stage'] = 'install';
  $r = dau_run([dau_plugin_bin(), 'update', 'unRAIDServer.plg'], 1800);
  $res['stage'] = 'verify';
  $now = dau_plg_attr(DAU_PLUGBOOT . '/unRAIDServer.plg', 'version');
  if ($now === '') $now = dau_plg_attr(DAU_PLUGLINKS . '/unRAIDServer.plg', 'version');
  $files = is_file(DAU_BOOT . '/bzroot') && is_file(DAU_BOOT . '/bzimage');
  if ($now === $latest && $files) {
    $res['result'] = 'staged'; $res['stage'] = '';
    $res['verification'] = ['result' => 'staged', 'ok' => true, 'detail' => "Unraid $latest is installed on the flash drive and becomes active after a reboot."];
    $res['next'] = 'Reboot to finish. If anything goes wrong, Tools > Update OS > Restore returns to ' . ($installed ?: 'the previous release') . '.';
    return $done();
  }
  $res['error'] = $r['timeout'] ? 'The install did not finish in time.' : 'After the install Unraid reports version ' . ($now ?: 'unknown') . ($files ? '' : ' and the boot files are incomplete') . ' (expected ' . $latest . '). ' . dau_clip(dau_redact(trim($r['err'] . ' ' . $r['out'])), 200);
  $res['next'] = 'Do NOT reboot until you have checked Tools > Update OS. The previous release is kept on the flash drive and can be restored there.';
  return $done();
}

/** Reboot with Unraid's stock command (the same one the Reboot button runs). */
function dau_os_reboot() {
  $r = dau_run([DAU_REBOOT, '-n'], 30);
  return $r['code'] === 0 || $r['timeout'];
}

/**
 * Called at every boot (install script): if an OS update was waiting for this reboot, record whether it is now running.
 * The announcement itself is sent by the next job (the network may not be up yet).
 */
function dau_os_boot_verify(array &$st) {
  $pend = $st['os']['pending'] ?? null;
  $installed = dau_os_version();
  if ($installed !== null && $installed !== '') $st['os']['installed'] = $installed;
  if (!is_array($pend) || empty($pend['to'])) return null;
  $ok = ($installed === $pend['to']);
  $st['os']['pending'] = null;
  $st['os']['boot_result'] = ['kind' => $ok ? 'os_verified' : 'os_unverified', 'installed' => (string)($pend['from'] ?? ''), 'available' => (string)$pend['to'], 'running' => (string)$installed, 'at' => dau_now(), 'auto' => !empty($pend['reboot'])];
  if ($ok) { $st['os']['available'] = null; $st['os']['notified'] = null; $st['os']['rebooted_for'] = ''; }
  return $st['os']['boot_result'];
}

function dau_os_slots(array $cfg) {
  $o = $cfg['os'];
  if (empty($o['check_enabled'])) return [];
  $s = dau_clean_schedule($o);
  return $s ? ['os' => ['sched' => $s, 'names' => ['*']]] : [];
}
]]></INLINE>
<SHA256>684c12250782f6bf64749725d41c4ec788b1a84cc297c343ade852a757b292c5</SHA256>
</FILE>

<FILE Name="&emhttp;/include/workflow.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - pre-OS maintenance workflow.
 * Before an Unraid OS update is installed (automatically or from the UI) the plugins - and, only if enabled, the Docker
 * containers - are brought up to date, the result is verified and the system is re-checked. The OS install runs only when
 * every REQUIRED step succeeded. It reuses dau_job_plugins() / dau_job_docker() (no second updater) and never reboots by itself.
 *
 * state.os.workflow: null | {state: running|awaiting_confirmation, version, started, reboot, manual}
 * state.os.last_report: the outcome of the latest run (shown in the UI, sent to Discord).
 */

const DAU_WORKFLOW_TTL = 86400;   // a paused workflow waits this long for a confirmation

function dau_os_pre_defaults() {
  return ['plugins' => true, 'docker' => false, 'require_plugins' => true, 'require_docker' => true, 'confirm' => false, 'notify' => true, 'scope' => 'auto'];
}

function dau_os_pre_spec() {
  return ['plugins' => ['bool'], 'docker' => ['bool'], 'require_plugins' => ['bool'], 'require_docker' => ['bool'], 'confirm' => ['bool'], 'notify' => ['bool'], 'scope' => ['enum', ['auto', 'all']]];
}

/** Containers the workflow may update: policy "auto", has an update, not "critical" (those always need an explicit approval). */
function dau_os_pre_containers(array $cfg) {
  $out = [];
  foreach ((dau_containers() ?? []) as $c) {
    $cc = dau_container_cfg($cfg, $c['name']);
    if ($c['update'] !== true || !$c['managed'] || $cc['policy'] !== 'auto' || !empty($cc['critical'])) continue;
    if (!empty($cfg['global']['skip_stopped']) && $c['state'] !== 'running') continue;
    $out[] = $c['name'];
  }
  return $out;
}

/** Re-check the system after the updates. Returns ['ok'=>bool,'issues'=>[string]]. */
function dau_os_health(array $cfg, $needDocker) {
  $issues = [];
  $a = dau_os_array_state();
  if (!$a['ok']) $issues[] = 'The array state could not be read.';
  elseif (!in_array($a['state'], ['STARTED', 'STOPPED'], true)) $issues[] = 'The array is in state ' . $a['state'] . '.';
  $free = dau_os_boot_free_mb();
  if ($free < 600) $issues[] = 'Only ' . $free . ' MB free on the flash drive (600 MB needed).';
  foreach (dau_plugins_installed() as $f => $p) if ($p['version'] === '') $issues[] = "Plugin $f could not be read after the updates.";
  if ($needDocker && dau_containers() === null) $issues[] = 'The Docker service is not responding.';
  if (dau_stop_requested()) $issues[] = 'Stopped by the user.';
  return ['ok' => !$issues, 'issues' => $issues];
}

function dau_os_wf_history(array $J, $result, $detail, $started) {
  dau_history_add(['type' => 'os', 'name' => 'Unraid OS', 'action' => 'prerequisites', 'result' => $result, 'started' => $started, 'finished' => dau_now(), 'trigger' => $J['trigger'],
    'error' => $result === 'failed' || $result === 'aborted' ? $detail : '', 'message' => $result === 'ok' || $result === 'waiting' ? $detail : ''], $J['cfg']['history']['max_entries']);
}

/**
 * Run the prerequisites. opt: manual, reboot, plugins/docker (null = use settings), skip_pre (already done, only re-check).
 * Returns 'proceed' (install now), 'wait' (paused for a confirmation) or 'stop' (the OS update must not continue).
 */
function dau_os_workflow(array &$J, $latest, array $opt) {
  $cfg = $J['cfg']; $pre = $cfg['os']['pre']; $started = dau_now();
  $manual = !empty($opt['manual']);
  $wantP = !empty($opt['skip_pre']) ? false : ($opt['plugins'] ?? $pre['plugins']);
  $wantD = !empty($opt['skip_pre']) ? false : ($opt['docker'] ?? $pre['docker']);
  $needConfirm = !$manual && !empty($pre['confirm']) && empty($opt['skip_pre']);
  if (!$wantP && !$wantD && !$needConfirm && empty($opt['skip_pre'])) return 'proceed';       // nothing configured: classic behaviour

  $inst = $J['st']['os']['installed'] ?? dau_os_version();
  $os =& $J['st']['os'];
  $os['workflow'] = ['state' => 'running', 'version' => $latest, 'started' => $started, 'reboot' => !empty($opt['reboot']), 'manual' => $manual];
  dau_state_save($J['st']);
  if ($pre['notify'] && empty($opt['skip_pre'])) {
    $steps = array_filter([$wantP ? 'plugins' : null, $wantD ? 'Docker containers' : null]);
    $J['events'][] = dau_ev('os', 'Unraid OS', 'os_workflow_started', ['installed' => $inst, 'available' => $latest, 'reason' => 'Updating ' . ($steps ? implode(' and then ', $steps) : 'nothing') . ' first, then re-checking the system.']);
  }
  $rep = ['version' => $latest, 'at' => $started, 'result' => 'ok', 'plugins' => null, 'docker' => null, 'health' => null, 'issues' => []];
  $fail = function ($result, $why) use (&$J, &$rep, $latest, $manual, $started, $inst) {
    $J['st']['os']['workflow'] = null;
    $rep['result'] = $result; $rep['issues'][] = $why; $J['st']['os']['last_report'] = $rep;
    if ($result === 'failed' && !$manual) $J['st']['os']['attempted'] = ['version' => $latest, 'result' => 'failed', 'reason' => dau_clip($why, 200), 'at' => dau_now()];
    if ($result === 'failed') dau_stats_record($J['st'], 'os', false, 0);
    $J['events'][] = dau_ev('os', 'Unraid OS', $result === 'aborted' ? 'os_aborted' : 'os_prereq_failed', ['installed' => $inst, 'available' => $latest, 'error' => $result === 'failed' ? $why : '', 'reason' => $result === 'aborted' ? $why : '',
      'detail' => dau_os_report_text($rep), 'next' => 'The Unraid OS update was NOT installed. Fix the problem and start it again from the Unraid OS tab' . ($manual ? '.' : ' (an automatic attempt is made once per version).')]);
    dau_os_wf_history($J, $result, $why, $started);
    dau_log($result === 'failed' ? 'error' : 'warn', 'os', 'Unraid OS', 'prerequisites', $result, $why);
    dau_state_save($J['st']);
    return 'stop';
  };

  if ($wantP) {
    dau_phase('Before the OS update: updating plugins');
    $b = $J['sum']['plugins'];
    dau_job_plugins($J, ['update' => true, 'pre' => $pre['scope']]);
    $a = $J['sum']['plugins'];
    $rep['plugins'] = ['updated' => $a['updated'] - $b['updated'], 'failed' => $a['failed'] - $b['failed'], 'skipped' => $a['skipped'] - $b['skipped']];
    if (dau_stop_requested()) return $fail('aborted', 'Aborted by the user during the plugin updates.');
    if ($rep['plugins']['failed'] > 0 && !empty($pre['require_plugins'])) return $fail('failed', $rep['plugins']['failed'] . ' plugin update(s) failed and successful plugin updates are required.');
  }
  if ($wantD) {
    dau_phase('Before the OS update: updating Docker containers');
    $names = dau_os_pre_containers($cfg);
    $rep['docker'] = ['updated' => 0, 'failed' => 0, 'skipped' => 0, 'selected' => count($names)];
    if ($names) {
      $b = $J['sum']['docker'];
      dau_job_docker($J, ['names' => $names, 'update' => true, 'manual' => true]);
      $a = $J['sum']['docker'];
      $rep['docker'] = ['updated' => $a['updated'] - $b['updated'], 'failed' => $a['failed'] - $b['failed'], 'skipped' => $a['skipped'] - $b['skipped'], 'selected' => count($names)];
    }
    if (dau_stop_requested()) return $fail('aborted', 'Aborted by the user during the Docker updates.');
    if ($rep['docker']['failed'] > 0 && !empty($pre['require_docker'])) return $fail('failed', $rep['docker']['failed'] . ' container update(s) failed and successful Docker updates are required.');
  }
  dau_phase('Before the OS update: checking the system');
  $h = dau_os_health($cfg, $wantD);
  $rep['health'] = $h['ok'] ? 'ok' : 'failed'; $rep['issues'] = $h['issues'];
  if (!$h['ok']) {
    if (dau_stop_requested()) return $fail('aborted', 'Aborted by the user.');
    return $fail('failed', 'System check failed: ' . implode(' ', $h['issues']));
  }
  if ($needConfirm) {
    $os['workflow'] = ['state' => 'awaiting_confirmation', 'version' => $latest, 'started' => dau_now(), 'reboot' => !empty($opt['reboot']), 'manual' => false];
    $rep['result'] = 'waiting'; $os['last_report'] = $rep;
    $J['events'][] = dau_ev('os', 'Unraid OS', 'os_awaiting', ['installed' => $inst, 'available' => $latest, 'detail' => dau_os_report_text($rep), 'next' => 'Open Unraid Swiss Manager > Unraid OS and choose Confirm or Abort. Nothing has been installed.']);
    dau_os_wf_history($J, 'waiting', 'Prerequisites passed; waiting for the confirmation to install ' . $latest . '.', $started);
    dau_log('info', 'os', 'Unraid OS', 'prerequisites', 'waiting', 'waiting for confirmation');
    dau_state_save($J['st']);
    return 'wait';
  }
  $os['workflow'] = null; $os['last_report'] = $rep;
  if (empty($opt['skip_pre'])) {
    $J['events'][] = dau_ev('os', 'Unraid OS', 'os_workflow_done', ['installed' => $inst, 'available' => $latest, 'detail' => dau_os_report_text($rep), 'reason' => 'All required steps passed; installing the OS update now.']);
    dau_os_wf_history($J, 'ok', dau_os_report_text($rep), $started);
  }
  dau_log('info', 'os', 'Unraid OS', 'prerequisites', 'ok', dau_os_report_text($rep));
  dau_state_save($J['st']);
  return 'proceed';
}

/** One readable block: what was updated, skipped or failed. */
function dau_os_report_text(array $r) {
  $line = function ($label, $x) { return $x === null ? "$label: not part of this workflow" : "$label: " . (int)$x['updated'] . ' updated, ' . (int)$x['failed'] . ' failed, ' . (int)$x['skipped'] . ' skipped'; };
  $t = $line('Plugins', $r['plugins']) . "\n" . $line('Docker', $r['docker']);
  if ($r['health'] !== null) $t .= "\nSystem check: " . $r['health'];
  if (!empty($r['issues'])) $t .= "\nIssues: " . implode(' ', $r['issues']);
  return $t;
}
]]></INLINE>
<SHA256>906ffe5fd9010fb6bc67004357cde0b09e0f267ceba78da1ccf5db01d3ce1ad0</SHA256>
</FILE>

<FILE Name="&emhttp;/include/jobs.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - job orchestration. One lock, one dispatcher (the "tick"), events collected during a run and
 * announced once at the end (Unraid notifications + one combined Discord summary).
 */

function dau_ev($type, $name, $kind, array $x = []) { return ['type' => $type, 'name' => $name, 'kind' => $kind, 'ts' => dau_now()] + $x; }

function dau_job_new($trigger, array $cfg, array $st) {
  $z = ['updated' => 0, 'failed' => 0, 'skipped' => 0, 'available' => 0];
  return ['cfg' => $cfg, 'st' => $st, 'trigger' => $trigger, 'events' => [], 'sum' => ['docker' => $z, 'plugins' => $z, 'os' => ['available' => null, 'version' => '', 'installed' => false]], 'ran' => [], 'reboot' => false];
}

function dau_phase($txt, array $x = []) { dau_progress(['running' => true, 'phase' => $txt, 'ts' => dau_now()] + $x); }

function dau_hist(array &$J, $type, $name, $action, $res, $msgTrigger = '') {
  $h = $J['cfg']['history']['max_entries'];
  dau_history_add([
    'type' => $type, 'name' => $name, 'action' => $action, 'result' => $res['result'], 'started' => $res['started'], 'finished' => $res['finished'] ?: dau_now(),
    'prev' => $res['prev'] ?? null, 'new' => $res['new'] ?? null, 'verification' => $res['verification'] ?? null,
    'attempts' => $res['attempts'] ?? 1, 'error' => $res['error'] ?? '', 'trigger' => $J['trigger'],
    'message' => $res['next'] ?? '', 'backup' => isset($res['backup']['kinds']) ? $res['backup']['kinds'] : null,
  ], $h);
}

/* ---------------- Docker ---------------- */

/**
 * opts: names (null = every container), update (bool, apply updates), manual (bool: user asked, policy/delay/window ignored),
 *       refresh (bool, default true).
 */
function dau_job_docker(array &$J, array $opts) {
  $cfg = $J['cfg']; $g = $cfg['global'];
  $manual = !empty($opts['manual']); $names = $opts['names'] ?? null;
  dau_phase('Checking Docker images');
  if (($opts['refresh'] ?? true) && !dau_docker_refresh()) dau_log('warn', 'docker', '-', 'check', 'warn', 'Could not refresh update status with Unraid; using the last known status.');
  $cs = dau_containers();
  if ($cs === null) { dau_log('warn', 'docker', '-', 'check', 'skip', 'The Docker service is not running.'); return; }
  $now = dau_now();
  dau_docker_track($J['st'], $cs, $now);
  $todo = [];
  foreach ($cs as $c) {
    $n = $c['name'];
    if ($names !== null && !in_array($n, $names, true)) continue;
    $cc = dau_container_cfg($cfg, $n);
    $silent = empty($g['notify']) || empty($cc['notify']);
    $ev = dau_docker_eval($cfg, $J['st'], $c, $now, $manual);
    if ($c['update'] === true && $c['managed'] && ($cc['policy'] !== 'ignore' || $manual)) {
      $J['sum']['docker']['available']++;
      if (($J['st']['docker']['notified'][$n] ?? '') !== (string)$c['remote']) {
        $J['st']['docker']['notified'][$n] = (string)$c['remote'];
        $J['events'][] = dau_ev('docker', $n, 'available', ['installed' => dau_short_digest($c['local']), 'available' => dau_short_digest($c['remote']),
          'reason' => $ev['state'] === 'ready' ? '' : $ev['reason'], 'silent' => $silent]);
      }
    }
    if (empty($opts['update'])) continue;
    if ($ev['state'] === 'ready') { $todo[] = [$c, $ev, $silent]; continue; }
    if ($manual && $c['update'] !== false) { $J['sum']['docker']['skipped']++; $J['events'][] = dau_ev('docker', $n, 'skipped', ['reason' => $ev['reason'], 'silent' => $silent]); }
    elseif (in_array($ev['state'], ['waiting_delay', 'window_closed', 'retry_wait'], true)) {
      $at = $ev['state'] === 'window_closed' ? dau_window_next_open($g['window'], $now) : $ev['eta'];
      if ($at) $J['st']['docker']['deferred'][$n] = ['at' => (int)$at];
    } elseif ($ev['state'] === 'approval' || $ev['state'] === 'retry_exhausted') { $J['sum']['docker']['skipped']++; }
  }
  $i = 0; $total = count($todo);
  foreach ($todo as list($c, $ev, $silent)) {
    if (dau_stop_requested()) { dau_log('warn', 'job', '-', 'stop', 'info', 'Stopped on request; remaining containers were not updated.'); break; }
    if ($i++ > 0 && (int)$g['delay'] > 0) dau_sleep((int)$g['delay']);
    $n = $c['name'];
    dau_phase("Updating $n", ['done' => $i - 1, 'total' => $total, 'current' => $n]);
    dau_mark_current($J['st'], 'docker', $n, dau_now());
    $res = dau_docker_update($cfg, $n, $c);
    dau_clear_current($J['st']);
    unset($J['st']['docker']['deferred'][$n]);
    $J['ran'][] = $n;
    $x = ['installed' => dau_short_digest($res['prev']['digest']) ?: $res['prev']['id'], 'available' => dau_short_digest($res['new']['digest']) ?: $res['new']['id'],
          'duration' => $res['finished'] - $res['started'], 'verification' => $res['verification'], 'stage' => $res['stage'], 'error' => $res['error'], 'next' => $res['next'], 'silent' => $silent];
    if ($res['result'] === 'updated') {
      dau_stats_record($J['st'], 'docker', true, $x['duration']); unset($J['st']['docker']['retry'][$n], $J['st']['docker']['notified'][$n]);
      $J['sum']['docker']['updated']++; $J['events'][] = dau_ev('docker', $n, 'updated', $x);
      dau_hist($J, 'docker', $n, 'update', $res); dau_log('info', 'docker', $n, 'update', 'ok', ($res['verification']['result'] ?? '') . ' ' . implode(' | ', $res['warnings']));
    } elseif ($res['result'] === 'unchanged') {
      unset($J['st']['docker']['retry'][$n]); dau_log('info', 'docker', $n, 'update', 'skip', 'Already running the newest image.');
    } elseif ($res['result'] === 'blocked') {
      $J['sum']['docker']['skipped']++; $J['events'][] = dau_ev('docker', $n, 'blocked', ['reason' => $res['error']] + $x);
      dau_hist($J, 'docker', $n, 'update', $res); dau_log('warn', 'docker', $n, 'update', 'blocked', $res['error']);
    } else {
      $kind = 'failed'; $rn = 0;
      if (!$manual) {
        $r = dau_docker_retry_after_failure($cfg, $J['st'], $n, $c, $res, dau_now());
        $rn = (int)($J['st']['docker']['retry'][$n]['attempts'] ?? 0);
        if ($r === 'scheduled') { $kind = 'retrying'; $x['retry'] = $rn . '/' . (int)$g['retry']['max']; $x['next'] = 'Next attempt in ' . (int)$g['retry']['interval_min'] . ' min. ' . $res['next']; $J['st']['docker']['deferred'][$n] = ['at' => (int)$J['st']['docker']['retry'][$n]['next_at']]; }
        elseif ($r === 'exhausted') { $kind = 'retry_exhausted'; $x['retry'] = ($rn - 1) . ' retries used'; }
      }
      $res['attempts'] = max(1, $rn);
      dau_stats_record($J['st'], 'docker', false, 0);
      $J['sum']['docker']['failed']++; $J['events'][] = dau_ev('docker', $n, $kind, $x);
      dau_hist($J, 'docker', $n, 'update', $res); dau_log('error', 'docker', $n, 'update', 'fail', $res['stage'] . ': ' . $res['error'], $rn);
    }
    dau_state_save($J['st']);
  }
}

/* ---------------- Plugins ---------------- */

function dau_job_plugins(array &$J, array $opts) {
  $cfg = $J['cfg']; $pc = $cfg['plugins']; $now = dau_now();
  $pre = $opts['pre'] ?? null;      // pre-OS workflow: 'auto' = only plugins whose policy is auto, 'all' = every plugin that is not ignored; delay/window/master switch are bypassed
  $manual = !empty($opts['manual']) || $pre !== null; $names = $opts['names'] ?? null;
  dau_phase('Checking plugins');
  $inst = dau_plugins_installed();
  $chk = dau_plugins_check_all($cfg, $inst);
  $J['st']['plugins']['last_check'] = $now;
  if (count($chk['errors']) < count($inst) || !$inst) $J['st']['plugins']['last_check_ok'] = $now;
  $J['st']['plugins']['last_error'] = $chk['errors'] ? count($chk['errors']) . ' plugin(s) could not be checked' : '';
  foreach ($chk['errors'] as $f => $e) dau_log('warn', 'plugin', $f, 'check', 'fail', $e);
  dau_plugins_track($J['st'], $chk['avail'], $now);
  $J['st']['plugins']['available'] = $chk['avail'];
  $next = 0; $todo = [];
  foreach ($chk['avail'] as $f => $latest) {
    if ($names !== null && !in_array($f, $names, true)) continue;
    $p = $inst[$f]; $policy = dau_plugin_policy($cfg, $f);
    if ($pre !== null && ($p['self'] || $policy === 'ignore' || ($pre === 'auto' && $policy !== 'auto'))) continue;
    $ev = dau_plugin_eval($cfg, $J['st'], $p, $latest, $now, $manual);
    if ($ev['state'] === 'self' && !$manual) { /* still announce */ }
    if ($policy !== 'ignore' || $manual) {
      $J['sum']['plugins']['available']++;
      if (($J['st']['plugins']['notified'][$f] ?? '') !== $latest) {
        $J['st']['plugins']['notified'][$f] = $latest;
        $J['events'][] = dau_ev('plugin', $p['name'], 'available', ['installed' => $p['version'], 'available' => $latest, 'reason' => in_array($ev['state'], ['ready', 'notify_only', 'self'], true) ? '' : $ev['reason']]);
      }
    }
    if (empty($opts['update'])) continue;
    if ($ev['state'] === 'ready') $todo[] = [$p, $latest];
    elseif ($manual) { $J['sum']['plugins']['skipped']++; $J['events'][] = dau_ev('plugin', $p['name'], 'skipped', ['reason' => $ev['reason']]); }
    elseif (in_array($ev['state'], ['waiting_delay', 'window_closed'], true)) {
      $at = $ev['state'] === 'window_closed' ? dau_window_next_open($pc['window'], $now) : $ev['eta'];
      if ($at && (!$next || $at < $next)) $next = (int)$at;
    }
  }
  $J['st']['plugins']['deferred_at'] = $next;
  $i = 0;
  foreach ($todo as list($p, $latest)) {
    if (dau_stop_requested()) break;
    if ($i++ > 0 && (int)$pc['delay'] > 0) dau_sleep((int)$pc['delay']);
    dau_phase('Updating plugin ' . $p['name'], ['current' => $p['name']]);
    dau_mark_current($J['st'], 'plugin', $p['name'], dau_now());
    $res = dau_plugin_update($cfg, $p, $latest);
    dau_clear_current($J['st']);
    $x = ['installed' => $p['version'], 'available' => $latest, 'duration' => $res['finished'] - $res['started'], 'verification' => $res['verification'], 'stage' => $res['stage'], 'error' => $res['error'], 'next' => $res['next']];
    if ($res['result'] === 'updated') { dau_stats_record($J['st'], 'plugin', true, $x['duration']); $J['sum']['plugins']['updated']++; $J['events'][] = dau_ev('plugin', $p['name'], 'updated', $x); unset($J['st']['plugins']['notified'][$p['file']]); }
    elseif ($res['result'] === 'blocked') {
      $J['sum']['plugins']['skipped']++; $J['st']['plugins']['blocked'][$p['file']] = ['version' => $latest, 'reason' => $res['error']];
      $J['events'][] = dau_ev('plugin', $p['name'], 'blocked', ['reason' => $res['error']] + $x);
    } else { dau_stats_record($J['st'], 'plugin', false, 0); $J['sum']['plugins']['failed']++; $J['events'][] = dau_ev('plugin', $p['name'], 'failed', $x); }
    dau_hist($J, 'plugin', $p['name'], 'update', $res);
    dau_log($res['result'] === 'updated' ? 'info' : 'error', 'plugin', $p['name'], 'update', $res['result'], $res['error']);
    dau_state_save($J['st']);
  }
}

/* ---------------- OS ---------------- */

function dau_job_os(array &$J, array $opts = []) {
  $cfg = $J['cfg']; $now = dau_now(); $manual = !empty($opts['manual']);
  dau_phase('Checking for an Unraid OS update');
  $chk = dau_os_check();
  $ev = dau_os_process($J['st'], $chk, $now);
  foreach ($ev as $e) $J['events'][] = dau_ev('os', 'Unraid OS', $e['kind'], $e);
  $os = $J['st']['os'];
  $J['sum']['os'] = ['available' => $chk['ok'] ? ($os['available'] !== null) : null, 'version' => (string)$os['available'], 'installed' => false];
  dau_log($chk['ok'] ? 'info' : 'warn', 'os', '-', 'check', $chk['ok'] ? 'ok' : 'fail', $chk['ok'] ? ('latest ' . $chk['latest']) : $chk['error']);
  $J['st']['os']['deferred_at'] = 0;
  if (empty($opts['install']) || !$chk['ok']) return;
  $reboot = $manual ? !empty($opts['reboot']) : ($cfg['os']['mode'] === 'install_reboot');
  if (!empty($opts['skip_pre']) && is_array($J['st']['os']['workflow'] ?? null)) $reboot = !empty($J['st']['os']['workflow']['reboot']);
  $e = dau_os_eval($cfg, $J['st'], $now, $manual);
  $latest = (string)$J['st']['os']['available'];
  if (!empty($opts['skip_pre']) && $e['state'] === 'awaiting_confirmation') $e['state'] = 'ready';
  if ($e['state'] === 'ready') {
    $w = dau_os_workflow($J, $latest, ['manual' => $manual, 'reboot' => $reboot, 'plugins' => $opts['pre_plugins'] ?? null, 'docker' => $opts['pre_docker'] ?? null, 'skip_pre' => !empty($opts['skip_pre'])]);
    if ($w !== 'proceed') return;
    dau_phase('Installing Unraid ' . $latest, ['current' => 'Unraid OS']);
    dau_mark_current($J['st'], 'os', 'Unraid OS', dau_now());
    $res = dau_os_install($cfg, $latest);
    dau_clear_current($J['st']);
    $x = ['installed' => $res['prev']['version'], 'available' => $latest, 'duration' => $res['finished'] - $res['started'], 'verification' => $res['verification']['detail'] ?? null, 'stage' => $res['stage'], 'error' => $res['error'], 'next' => $res['next']];
    if ($res['result'] === 'staged') {
      $J['st']['os']['pending'] = ['from' => $res['prev']['version'], 'to' => $latest, 'at' => dau_now(), 'reboot' => false];
      $J['sum']['os']['installed'] = true;
      $J['events'][] = dau_ev('os', 'Unraid OS', 'os_staged', $x);
    } else {
      $J['st']['os']['attempted'] = ['version' => $latest, 'result' => $res['result'], 'reason' => dau_clip($res['error'], 200), 'at' => dau_now()];
      dau_stats_record($J['st'], 'os', false, 0);
      $J['events'][] = dau_ev('os', 'Unraid OS', 'os_install_failed', $x);
    }
    dau_hist($J, 'os', 'Unraid OS', 'update', $res);
    dau_log($res['result'] === 'staged' ? 'info' : 'error', 'os', 'Unraid OS', 'install', $res['result'], $res['error']);
    dau_state_save($J['st']);
    if ($res['result'] !== 'staged') return;
    $e['state'] = 'staged';
  } elseif ($e['state'] === 'waiting_delay' && !$manual) {
    $J['st']['os']['deferred_at'] = (int)$e['eta'];
  } elseif ($e['state'] === 'window_closed' && !$manual) {
    $J['st']['os']['deferred_at'] = (int)dau_window_next_open($cfg['os']['window'], $now);
  }
  if ($e['state'] !== 'staged' || !$reboot) return;
  /* reboot step: only for a release that is installed and waiting; at most once per version when automatic */
  $os =& $J['st']['os'];
  if (!$manual) {
    if ($os['rebooted_for'] === $latest) return;
    if (!dau_window_open($cfg['os']['window'], $now)) { $os['deferred_at'] = (int)dau_window_next_open($cfg['os']['window'], $now); return; }
  }
  $safe = dau_os_reboot_safe();
  if (!$safe['ok']) {
    if (!$manual) $os['deferred_at'] = $now + 1800;
    if ($os['reboot_notified'] !== $latest . '|' . $safe['reason']) {
      $os['reboot_notified'] = $latest . '|' . $safe['reason'];
      $J['events'][] = dau_ev('os', 'Unraid OS', 'os_reboot_blocked', ['installed' => $os['installed'], 'available' => $latest, 'reason' => $safe['reason'], 'next' => $manual ? 'Reboot when it is safe, from the Unraid main menu.' : 'Will try again in 30 minutes (inside the maintenance window).']);
    }
    dau_log('warn', 'os', 'Unraid OS', 'reboot', 'postponed', $safe['reason']);
    return;
  }
  $os['rebooted_for'] = $latest;
  if (is_array($os['pending'])) $os['pending']['reboot'] = true;
  $J['reboot'] = true;
  $J['events'][] = dau_ev('os', 'Unraid OS', 'os_rebooting', ['installed' => $os['installed'], 'available' => $latest, 'next' => 'The server restarts now. After it is back, the new version is checked and reported.']);
  dau_log('info', 'os', 'Unraid OS', 'reboot', 'requested', 'rebooting to finish ' . $latest);
}

/* ---------------- notifications ---------------- */

function dau_job_finish(array &$J) {
  $cfg = $J['cfg']; $sum = $J['sum']; $ev = $J['events'];
  $failed = $sum['docker']['failed'] + $sum['plugins']['failed'];
  foreach ($ev as $e) if ($e['type'] === 'os' && in_array($e['kind'], ['os_install_failed', 'os_unverified', 'os_prereq_failed'], true)) $failed++;
  $sum['status'] = $failed ? 'failed' : (($sum['docker']['skipped'] + $sum['plugins']['skipped']) ? 'warnings' : 'ok');
  $sum['trigger'] = $J['trigger'];
  /* Unraid's own notification center */
  $nu = $cfg['notify_unraid']; $sent = 0; $more = 0;
  foreach ($ev as $e) {
    $important = $e['type'] === 'os' && in_array($e['kind'], ['os_staged', 'os_rebooting', 'os_reboot_blocked', 'os_install_failed', 'os_verified', 'os_unverified', 'os_awaiting', 'os_prereq_failed', 'os_aborted'], true);   // reboots and failed installs are never silent
    if (!empty($e['silent']) || !empty($e['silent_native']) || (!$important && empty($nu[['docker' => 'docker', 'plugin' => 'plugins', 'os' => 'os'][$e['type']]]))) continue;
    if ($sent >= 8) { $more++; continue; }
    $label = dau_type_label($e['type']) . ' ' . $e['name'];
    $map = ['available' => ['update available', 'normal'], 'updated' => ['updated', 'normal'], 'failed' => ['update FAILED', 'alert'], 'retrying' => ['update failed, will retry', 'warning'],
            'retry_exhausted' => ['update failed, retries used up', 'alert'], 'blocked' => ['update not applied', 'warning'], 'skipped' => ['update skipped', 'normal'],
            'os_withdrawn' => ['update withdrawn', 'normal'], 'os_check_failed' => ['update check failed', 'warning'], 'os_installed' => ['now installed', 'normal'],
            'os_staged' => ['update installed, reboot needed', 'warning'], 'os_rebooting' => ['rebooting to finish the update', 'warning'], 'os_reboot_blocked' => ['reboot postponed', 'warning'],
            'os_install_failed' => ['update FAILED, nothing was rebooted', 'alert'], 'os_workflow_started' => ['pre-update maintenance started', 'normal'], 'os_workflow_done' => ['pre-update checks passed', 'normal'],
            'os_awaiting' => ['waiting for your confirmation', 'warning'], 'os_prereq_failed' => ['update STOPPED, a prerequisite failed', 'alert'], 'os_aborted' => ['update aborted', 'warning'], 'os_verified' => ['update verified after reboot', 'normal'], 'os_unverified' => ['update is NOT active after reboot', 'alert']];
    list($t, $imp) = $map[$e['kind']] ?? [$e['kind'], 'normal'];
    $d = trim(($e['installed'] ?? '') && ($e['available'] ?? '') ? $e['installed'] . ' -> ' . $e['available'] : '');
    $d .= ' ' . ($e['error'] ?? $e['reason'] ?? '') . (!empty($e['next']) && $e['type'] === 'os' ? ' ' . $e['next'] : '');
    dau_unraid_notify("$label: $t", trim($d), $imp, $e['type'] === 'os' ? '/Tools' : ($e['type'] === 'plugin' ? '/Plugins' : '/Docker'));
    $sent++;
  }
  if ($more) dau_unraid_notify("Unraid Swiss Manager: $more more notification(s)", 'See the plugin\'s Activity tab.', 'normal', '/Settings/UnraidAutoUpdater');
  /* Discord (never fails the job) */
  try { $d = dau_discord_dispatch($cfg, $J['st'], array_values($ev), $sum); }
  catch (Throwable $e) { dau_log('warn', 'discord', '-', 'send', 'fail', $e->getMessage()); }
  $J['st']['last_run'] = dau_now(); $J['st']['last_trigger'] = $J['trigger'];
  $J['st']['last_result'] = ['docker' => $sum['docker'], 'plugins' => $sum['plugins'], 'status' => $sum['status'], 'ts' => dau_now()];
  dau_state_save($J['st']);
}

/* ---------------- entry points ---------------- */

/**
 * action: tick | check | docker | plugins | os
 * Returns exit code: 0 ok, 3 another job is running.
 */
function dau_job_main($action, array $o = []) {
  $lock = dau_lock_try();
  if (!$lock) { if ($action !== 'tick') dau_log('info', 'job', '-', $action, 'skip', 'Another job is running.'); return 3; }
  try {
    $status = 'ok';
    $cfg = dau_load_config($status);
    $st = dau_state_load();
    $max = $cfg['history']['max_entries'];
    $rec = dau_recover_interrupted($st, $max);
    $now = dau_now();
    /* a pre-OS workflow whose job died (power loss, kill) is recorded as interrupted; a paused one expires */
    $wf = $st['os']['workflow'] ?? null;
    if (is_array($wf) && (($wf['state'] ?? '') === 'running' || $now - (int)($wf['started'] ?? 0) > DAU_WORKFLOW_TTL)) {
      dau_history_add(['type' => 'os', 'name' => 'Unraid OS', 'action' => 'prerequisites', 'result' => ($wf['state'] ?? '') === 'running' ? 'interrupted' : 'aborted', 'started' => (int)$wf['started'], 'finished' => $now, 'trigger' => 'recovery',
        'error' => ($wf['state'] ?? '') === 'running' ? 'The pre-OS workflow was interrupted. Nothing was installed; the next run starts from a fresh check.' : 'The confirmation for the OS update was not given within 24 hours.'], $max);
      $st['os']['workflow'] = null; dau_state_save($st);
    }
    $J = dau_job_new($action === 'tick' ? 'scheduled' : 'manual', $cfg, $st);
    /* result of an OS update that was waiting for a reboot (verified at boot, announced here once the network is up) */
    $announced = false;
    $br = $J['st']['os']['boot_result'] ?? null;
    if (is_array($br)) {
      $J['events'][] = dau_ev('os', 'Unraid OS', $br['kind'], ['installed' => $br['installed'], 'available' => $br['available'], 'silent_native' => true,
        'error' => $br['kind'] === 'os_unverified' ? 'Unraid is running ' . ($br['running'] ?: 'an unknown version') . ' instead of ' . $br['available'] . '.' : '',
        'next' => $br['kind'] === 'os_unverified' ? 'Open Tools > Update OS to check the state; the previous release can be restored there.' : '']);
      $J['st']['os']['boot_result'] = null; $announced = true;
    }

    if ($action === 'tick') {
      $slots = []; $names = [];
      foreach (dau_docker_slots($cfg) as $k => $s) $slots['d:' . $k] = $s;
      foreach (dau_plugin_slots($cfg) as $k => $s) $slots['p:' . $k] = $s;
      foreach (dau_os_slots($cfg) as $k => $s) $slots['o:' . $k] = $s;
      dau_slots_register($J['st'], array_keys($slots), $now);
      $doDocker = []; $doPlug = false; $doOs = false; $osInstall = $cfg['os']['mode'] !== 'notify';
      foreach ($slots as $k => $s) {
        if (!dau_slot_due($s['sched'], dau_slot_rec($J['st'], $k), $now)) continue;
        $J['st']['slots'][$k]['last'] = $now;
        if ($k[0] === 'd') $doDocker = array_merge($doDocker, $s['names']); elseif ($k[0] === 'p') $doPlug = true; else $doOs = true;
      }
      foreach ($J['st']['docker']['deferred'] as $n => $d) if ((int)($d['at'] ?? 0) <= $now) { $doDocker[] = $n; unset($J['st']['docker']['deferred'][$n]); }
      if (!$doPlug && (int)$J['st']['plugins']['deferred_at'] > 0 && (int)$J['st']['plugins']['deferred_at'] <= $now) $doPlug = true;
      $doDocker = array_values(array_unique($doDocker));
      if (!$doOs && (int)$J['st']['os']['deferred_at'] > 0 && (int)$J['st']['os']['deferred_at'] <= $now) $doOs = true;
      if ($doDocker) dau_job_docker($J, ['names' => $doDocker, 'update' => true, 'manual' => false]);
      if ($doPlug) dau_job_plugins($J, ['update' => true]);
      if ($doOs) dau_job_os($J, ['install' => $osInstall]);
      if (!$doDocker && !$doPlug && !$doOs && !$announced) { dau_state_save($J['st']); dau_lock_release($lock); return 0; }
    } elseif ($action === 'check') {
      dau_job_docker($J, ['update' => false]); dau_job_plugins($J, ['update' => false]); dau_job_os($J, ['manual' => true]);
    } elseif ($action === 'docker') {
      dau_job_docker($J, ['names' => $o['names'] ?? [], 'update' => true, 'manual' => true]);
    } elseif ($action === 'plugins') {
      dau_job_plugins($J, ['names' => $o['names'] ?? [], 'update' => true, 'manual' => true]);
    } elseif ($action === 'os') {
      dau_job_os($J, ['manual' => true]);
    } elseif ($action === 'os_install') {
      dau_job_os($J, ['manual' => true, 'install' => true, 'reboot' => !empty($o['reboot']), 'pre_plugins' => $o['pre_plugins'] ?? null, 'pre_docker' => $o['pre_docker'] ?? null]);
    } elseif ($action === 'os_confirm') {
      dau_job_os($J, ['manual' => true, 'install' => true, 'skip_pre' => true]);
    }
    dau_job_finish($J);
    dau_progress(['running' => false, 'ts' => dau_now(), 'phase' => !empty($J['reboot']) ? 'Rebooting' : 'Done']);
    dau_log('info', 'job', '-', $action, 'done', json_encode($J['sum']['docker']) . ' ' . json_encode($J['sum']['plugins']));
    if (!empty($J['reboot'])) dau_os_reboot();
    return 0;
  } catch (Throwable $e) {
    dau_log('error', 'job', '-', $action, 'crash', $e->getMessage() . ' @ ' . basename($e->getFile()) . ':' . $e->getLine());
    dau_progress(['running' => false, 'ts' => dau_now(), 'phase' => 'Failed']);
    return 1;
  } finally {
    dau_lock_release($lock);
    @unlink(DAU_STOPFLAG);
  }
}

/* ---------------- cron / install ---------------- */

/** One line, every 5 minutes, only when something is scheduled. */
function dau_cron_apply(array $cfg) {
  $any = dau_docker_slots($cfg) || dau_plugin_slots($cfg) || dau_os_slots($cfg);
  if ($any) {
    $line = "# Unraid Swiss Manager dispatcher (generated; do not edit)\n*/" . DAU_TICK_MIN . ' * * * * ' . DAU_PHP . ' ' . DAU_ROOT . "/scripts/run.php --tick > /dev/null 2>&1\n";
    if (!is_dir(DAU_DIR)) @mkdir(DAU_DIR, 0755, true);
    if (@file_get_contents(DAU_CRON) !== $line) file_put_contents(DAU_CRON, $line);
  } elseif (is_file(DAU_CRON)) @unlink(DAU_CRON);
  if (is_executable('/usr/local/sbin/update_cron')) dau_run(['/usr/local/sbin/update_cron'], 30);
  return true;
}

/** Runs at every boot (install script): migrate config, rebuild cron, tidy leftovers. */
function dau_install() {
  if (!is_dir(DAU_DIR)) @mkdir(DAU_DIR, 0755, true);
  $status = 'ok'; $cfg = dau_load_config($status);
  if ($status !== 'ok' || !is_file(DAU_CFG)) dau_save_config($cfg);
  dau_cron_apply($cfg);
  /* an OS update that was waiting for this reboot: record whether the new release is now running */
  $st = dau_state_load();
  $r = dau_os_boot_verify($st);
  if ($r) {
    $ok = $r['kind'] === 'os_verified';
    dau_history_add(['type' => 'os', 'name' => 'Unraid OS', 'action' => 'update', 'result' => $ok ? 'updated' : 'failed', 'started' => (int)$r['at'], 'finished' => (int)$r['at'], 'trigger' => 'boot',
      'prev' => ['version' => $r['installed']], 'new' => ['version' => $r['running']], 'verification' => ['result' => $ok ? 'version_matches' : 'version_differs', 'ok' => $ok, 'detail' => 'After the reboot Unraid reports ' . ($r['running'] ?: 'unknown') . ' (expected ' . $r['available'] . ').'],
      'error' => $ok ? '' : 'The new release is not running after the reboot.'], $cfg['history']['max_entries']);
    dau_stats_record($st, 'os', $ok, 0);
    dau_unraid_notify(DAU_NAME . ': Unraid OS ' . ($ok ? 'update verified' : 'update NOT active'), 'Expected ' . $r['available'] . ', running ' . ($r['running'] ?: 'unknown') . '.', $ok ? 'normal' : 'alert', '/Tools');
    dau_log($ok ? 'info' : 'error', 'os', 'Unraid OS', 'boot-verify', $ok ? 'ok' : 'fail', 'expected ' . $r['available'] . ', running ' . $r['running']);
  }
  dau_state_save($st);
  @unlink(DAU_STOPFLAG); @unlink(DAU_PROGRESS);
  dau_log('info', 'job', '-', 'install', $status, 'Config ' . $status . '; version ' . DAU_VERSION);
  return $status;
}

function dau_uninstall() {
  if (is_file(DAU_CRON)) @unlink(DAU_CRON);
  if (is_executable('/usr/local/sbin/update_cron')) dau_run(['/usr/local/sbin/update_cron'], 30);
}
]]></INLINE>
<SHA256>00b232d7eca7dca49d531ca6bfb23471d50e4f7378fef7234d13f8ae174818a5</SHA256>
</FILE>

<FILE Name="&emhttp;/include/api.php" Mode="0644">
<INLINE><![CDATA[<?php
/* Unraid Swiss Manager - JSON API. Reads are GET/POST; EVERY change requires POST (Unraid validates the CSRF token of every POST itself). */
require_once '/usr/local/emhttp/plugins/unraid-autoupdater/include/lib.php';

header('Content-Type: application/json');
header('Cache-Control: no-store');
header('X-Content-Type-Options: nosniff');

function out($d, $code = 200) { http_response_code($code); echo json_encode($d, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR); exit; }
function fail($m, $code = 400) { out(['error' => $m], $code); }

$action = (string)($_POST['action'] ?? $_GET['action'] ?? '');
$READ = ['overview', 'docker', 'plugins', 'os', 'history', 'log', 'status', 'export', 'preview'];
if (!in_array($action, $READ, true)) {
  if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') fail('This action requires POST.', 405);
  /* The CSRF token is checked (and then removed from $_POST) by Unraid's own auto-prepended local_prepend.php for every POST,
     so it must not be re-checked here: it is already gone. Mutations are POST-only. */
}
$json = function ($k) { $v = json_decode((string)($_POST[$k] ?? ''), true); return is_array($v) ? $v : null; };

/** Row data for the Docker table. */
function api_docker_rows($cfg, $st) {
  $cs = dau_containers(); if ($cs === null) return null;
  $now = dau_now(); $last = dau_history_last_by_name('docker'); $rows = [];
  foreach ($cs as $c) {
    $cc = dau_container_cfg($cfg, $c['name']); $ev = dau_docker_eval($cfg, $st, $c, $now, false);
    $sched = dau_clean_schedule($cc['schedule']);
    $rows[] = ['run_state' => $c['state']] + array_diff_key($c, ['state' => 1]) + ['cfg' => $cc, 'state' => $ev['state'], 'reason' => $ev['reason'], 'eta' => $ev['eta'], 'delay_hours' => $ev['delay_hours'],
      'schedule_text' => $sched ? dau_sched_text($sched) : null, 'last' => $last[$c['name']] ?? null,
      'first_seen' => $st['docker']['seen'][$c['name']]['first'] ?? null, 'approved' => ($st['docker']['approved'][$c['name']] ?? '') === (string)$c['remote'] && $c['remote'],
      'retry' => $st['docker']['retry'][$c['name']] ?? null];
  }
  return $rows;
}

function api_plugin_rows($cfg, $st) {
  $rows = []; $now = dau_now(); $last = dau_history_last_by_name('plugin');
  foreach (dau_plugins_installed() as $f => $p) {
    $latest = $st['plugins']['available'][$f] ?? null;
    $ev = $latest ? dau_plugin_eval($cfg, $st, $p, $latest, $now, false) : ['state' => 'up_to_date', 'reason' => '', 'eta' => null];
    $rows[] = ['file' => $f, 'name' => $p['name'], 'version' => $p['version'], 'latest' => $latest, 'self' => $p['self'], 'policy' => dau_plugin_policy($cfg, $f),
      'explicit' => $cfg['plugins']['items'][$f]['policy'] ?? null, 'state' => $ev['state'], 'reason' => $ev['reason'], 'eta' => $ev['eta'], 'last' => $last[$p['name']] ?? null,
      'first_seen' => $st['plugins']['seen'][$f]['first'] ?? null];
  }
  return $rows;
}

function api_next_runs($cfg, $st) {
  $now = dau_now(); $o = [];
  $add = function ($label, $slots) use (&$o, $st, $now) { foreach ($slots as $k => $s) $o[] = ['label' => $label, 'text' => dau_sched_text($s['sched']), 'next' => dau_next_run($s['sched'], dau_slot_rec($st, $k), $now), 'count' => count($s['names'])]; };
  $d = []; foreach (dau_docker_slots($cfg) as $k => $s) $d['d:' . $k] = $s;
  $add('Docker', $d);
  $p = []; foreach (dau_plugin_slots($cfg) as $k => $s) $p['p:' . $k] = $s; $add('Plugins', $p);
  $x = []; foreach (dau_os_slots($cfg) as $k => $s) $x['o:' . $k] = $s; $add('Unraid OS', $x);
  return $o;
}

function api_config_view($cfg) {
  $v = $cfg; $v['discord']['webhook_set'] = dau_webhook_valid(dau_secret_get('discord_url')); $v['discord']['icon_default'] = DAU_DEFAULT_ICON;   // the URL itself is never sent to the browser
  return $v;
}

function api_save($cfg) { dau_save_config($cfg); dau_cron_apply($cfg); }

switch ($action) {

  case 'overview': {
    $cfg = dau_load_config($s); $st = dau_state_load();
    $rows = api_docker_rows($cfg, $st); $prow = api_plugin_rows($cfg, $st);
    $cnt = function ($r, $f) { return count(array_filter($r ?? [], $f)); };
    out([
      'config' => api_config_view($cfg), 'config_status' => $s, 'run' => dau_run_info(), 'now' => dau_now(), 'version' => DAU_VERSION, 'name' => DAU_NAME,
      'docker_up' => $rows !== null,
      'cards' => [
        'containers' => count($rows ?? []), 'docker_updates' => $cnt($rows, function ($r) { return $r['update'] === true; }),
        'docker_auto' => $cnt($rows, function ($r) { return $r['cfg']['policy'] === 'auto'; }),
        'plugins' => count($prow), 'plugin_updates' => $cnt($prow, function ($r) { return !empty($r['latest']); }),
        'os_installed' => dau_os_version(), 'os_available' => $st['os']['available'], 'os_error' => $st['os']['last_error'],
        'last_run' => $st['last_run'], 'last_result' => $st['last_result'], 'next' => api_next_runs($cfg, $st),
        'failures' => count(array_filter(array_slice(dau_history_load(), 0, 20), function ($e) { return $e['result'] === 'failed'; })),
      ],
      'stats' => dau_stats_summary($st), 'discord' => ['last_ok' => $st['discord']['last_ok'], 'last_error' => $st['discord']['last_error'], 'invalid' => $st['discord']['invalid']],
      'checked' => ['docker' => is_file(DAU_UPDSTATUS) ? filemtime(DAU_UPDSTATUS) : 0, 'plugins' => $st['plugins']['last_check'], 'os' => $st['os']['last_check']],
      'tick_installed' => is_file(DAU_CRON),
    ]);
  }

  case 'docker': { $cfg = dau_load_config(); $st = dau_state_load(); $r = api_docker_rows($cfg, $st); out(['docker_up' => $r !== null, 'rows' => $r ?? []]); }
  case 'plugins': { $cfg = dau_load_config(); $st = dau_state_load(); out(['rows' => api_plugin_rows($cfg, $st), 'auto_update' => !empty($cfg['plugins']['auto_update'])]); }
  case 'os': {
    $cfg = dau_load_config(); $st = dau_state_load(); $now = dau_now();
    $ev = dau_os_eval($cfg, $st, $now, false); $man = dau_os_eval($cfg, $st, $now, true);
    $av = $st['os']['available'];
    out(['os' => $st['os'], 'installed' => dau_os_version(), 'mode' => $cfg['os']['mode'], 'eval' => $ev, 'manual' => $man, 'stable' => $av ? dau_os_is_stable($av) : null,
         'reboot' => dau_os_reboot_safe(), 'array' => dau_os_array_state(), 'free_mb' => dau_os_boot_free_mb(), 'window_text' => dau_window_text($cfg['os']['window']),
         'pending' => $st['os']['pending'], 'workflow' => $st['os']['workflow'], 'report' => $st['os']['last_report'], 'pre' => $cfg['os']['pre'],
         'pre_containers' => !empty($cfg['os']['pre']['docker']) ? count(dau_os_pre_containers($cfg)) : 0]);
  }
  case 'history': { out(['rows' => array_slice(dau_history_load(), 0, 200)]); }
  case 'log': { out(['log' => dau_log_tail(300)]); }
  case 'status': { out(['run' => dau_run_info()]); }

  /* what a bulk update WILL do, shown before the user confirms */
  case 'preview': {
    $cfg = dau_load_config(); $st = dau_state_load();
    $names = array_filter(explode(',', (string)($_POST['names'] ?? $_GET['names'] ?? '')), 'dau_valid_name');
    $rows = api_docker_rows($cfg, $st) ?? []; $out = [];
    foreach ($rows as $r) {
      if ($names && !in_array($r['name'], $names, true)) continue;
      if ($r['update'] !== true) continue;
      $out[] = ['name' => $r['name'], 'image' => $r['image'], 'current' => dau_short_digest($r['local']), 'new' => dau_short_digest($r['remote']), 'state' => $r['state'], 'was_running' => $r['run_state'] === 'running',
        'managed' => $r['managed'], 'critical' => !empty($r['cfg']['critical']),
        'backup' => !empty($cfg['global']['backup']['enabled']) && !empty($r['cfg']['backup'])];
    }
    out(['rows' => $out, 'verify' => !empty($cfg['global']['verify']['enabled'])]);
  }

  case 'export': {
    header('Content-Disposition: attachment; filename="unraid-autoupdater-config.json"');
    echo json_encode(dau_export_config(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES); exit;
  }

  /* ---- changes (POST + CSRF) ---- */

  case 'save_config': {
    $in = $json('config'); if ($in === null) fail('Invalid settings payload');
    unset($in['containers']);
    $cfg = dau_sanitize_config($in, dau_load_config());
    if (!empty($in['discord']['webhook_url'])) {
      $u = (string)$in['discord']['webhook_url'];
      if (!dau_webhook_valid($u)) fail('That is not a valid Discord webhook URL.');
      dau_secret_set('discord_url', $u);
      $st = dau_state_load(); $st['discord']['invalid'] = false; dau_state_save($st);
    }
    api_save($cfg);
    out(['ok' => true, 'config' => api_config_view($cfg)]);
  }

  case 'set_container': {
    $in = $json('data'); $names = $json('names');
    if ($in === null || !$names) fail('Invalid request');
    $cfg = dau_load_config();
    foreach ($names as $n) {
      if (!dau_valid_name($n)) continue;
      $cfg = dau_sanitize_config(['containers' => [$n => $in]], $cfg);
    }
    api_save($cfg); out(['ok' => true]);
  }

  case 'set_plugin': {
    $in = $json('data'); $files = $json('files');
    if ($in === null || !$files) fail('Invalid request');
    $cfg = dau_load_config();
    $items = [];
    foreach ($files as $f) if (dau_valid_plg($f)) $items[$f] = ['policy' => $in['policy'] ?? null];
    $cfg = dau_sanitize_config(['plugin_items' => $items], $cfg);
    api_save($cfg); out(['ok' => true]);
  }

  case 'approve': {
    $n = (string)($_POST['name'] ?? ''); if (!dau_valid_name($n)) fail('Invalid name');
    $cs = dau_containers() ?? []; $st = dau_state_load();
    foreach ($cs as $c) if ($c['name'] === $n && $c['remote']) { $st['docker']['approved'][$n] = (string)$c['remote']; dau_state_save($st); out(['ok' => true]); }
    fail('No pending update with a known image to approve for this container.');
  }

  case 'run': {
    $what = (string)($_POST['what'] ?? '');
    if ($what === 'check') $args = ['--check'];
    elseif ($what === 'os') $args = ['--os-check'];
    elseif ($what === 'os_install') {
      if (($_POST['confirm'] ?? '') !== '1') fail('Installing an OS update needs an explicit confirmation.');
      $args = [!empty($_POST['reboot']) && $_POST['reboot'] === '1' ? '--os-install-reboot' : '--os-install'];
      foreach (['pre_plugins' => '--pre-plugins=', 'pre_docker' => '--pre-docker='] as $k => $flag) if (isset($_POST[$k]) && in_array($_POST[$k], ['0', '1'], true)) $args[] = $flag . $_POST[$k];
    }
    elseif ($what === 'os_confirm') {
      if (($_POST['confirm'] ?? '') !== '1') fail('Installing an OS update needs an explicit confirmation.');
      $st = dau_state_load(); $wf = $st['os']['workflow'] ?? null;
      if (!is_array($wf) || ($wf['state'] ?? '') !== 'awaiting_confirmation') fail('No OS update is waiting for a confirmation.');
      $args = ['--os-confirm'];
    }
    elseif ($what === 'docker' || $what === 'plugins') {
      $names = $json('names'); if (!$names) fail('Nothing selected');
      $ok = array_values(array_filter($names, $what === 'docker' ? 'dau_valid_name' : 'dau_valid_plg'));
      if (!$ok) fail('Invalid names');
      $args = ['--update-' . $what . '=' . implode(',', $ok)];
    } else fail('Unknown job');
    if (!dau_spawn($args)) fail('Another job is already running.', 409);
    out(['ok' => true]);
  }

  case 'os_abort': {
    /* abort the pre-OS workflow: a running job stops after its current step, a paused one is cancelled here */
    if (dau_run_info()['running']) { @touch(DAU_STOPFLAG); out(['ok' => true, 'running' => true]); }
    $st = dau_state_load(); $wf = $st['os']['workflow'] ?? null;
    if (is_array($wf)) {
      dau_history_add(['type' => 'os', 'name' => 'Unraid OS', 'action' => 'prerequisites', 'result' => 'aborted', 'started' => (int)$wf['started'], 'finished' => dau_now(), 'trigger' => 'manual', 'error' => 'Aborted by the user. Nothing was installed.'], dau_load_config()['history']['max_entries']);
      $st['os']['workflow'] = null; dau_state_save($st);
    }
    out(['ok' => true, 'running' => false]);
  }

  case 'stop': { @touch(DAU_STOPFLAG); out(['ok' => true]); }

  case 'test_discord': {
    $st = dau_state_load(); $u = (string)($_POST['url'] ?? '');
    $r = dau_discord_test($st, $u !== '' ? $u : null); dau_state_save($st); out($r);
  }

  case 'clear_webhook': { dau_secret_set('discord_url', ''); $cfg = dau_load_config(); $cfg['discord']['enabled'] = false; api_save($cfg); out(['ok' => true]); }

  case 'import': {
    $in = $json('config'); if ($in === null) fail('Invalid file');
    if (isset($in['config']) && is_array($in['config'])) $in = $in['config'];
    $cur = dau_load_config();
    $cfg = dau_sanitize_config($in, dau_defaults());
    dau_write_json(DAU_DIR . '/config.before-import.json', $cur);
    api_save($cfg); out(['ok' => true]);
  }

  case 'clear_history': { dau_write_json(DAU_HIST, []); out(['ok' => true]); }

  default: fail('Unknown action', 404);
}
]]></INLINE>
<SHA256>a95890dd4ec12be76b4c7ddc582a5790de97ddac5a6745089517aa144304c770</SHA256>
</FILE>

<FILE Name="&emhttp;/scripts/run.php" Mode="0755">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - command line runner.
 *   --tick                    cron dispatcher: runs whatever is due (called every 5 minutes)
 *   --check                   refresh Docker/plugin/OS update information, update nothing
 *   --update-docker=a,b       update these containers now (manual: policy, delay and window are bypassed)
 *   --update-plugins=a.plg,b  update these plugins now (after the usual safety validation)
 *   --os-check                check for an Unraid OS update (notify only)
 *   --os-install[-reboot]     install the available Unraid OS update now (manual; optionally reboot afterwards); --pre-plugins=0|1 --pre-docker=0|1 override the pre-OS steps
 *   --os-confirm              continue an OS update that is waiting for its confirmation
 *   --install / --uninstall   boot-time setup / removal
 */
if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
require_once '/usr/local/emhttp/plugins/unraid-autoupdater/include/lib.php';
set_time_limit(0);
ini_set('display_errors', '0');

$o = getopt('', ['tick', 'check', 'update-docker:', 'update-plugins:', 'os-check', 'os-install', 'os-install-reboot', 'os-confirm', 'pre-plugins:', 'pre-docker:', 'install', 'uninstall']);
$list = function ($k) use ($o) { return isset($o[$k]) ? array_values(array_filter(array_map('trim', explode(',', (string)$o[$k])))) : []; };

if (isset($o['install']))   { dau_install(); exit(0); }
if (isset($o['uninstall'])) { dau_uninstall(); exit(0); }
if (isset($o['tick']))      exit(dau_job_main('tick'));
if (isset($o['check']))     exit(dau_job_main('check'));
if (isset($o['os-check']))  exit(dau_job_main('os'));
$flag = function ($k) use ($o) { return isset($o[$k]) ? ($o[$k] === '1') : null; };     // absent = use the setting
if (isset($o['os-confirm']))        exit(dau_job_main('os_confirm'));
if (isset($o['os-install']))        exit(dau_job_main('os_install', ['reboot' => false, 'pre_plugins' => $flag('pre-plugins'), 'pre_docker' => $flag('pre-docker')]));
if (isset($o['os-install-reboot'])) exit(dau_job_main('os_install', ['reboot' => true, 'pre_plugins' => $flag('pre-plugins'), 'pre_docker' => $flag('pre-docker')]));
if (isset($o['update-docker']))  exit(dau_job_main('docker',  ['names' => array_values(array_filter($list('update-docker'), 'dau_valid_name'))]));
if (isset($o['update-plugins'])) exit(dau_job_main('plugins', ['names' => array_values(array_filter($list('update-plugins'), 'dau_valid_plg'))]));
fwrite(STDERR, "usage: run.php --tick | --check | --update-docker=a,b | --update-plugins=a.plg | --os-check | --os-install | --os-install-reboot | --install | --uninstall\n");
exit(64);
]]></INLINE>
<SHA256>8ecdab2b9a457c7ef70083146ae166a45767d1d40b8c9fb026ba6525199836b9</SHA256>
</FILE>

<FILE Name="&emhttp;/assets/app.css" Mode="0644">
<INLINE><![CDATA[/* Unraid Swiss Manager - dark grey UI matching the Unraid theme. Scoped to .dau so it never leaks into the page. */
.dau{--bg:#1d1b1b;--panel:#222020;--bar:#262626;--field:#181616;--line:#333030;--line-2:#433f3f;--text:#e8e6e6;--muted:#9b9797;--accent:#f15a2c;--accent-hi:#ff7447;--amber:#e8b33c;--ok:#4ec38b;--bad:#ff6b5e;--link:#6f93e0;
  --font:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;color:var(--text);font:14px/1.5 var(--font);padding:4px 0 24px;margin:0;text-align:left;position:relative}
.dau *,.dau *::before,.dau *::after{box-sizing:border-box}
.dau .grow{flex:1 1 auto;min-width:0}.dau .muted{color:var(--muted)}.dau .sm{font-size:12.5px}.dau b{font-weight:600;color:var(--text)}
.dau-loading{padding:40px;text-align:center;color:var(--muted)}
.dau .head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}
/* header: logo + title + orange version line */
.dau .brand{display:flex;align-items:center;gap:16px;min-width:0}
.dau .logo{width:64px;height:64px;border-radius:14px;flex:none;display:block}
.dau .dau-name{font-family:Poppins,"Segoe UI",system-ui,-apple-system,sans-serif;font-size:28px;font-weight:600;line-height:1.15;letter-spacing:0;color:#fff;background:none;border:0;padding:0;margin:0;text-shadow:none}
.dau .ver{font-size:15px;font-weight:500;color:var(--accent);margin-top:4px}
@media (max-width:600px){.dau .brand{gap:12px}.dau .logo{width:48px;height:48px;border-radius:11px}.dau .dau-name{font-size:21px}.dau .ver{font-size:13px}}
.dau .actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.dau .tabs{display:flex;gap:2px;border-bottom:1px solid var(--line);margin-bottom:16px;overflow-x:auto}
.dau .tab{background:none!important;border:0!important;border-bottom:2px solid transparent!important;color:var(--muted)!important;padding:8px 14px!important;margin:0!important;cursor:pointer;font:inherit!important;white-space:nowrap;border-radius:0!important;text-transform:none!important;letter-spacing:0!important}
.dau .tab:hover{color:var(--text)!important}.dau .tab.on{color:var(--text)!important;border-bottom-color:var(--accent)!important}
.dau .tab .n{background:var(--accent);color:#fff;border-radius:9px;font-size:11px;padding:0 6px;margin-left:6px}
.dau button.btn,.dau .btn{background:var(--bar)!important;color:var(--text)!important;border:1px solid var(--line-2)!important;border-radius:4px!important;padding:6px 12px!important;margin:0!important;font:inherit!important;font-size:13px!important;cursor:pointer;text-transform:none!important;letter-spacing:0!important;line-height:1.3!important;min-height:0!important;box-shadow:none!important}
.dau .btn:hover:not(:disabled){border-color:var(--accent)!important}.dau .btn:disabled{opacity:.45;cursor:not-allowed}
.dau .btn.pri{background:var(--accent)!important;border-color:var(--accent)!important;color:#fff!important}.dau .btn.pri:hover:not(:disabled){background:var(--accent-hi)!important}
.dau .btn.danger{color:var(--bad)!important}.dau .btn.sm{padding:3px 8px!important;font-size:12px!important}
.dau input[type=text],.dau input[type=number],.dau input[type=time],.dau input[type=url],.dau input[type=password],.dau input[type=search],.dau select,.dau textarea{background:var(--field)!important;color:var(--text)!important;border:1px solid var(--line-2)!important;border-radius:4px!important;padding:5px 8px!important;margin:0!important;font:inherit!important;font-size:13px!important;height:auto!important;min-height:30px;width:auto;max-width:100%;box-shadow:none!important}
.dau input:focus,.dau select:focus{border-color:var(--accent)!important;outline:0}
.dau input[type=checkbox]{accent-color:var(--accent);width:16px;height:16px;margin:0 6px 0 0;vertical-align:middle}
.dau .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-bottom:16px}
.dau .card{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:12px 14px}
.dau .card .k{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.06em}.dau .card .v{font-size:24px;font-weight:600;line-height:1.3}.dau .card .s{color:var(--muted);font-size:12.5px}
.dau .card.hot .v{color:var(--accent)}.dau .card.bad .v{color:var(--bad)}
.dau .panel{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:14px 16px;margin-bottom:14px}
.dau .panel h3{margin:0 0 10px;font-size:14px;font-weight:600;color:var(--text);text-transform:uppercase;letter-spacing:.05em}
.dau .panel h4{margin:14px 0 6px;font-size:13px;color:var(--muted);font-weight:600}
.dau .tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
.dau table{width:100%;border-collapse:collapse;background:transparent;margin:0}
.dau th{background:var(--bar)!important;color:var(--muted)!important;font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:8px 10px!important;border-bottom:1px solid var(--line)!important;white-space:nowrap}
.dau td{padding:8px 10px!important;border-bottom:1px solid var(--line)!important;vertical-align:middle;background:transparent!important;color:var(--text)}
.dau tr.row:hover td{background:#252323!important}.dau tr.open td{background:#201e1e!important}
.dau td.name .nm{font-weight:600}.dau td.name .img{color:var(--muted);font-size:12px;word-break:break-all}
.dau .ico{width:26px;height:26px;border-radius:4px;vertical-align:middle;margin-right:8px;background:var(--field)}
.dau .badge{display:inline-block;border-radius:10px;padding:1px 9px;font-size:11.5px;border:1px solid var(--line-2);color:var(--muted);white-space:nowrap}
.dau .badge.ok{color:var(--ok);border-color:#2c5e48}.dau .badge.bad{color:var(--bad);border-color:#6b3a35}.dau .badge.warn{color:var(--amber);border-color:#6b5a2a}.dau .badge.acc{color:var(--accent-hi);border-color:#7a3a25}
.dau .digest{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;color:var(--muted)}
.dau .drawer td{padding:0!important}.dau .drawer .in{padding:12px 14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.dau .fld{display:flex;flex-direction:column;gap:4px;margin-bottom:8px}.dau .fld>label,.dau .lbl{color:var(--muted);font-size:12.5px}
.dau .fld .hint{color:var(--muted);font-size:12px}
.dau .inl{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.dau .grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:4px 24px}
.dau .switch{display:flex;align-items:center;gap:8px;cursor:pointer;margin:4px 0}
.dau .banner{border:1px solid var(--line-2);border-left:3px solid var(--amber);background:#2a2620;border-radius:4px;padding:8px 12px;margin-bottom:12px}
.dau .banner.bad{border-left-color:var(--bad);background:#2a2120}.dau .banner.ok{border-left-color:var(--ok);background:#202823}
.dau .progress{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin:6px 0}.dau .progress i{display:block;height:100%;background:var(--accent);animation:dau-slide 1.2s infinite linear;width:30%}
@keyframes dau-slide{0%{margin-left:-30%}100%{margin-left:100%}}
.dau .modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:10000;display:flex;align-items:center;justify-content:center;padding:16px}
.dau .modal{background:var(--panel);border:1px solid var(--line-2);border-radius:8px;max-width:760px;width:100%;max-height:88vh;overflow:auto;padding:18px}
.dau .modal h3{margin:0 0 10px;font-size:16px}.dau .modal .foot{display:flex;gap:8px;justify-content:flex-end;margin-top:14px;flex-wrap:wrap}
.dau pre.log{background:var(--field);border:1px solid var(--line);border-radius:4px;padding:10px;max-height:460px;overflow:auto;font-size:12px;line-height:1.45;white-space:pre-wrap;word-break:break-word;color:#cfcaca}
.dau .toast{position:fixed;right:18px;bottom:18px;background:var(--bar);border:1px solid var(--line-2);border-left:3px solid var(--accent);padding:10px 14px;border-radius:4px;z-index:10001;max-width:420px}
.dau .toast.bad{border-left-color:var(--bad)}
.dau a{color:var(--link)}
@media (max-width:820px){
  .dau table.resp thead{display:none}
  .dau table.resp,.dau table.resp tbody,.dau table.resp tr,.dau table.resp td{display:block;width:100%}
  .dau table.resp tr.row{border:1px solid var(--line);border-radius:6px;margin-bottom:8px;padding:6px 4px;background:var(--panel)}
  .dau table.resp td{border:0!important;padding:4px 10px!important}
  .dau table.resp td[data-l]::before{content:attr(data-l);display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.05em}
  .dau .drawer td{padding:0!important}
}
]]></INLINE>
<SHA256>9c45b2e13d0c9c79056becc3ff30ddb3383ddc9943be8b1369dfdce0c476de3c</SHA256>
</FILE>

<FILE Name="&emhttp;/assets/app.js" Mode="0644">
<INLINE><![CDATA[/* Unraid Swiss Manager UI. Plain JS, no libraries; every string is inserted as text (never as HTML). */
(function () {
  'use strict';
  var API = '/plugins/unraid-autoupdater/include/api.php';
  var root = document.getElementById('dau');
  var S = { tab: 'overview', ov: null, docker: null, plugins: null, os: null, hist: null, log: null, draft: null, sel: {}, psel: {}, open: {}, q: '', filter: 'all', sort: 'name', pq: '', pfilter: 'all', busy: false, poll: null };
  var DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  var FREQ = [['6h', 'Every 6 hours'], ['12h', 'Every 12 hours'], ['daily', 'Daily'], ['weekly', 'Weekly'], ['biweekly', 'Every two weeks'], ['monthly', 'Monthly']];
  var POL = [['auto', 'Auto update'], ['notify', 'Notify only'], ['ignore', 'Ignore']];
  var DELAYS = [[0, 'Immediately'], [24, '24 hours'], [72, '3 days'], [168, '7 days']];
  var STATE = {
    external: ['Not managed by Unraid', ''], unknown: ['Status unknown', ''], up_to_date: ['Up to date', 'ok'], ignored: ['Ignored', ''], notify_only: ['Update available', 'acc'],
    stopped: ['Skipped: stopped', 'warn'], approval: ['Needs your approval', 'warn'], no_identity: ['Waiting: digest unknown', 'warn'], waiting_delay: ['Waiting for delay', 'warn'],
    retry_wait: ['Retry scheduled', 'warn'], retry_exhausted: ['Retries used up', 'bad'], window_closed: ['Waiting for window', 'warn'], ready: ['Ready to update', 'acc'],
    blocked: ['Blocked', 'bad'], self: ['This plugin', '']
  };

  function h(tag, p) {
    var e = document.createElement(tag); p = p || {};
    for (var k in p) {
      if (k === 'class') e.className = p[k];
      else if (k.slice(0, 2) === 'on') e.addEventListener(k.slice(2), p[k]);
      else if (k === 'value') e.value = p[k];
      else if (k === 'checked' || k === 'disabled' || k === 'selected') e[k] = !!p[k];
      else if (p[k] !== null && p[k] !== undefined && p[k] !== false) e.setAttribute(k, p[k]);
    }
    for (var i = 2; i < arguments.length; i++) add(e, arguments[i]);
    return e;
  }
  function add(e, c) {
    if (c === null || c === undefined || c === false) return;
    if (Array.isArray(c)) { c.forEach(function (x) { add(e, x); }); return; }
    e.appendChild(c.nodeType ? c : document.createTextNode(String(c)));
  }
  function clear(e) { while (e.firstChild) e.removeChild(e.firstChild); }
  function ago(ts) { if (!ts) return 'never'; var s = Math.max(0, S.ov ? S.ov.now - ts : Date.now() / 1000 - ts); if (s < 90) return 'just now'; if (s < 5400) return Math.round(s / 60) + ' min ago'; if (s < 129600) return Math.round(s / 3600) + ' h ago'; return Math.round(s / 86400) + ' d ago'; }
  function when(ts) { return ts ? new Date(ts * 1000).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) : '-'; }
  function dur(s) { s = Math.round(s || 0); return s < 60 ? s + ' s' : Math.floor(s / 60) + ' min ' + (s % 60) + ' s'; }
  function toast(msg, bad) { var t = h('div', { class: 'toast' + (bad ? ' bad' : '') }, msg); root.appendChild(t); setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, bad ? 7000 : 3500); }

  function api(action, data, post) {
    var fd = new URLSearchParams(); fd.append('action', action);   // urlencoded, not multipart: multipart POSTs hang on Unraid's web server
    fd.append('csrf_token', window.DAU_CSRF || '');   // Unraid rejects any POST without it, reads included
    for (var k in (data || {})) fd.append(k, typeof data[k] === 'object' ? JSON.stringify(data[k]) : data[k]);
    return fetch(API, { method: post ? 'POST' : 'POST', body: fd, credentials: 'same-origin' }).then(function (r) {
      return r.json().catch(function () { return { error: 'Unexpected response (' + r.status + ')' }; }).then(function (j) { if (!r.ok && !j.error) j.error = 'Request failed (' + r.status + ')'; return j; });
    }).catch(function () { return { error: 'Could not reach the server.' }; });
  }
  function act(action, data, okMsg) { return api(action, data, true).then(function (j) { if (j.error) toast(j.error, true); else if (okMsg) toast(okMsg); return j; }); }

  /* ---------- loading ---------- */
  function load(which) {
    var jobs = [];
    var want = which || S.tab;
    jobs.push(api('overview').then(function (j) { if (!j.error) { S.ov = j; if (!S.draft) S.draft = JSON.parse(JSON.stringify(j.config)); } else S.err = j.error; }));
    if (want === 'docker') jobs.push(api('docker').then(function (j) { S.docker = j; }));
    if (want === 'plugins') jobs.push(api('plugins').then(function (j) { S.plugins = j; }));
    if (want === 'os') jobs.push(api('os').then(function (j) { S.os = j; }));
    if (want === 'activity') { jobs.push(api('history').then(function (j) { S.hist = j.rows || []; })); jobs.push(api('log').then(function (j) { S.log = j.log || ''; })); }
    return Promise.all(jobs).then(render);
  }
  function startPoll() {
    if (S.poll) return;
    S.poll = setInterval(function () {
      api('status').then(function (j) {
        if (!j.run) return;
        var was = S.ov && S.ov.run.running; S.ov.run = j.run;
        if (!j.run.running && was) { clearInterval(S.poll); S.poll = null; toast('Finished.'); load(); }
        else renderRunBar();
      });
    }, 2000);
  }
  function runJob(what, names, okMsg, extra) {
    var d = { what: what, names: names || [] }; for (var k in (extra || {})) d[k] = extra[k];
    return act('run', d, okMsg || 'Started.').then(function (j) {
