<FILE Name="&emhttp;/include/lib.php" Mode="0644">
<INLINE><![CDATA[<?php
/* Docker Auto Update - shared helpers */

$__ident = @parse_ini_file('/boot/config/ident.cfg');
if (is_array($__ident) && !empty($__ident['timezone'])) @date_default_timezone_set($__ident['timezone']);
unset($__ident);

define('DAU_ROOT',      '/usr/local/emhttp/plugins/docker.autoupdate');
define('DAU_DIR',       '/boot/config/plugins/docker.autoupdate');
define('DAU_CFG',       DAU_DIR . '/config.json');
define('DAU_HIST',      DAU_DIR . '/history.json');
define('DAU_STATEF',    DAU_DIR . '/state.json');
define('DAU_CRON',      DAU_DIR . '/docker-autoupdate.cron');
define('DAU_LOG',       '/var/log/docker-autoupdate.log');
define('DAU_LOCK',      '/var/run/docker-autoupdate.lock');
define('DAU_PROGRESS',  '/var/run/docker-autoupdate.progress');
define('DAU_UPDSTATUS', '/var/lib/docker/unraid-update-status.json');
define('DAU_DM',        '/usr/local/emhttp/plugins/dynamix.docker.manager');
define('DAU_TEMPLATES', '/boot/config/plugins/dockerMan/templates-user');

/* ---------- JSON + config ---------- */

function dau_read_json($file, $default) {
  if (!is_file($file)) return $default;
  $d = json_decode((string)@file_get_contents($file), true);
  return is_array($d) ? $d : $default;
}

function dau_write_json($file, $data) {
  @mkdir(dirname($file), 0755, true);
  $tmp = $file . '.tmp';
  file_put_contents($tmp, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
  rename($tmp, $file);
}

function dau_defaults() {
  return [
    'global' => [
      'enabled'      => false,
      'frequency'    => 'daily',   // daily | weekly | biweekly | monthly
      'time'         => '04:00',
      'weekday'      => 0,         // 0 = Sunday
      'monthday'     => 1,         // 1..28
      'notify'       => true,     // master switch; each container can also opt out
      'check_only'   => false,     // scheduled runs only notify, never apply
      'skip_stopped' => true,
      'prune'        => true,
      'delay'        => 10,        // seconds between container updates
    ],
    'containers' => [],
  ];
}

function dau_load_config() {
  $d = dau_defaults();
  $c = dau_read_json(DAU_CFG, []);
  $g = array_merge($d['global'], is_array($c['global'] ?? null) ? $c['global'] : []);
  $ct = is_array($c['containers'] ?? null) ? $c['containers'] : [];
  return ['global' => $g, 'containers' => $ct];
}

function dau_save_config($cfg) {
  dau_write_json(DAU_CFG, ['global' => $cfg['global'], 'containers' => (object)$cfg['containers']]);
}

function dau_clean_global($in, $cur) {
  $o = $cur;
  foreach (['enabled', 'notify', 'check_only', 'skip_stopped', 'prune'] as $k) {
    if (array_key_exists($k, $in)) $o[$k] = filter_var($in[$k], FILTER_VALIDATE_BOOLEAN);
  }
  if (isset($in['frequency']) && in_array($in['frequency'], ['daily', 'weekly', 'biweekly', 'monthly'], true)) $o['frequency'] = $in['frequency'];
  if (isset($in['time']) && preg_match('/^([01]\d|2[0-3]):[0-5]\d$/', (string)$in['time'])) $o['time'] = $in['time'];
  if (isset($in['weekday']))  $o['weekday']  = max(0, min(6, (int)$in['weekday']));
  if (isset($in['monthday'])) $o['monthday'] = max(1, min(28, (int)$in['monthday']));
  if (isset($in['delay']))    $o['delay']    = max(0, min(600, (int)$in['delay']));
  return $o;
}

/* ---------- schedules ---------- */

/** Normalise a schedule array, or return null when it is not a valid schedule. */
function dau_clean_schedule($in) {
  if (!is_array($in)) return null;
  $f = $in['frequency'] ?? 'daily';
  if (!in_array($f, ['daily', 'weekly', 'biweekly', 'monthly'], true)) return null;
  $t = (isset($in['time']) && preg_match('/^([01]\d|2[0-3]):[0-5]\d$/', (string)$in['time'])) ? $in['time'] : '04:00';
  return [
    'frequency' => $f,
    'time'      => $t,
    'weekday'   => max(0, min(6, (int)($in['weekday'] ?? 0))),
    'monthday'  => max(1, min(28, (int)($in['monthday'] ?? 1))),
  ];
}

/** Containers sharing the same schedule share one cron line ("slot"). */
function dau_slot_key($s) {
  $sig = $s['frequency'] . '|' . $s['time']
       . '|' . (in_array($s['frequency'], ['weekly', 'biweekly'], true) ? (int)$s['weekday'] : '')
       . '|' . ($s['frequency'] === 'monthly' ? (int)$s['monthday'] : '');
  return 'c' . substr(md5($sig), 0, 8);
}

/**
 * Effective schedule of a container, or null when it is not scheduled:
 * it must be marked Auto, and it uses its own schedule if it has one,
 * otherwise the global default (which must be switched on).
 */
function dau_container_schedule($cfg, $name) {
  $c = $cfg['containers'][$name] ?? null;
  if (!is_array($c) || empty($c['auto'])) return null;
  $custom = dau_clean_schedule($c['schedule'] ?? null);
  if ($custom) return ['slot' => dau_slot_key($custom), 'sched' => $custom, 'custom' => true];
  if (empty($cfg['global']['enabled'])) return null;
  return ['slot' => 'global', 'sched' => dau_clean_schedule($cfg['global']), 'custom' => false];
}

function dau_last_run($state, $slot) {
  $m = $state['last_scheduled'] ?? null;
  return is_array($m) ? (int)($m[$slot] ?? 0) : 0;
}

function dau_cron_line($s, $slot) {
  list($h, $m) = array_map('intval', explode(':', $s['time']));
  switch ($s['frequency']) {
    case 'weekly':
    case 'biweekly': $spec = "$m $h * * " . (int)$s['weekday']; break;   // bi-weekly gating happens in run.php
    case 'monthly':  $spec = "$m $h " . (int)$s['monthday'] . " * *"; break;
    default:         $spec = "$m $h * * *";
  }
  return $spec . ' /usr/bin/php ' . DAU_ROOT . '/scripts/run.php --scheduled --slot=' . $slot . ' > /dev/null 2>&1';
}

/** Rebuild the cron file: one line for the global default plus one per distinct custom schedule. */
function dau_apply_cron($cfg) {
  $slots = [];
  if (!empty($cfg['global']['enabled'])) $slots['global'] = dau_clean_schedule($cfg['global']);
  foreach (array_keys($cfg['containers']) as $n) {
    $x = dau_container_schedule($cfg, $n);
    if ($x && $x['custom']) $slots[$x['slot']] = $x['sched'];
  }
  if (!$slots) {
    @unlink(DAU_CRON);
  } else {
    @mkdir(DAU_DIR, 0755, true);
    $lines = "# Docker Auto Update\n";
    foreach ($slots as $slot => $s) $lines .= dau_cron_line($s, $slot) . "\n";
    file_put_contents(DAU_CRON, $lines);
  }
  @exec('/usr/local/sbin/update_cron');
}

/** Next run of a schedule array (caller decides whether it is active). */
function dau_next_run($g, $last = 0) {
  $now = time();
  try { $dt = new DateTime('today ' . $g['time']); } catch (Exception $e) { return null; }
  $freq = $g['frequency'];
  for ($i = 0; $i < 400; $i++) {
    $ts = $dt->getTimestamp();
    $ok = $ts > $now;
    if ($ok && ($freq === 'weekly' || $freq === 'biweekly')) $ok = ((int)$dt->format('w') === (int)$g['weekday']);
    if ($ok && $freq === 'monthly') $ok = ((int)$dt->format('j') === (int)$g['monthday']);
    if ($ok && $freq === 'biweekly' && $last && $ts < $last + 12 * 86400) $ok = false;
    if ($ok) return $ts;
    $dt->modify('+1 day');
  }
  return null;
}

/* ---------- docker ---------- */

function dau_image_key($img) {
  if (strpos($img, '@') !== false) return $img;
  $pos = strrpos($img, '/');
  $last = $pos === false ? $img : substr($img, $pos + 1);
  return strpos($last, ':') === false ? $img . ':latest' : $img;
}

function dau_update_flag($img, $map) {
  $k = dau_image_key($img);
  $nodocker = preg_replace('#^docker\.io/#', '', $k);
  foreach ([$k, $nodocker, preg_replace('#^library/#', '', $nodocker)] as $c) {
    if (isset($map[$c]) && is_array($map[$c])) {
      $e = $map[$c];
      if (!empty($e['local']) && !empty($e['remote'])) return $e['local'] !== $e['remote'];
      return null;
    }
  }
  return null; // unknown / not checked yet
}

/** Returns list of containers, or null when Docker is not running. */
function dau_containers() {
  $ids = [];
  exec('docker ps -aq --no-trunc 2>/dev/null', $ids, $rc);
  if ($rc !== 0) return null;
  if (!$ids) return [];
  $raw  = shell_exec('docker inspect ' . implode(' ', array_map('escapeshellarg', $ids)) . ' 2>/dev/null');
  $data = json_decode((string)$raw, true);
  if (!is_array($data)) return [];
  $map = dau_read_json(DAU_UPDSTATUS, []);
  $out = [];
  foreach ($data as $c) {
    $name = ltrim($c['Name'] ?? '', '/');
    if ($name === '') continue;
    $labels = $c['Config']['Labels'] ?? [];
    $img    = $c['Config']['Image'] ?? '';
    $managed = is_file(DAU_TEMPLATES . "/my-$name.xml") && (($labels['net.unraid.docker.managed'] ?? '') !== 'composeman');
    $out[] = [
      'name'    => $name,
      'image'   => $img,
      'state'   => $c['State']['Status'] ?? 'unknown',
      'icon'    => $labels['net.unraid.docker.icon'] ?? '',
      'managed' => $managed,
      'update'  => dau_update_flag($img, $map),
      'created' => $c['Created'] ?? '',
    ];
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  return $out;
}

function dau_inspect($name, $fmt) {
  return trim((string)shell_exec('docker inspect --format ' . escapeshellarg($fmt) . ' ' . escapeshellarg($name) . ' 2>/dev/null'));
}

/** Ask Unraid to re-check every image against its registry. */
function dau_refresh_updates() {
  $p = DAU_DM . '/scripts/dockerupdate.php';
  if (!is_file($p)) return false;
  $o = [];
  exec('/usr/bin/php ' . escapeshellarg($p) . ' check 2>&1', $o, $rc);
  return $rc === 0;
}

/** Update one container with Unraid's own routine (keeps the template config). */
function dau_update_container($name) {
  $script = DAU_DM . '/scripts/update_container';
  if (!is_file($script)) return ['ok' => false, 'changed' => false, 'msg' => 'Unraid update_container script not found'];
  $wasRunning = dau_inspect($name, '{{.State.Status}}') === 'running';
  $before = dau_inspect($name, '{{.Image}}');
  $cmd = (is_executable($script) ? '' : '/usr/bin/php ') . escapeshellarg($script) . ' ' . escapeshellarg($name) . ' 2>&1';
  $out = [];
  exec($cmd, $out, $rc);
  $after = dau_inspect($name, '{{.Image}}');
  $state = dau_inspect($name, '{{.State.Status}}');
  $clean = array_values(array_filter(array_map(function ($l) {
    return trim(preg_replace('/\x1b\[[0-9;]*[A-Za-z]|[\x00-\x08\x0b-\x1f]/', '', $l));
  }, $out)));
  $tail = implode(' | ', array_slice($clean, -3));
  if ($rc !== 0 || $after === '') return ['ok' => false, 'changed' => false, 'msg' => "exit code $rc: $tail"];
  if ($wasRunning && $state !== 'running') return ['ok' => false, 'changed' => $before !== $after, 'msg' => "container is '$state' after the update"];
  return ['ok' => true, 'changed' => $before !== $after, 'msg' => $tail];
}

/* ---------- log, history, run state ---------- */

function dau_log($msg) {
  if (is_file(DAU_LOG) && filesize(DAU_LOG) > 524288) {
    $l = file(DAU_LOG);
    file_put_contents(DAU_LOG, implode('', array_slice($l, -300)));
  }
  file_put_contents(DAU_LOG, '[' . date('Y-m-d H:i:s') . '] ' . $msg . "\n", FILE_APPEND);
}

function dau_log_tail($n = 150) {
  if (!is_file(DAU_LOG)) return '';
  return implode('', array_slice(file(DAU_LOG), -$n));
}

function dau_history_add($e) {
  $h = dau_read_json(DAU_HIST, []);
  array_unshift($h, $e + ['ts' => time()]);
  dau_write_json(DAU_HIST, array_slice($h, 0, 150));
}

function dau_is_locked() {
  $fp = @fopen(DAU_LOCK, 'c');
  if (!$fp) return false;
  if (flock($fp, LOCK_EX | LOCK_NB)) { flock($fp, LOCK_UN); fclose($fp); return false; }
  fclose($fp);
  return true;
}

function dau_run_info() {
  $p = dau_read_json(DAU_PROGRESS, []);
  $queued = !empty($p['queued']) && (time() - (int)($p['ts'] ?? 0)) < 20;
  return ['running' => dau_is_locked() || $queued, 'progress' => (object)$p];
}

function dau_spawn($args) {
  $info = dau_run_info();
  if ($info['running']) return false;
  dau_write_json(DAU_PROGRESS, ['queued' => true, 'ts' => time(), 'phase' => 'Starting']);
  exec('nohup /usr/bin/php ' . escapeshellarg(DAU_ROOT . '/scripts/run.php') . ' ' . $args . ' > /dev/null 2>&1 &');
  return true;
}

function dau_notify($subject, $desc, $importance = 'normal') {
  $n = '/usr/local/emhttp/webGui/scripts/notify';
  if (!is_file($n)) return;
  exec(escapeshellarg($n) . ' -e ' . escapeshellarg('Docker Auto Update') . ' -s ' . escapeshellarg($subject)
     . ' -d ' . escapeshellarg($desc) . ' -i ' . escapeshellarg($importance) . ' 2>&1');
}
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/include/api.php" Mode="0644">
<INLINE><![CDATA[<?php
/* Docker Auto Update - JSON API for the UI */
require_once '/usr/local/emhttp/plugins/docker.autoupdate/include/lib.php';

header('Content-Type: application/json');
header('Cache-Control: no-store');

function out($d) { echo json_encode($d, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR); exit; }
function fail($m, $code = 400) { http_response_code($code); out(['error' => $m]); }
function valid_name($n) { return is_string($n) && preg_match('/^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/', $n) === 1; }

$action = $_POST['action'] ?? $_GET['action'] ?? '';

switch ($action) {

  case 'list': {
    $cfg = dau_load_config();
    $st  = dau_read_json(DAU_STATEF, []);
    $cs  = dau_containers();
    if ($cs === null) $cs = null; // Docker down
    foreach ((array)$cs as $k => $c) {
      $e  = $cfg['containers'][$c['name']] ?? [];
      $x  = dau_container_schedule($cfg, $c['name']);
      $c['auto']     = !empty($e['auto']);
      $c['notify']   = array_key_exists('notify', $e) ? !empty($e['notify']) : true;
      $c['schedule'] = dau_clean_schedule($e['schedule'] ?? null);   // null = follows the global default
      $c['next']     = $x ? dau_next_run($x['sched'], dau_last_run($st, $x['slot'])) : null;
      $cs[$k] = $c;
    }
    $g = $cfg['global'];
    out([
      'docker'     => $cs !== null,
      'containers' => $cs ?? [],
      'config'     => ['global' => $g],
      'run'        => dau_run_info(),
      'next'       => !empty($g['enabled']) ? dau_next_run($g, dau_last_run($st, 'global')) : null,
      'last'       => (object)$st,
      'checked_at' => is_file(DAU_UPDSTATUS) ? filemtime(DAU_UPDSTATUS) : 0,
      'history'    => array_slice(dau_read_json(DAU_HIST, []), 0, 12),
    ]);
  }

  case 'save_global': {
    $in = json_decode($_POST['global'] ?? '', true);
    if (!is_array($in)) fail('Invalid settings payload');
    $cfg = dau_load_config();
    $cfg['global'] = dau_clean_global($in, $cfg['global']);
    dau_save_config($cfg);
    dau_apply_cron($cfg);
    $st = dau_read_json(DAU_STATEF, []);
    out(['ok' => true, 'global' => $cfg['global'],
         'next' => !empty($cfg['global']['enabled']) ? dau_next_run($cfg['global'], dau_last_run($st, 'global')) : null]);
  }

  case 'set_auto': {
    $names = json_decode($_POST['names'] ?? '', true);
    if (!is_array($names)) fail('Invalid container list');
    $val = filter_var($_POST['value'] ?? false, FILTER_VALIDATE_BOOLEAN);
    $cfg = dau_load_config();
    foreach ($names as $n) {
      if (!valid_name($n)) continue;
      $e = is_array($cfg['containers'][$n] ?? null) ? $cfg['containers'][$n] : [];
      $e['auto'] = $val;
      $cfg['containers'][$n] = $e;
    }
    dau_save_config($cfg);
    dau_apply_cron($cfg);
    out(['ok' => true]);
  }

  case 'set_container': {
    $name = $_POST['name'] ?? '';
    if (!valid_name($name)) fail('Invalid container name');
    $f = json_decode($_POST['fields'] ?? '', true);
    if (!is_array($f)) fail('Invalid payload');
    $cfg = dau_load_config();
    $e = is_array($cfg['containers'][$name] ?? null) ? $cfg['containers'][$name] : [];
    if (array_key_exists('auto', $f))   $e['auto']   = filter_var($f['auto'], FILTER_VALIDATE_BOOLEAN);
    if (array_key_exists('notify', $f)) $e['notify'] = filter_var($f['notify'], FILTER_VALIDATE_BOOLEAN);
    if (array_key_exists('schedule', $f)) {
      if ($f['schedule'] === null) {
        unset($e['schedule']);
      } else {
        $sc = dau_clean_schedule($f['schedule']);
        if (!$sc) fail('Invalid schedule');
        $e['schedule'] = $sc;
      }
    }
    $cfg['containers'][$name] = $e;
    dau_save_config($cfg);
    dau_apply_cron($cfg);
    out(['ok' => true]);
  }

  case 'check': {
    if (!dau_spawn('--check')) fail('A run is already in progress', 409);
    out(['ok' => true]);
  }

  case 'update': {
    $name = $_POST['name'] ?? '';
    if ($name === '__all__') {
      $args = '--all';
    } elseif (valid_name($name)) {
      $args = escapeshellarg('--container=' . $name);
    } else {
      fail('Invalid container name');
    }
    if (!dau_spawn($args)) fail('A run is already in progress', 409);
    out(['ok' => true]);
  }

  case 'status': {
    out(['run' => dau_run_info(), 'log' => dau_log_tail(150)]);
  }

  case 'clear_log': {
    @file_put_contents(DAU_LOG, '');
    out(['ok' => true]);
  }

  case 'clear_history': {
    dau_write_json(DAU_HIST, []);
    out(['ok' => true]);
  }

  default:
    fail('Unknown action');
}
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/scripts/run.php" Mode="0755">
<INLINE><![CDATA[<?php
/*
 * Docker Auto Update - runner
 *   --scheduled --slot=KEY   run from cron: update the containers whose schedule slot is KEY
 *                            (KEY "global" = containers that follow the default schedule)
 *   --check                  only refresh update status
 *   --all                    update every container that has an update pending
 *   --container=NAME         update one container (forced)
 */
require_once '/usr/local/emhttp/plugins/docker.autoupdate/include/lib.php';
set_time_limit(0);

$opt       = getopt('', ['scheduled', 'check', 'all', 'container:', 'slot:']);
$scheduled = isset($opt['scheduled']);
$slot      = isset($opt['slot']) ? (string)$opt['slot'] : 'global';

/* Scheduled runs queue up behind another run (two schedules can share a minute); manual runs do not. */
$lock = fopen(DAU_LOCK, 'c');
$t0 = time();
$wait = $scheduled ? 7200 : 0;
while (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) {
  if (!$lock || time() - $t0 >= $wait) { dau_log('Another run is already in progress, exiting'); exit(0); }
  sleep(5);
}

function progress($p) { dau_write_json(DAU_PROGRESS, $p); }

$cfg     = dau_load_config();
$g       = $cfg['global'];
$state   = dau_read_json(DAU_STATEF, []);
if (!is_array($state['last_scheduled'] ?? null)) $state['last_scheduled'] = [];
$trigger = $scheduled ? 'scheduled' : 'manual';
$force   = isset($opt['container']);
$started = time();

/* containers that belong to this schedule slot */
$slotTargets = [];
$slotSched = null;
if ($scheduled) {
  foreach (array_keys($cfg['containers']) as $n) {
    $x = dau_container_schedule($cfg, $n);
    if ($x && $x['slot'] === $slot) { $slotTargets[] = $n; $slotSched = $x['sched']; }
  }
  if (!$slotTargets) { progress(['running' => false]); exit(0); }
  $last = dau_last_run($state, $slot);
  if ($slotSched['frequency'] === 'biweekly' && $last && (time() - $last) < 12 * 86400) {
    dau_log("Bi-weekly schedule ($slot): off week, skipping");
    progress(['running' => false]);
    exit(0);
  }
  $state['last_scheduled'][$slot] = time();
}

$mode = $scheduled ? "scheduled run ($slot)" : (isset($opt['check']) ? 'update check' : (isset($opt['all']) ? 'update all pending' : 'update ' . ($opt['container'] ?? '')));
dau_log("=== Started: $mode");
progress(['running' => true, 'phase' => 'Checking for updates', 'done' => 0, 'total' => 0, 'started' => $started]);

if (!dau_refresh_updates()) dau_log('Warning: could not refresh update status with Unraid, using the last known status');

$list = dau_containers();
if ($list === null) {
  dau_log('Docker is not running, aborting');
  progress(['running' => false, 'finished' => time()]);
  exit(1);
}
$by = [];
foreach ($list as $c) $by[$c['name']] = $c;

/* pick targets */
$targets = [];
if (isset($opt['container'])) {
  $targets[] = $opt['container'];
} elseif (isset($opt['all'])) {
  foreach ($list as $c) if ($c['update'] === true && $c['managed']) $targets[] = $c['name'];
} elseif ($scheduled) {
  foreach ($slotTargets as $n) if (isset($by[$n])) $targets[] = $n;
}

if (isset($opt['check'])) {
  $pending = array_map(function ($c) { return $c['name']; }, array_filter($list, function ($c) { return $c['update'] === true; }));
  dau_log(count($pending) ? 'Updates available: ' . implode(', ', $pending) : 'All containers are up to date');
}

/* per-container notification (scheduled runs only, the UI shows manual results) */
function notify_for($name, $subject, $desc, $importance = 'normal') {
  global $cfg, $g, $scheduled;
  if (!$scheduled || empty($g['notify'])) return;
  $e = $cfg['containers'][$name] ?? [];
  if (array_key_exists('notify', $e) && empty($e['notify'])) return;
  dau_notify($subject, $desc, $importance);
}

$res = ['updated' => [], 'failed' => [], 'available' => [], 'unchanged' => []];
$total = count($targets);

foreach ($targets as $i => $name) {
  progress(['running' => true, 'phase' => 'Updating', 'current' => $name, 'done' => $i, 'total' => $total, 'started' => $started]);
  $c = $by[$name] ?? null;
  if (!$c) { dau_log("$name: not found, skipped"); continue; }
  if (!$c['managed']) { dau_log("$name: not created from an Unraid template, skipped"); continue; }
  if (!$force && $c['update'] !== true) { dau_log("$name: up to date"); continue; }
  if (!$force && !empty($g['skip_stopped']) && $c['state'] !== 'running') { dau_log("$name: stopped, skipped"); continue; }

  if ($scheduled && !empty($g['check_only'])) {
    dau_log("$name: update available (notify only)");
    $res['available'][] = $name;
    dau_history_add(['container' => $name, 'image' => $c['image'], 'result' => 'available', 'message' => 'Update available', 'trigger' => $trigger]);
    notify_for($name, "$name: update available", $c['image'] . ' has a newer image. Auto-apply is off (notify only).');
    continue;
  }

  dau_log("$name: updating " . $c['image']);
  $r = dau_update_container($name);
  if (!$r['ok']) {
    dau_log("$name: FAILED - " . $r['msg']);
    $res['failed'][] = $name;
    dau_history_add(['container' => $name, 'image' => $c['image'], 'result' => 'failed', 'message' => $r['msg'], 'trigger' => $trigger]);
    notify_for($name, "$name: update failed", $r['msg'], 'warning');
  } elseif ($r['changed']) {
    dau_log("$name: updated");
    $res['updated'][] = $name;
    dau_history_add(['container' => $name, 'image' => $c['image'], 'result' => 'updated', 'message' => 'Updated to the latest image', 'trigger' => $trigger]);
    notify_for($name, "$name: updated", $c['image'] . ' was updated to the latest image.');
  } else {
    dau_log("$name: already on the latest image");
    $res['unchanged'][] = $name;
    dau_history_add(['container' => $name, 'image' => $c['image'], 'result' => 'unchanged', 'message' => 'Already on the latest image', 'trigger' => $trigger]);
  }

  if ($i < $total - 1 && (int)$g['delay'] > 0) {
    progress(['running' => true, 'phase' => 'Waiting before the next update', 'current' => $name, 'done' => $i + 1, 'total' => $total, 'started' => $started]);
    sleep((int)$g['delay']);
  }
}

if ($res['updated'] && !empty($g['prune'])) {
  progress(['running' => true, 'phase' => 'Removing old images', 'done' => $total, 'total' => $total, 'started' => $started]);
  $o = [];
  exec('docker image prune -f 2>&1', $o);
  dau_log('Pruned old images: ' . trim((string)end($o)));
}

$state['last_run']     = time();
$state['last_trigger'] = $trigger;
$state['last_result']  = ['updated' => count($res['updated']), 'failed' => count($res['failed']), 'available' => count($res['available'])];
dau_write_json(DAU_STATEF, $state);

dau_log(sprintf('=== Finished: %d updated, %d failed, %d available', count($res['updated']), count($res['failed']), count($res['available'])));
progress(['running' => false, 'finished' => time()]);
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/assets/app.css" Mode="0644">
<INLINE><![CDATA[/* Docker Auto Update - dark grey UI matching the Unraid theme. Scoped to .dau so it never leaks into the page. */
.dau {
  --bg: #1d1b1b;
  --panel: #222020;
  --bar: #262626;
  --field: #181616;
  --line: #333030;
  --line-2: #433f3f;
  --text: #e8e6e6;
  --muted: #9b9797;
  --accent: #f15a2c;
  --accent-hi: #ff7447;
  --amber: #e8b33c;
  --ok: #4ec38b;
  --bad: #ff6b5e;
  --link: #6f93e0;
  --font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background: transparent;
  color: var(--text);
  font: 14px/1.5 var(--font);
  padding: 4px 0 24px;
  margin: 0;
  text-align: left;
  position: relative;
}
.dau *, .dau *::before, .dau *::after { box-sizing: border-box; }
.dau .grow { flex: 1 1 auto; min-width: 0; }
.dau .muted { color: var(--muted); }
.dau .sm { font-size: 12.5px; }
.dau b { font-weight: 600; color: var(--text); }
.dau svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex: none; }
.dau-loading { padding: 40px; text-align: center; color: var(--muted); }

/* header */
.dau .head { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
.dau .title { font-size: 20px; font-weight: 600; line-height: 1.2; color: var(--text); letter-spacing: .02em; }
.dau .subtitle { color: var(--muted); margin-top: 2px; }
.dau .actions { display: flex; gap: 10px; flex-wrap: wrap; }

/* buttons - beat Unraid's global button styles */
.dau .btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  height: 34px; min-width: 0; margin: 0; padding: 0 14px;
  border: 1px solid var(--line-2); border-radius: 4px;
  background: #2c2a2a; color: var(--text);
  font: 600 13px/1 var(--font); letter-spacing: .02em; text-shadow: none; box-shadow: none;
  cursor: pointer; transition: background .15s, border-color .15s;
}
.dau .btn:hover { background: #363333; border-color: #5a5555; color: var(--text); }
.dau .btn:focus-visible, .dau .switch:focus-visible, .dau .seg-b:focus-visible, .dau .field:focus-visible, .dau .sched:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
.dau .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
.dau .btn.primary:hover { background: var(--accent-hi); border-color: var(--accent-hi); color: #fff; }
.dau .btn.sm { height: 28px; padding: 0 11px; font-size: 12.5px; }
.dau .btn.quiet { background: transparent; border-color: transparent; color: var(--muted); }
.dau .btn.quiet:hover { background: #2c2a2a; color: var(--text); border-color: transparent; }
.dau .btn:disabled { opacity: .4; cursor: not-allowed; }

/* banner */
.dau .banner { display: flex; align-items: center; gap: 12px; padding: 11px 16px; border: 1px solid var(--line); border-radius: 4px; background: var(--panel); margin-bottom: 14px; }
.dau .banner.run { border-color: rgba(241, 90, 44, .55); }
.dau .b-title { margin-bottom: 6px; }
.dau .bar { height: 4px; border-radius: 99px; background: var(--line); overflow: hidden; }
.dau .bar i { display: block; height: 100%; background: var(--accent); border-radius: 99px; transition: width .4s ease; }
.dau .spin { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--line-2); border-top-color: var(--accent); animation: dau-spin .8s linear infinite; flex: none; }
@keyframes dau-spin { to { transform: rotate(360deg); } }
.dau .led { width: 9px; height: 9px; border-radius: 50%; background: #5a5555; flex: none; }
.dau .led.on { background: var(--ok); box-shadow: 0 0 0 4px rgba(78, 195, 139, .15); }

/* stats */
.dau .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 14px; }
.dau .stat { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 12px 16px; }
.dau .stat .n { font-size: 26px; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
.dau .stat .l { color: var(--muted); font-size: 13px; margin-top: 2px; }
.dau .stat.hot .n { color: var(--amber); }

/* layout */
.dau .grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 14px; align-items: start; }
.dau .side { display: grid; gap: 14px; }
.dau .card { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; overflow: hidden; }
.dau .card-h { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: var(--bar); border-bottom: 1px solid var(--line); min-height: 44px; }
.dau .card-t { font-size: 14px; font-weight: 600; color: var(--text); letter-spacing: .06em; }
.dau .log-wrap { margin-top: 14px; }

/* toolbar */
.dau .toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 12px 16px; border-bottom: 1px solid var(--line); }
.dau .search { position: relative; flex: 1 1 180px; min-width: 150px; }
.dau .search svg { position: absolute; left: 11px; top: 9px; color: var(--muted); }
.dau .field {
  display: block; width: 100%; height: 34px; min-width: 0; margin: 0; padding: 0 12px;
  background: var(--field); color: var(--text); border: 1px solid var(--line-2); border-radius: 4px;
  font: 13.5px/1 var(--font); box-shadow: none; text-shadow: none; -webkit-appearance: none; appearance: none;
}
.dau .field.has-ico { padding-left: 34px; }
.dau select.field { padding-right: 28px; background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); background-position: calc(100% - 16px) 14px, calc(100% - 11px) 14px; background-size: 5px 5px; background-repeat: no-repeat; }
.dau input[type=time].field, .dau input[type=number].field { color-scheme: dark; }
.dau .seg { display: inline-flex; padding: 3px; gap: 2px; background: var(--field); border: 1px solid var(--line-2); border-radius: 4px; }
.dau .seg-b { height: 26px; min-width: 0; margin: 0; padding: 0 11px; border: 0; border-radius: 3px; background: transparent; color: var(--muted); font: 600 12.5px/1 var(--font); letter-spacing: 0; text-shadow: none; box-shadow: none; cursor: pointer; }
.dau .seg-b:hover { color: var(--text); background: transparent; }
.dau .seg-b.on { background: var(--accent); color: #fff; }
.dau .seg.full { display: grid; grid-template-columns: repeat(4, 1fr); width: 100%; }
.dau .seg.full .seg-b { padding: 0 4px; }
.dau .seg.two-up { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }

/* container rows: left rail encodes update status */
.dau .cols, .dau .row { display: grid; grid-template-columns: minmax(0, 1fr) 118px 176px 52px 56px 84px; gap: 12px; align-items: center; padding: 0 16px; }
.dau .cols { height: 34px; color: var(--muted); font-size: 12.5px; border-bottom: 1px solid var(--line); background: var(--bar); }
.dau .cols .c { text-align: center; }
.dau .row { min-height: 64px; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--line); position: relative; }
.dau .row:last-child { border-bottom: 0; }
.dau .row::before { content: ""; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; border-radius: 0 3px 3px 0; background: var(--line-2); }
.dau .row.s-up::before { background: var(--ok); }
.dau .row.s-new::before { background: var(--amber); }
.dau .row.s-ext { opacity: .65; }
.dau .ct { display: flex; align-items: center; gap: 12px; min-width: 0; }
.dau .avatar { width: 38px; height: 38px; border-radius: 6px; background: #2c2a2a; border: 1px solid var(--line); display: grid; place-items: center; font-weight: 600; color: var(--muted); position: relative; overflow: hidden; flex: none; }
.dau .avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #2c2a2a; padding: 4px; }
.dau .ct-name { font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 8px; min-width: 0; }
.dau .ct-name span.t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dau .ct-img { color: var(--muted); font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dau .pill { display: inline-flex; align-items: center; height: 20px; padding: 0 8px; border-radius: 99px; font-size: 11.5px; font-weight: 600; border: 1px solid var(--line-2); color: var(--muted); white-space: nowrap; flex: none; }
.dau .pill.ok { color: var(--ok); border-color: rgba(78, 195, 139, .4); }
.dau .pill.new { color: var(--amber); border-color: rgba(232, 179, 60, .5); background: rgba(232, 179, 60, .08); }
.dau .pill.run { color: var(--ok); border-color: rgba(78, 195, 139, .3); }
.dau .pill.off { color: var(--muted); }
.dau .cell-c { display: flex; justify-content: center; }
.dau .cell-r { display: flex; justify-content: flex-end; }
.dau .empty { padding: 36px 18px; text-align: center; color: var(--muted); }
.dau .empty b { display: block; margin-bottom: 4px; font-size: 15px; }

/* schedule cell */
.dau .sched { display: block; width: 100%; min-width: 0; margin: 0; padding: 5px 8px; text-align: left; border: 1px solid transparent; border-radius: 4px; background: transparent; color: var(--text); font: 13px/1.3 var(--font); letter-spacing: 0; text-shadow: none; box-shadow: none; cursor: pointer; }
.dau .sched:hover { background: #2c2a2a; border-color: var(--line-2); color: var(--text); }
.dau .sched:disabled { cursor: not-allowed; opacity: .5; }
.dau .sched .s1 { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dau .sched .s2 { display: block; color: var(--muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dau .sched.custom .s1 { color: var(--link); }

/* switch */
.dau .switch { position: relative; width: 40px; height: 22px; min-width: 0; margin: 0; padding: 0; border-radius: 99px; border: 1px solid var(--line-2); background: #2c2a2a; cursor: pointer; transition: background .18s, border-color .18s; flex: none; box-shadow: none; }
.dau .switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #9b9797; transition: left .18s, background .18s; }
.dau .switch.on { background: var(--accent); border-color: var(--accent); }
.dau .switch.on::after { left: 20px; background: #fff; }
.dau .switch:disabled { opacity: .35; cursor: not-allowed; }
.dau .switch:hover { background: #3a3737; }
.dau .switch.on:hover { background: var(--accent-hi); }

/* settings */
.dau .master { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
.dau .master .t { font-weight: 600; font-size: 14.5px; color: var(--text); }
.dau .set-body { padding: 16px; display: grid; gap: 16px; transition: opacity .2s; }
.dau .set-body.dim { opacity: .5; }
.dau .lbl { font-size: 13px; color: var(--muted); margin-bottom: 7px; }
.dau .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.dau .opt { display: flex; align-items: center; gap: 14px; padding: 10px 0; border-top: 1px solid var(--line); }
.dau .opt:first-of-type { border-top: 0; }
.dau .opt-t { color: var(--text); font-weight: 550; }
.dau .opts { display: grid; }

/* history */
.dau .h-item { display: flex; gap: 12px; padding: 11px 16px; border-bottom: 1px solid var(--line); }
.dau .h-item:last-child { border-bottom: 0; }
.dau .h-top { display: flex; justify-content: space-between; gap: 10px; }
.dau .dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 7px; background: var(--muted); flex: none; }
.dau .dot.updated { background: var(--ok); }
.dau .dot.failed { background: var(--bad); }
.dau .dot.available { background: var(--amber); }
.dau .dot.unchanged { background: var(--link); }

/* log */
.dau pre.log { margin: 0; padding: 14px 16px; max-height: 280px; overflow: auto; background: var(--field); color: #bdb9b9; font: 12.5px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: pre-wrap; word-break: break-word; border: 0; border-radius: 0; }

/* schedule dialog */
.dau-modal { position: fixed; inset: 0; z-index: 99998; background: rgba(0, 0, 0, .6); display: grid; place-items: center; padding: 16px; }
.dau-dialog { width: 100%; max-width: 440px; background: #222020; color: #e8e6e6; border: 1px solid #433f3f; border-radius: 6px; box-shadow: 0 20px 50px rgba(0, 0, 0, .6); font: 14px/1.5 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
.dau-dialog .d-h { padding: 14px 18px; background: #262626; border-bottom: 1px solid #333030; border-radius: 6px 6px 0 0; font-weight: 600; letter-spacing: .04em; }
.dau-dialog .d-b { padding: 18px; display: grid; gap: 16px; }
.dau-dialog .d-f { padding: 14px 18px; display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #333030; }
.dau-dialog .note { color: #9b9797; font-size: 12.5px; }

/* toasts */
.dau-toasts { position: fixed; right: 22px; bottom: 22px; display: grid; gap: 8px; z-index: 99999; }
.dau-toast { background: #262626; color: #e8e6e6; border: 1px solid #433f3f; border-left: 3px solid #f15a2c; padding: 10px 14px; border-radius: 4px; font: 13.5px/1.4 ui-sans-serif, system-ui, sans-serif; box-shadow: 0 10px 30px rgba(0, 0, 0, .5); max-width: 340px; animation: dau-in .18s ease-out; }
.dau-toast.bad { border-left-color: #ff6b5e; }
.dau-toast.warn { border-left-color: #e8b33c; }
@keyframes dau-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

@media (max-width: 1280px) { .dau .grid { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 760px) {
  .dau .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dau .cols { display: none; }
  .dau .row { grid-template-columns: auto auto minmax(0, 1fr); grid-template-areas: "ct ct ct" "upd sch sch" "auto not btn"; row-gap: 8px; }
  .dau .row .ct { grid-area: ct; }
  .dau .row .cell-u { grid-area: upd; }
  .dau .row .cell-s { grid-area: sch; }
  .dau .row .cell-a { grid-area: auto; }
  .dau .row .cell-n { grid-area: not; }
  .dau .row .cell-b { grid-area: btn; }
}
@media (prefers-reduced-motion: reduce) {
  .dau .spin { animation-duration: 2.4s; }
  .dau .bar i, .dau .switch, .dau .switch::after, .dau-toast { transition: none; animation: none; }
}
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/assets/app.js" Mode="0644">
<INLINE><![CDATA[(() => {
  'use strict';

  const API = '/plugins/docker.autoupdate/include/api.php';
  const CSRF = window.DAU_CSRF || window.csrf_token || '';
  const root = document.getElementById('dau');
  if (!root) return;

  const S = {
    docker: true, containers: [], history: [],
    cfg: { global: {} },
    run: { running: false, progress: {} },
    next: null, last: {}, checkedAt: 0,
    filter: 'all', q: '', logOpen: false, first: true,
  };
  let M = null;                       // schedule dialog state
  let pollTimer = null, saveTimer = null, dirty = false;

  /* ---------- helpers ---------- */
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const $ = (sel, r = root) => r.querySelector(sel);
  const ico = (paths) => `<svg viewBox="0 0 24 24" aria-hidden="true">${paths}</svg>`;
  const ICON = {
    refresh: ico('<polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>'),
    down: ico('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>'),
    search: ico('<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>'),
    term: ico('<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>'),
  };
  const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const FREQS = [['daily', 'Daily'], ['weekly', 'Weekly'], ['biweekly', 'Bi-weekly'], ['monthly', 'Monthly']];

  function schedShort(s) {
    const t = s.time || '04:00';
    switch (s.frequency) {
      case 'weekly': return 'Weekly ' + DAYS[+s.weekday || 0].slice(0, 3) + ' ' + t;
      case 'biweekly': return 'Bi-weekly ' + DAYS[+s.weekday || 0].slice(0, 3) + ' ' + t;
      case 'monthly': return 'Monthly day ' + (+s.monthday || 1) + ', ' + t;
      default: return 'Daily ' + t;
    }
  }
  function ago(ts) {
    if (!ts) return 'never';
    const s = Math.max(0, Math.floor(Date.now() / 1000 - ts));
    if (s < 60) return 'just now';
    if (s < 3600) return Math.floor(s / 60) + ' min ago';
    if (s < 86400) return Math.floor(s / 3600) + ' h ago';
    return Math.floor(s / 86400) + ' d ago';
  }
  function when(ts) {
    return new Date(ts * 1000).toLocaleString([], { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  async function api(action, data = {}) {
    const body = new URLSearchParams({ action, csrf_token: CSRF });
    Object.entries(data).forEach(([k, v]) => body.append(k, typeof v === 'object' ? JSON.stringify(v) : String(v)));
    const res = await fetch(API, { method: 'POST', body, credentials: 'same-origin' });
    let j = null;
    try { j = await res.json(); } catch (e) { /* handled below */ }
    if (!res.ok || !j) throw new Error((j && j.error) || 'Request failed (' + res.status + ')');
    if (j.error) throw new Error(j.error);
    return j;
  }

  function toast(msg, kind = '') {
    let box = document.querySelector('.dau-toasts');
    if (!box) { box = document.createElement('div'); box.className = 'dau-toasts'; document.body.appendChild(box); }
    const t = document.createElement('div');
    t.className = 'dau-toast ' + kind;
    t.textContent = msg;
    box.appendChild(t);
    setTimeout(() => t.remove(), 3800);
  }

  /* ---------- shell ---------- */
  function shell() {
    root.innerHTML = `
      <div class="head">
        <div>
          <div class="title">Docker Auto Update</div>
          <div class="subtitle">Pick the containers to keep current, and when each one should be checked.</div>
        </div>
        <div class="actions">
          <button class="btn" data-act="check">${ICON.refresh}Check for updates</button>
          <button class="btn primary" data-act="update-all">${ICON.down}Update all pending</button>
        </div>
      </div>
      <div id="banner"></div>
      <div class="stats" id="stats"></div>
      <div class="grid">
        <section class="card">
          <div class="toolbar">
            <div class="search">${ICON.search}<input id="q" class="field has-ico" type="text" placeholder="Search containers" autocomplete="off"></div>
            <div class="seg" id="filters">
              <button class="seg-b on" data-filter="all">All</button>
              <button class="seg-b" data-filter="updates">Updates</button>
              <button class="seg-b" data-filter="auto">Auto</button>
            </div>
            <button class="btn sm" data-act="bulk-on" title="Turn on auto-update for the containers shown">Auto on</button>
            <button class="btn sm" data-act="bulk-off" title="Turn off auto-update for the containers shown">Auto off</button>
          </div>
          <div class="cols"><div>Container</div><div>Update</div><div>Schedule</div><div class="c">Auto</div><div class="c">Notify</div><div></div></div>
          <div id="list"></div>
        </section>
        <aside class="side">
          <section class="card" id="settings"></section>
          <section class="card">
            <div class="card-h"><div class="card-t grow">Recent activity</div><button class="btn sm quiet" data-act="hist-clear">Clear</button></div>
            <div id="history"></div>
          </section>
        </aside>
      </div>
      <section class="card log-wrap">
        <div class="card-h">
          ${ICON.term}<div class="card-t grow">Log</div>
          <button class="btn sm quiet" data-act="log-refresh">Refresh</button>
          <button class="btn sm quiet" data-act="log-clear">Clear</button>
          <button class="btn sm" data-act="log-toggle" id="logToggle">Show</button>
        </div>
        <pre class="log" id="log" hidden></pre>
      </section>`;
  }

  /* ---------- renderers ---------- */
  function renderStats() {
    const cs = S.containers;
    const items = [
      [cs.length, 'Containers', ''],
      [cs.filter(c => c.state === 'running').length, 'Running', ''],
      [cs.filter(c => c.update === true).length, 'Updates waiting', cs.some(c => c.update === true) ? 'hot' : ''],
      [cs.filter(c => c.managed && c.auto).length, 'On auto-update', ''],
    ];
    $('#stats').innerHTML = items.map(([n, l, k]) => `<div class="stat ${k}"><div class="n">${n}</div><div class="l">${l}</div></div>`).join('');
  }

  function renderBanner() {
    const el = $('#banner');
    const p = S.run.progress || {};
    if (S.run.running) {
      const total = p.total || 0, done = p.done || 0;
      const pct = total ? Math.max(6, Math.round(done / total * 100)) : 8;
      el.innerHTML = `<div class="banner run"><div class="spin"></div><div class="grow">
        <div class="b-title">${esc(p.phase || 'Working')}${p.current ? ' <b>' + esc(p.current) + '</b>' : ''}</div>
        <div class="bar"><i style="width:${pct}%"></i></div></div>
        <div class="muted">${total ? done + ' of ' + total : ''}</div></div>`;
      return;
    }
    const g = S.cfg.global || {};
    const own = S.containers.filter(c => c.managed && c.auto && c.schedule).length;
    const onDefault = S.containers.filter(c => c.managed && c.auto && !c.schedule).length;
    const parts = [];
    parts.push(g.enabled
      ? `<b>Default schedule is on</b> <span class="muted">${esc(schedShort(g))}${S.next ? ', next run ' + esc(when(S.next)) : ''}, ${onDefault} container${onDefault === 1 ? '' : 's'}</span>`
      : `<b>Default schedule is off</b> <span class="muted">switch it on in the panel to the right</span>`);
    if (own) parts.push(`<span class="muted">${own} container${own === 1 ? '' : 's'} on their own schedule</span>`);
    el.innerHTML = `<div class="banner"><span class="led ${(g.enabled || own) ? 'on' : ''}"></span><div class="grow">${parts.join(', ')}</div>
      <div class="muted sm">Last check ${esc(ago(S.checkedAt))}</div></div>`;
  }

  function visible() {
    const q = S.q.trim().toLowerCase();
    return S.containers.filter(c =>
      (!q || c.name.toLowerCase().includes(q) || c.image.toLowerCase().includes(q)) &&
      (S.filter === 'all' || (S.filter === 'updates' && c.update === true) || (S.filter === 'auto' && c.auto)));
  }

  function schedCell(c) {
    const g = S.cfg.global || {};
    let s1, s2, cls = '';
    if (c.schedule) {
      cls = 'custom';
      s1 = schedShort(c.schedule);
      s2 = c.auto ? (c.next ? 'Next ' + when(c.next) : '') : 'Auto is off';
    } else {
      s1 = g.enabled ? 'Default: ' + schedShort(g) : 'Default (off)';
      s2 = !c.auto ? 'Auto is off' : (g.enabled ? (c.next ? 'Next ' + when(c.next) : '') : 'Default schedule is off');
    }
    return `<button class="sched ${cls}" data-act="schedule" title="Change when ${esc(c.name)} is updated" ${c.managed ? '' : 'disabled'}><span class="s1">${esc(s1)}</span><span class="s2">${esc(s2)}</span></button>`;
  }

  function renderList() {
    const el = $('#list');
    if (!S.docker) {
      el.innerHTML = `<div class="empty"><b>Docker is not running</b>Start the Docker service under Settings, then Docker, and reload this page.</div>`;
      return;
    }
    const rows = visible();
    if (!rows.length) {
      el.innerHTML = S.containers.length
        ? `<div class="empty"><b>No matches</b>Try a different search or filter.</div>`
        : `<div class="empty"><b>No containers yet</b>Create a container from the Docker tab and it will show up here.</div>`;
      return;
    }
    const busy = S.run.running;
    const notifyOn = !!(S.cfg.global && S.cfg.global.notify);
    el.innerHTML = rows.map(c => {
      const cls = !c.managed ? 's-ext' : c.update === true ? 's-new' : c.update === false ? 's-up' : '';
      const badge = !c.managed ? `<span class="pill off" title="Not created from an Unraid template, so it can't be updated here">External</span>`
        : c.update === true ? `<span class="pill new">Update ready</span>`
        : c.update === false ? `<span class="pill ok">Up to date</span>`
        : `<span class="pill">Not checked</span>`;
      const state = c.state === 'running' ? `<span class="pill run">Running</span>` : `<span class="pill off">${esc(c.state === 'exited' ? 'Stopped' : c.state)}</span>`;
      return `<div class="row ${cls}" data-name="${esc(c.name)}">
        <div class="ct">
          <div class="avatar">${esc((c.name[0] || '?').toUpperCase())}${c.icon ? `<img src="${esc(c.icon)}" alt="" loading="lazy" onerror="this.remove()">` : ''}</div>
          <div class="grow"><div class="ct-name"><span class="t">${esc(c.name)}</span>${state}</div><div class="ct-img" title="${esc(c.image)}">${esc(c.image)}</div></div>
        </div>
        <div class="cell-u">${badge}</div>
        <div class="cell-s">${schedCell(c)}</div>
        <div class="cell-c cell-a"><button class="switch ${c.auto ? 'on' : ''}" role="switch" aria-checked="${!!c.auto}" aria-label="Auto-update ${esc(c.name)}" data-act="toggle" ${c.managed ? '' : 'disabled'}></button></div>
        <div class="cell-c cell-n"><button class="switch ${c.notify ? 'on' : ''}" role="switch" aria-checked="${!!c.notify}" aria-label="Notify when ${esc(c.name)} is updated" data-act="notify" title="${notifyOn ? 'Notify when this container is updated' : 'Notifications are switched off in the default settings'}" ${(c.managed && notifyOn) ? '' : 'disabled'}></button></div>
        <div class="cell-r cell-b"><button class="btn sm ${c.update === true ? 'primary' : ''}" data-act="update" ${(!c.managed || busy) ? 'disabled' : ''}>Update</button></div>
      </div>`;
    }).join('');
  }

  function sw(key, on) {
    return `<button class="switch ${on ? 'on' : ''}" role="switch" aria-checked="${!!on}" data-set="${key}"></button>`;
  }

  function renderSettings() {
    const g = S.cfg.global;
    const f = g.frequency || 'daily';
    const opt = (key, t, d) => `<div class="opt"><div class="grow"><div class="opt-t">${t}</div><div class="muted sm">${d}</div></div>${sw(key, g[key])}</div>`;
    $('#settings').innerHTML = `
      <div class="card-h"><div class="card-t grow">Default schedule</div></div>
      <div class="master">
        <div class="grow"><div class="t">Global auto-update</div><div class="muted sm">Containers marked Auto follow this schedule unless they have their own.</div></div>
        ${sw('enabled', g.enabled)}
      </div>
      <div class="set-body ${g.enabled ? '' : 'dim'}">
        <div>
          <div class="lbl">Check for updates</div>
          <div class="seg full">${FREQS.map(([v, l]) => `<button class="seg-b ${f === v ? 'on' : ''}" data-set="frequency" data-val="${v}">${l}</button>`).join('')}</div>
        </div>
        <div class="two">
          <div><div class="lbl">Time</div><input class="field" type="time" data-set="time" value="${esc(g.time || '04:00')}"></div>
          ${f === 'monthly'
            ? `<div><div class="lbl">Day of month</div><select class="field" data-set="monthday">${Array.from({ length: 28 }, (_, i) => `<option value="${i + 1}" ${+g.monthday === i + 1 ? 'selected' : ''}>${i + 1}</option>`).join('')}</select></div>`
            : f === 'daily'
              ? `<div><div class="lbl">Day</div><select class="field" disabled><option>Every day</option></select></div>`
              : `<div><div class="lbl">Day of week</div><select class="field" data-set="weekday">${DAYS.map((d, i) => `<option value="${i}" ${+g.weekday === i ? 'selected' : ''}>${d}</option>`).join('')}</select></div>`}
        </div>
      </div>
      <div class="set-body" style="padding-top:0">
        <div class="opts">
          ${opt('notify', 'Notifications', 'Send an Unraid notification for each container update. Turn individual containers on or off in the list.')}
          ${opt('check_only', 'Notify only', 'Check on schedule but never apply updates. You update by hand.')}
          ${opt('skip_stopped', 'Skip stopped containers', 'Leave containers alone if they are not running.')}
          ${opt('prune', 'Remove old images', 'Free disk space after a successful update.')}
        </div>
        <div>
          <div class="lbl">Pause between updates (seconds)</div>
          <input class="field" type="number" min="0" max="600" step="5" data-set="delay" value="${+g.delay || 0}">
        </div>
      </div>`;
  }

  function renderHistory() {
    const el = $('#history');
    if (!S.history.length) { el.innerHTML = `<div class="empty sm">Nothing yet. Updates you run or schedule will appear here.</div>`; return; }
    const text = h => ({
      updated: 'Updated to the latest image',
      unchanged: 'Already on the latest image',
      available: 'Update available',
      failed: 'Failed: ' + (h.message || 'unknown error'),
    }[h.result] || h.message || '');
    el.innerHTML = S.history.slice(0, 10).map(h => `
      <div class="h-item"><span class="dot ${esc(h.result)}"></span><div class="grow">
        <div class="h-top"><b>${esc(h.container)}</b><span class="muted sm">${esc(ago(h.ts))}</span></div>
        <div class="muted sm">${esc(text(h))}${h.trigger === 'scheduled' ? ' (scheduled)' : ''}</div></div></div>`).join('');
  }

  function setLog(text) {
    const pre = $('#log');
    const stick = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 30;
    pre.textContent = text || 'The log is empty.';
    if (stick) pre.scrollTop = pre.scrollHeight;
  }

  function renderAll() { renderStats(); renderBanner(); renderList(); renderHistory(); }

  /* ---------- per-container schedule dialog ---------- */
  function openSchedule(name) {
    const c = S.containers.find(x => x.name === name);
    if (!c) return;
    const g = S.cfg.global || {};
    M = {
      name, auto: c.auto, mode: c.schedule ? 'custom' : 'global',
      s: Object.assign({ frequency: 'daily', time: g.time || '04:00', weekday: +g.weekday || 0, monthday: +g.monthday || 1 }, c.schedule || {}),
    };
    renderModal();
  }

  function renderModal() {
    let el = $('#modal');
    if (!M) { if (el) el.remove(); return; }
    if (!el) { el = document.createElement('div'); el.id = 'modal'; el.className = 'dau-modal'; root.appendChild(el); }
    const g = S.cfg.global || {};
    const s = M.s;
    const custom = M.mode === 'custom';
    const dayField = s.frequency === 'monthly'
      ? `<div><div class="lbl">Day of month</div><select class="field" data-m="monthday">${Array.from({ length: 28 }, (_, i) => `<option value="${i + 1}" ${+s.monthday === i + 1 ? 'selected' : ''}>${i + 1}</option>`).join('')}</select></div>`
      : s.frequency === 'daily'
        ? `<div><div class="lbl">Day</div><select class="field" disabled><option>Every day</option></select></div>`
        : `<div><div class="lbl">Day of week</div><select class="field" data-m="weekday">${DAYS.map((d, i) => `<option value="${i}" ${+s.weekday === i ? 'selected' : ''}>${d}</option>`).join('')}</select></div>`;
    el.innerHTML = `<div class="dau-dialog" role="dialog" aria-modal="true" aria-label="Schedule for ${esc(M.name)}">
      <div class="d-h">Schedule for ${esc(M.name)}</div>
      <div class="d-b">
        <div class="seg two-up">
          <button class="seg-b ${custom ? '' : 'on'}" data-m="mode" data-val="global">Use default</button>
          <button class="seg-b ${custom ? 'on' : ''}" data-m="mode" data-val="custom">Own schedule</button>
        </div>
        ${custom ? `
          <div><div class="lbl">Check for updates</div>
            <div class="seg full">${FREQS.map(([v, l]) => `<button class="seg-b ${s.frequency === v ? 'on' : ''}" data-m="freq" data-val="${v}">${l}</button>`).join('')}</div></div>
          <div class="two"><div><div class="lbl">Time</div><input class="field" type="time" data-m="time" value="${esc(s.time)}"></div>${dayField}</div>
          <div class="note">Runs on this schedule even when the default schedule is off. The container still needs Auto switched on.</div>`
        : `<div class="note">Follows the default schedule: ${g.enabled ? esc(schedShort(g)) : 'currently switched off'}.</div>`}
      </div>
      <div class="d-f"><button class="btn" data-m="cancel">Cancel</button><button class="btn primary" data-m="save">Save schedule</button></div>
    </div>`;
  }

  async function saveSchedule() {
    const m = M;
    const schedule = m.mode === 'custom'
      ? { frequency: m.s.frequency, time: m.s.time, weekday: +m.s.weekday, monthday: +m.s.monthday }
      : null;
    try {
      await api('set_container', { name: m.name, fields: { schedule } });
      M = null; renderModal();
      toast(schedule ? 'Own schedule saved for ' + m.name : m.name + ' follows the default schedule',
        schedule && !m.auto ? 'warn' : '');
      if (schedule && !m.auto) toast('Switch Auto on for ' + m.name + ' so it runs.', 'warn');
      await loadAll();
    } catch (e) { toast(e.message, 'bad'); }
  }

  /* ---------- data ---------- */
  async function loadAll() {
    try {
      const j = await api('list');
      const keep = dirty ? S.cfg.global : null;
      S.docker = j.docker; S.containers = j.containers; S.history = j.history || [];
      S.cfg = { global: j.config.global }; S.run = j.run; S.next = j.next; S.last = j.last || {}; S.checkedAt = j.checked_at;
      if (keep) S.cfg.global = keep;
      if (S.first) { renderSettings(); S.first = false; }
      renderAll();
      if (S.run.running) startPolling();
    } catch (e) {
      toast(e.message, 'bad');
    }
  }

  function startPolling() { if (!pollTimer) { pollTimer = setInterval(poll, 2000); poll(); } }
  async function poll() {
    try {
      const j = await api('status');
      const was = S.run.running;
      S.run = j.run;
      renderBanner(); renderList();
      if (S.logOpen) setLog(j.log);
      if (!S.run.running) {
        clearInterval(pollTimer); pollTimer = null;
        if (was) { toast('Run finished'); await loadAll(); }
      }
    } catch (e) { /* keep polling */ }
  }

  async function start(action, data, msg) {
    try {
      await api(action, data);
      S.run = { running: true, progress: { phase: 'Starting' } };
      renderBanner(); renderList();
      toast(msg);
      startPolling();
    } catch (e) { toast(e.message, 'bad'); }
  }

  /* ---------- default schedule settings ---------- */
  function queueSave() { dirty = true; clearTimeout(saveTimer); saveTimer = setTimeout(saveGlobal, 450); }
  async function saveGlobal() {
    try {
      const j = await api('save_global', { global: S.cfg.global });
      dirty = false;
      S.cfg.global = j.global; S.next = j.next;
      await loadAll();
      toast('Default schedule saved');
    } catch (e) { dirty = false; toast(e.message, 'bad'); }
  }
  function setGlobal(key, val) {
    S.cfg.global[key] = val;
    renderSettings(); renderBanner(); renderList();
    if (key === 'enabled' && val && !S.containers.some(c => c.managed && c.auto && !c.schedule)) {
      toast('Default schedule is on, but no container is marked Auto yet.', 'warn');
    }
    queueSave();
  }

  /* ---------- per-container toggles ---------- */
  async function setAuto(names, value) {
    S.containers.forEach(c => { if (names.includes(c.name)) c.auto = value; });
    renderStats(); renderBanner(); renderList();
    try { await api('set_auto', { names, value }); await loadAll(); }
    catch (e) { toast(e.message, 'bad'); loadAll(); }
  }
  async function toggleNotify(name) {
    const c = S.containers.find(x => x.name === name);
    if (!c) return;
    c.notify = !c.notify;
    renderList();
    try { await api('set_container', { name, fields: { notify: c.notify } }); }
    catch (e) { toast(e.message, 'bad'); loadAll(); }
  }

  /* ---------- events ---------- */
  root.addEventListener('click', e => {
    const m = e.target.closest('[data-m]');
    if (m && M) {
      const k = m.dataset.m;
      if (k === 'cancel') { M = null; renderModal(); }
      else if (k === 'save') saveSchedule();
      else if (k === 'mode') { M.mode = m.dataset.val; renderModal(); }
      else if (k === 'freq') { M.s.frequency = m.dataset.val; renderModal(); }
      return;
    }
    if (M && e.target.id === 'modal') { M = null; renderModal(); return; }

    const set = e.target.closest('[data-set]');
    if (set && set.classList.contains('switch')) { setGlobal(set.dataset.set, !S.cfg.global[set.dataset.set]); return; }
    if (set && set.classList.contains('seg-b')) { setGlobal(set.dataset.set, set.dataset.val); return; }

    const f = e.target.closest('[data-filter]');
    if (f) {
      S.filter = f.dataset.filter;
      root.querySelectorAll('#filters .seg-b').forEach(b => b.classList.toggle('on', b === f));
      renderList(); return;
    }

    const b = e.target.closest('[data-act]');
    if (!b || b.disabled) return;
    const row = b.closest('.row');
    const name = row ? row.dataset.name : null;
    const cur = name ? S.containers.find(c => c.name === name) : null;

    switch (b.dataset.act) {
      case 'toggle': setAuto([name], !(cur && cur.auto)); break;
      case 'notify': toggleNotify(name); break;
      case 'schedule': openSchedule(name); break;
      case 'update': start('update', { name }, 'Updating ' + name); break;
      case 'check': start('check', {}, 'Checking for updates'); break;
      case 'update-all': {
        const n = S.containers.filter(c => c.update === true && c.managed).length;
        if (!n) { toast('Nothing is waiting. Run a check first if the list looks stale.'); break; }
        if (confirm('Update ' + n + ' container' + (n > 1 ? 's' : '') + ' now? Each one restarts briefly.')) start('update', { name: '__all__' }, 'Updating ' + n + ' container' + (n > 1 ? 's' : ''));
        break;
      }
      case 'bulk-on':
      case 'bulk-off': {
        const names = visible().filter(c => c.managed).map(c => c.name);
        if (names.length) setAuto(names, b.dataset.act === 'bulk-on');
        break;
      }
      case 'hist-clear': api('clear_history').then(() => { S.history = []; renderHistory(); }).catch(err => toast(err.message, 'bad')); break;
      case 'log-toggle': {
        S.logOpen = !S.logOpen;
        $('#log').hidden = !S.logOpen;
        $('#logToggle').textContent = S.logOpen ? 'Hide' : 'Show';
        if (S.logOpen) api('status').then(j => { setLog(j.log); $('#log').scrollTop = $('#log').scrollHeight; });
        break;
      }
      case 'log-refresh': api('status').then(j => setLog(j.log)).catch(err => toast(err.message, 'bad')); break;
      case 'log-clear': api('clear_log').then(() => setLog('')).catch(err => toast(err.message, 'bad')); break;
    }
  });

  root.addEventListener('input', e => {
    if (e.target.id === 'q') { S.q = e.target.value; renderList(); }
  });

  root.addEventListener('change', e => {
    const mEl = e.target.closest('[data-m]');
    if (mEl && M) {
      const k = mEl.dataset.m;
      if (k === 'time' && /^\d{2}:\d{2}$/.test(mEl.value)) M.s.time = mEl.value;
      else if (k === 'weekday' || k === 'monthday') M.s[k] = parseInt(mEl.value, 10);
      return;
    }
    const el = e.target.closest('[data-set]');
    if (!el || el.classList.contains('switch') || el.classList.contains('seg-b')) return;
    const key = el.dataset.set;
    let v = el.value;
    if (key === 'delay') v = Math.max(0, Math.min(600, parseInt(v, 10) || 0));
    else if (key === 'weekday' || key === 'monthday') v = parseInt(v, 10);
    else if (key === 'time' && !/^\d{2}:\d{2}$/.test(v)) return;
    S.cfg.global[key] = v;
    queueSave();
  });

  document.addEventListener('keydown', e => { if (e.key === 'Escape' && M) { M = null; renderModal(); } });

  /* ---------- boot ---------- */
  shell();
  loadAll();
  setInterval(() => { if (!S.run.running && !document.hidden && !M) loadAll(); }, 60000);
})();
]]></INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
mkdir -p &flash;
chmod 755 &emhttp;/scripts/run.php
# register the schedule again if one was saved before (e.g. after a reinstall or reboot)
/usr/local/sbin/update_cron 2>/dev/null
echo ""
echo "----------------------------------------------------"
echo " Docker Auto Update &version; installed"
echo " Open it from Settings > User Utilities > Docker Auto Update"
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -f &flash;/docker-autoupdate.cron
/usr/local/sbin/update_cron 2>/dev/null
rm -rf &emhttp;
rm -f /var/run/docker-autoupdate.lock /var/run/docker-autoupdate.progress
echo "Docker Auto Update removed. Settings and history were kept in &flash;"
</INLINE>
</FILE>

</PLUGIN>
