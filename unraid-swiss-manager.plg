<FILE Name="&emhttp;/include/plugins.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - Unraid plugins.
 * Only Unraid's own `plugin` tool ever installs anything: `plugin check` downloads the plg the plugin itself points
 * to, `plugin update` installs that downloaded file. This module adds the safety net around it (opt-in, policies,
 * delay, validation, pinning, verification). It never disables a check Unraid does and never auto-rolls back.
 */

const DAU_PLG_MAX_BYTES = 2097152;

function dau_plugin_bin() { return dau_bin('plugin'); }

function dau_plg_attr($path, $attr) {
  $r = dau_run([dau_plugin_bin(), $attr, $path], 30);
  return $r['code'] === 0 ? trim($r['out']) : '';
}

/** Installed plugins (never Unraid itself). */
function dau_plugins_installed() {
  $out = [];
  foreach (glob(DAU_PLUGLINKS . '/*.plg') ?: [] as $link) {
    $f = basename($link);
    if (!dau_valid_plg($f) || $f === 'unRAIDServer.plg' || strpos($f, 'unRAIDServer-') === 0) continue;
    $path = DAU_PLUGBOOT . '/' . $f;
    if (!is_file($path)) continue;
    $out[$f] = [
      'file' => $f, 'path' => $path, 'self' => $f === DAU_SELF_PLG,
      'name' => preg_replace('/\.plg$/', '', $f),
      'version' => dau_plg_attr($path, 'version'),
      'url' => dau_plg_attr($path, 'pluginURL'),
      'min' => dau_plg_attr($path, 'min'), 'max' => dau_plg_attr($path, 'max'),
    ];
  }
  ksort($out);
  return $out;
}

/**
 * Ask the plugin's own server for its current version. `plugin check` downloads the new plg to /tmp/plugins and prints
 * progress and hook-script lines around the version, so stdout is NOT parsed: the version is read from the downloaded file.
 */
function dau_plugin_check($file) {
  if (!dau_valid_plg($file)) return ['ok' => false, 'error' => 'invalid plugin name'];
  $tmp = DAU_PLUGTMP . '/' . $file;
  if (is_file($tmp)) @unlink($tmp);                      // never trust a stale download
  $r = dau_run([dau_plugin_bin(), 'check', $file], 120);
  if ($r['timeout']) return ['ok' => false, 'error' => 'check timed out'];
  $err = function () use ($r) { return dau_clip(dau_redact(trim(preg_replace('/[\r\n]+/', ' ', $r['err'] . ' ' . $r['out']))), 200) ?: 'no version returned'; };
  if ($r['code'] !== 0 || !is_file($tmp)) return ['ok' => false, 'error' => $err()];
  $v = dau_plg_attr($tmp, 'version');
  if ($v === '' || !preg_match('/^[A-Za-z0-9._+-]{1,40}$/', $v)) return ['ok' => false, 'error' => 'the downloaded plugin file has no valid version'];
  return ['ok' => true, 'latest' => $v];
}

/** Mirrors Unraid's own comparison (string compare of the version names). */
function dau_version_newer($latest, $installed) { return $latest !== '' && strcmp($latest, $installed) > 0; }

function dau_url_hosts($text) {
  $h = [];
  if (preg_match_all('#https?://([^/\s"\'<>:]+)#i', $text, $m)) foreach ($m[1] as $x) $h[strtolower($x)] = true;
  return array_keys($h);
}

/** Parse a plg safely: refuse external entities, no network. Returns SimpleXMLElement|null. */
function dau_plg_parse($text) {
  if (preg_match('/<!ENTITY\s+\S+\s+(SYSTEM|PUBLIC)\b/i', $text)) return null;
  $prev = libxml_use_internal_errors(true);
  $loader = PHP_VERSION_ID < 80000 ? libxml_disable_entity_loader(true) : null;     // process-wide on PHP 7: put it back, or later simplexml_load_file() calls fail
  $x = @simplexml_load_string($text, 'SimpleXMLElement', LIBXML_NONET | LIBXML_NOENT);
  if ($loader !== null) libxml_disable_entity_loader($loader);
  libxml_clear_errors(); libxml_use_internal_errors($prev);
  return $x instanceof SimpleXMLElement && $x->getName() === 'PLUGIN' ? $x : null;
}

function dau_unraid_version_ok($min, $max) {
  $cur = dau_os_version();
  if ($cur === '') return true;
  if ($min !== '' && version_compare($cur, $min, '<')) return false;
  if ($max !== '' && version_compare($cur, $max, '>')) return false;
  return true;
}

/**
 * Validate the downloaded update before it may be applied automatically.
 * @return array ['ok'=>bool,'reason'=>string,'sha'=>string]
 */
function dau_plugin_validate(array $p, $latest) {
  $no = function ($why) { return ['ok' => false, 'reason' => $why, 'sha' => '']; };
  if ($p['self']) return $no('This plugin never updates itself automatically.');
  $url = $p['url'];
  if ($url === '' || !preg_match('~^https://[A-Za-z0-9.-]+(:\d+)?/[A-Za-z0-9._%/+@:=?&#-]*$~', $url) || strlen($url) > 400) {
    return $no('Plugin source URL is not a plain https:// address (' . dau_clip($url, 80) . ').');
  }
  $tmp = DAU_PLUGTMP . '/' . $p['file'];
  if (!is_file($tmp)) return $no('The downloaded update file is missing.');
  $size = filesize($tmp);
  if ($size === false || $size < 50 || $size > DAU_PLG_MAX_BYTES) return $no('The downloaded update file has an unexpected size.');
  $text = (string)file_get_contents($tmp);
  $x = dau_plg_parse($text);
  if ($x === null) return $no('The downloaded update is not a valid plugin file (or uses external XML entities).');
  if ((string)$x['pluginURL'] !== '' && (string)$x['pluginURL'] !== $url) return $no('The update changes the plugin\'s source URL; install it manually after reviewing.');
  if ((string)$x['name'] !== '' && (string)$x['name'] !== $p['name']) return $no('The update changes the plugin name.');
  $ver = (string)$x['version'];
  if ($ver !== $latest) return $no("Downloaded version ($ver) differs from the announced version ($latest).");
  if (!dau_version_newer($ver, $p['version'])) return $no('Not newer than the installed version.');
  if (!dau_unraid_version_ok((string)$x['min'], (string)$x['max'])) return $no('Not compatible with this Unraid version (min ' . (string)$x['min'] . ', max ' . (string)$x['max'] . ').');
  $oldText = (string)@file_get_contents($p['path']);
  $allowed = array_merge(dau_url_hosts($oldText), dau_url_hosts($url));
  $new = array_diff(dau_url_hosts($text), $allowed);
  if ($new) return $no('The update downloads from a new host (' . implode(', ', array_slice($new, 0, 3)) . '); review and install it manually.');
  return ['ok' => true, 'reason' => '', 'sha' => hash('sha256', $text)];
}

/** Eligibility (same vocabulary as containers). */
function dau_plugin_eval(array $cfg, array $st, array $p, $latest, $now, $manual = false) {
  $pc = $cfg['plugins'];
  if ($p['self'] && $manual) return ['state' => 'self', 'reason' => 'Update this plugin from Plugins > Unraid Swiss Manager.', 'eta' => null];
  if ($p['self']) return ['state' => 'self', 'reason' => 'This plugin never updates itself automatically.', 'eta' => null];
  if (!dau_version_newer($latest, $p['version'])) return ['state' => 'up_to_date', 'reason' => '', 'eta' => null];
  if ($manual) return ['state' => 'ready', 'reason' => '', 'eta' => null];
  if (($st['plugins']['skipped'][$p['file']] ?? '') === $latest) return ['state' => 'skipped', 'reason' => 'You chose to skip this version. It is ignored until a newer one appears.', 'eta' => null];
  $policy = dau_plugin_policy($cfg, $p['file']);
  if (empty($pc['auto_update'])) return ['state' => $policy === 'ignore' ? 'ignored' : 'notify_only', 'reason' => 'Automatic plugin updates are switched off globally.', 'eta' => null];
  if ($policy === 'ignore') return ['state' => 'ignored', 'reason' => 'Policy is "ignore".', 'eta' => null];
  if ($policy === 'notify') return ['state' => 'notify_only', 'reason' => 'Policy is "notify only".', 'eta' => null];
  $seen = $st['plugins']['seen'][$p['file']] ?? null;
  $hours = (int)$pc['delay_hours'];
  if ($hours > 0) {
    if (!is_array($seen) || ($seen['version'] ?? '') !== $latest) return ['state' => 'no_identity', 'reason' => 'Version not tracked yet.', 'eta' => null];
    $eta = (int)$seen['first'] + $hours * 3600;
    if ($now < $eta) return ['state' => 'waiting_delay', 'reason' => "Waiting for the $hours h delay.", 'eta' => $eta];
  }
  $bl = $st['plugins']['blocked'][$p['file']] ?? null;
  if (is_array($bl) && ($bl['version'] ?? '') === $latest) return ['state' => 'blocked', 'reason' => $bl['reason'] ?? 'Blocked by a safety check.', 'eta' => null];
  if (!dau_window_open($pc['window'], $now)) return ['state' => 'window_closed', 'reason' => 'Outside the maintenance window.', 'eta' => null];
  return ['state' => 'ready', 'reason' => '', 'eta' => null];
}

/** Record when each available version was first seen. */
function dau_plugins_track(array &$st, array $avail, $now) {
  $seen = [];
  foreach ($avail as $f => $latest) {
    $r = $st['plugins']['seen'][$f] ?? null;
    $seen[$f] = (is_array($r) && ($r['version'] ?? '') === $latest) ? ['version' => $latest, 'first' => $r['first'], 'last' => $now] : ['version' => $latest, 'first' => $now, 'last' => $now];
  }
  $st['plugins']['seen'] = $seen;
  foreach (['notified', 'blocked', 'skipped', 'notes'] as $k) foreach (array_keys($st['plugins'][$k]) as $f) if (!isset($avail[$f]) || ($k === 'skipped' && $st['plugins'][$k][$f] !== $avail[$f])) unset($st['plugins'][$k][$f]);
}

function dau_plugin_recovery_copy($p) {
  if (!is_dir(DAU_RECOVERY)) @mkdir(DAU_RECOVERY, 0755, true);
  $dst = DAU_RECOVERY . '/' . $p['name'] . '-' . preg_replace('/[^A-Za-z0-9._-]/', '_', $p['version']) . '.plg';
  if (!@copy($p['path'], $dst)) return null;
  $all = glob(DAU_RECOVERY . '/' . $p['name'] . '-*.plg') ?: [];
  usort($all, function ($a, $b) { return filemtime($b) <=> filemtime($a); });
  foreach (array_slice($all, 3) as $old) @unlink($old);
  return $dst;
}

/**
 * Apply one plugin update. Result: updated | failed | blocked, with stage and recovery guidance (no rollback is attempted).
 */
function dau_plugin_update(array $cfg, array $p, $latest) {
  $res = ['result' => 'failed', 'stage' => 'validate', 'error' => '', 'next' => '', 'prev' => ['version' => $p['version']], 'new' => ['version' => $latest], 'started' => dau_now(), 'finished' => 0, 'verification' => null, 'warnings' => []];
  $done = function () use (&$res) { $res['finished'] = dau_now(); return $res; };
  $v = dau_plugin_validate($p, $latest);
  if (!$v['ok']) { $res['result'] = 'blocked'; $res['error'] = $v['reason']; $res['next'] = 'Review the change and update from the Plugins page if you trust it.'; return $done(); }
  $rec = dau_plugin_recovery_copy($p);
  if ($rec === null) $res['warnings'][] = 'Could not save a recovery copy of the current plugin file.';
  // re-check the file has not changed between validation and install
  $tmp = DAU_PLUGTMP . '/' . $p['file'];
  if (hash('sha256', (string)@file_get_contents($tmp)) !== $v['sha']) { $res['result'] = 'blocked'; $res['error'] = 'The downloaded file changed after validation.'; return $done(); }
  $res['stage'] = 'install';
  $r = dau_run([dau_plugin_bin(), 'update', $p['file']], 900);
  $res['stage'] = 'verify';
  $now = dau_plg_attr($p['path'], 'version');
  if ($now === $latest) {
    $res['result'] = 'updated'; $res['stage'] = '';
    $res['verification'] = ['result' => 'version_matches', 'ok' => true, 'detail' => "Installed plugin file now reports version $latest."];
    return $done();
  }
  $res['error'] = $r['timeout'] ? 'The install did not finish in time.' : 'After the install the plugin still reports version ' . ($now ?: 'unknown') . ' (expected ' . $latest . '). ' . dau_clip(dau_redact(trim($r['err'] . ' ' . $r['out'])), 200);
  $res['next'] = 'Not rolled back automatically. Check Plugins for the plugin\'s state' . ($rec ? '; the previous plugin file is saved in ' . $rec . ' (copy it over /boot/config/plugins/' . $p['file'] . ' and reboot to restore it)' : '') . '.';
  return $done();
}

/** Check all installed plugins. Returns ['avail'=>[file=>latest], 'errors'=>[file=>msg]]. */
function dau_plugins_check_all(array $cfg, array $installed) {
  $avail = []; $errors = [];
  foreach ($installed as $f => $p) {
    if (dau_stop_requested()) break;
    $c = dau_plugin_check($f);
    if (!$c['ok']) { $errors[$f] = $c['error']; continue; }
    if (dau_version_newer($c['latest'], $p['version'])) $avail[$f] = $c['latest'];
  }
  return ['avail' => $avail, 'errors' => $errors];
}

function dau_plugin_slots(array $cfg) {
  $pc = $cfg['plugins'];
  if (empty($pc['check_enabled']) && empty($pc['auto_update'])) return [];
  $s = dau_clean_schedule($pc);
  return $s ? ['plugins' => ['sched' => $s, 'names' => ['*']]] : [];
}
]]></INLINE>
<SHA256>5338ffc73c874670e8186ae3d5f38b1a4307afe6d65f03dd00aa86f4d4a4ac2c</SHA256>
</FILE>

<FILE Name="&emhttp;/include/os.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - Unraid OS.
 * DEFAULT: check and notify only. Installing an OS update (mode "install") and rebooting afterwards (mode "install_reboot")
 * are opt-in, need an explicit confirmation in the UI, a maintenance window and a waiting period, and use only Unraid's own
 * `plugin update unRAIDServer.plg` (the same thing Tools > Update OS runs) and the stock reboot command. Nothing is rolled back
 * automatically: Unraid keeps the previous release on the flash drive (Tools > Update OS > Restore).
 */

function dau_os_check() {
  $res = dau_plugin_check('unRAIDServer.plg');
  if (!$res['ok']) return $res;
  if (!preg_match('/^[0-9][A-Za-z0-9._+-]{0,30}$/', $res['latest'])) return ['ok' => false, 'error' => 'The OS update check returned an unexpected version.'];
  return $res;
}

function dau_os_notes() {
  $r = dau_run([dau_plugin_bin(), 'changes', DAU_PLUGTMP . '/unRAIDServer.plg'], 60);
  return $r['code'] === 0 ? dau_clip(dau_redact(trim($r['out'])), 900) : '';
}

/**
 * Update the OS block of the state from a check result and return the events that should be announced (each only once).
 * Events: available, os_withdrawn, os_check_failed, os_installed.
 */
function dau_os_process(array &$st, array $check, $now) {
  $os =& $st['os'];
  $events = [];
  $installed = dau_os_version();
  $os['last_check'] = $now;
  $prev = $os['installed'];
  if ($prev !== null && $installed !== '' && $prev !== $installed && ($os['notified'] === $installed || $os['available'] === $installed)) {
    $events[] = ['kind' => 'os_installed', 'installed' => $prev, 'available' => $installed];
  }
  $os['installed'] = $installed;
  if (!$check['ok']) {
    $os['last_error'] = $check['error'];
    if (empty($os['error_notified'])) { $events[] = ['kind' => 'os_check_failed', 'installed' => $installed, 'error' => $check['error']]; $os['error_notified'] = true; }
    return $events;
  }
  $os['error_notified'] = false; $os['last_error'] = ''; $os['last_check_ok'] = $now;
  $latest = $check['latest'];
  if (dau_version_newer($latest, $installed)) {
    if ($os['available'] !== $latest) { $os['available'] = $latest; if (($os['skipped'] ?? '') !== $latest) $os['skipped'] = ''; $os['first_seen'] = $now; $os['withdrawn_notified'] = false; $os['notes'] = dau_os_notes(); }
    if ($os['notified'] !== $latest) {
      $events[] = ['kind' => 'available', 'installed' => $installed, 'available' => $latest, 'reason' => $os['notes']];
      $os['notified'] = $latest;
    }
  } else {
    if ($os['available'] !== null && $os['available'] !== $installed && $os['notified'] === $os['available'] && empty($os['withdrawn_notified'])) {
      $events[] = ['kind' => 'os_withdrawn', 'installed' => $installed, 'available' => $os['available']];
      $os['withdrawn_notified'] = true;
    }
    if ($os['available'] === $installed || $os['available'] === null) { $os['available'] = null; }
    else $os['available'] = null;
    $os['notes'] = '';
  }
  return $events;
}

/* ---------------- policy ---------------- */

function dau_os_is_stable($v) { return preg_match('/^[0-9]+\.[0-9]+\.[0-9]+$/', (string)$v) === 1; }

/** Array state from Unraid's own var.ini. */
function dau_os_array_state() {
  $v = @parse_ini_file(DAU_VARINI);
  if (!is_array($v) || empty($v['mdState'])) return ['ok' => false, 'state' => '', 'resync' => 0];
  return ['ok' => true, 'state' => strtoupper((string)$v['mdState']), 'resync' => (int)($v['mdResync'] ?? 0)];
}

/** May the server be rebooted right now without interrupting something important? */
function dau_os_reboot_safe() {
  $a = dau_os_array_state();
  if (!$a['ok']) return ['ok' => false, 'reason' => 'The array state could not be read.'];
  if (!in_array($a['state'], ['STARTED', 'STOPPED'], true)) return ['ok' => false, 'reason' => 'The array is in state ' . $a['state'] . ' (not a plain started or stopped array).'];
  if ($a['resync'] > 0) return ['ok' => false, 'reason' => 'A parity check, sync or rebuild is running.'];
  if (dau_pid_alive(DAU_MOVERPID)) return ['ok' => false, 'reason' => 'The mover is running (files are being moved between the cache and the array).'];
  return ['ok' => true, 'reason' => ''];
}

function dau_os_boot_free_mb() {
  if (isset($GLOBALS['DAU_BOOTFREE'])) return (int)$GLOBALS['DAU_BOOTFREE'];
  $f = @disk_free_space(DAU_BOOT);
  return $f === false ? 0 : (int)($f / 1048576);
}

/** The installed OS plugin file, shaped like a plugin entry so the plugin safety checks can be reused. */
function dau_os_plugin_entry() {
  $path = DAU_PLUGBOOT . '/unRAIDServer.plg';
  if (!is_file($path)) $path = DAU_PLUGLINKS . '/unRAIDServer.plg';
  return ['file' => 'unRAIDServer.plg', 'path' => $path, 'self' => false, 'name' => 'unRAIDServer', 'version' => dau_os_version() ?: '',
          'url' => dau_plg_attr($path, 'pluginURL'), 'min' => dau_plg_attr($path, 'min'), 'max' => dau_plg_attr($path, 'max')];
}

/**
 * What would happen to the available OS version right now?
 * state: up_to_date | awaiting_confirmation | notify_only | not_confirmed | prerelease | blocked | waiting_delay | window_closed | staged | ready
 */
function dau_os_eval(array $cfg, array $st, $now, $manual = false) {
  $o = $cfg['os']; $os = $st['os'];
  $latest = $os['available'];
  if ($latest === null || $latest === '') return ['state' => 'up_to_date', 'reason' => '', 'eta' => null];
  $pend = $os['pending'] ?? null;
  if (is_array($pend) && ($pend['to'] ?? '') === $latest) return ['state' => 'staged', 'reason' => 'Installed, waiting for a reboot.', 'eta' => null];
  $wf = $os['workflow'] ?? null;
  if (is_array($wf) && ($wf['state'] ?? '') === 'awaiting_confirmation' && ($wf['version'] ?? '') === $latest) return ['state' => 'awaiting_confirmation', 'reason' => 'Prerequisites passed; waiting for your confirmation.', 'eta' => null];
  if ($manual) return ['state' => 'ready', 'reason' => '', 'eta' => null];
  if (($os['skipped'] ?? '') === (string)$latest) return ['state' => 'skipped', 'reason' => 'You chose to skip this release.', 'eta' => null];
  if ($o['mode'] === 'notify') return ['state' => 'notify_only', 'reason' => 'Automatic installation is off (notify only).', 'eta' => null];
  if ($o['confirmed'] !== $o['mode']) return ['state' => 'not_confirmed', 'reason' => 'The automatic mode was not confirmed.', 'eta' => null];
  if (!empty($o['stable_only']) && !dau_os_is_stable($latest)) return ['state' => 'prerelease', 'reason' => 'Only stable releases are installed automatically.', 'eta' => null];
  $at = $os['attempted'] ?? null;
  if (is_array($at) && ($at['version'] ?? '') === $latest) return ['state' => 'blocked', 'reason' => 'The last attempt for this version did not succeed: ' . ($at['reason'] ?? ''), 'eta' => null];
  if (empty($o['window']['enabled'])) return ['state' => 'blocked', 'reason' => 'Automatic OS installs need a maintenance window.', 'eta' => null];
  $eta = (int)$os['first_seen'] + (int)$o['delay_days'] * 86400;
  if ($now < $eta) return ['state' => 'waiting_delay', 'reason' => 'Waiting ' . (int)$o['delay_days'] . ' day(s) after the release was first seen.', 'eta' => $eta];
  if (!dau_window_open($o['window'], $now)) return ['state' => 'window_closed', 'reason' => 'Outside the maintenance window.', 'eta' => null];
  return ['state' => 'ready', 'reason' => '', 'eta' => null];
}

/* ---------------- install + reboot ---------------- */

/**
 * Install the OS update through `plugin update unRAIDServer.plg` after a fresh check and the standard plugin validation.
 * The new release only becomes active after a reboot. Result: staged | failed | blocked.
 */
function dau_os_install(array $cfg, $latest) {
  $installed = dau_os_version() ?: '';
  $res = ['result' => 'failed', 'stage' => 'check', 'error' => '', 'next' => '', 'prev' => ['version' => $installed], 'new' => ['version' => $latest], 'started' => dau_now(), 'finished' => 0, 'verification' => null];
  $done = function () use (&$res) { $res['finished'] = dau_now(); return $res; };
  $res['next'] = 'Nothing was changed.';
  $chk = dau_os_check();
  if (!$chk['ok']) { $res['error'] = 'Fresh update check failed: ' . $chk['error']; return $done(); }
  if ($chk['latest'] !== $latest) { $res['result'] = 'blocked'; $res['error'] = 'The offered version changed from ' . $latest . ' to ' . $chk['latest'] . ' during the check.'; return $done(); }
  $res['stage'] = 'validate';
  $p = dau_os_plugin_entry();
  $v = dau_plugin_validate($p, $latest);
  if (!$v['ok']) { $res['result'] = 'blocked'; $res['error'] = $v['reason']; $res['next'] = 'Install it yourself from Tools > Update OS after reading the release notes.'; return $done(); }
  $res['stage'] = 'space';
  $free = dau_os_boot_free_mb();
  if ($free < 600) { $res['result'] = 'blocked'; $res['error'] = 'Only ' . $free . ' MB free on the flash drive (600 MB needed).'; $res['next'] = 'Free up space on the flash drive and try again.'; return $done(); }
  $tmp = DAU_PLUGTMP . '/unRAIDServer.plg';
  if (hash('sha256', (string)@file_get_contents($tmp)) !== $v['sha']) { $res['result'] = 'blocked'; $res['error'] = 'The downloaded file changed after validation.'; return $done(); }
  $res['stage'] = 'install';
  $r = dau_run([dau_plugin_bin(), 'update', 'unRAIDServer.plg'], 1800);
  $res['stage'] = 'verify';
  $now = dau_plg_attr(DAU_PLUGBOOT . '/unRAIDServer.plg', 'version');
  if ($now === '') $now = dau_plg_attr(DAU_PLUGLINKS . '/unRAIDServer.plg', 'version');
  $files = is_file(DAU_BOOT . '/bzroot') && is_file(DAU_BOOT . '/bzimage');
  if ($now === $latest && $files) {
    $res['result'] = 'staged'; $res['stage'] = '';
    $res['verification'] = ['result' => 'staged', 'ok' => true, 'detail' => "Unraid $latest is installed on the flash drive and becomes active after a reboot."];
    $res['next'] = 'Reboot to finish. If anything goes wrong, Tools > Update OS > Restore returns to ' . ($installed ?: 'the previous release') . '.';
    return $done();
  }
  $res['error'] = $r['timeout'] ? 'The install did not finish in time.' : 'After the install Unraid reports version ' . ($now ?: 'unknown') . ($files ? '' : ' and the boot files are incomplete') . ' (expected ' . $latest . '). ' . dau_clip(dau_redact(trim($r['err'] . ' ' . $r['out'])), 200);
  $res['next'] = 'Do NOT reboot until you have checked Tools > Update OS. The previous release is kept on the flash drive and can be restored there.';
  return $done();
}

/** Reboot with Unraid's stock command (the same one the Reboot button runs). */
function dau_os_reboot() {
  $r = dau_run([DAU_REBOOT, '-n'], 30);
  return $r['code'] === 0 || $r['timeout'];
}

/**
 * Called at every boot (install script): if an OS update was waiting for this reboot, record whether it is now running.
 * The announcement itself is sent by the next job (the network may not be up yet).
 */
function dau_os_boot_verify(array &$st) {
  $pend = $st['os']['pending'] ?? null;
  $installed = dau_os_version();
  if ($installed !== null && $installed !== '') $st['os']['installed'] = $installed;
  if (!is_array($pend) || empty($pend['to'])) return null;
  $ok = ($installed === $pend['to']);
  $st['os']['pending'] = null;
  $st['os']['boot_result'] = ['kind' => $ok ? 'os_verified' : 'os_unverified', 'installed' => (string)($pend['from'] ?? ''), 'available' => (string)$pend['to'], 'running' => (string)$installed, 'at' => dau_now(), 'auto' => !empty($pend['reboot'])];
  if ($ok) { $st['os']['available'] = null; $st['os']['notified'] = null; $st['os']['rebooted_for'] = ''; }
  return $st['os']['boot_result'];
}

function dau_os_slots(array $cfg) {
  $o = $cfg['os'];
  if (empty($o['check_enabled'])) return [];
  $s = dau_clean_schedule($o);
  return $s ? ['os' => ['sched' => $s, 'names' => ['*']]] : [];
}
]]></INLINE>
<SHA256>5d289b0f401db8a2d31b0b9db30feabaecb14410c83da1dc739829fb39613490</SHA256>
</FILE>

<FILE Name="&emhttp;/include/workflow.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - pre-OS maintenance workflow.
 * Before an Unraid OS update is installed (automatically or from the UI) the plugins - and, only if enabled, the Docker
 * containers - are brought up to date, the result is verified and the system is re-checked. The OS install runs only when
 * every REQUIRED step succeeded. It reuses dau_job_plugins() / dau_job_docker() (no second updater) and never reboots by itself.
 *
 * state.os.workflow: null | {state: running|awaiting_confirmation, version, started, reboot, manual}
 * state.os.last_report: the outcome of the latest run (shown in the UI, sent to Discord).
 */

const DAU_WORKFLOW_TTL = 86400;   // a paused workflow waits this long for a confirmation

function dau_os_pre_defaults() {
  return ['plugins' => true, 'docker' => false, 'require_plugins' => true, 'require_docker' => true, 'confirm' => false, 'notify' => true, 'scope' => 'auto'];
}

function dau_os_pre_spec() {
  return ['plugins' => ['bool'], 'docker' => ['bool'], 'require_plugins' => ['bool'], 'require_docker' => ['bool'], 'confirm' => ['bool'], 'notify' => ['bool'], 'scope' => ['enum', ['auto', 'all']]];
}

/** Containers the workflow may update: policy "auto", has an update, not "critical" (those always need an explicit approval). */
function dau_os_pre_containers(array $cfg) {
  $out = [];
  foreach ((dau_containers() ?? []) as $c) {
    $cc = dau_container_cfg($cfg, $c['name']);
    if ($c['update'] !== true || !$c['managed'] || $cc['policy'] !== 'auto' || !empty($cc['critical'])) continue;
    if (!empty($cfg['global']['skip_stopped']) && $c['state'] !== 'running') continue;
    $out[] = $c['name'];
  }
  return $out;
}

/** Re-check the system after the updates. Returns ['ok'=>bool,'issues'=>[string]]. */
function dau_os_health(array $cfg, $needDocker) {
  $issues = [];
  $a = dau_os_array_state();
  if (!$a['ok']) $issues[] = 'The array state could not be read.';
  elseif (!in_array($a['state'], ['STARTED', 'STOPPED'], true)) $issues[] = 'The array is in state ' . $a['state'] . '.';
  $free = dau_os_boot_free_mb();
  if ($free < 600) $issues[] = 'Only ' . $free . ' MB free on the flash drive (600 MB needed).';
  foreach (dau_plugins_installed() as $f => $p) if ($p['version'] === '') $issues[] = "Plugin $f could not be read after the updates.";
  if ($needDocker && dau_containers() === null) $issues[] = 'The Docker service is not responding.';
  if (dau_stop_requested()) $issues[] = 'Stopped by the user.';
  return ['ok' => !$issues, 'issues' => $issues];
}

function dau_os_wf_history(array $J, $result, $detail, $started) {
  dau_history_add(['type' => 'os', 'name' => 'Unraid OS', 'action' => 'prerequisites', 'result' => $result, 'started' => $started, 'finished' => dau_now(), 'trigger' => $J['trigger'],
    'error' => $result === 'failed' || $result === 'aborted' ? $detail : '', 'message' => $result === 'ok' || $result === 'waiting' ? $detail : ''], $J['cfg']['history']['max_entries']);
}

/**
 * Run the prerequisites. opt: manual, reboot, plugins/docker (null = use settings), skip_pre (already done, only re-check).
 * Returns 'proceed' (install now), 'wait' (paused for a confirmation) or 'stop' (the OS update must not continue).
 */
function dau_os_workflow(array &$J, $latest, array $opt) {
  $cfg = $J['cfg']; $pre = $cfg['os']['pre']; $started = dau_now();
  $manual = !empty($opt['manual']);
  $wantP = !empty($opt['skip_pre']) ? false : ($opt['plugins'] ?? $pre['plugins']);
  $wantD = !empty($opt['skip_pre']) ? false : ($opt['docker'] ?? $pre['docker']);
  $needConfirm = !$manual && !empty($pre['confirm']) && empty($opt['skip_pre']);
  if (!$wantP && !$wantD && !$needConfirm && empty($opt['skip_pre'])) return 'proceed';       // nothing configured: classic behaviour

  $inst = $J['st']['os']['installed'] ?? dau_os_version();
  $os =& $J['st']['os'];
  $os['workflow'] = ['state' => 'running', 'version' => $latest, 'started' => $started, 'reboot' => !empty($opt['reboot']), 'manual' => $manual];
  dau_state_save($J['st']);
  if ($pre['notify'] && empty($opt['skip_pre'])) {
    $steps = array_filter([$wantP ? 'plugins' : null, $wantD ? 'Docker containers' : null]);
    $J['events'][] = dau_ev('os', 'Unraid OS', 'os_workflow_started', ['installed' => $inst, 'available' => $latest, 'reason' => 'Updating ' . ($steps ? implode(' and then ', $steps) : 'nothing') . ' first, then re-checking the system.']);
  }
  $rep = ['version' => $latest, 'at' => $started, 'result' => 'ok', 'plugins' => null, 'docker' => null, 'health' => null, 'issues' => []];
  $fail = function ($result, $why) use (&$J, &$rep, $latest, $manual, $started, $inst) {
    $J['st']['os']['workflow'] = null;
    $rep['result'] = $result; $rep['issues'][] = $why; $J['st']['os']['last_report'] = $rep;
    if ($result === 'failed' && !$manual) $J['st']['os']['attempted'] = ['version' => $latest, 'result' => 'failed', 'reason' => dau_clip($why, 200), 'at' => dau_now()];
    if ($result === 'failed') dau_stats_record($J['st'], 'os', false, 0);
    $J['events'][] = dau_ev('os', 'Unraid OS', $result === 'aborted' ? 'os_aborted' : 'os_prereq_failed', ['installed' => $inst, 'available' => $latest, 'error' => $result === 'failed' ? $why : '', 'reason' => $result === 'aborted' ? $why : '',
      'detail' => dau_os_report_text($rep), 'next' => 'The Unraid OS update was NOT installed. Fix the problem and start it again from the Unraid OS tab' . ($manual ? '.' : ' (an automatic attempt is made once per version).')]);
    dau_os_wf_history($J, $result, $why, $started);
    dau_log($result === 'failed' ? 'error' : 'warn', 'os', 'Unraid OS', 'prerequisites', $result, $why);
    dau_state_save($J['st']);
    return 'stop';
  };

  if ($wantP) {
    dau_phase('Before the OS update: updating plugins');
    $b = $J['sum']['plugins'];
    dau_job_plugins($J, ['update' => true, 'pre' => $pre['scope']]);
    $a = $J['sum']['plugins'];
    $rep['plugins'] = ['updated' => $a['updated'] - $b['updated'], 'failed' => $a['failed'] - $b['failed'], 'skipped' => $a['skipped'] - $b['skipped']];
    if (dau_stop_requested()) return $fail('aborted', 'Aborted by the user during the plugin updates.');
    if ($rep['plugins']['failed'] > 0 && !empty($pre['require_plugins'])) return $fail('failed', $rep['plugins']['failed'] . ' plugin update(s) failed and successful plugin updates are required.');
  }
  if ($wantD) {
    dau_phase('Before the OS update: updating Docker containers');
    $names = dau_os_pre_containers($cfg);
    $rep['docker'] = ['updated' => 0, 'failed' => 0, 'skipped' => 0, 'selected' => count($names)];
    if ($names) {
      $b = $J['sum']['docker'];
      dau_job_docker($J, ['names' => $names, 'update' => true, 'manual' => true]);
      $a = $J['sum']['docker'];
      $rep['docker'] = ['updated' => $a['updated'] - $b['updated'], 'failed' => $a['failed'] - $b['failed'], 'skipped' => $a['skipped'] - $b['skipped'], 'selected' => count($names)];
    }
    if (dau_stop_requested()) return $fail('aborted', 'Aborted by the user during the Docker updates.');
    if ($rep['docker']['failed'] > 0 && !empty($pre['require_docker'])) return $fail('failed', $rep['docker']['failed'] . ' container update(s) failed and successful Docker updates are required.');
  }
  dau_phase('Before the OS update: checking the system');
  $h = dau_os_health($cfg, $wantD);
  $rep['health'] = $h['ok'] ? 'ok' : 'failed'; $rep['issues'] = $h['issues'];
  if (!$h['ok']) {
    if (dau_stop_requested()) return $fail('aborted', 'Aborted by the user.');
    return $fail('failed', 'System check failed: ' . implode(' ', $h['issues']));
  }
  if ($needConfirm) {
    $os['workflow'] = ['state' => 'awaiting_confirmation', 'version' => $latest, 'started' => dau_now(), 'reboot' => !empty($opt['reboot']), 'manual' => false];
    $rep['result'] = 'waiting'; $os['last_report'] = $rep;
    $J['events'][] = dau_ev('os', 'Unraid OS', 'os_awaiting', ['installed' => $inst, 'available' => $latest, 'detail' => dau_os_report_text($rep), 'next' => 'Open Unraid Swiss Manager > Unraid OS and choose Confirm or Abort. Nothing has been installed.']);
    dau_os_wf_history($J, 'waiting', 'Prerequisites passed; waiting for the confirmation to install ' . $latest . '.', $started);
    dau_log('info', 'os', 'Unraid OS', 'prerequisites', 'waiting', 'waiting for confirmation');
    dau_state_save($J['st']);
    return 'wait';
  }
  $os['workflow'] = null; $os['last_report'] = $rep;
  if (empty($opt['skip_pre'])) {
    $J['events'][] = dau_ev('os', 'Unraid OS', 'os_workflow_done', ['installed' => $inst, 'available' => $latest, 'detail' => dau_os_report_text($rep), 'reason' => 'All required steps passed; installing the OS update now.']);
    dau_os_wf_history($J, 'ok', dau_os_report_text($rep), $started);
  }
  dau_log('info', 'os', 'Unraid OS', 'prerequisites', 'ok', dau_os_report_text($rep));
  dau_state_save($J['st']);
  return 'proceed';
}

/** One readable block: what was updated, skipped or failed. */
function dau_os_report_text(array $r) {
  $line = function ($label, $x) { return $x === null ? "$label: not part of this workflow" : "$label: " . (int)$x['updated'] . ' updated, ' . (int)$x['failed'] . ' failed, ' . (int)$x['skipped'] . ' skipped'; };
  $t = $line('Plugins', $r['plugins']) . "\n" . $line('Docker', $r['docker']);
  if ($r['health'] !== null) $t .= "\nSystem check: " . $r['health'];
  if (!empty($r['issues'])) $t .= "\nIssues: " . implode(' ', $r['issues']);
  return $t;
}
]]></INLINE>
