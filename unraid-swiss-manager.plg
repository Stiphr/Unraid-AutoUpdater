    q.rows.forEach(function (e) {
      var st = !e.exists ? ['bad', 'missing'] : !e.known_root ? ['warn', 'appdata folder not set up'] : e.free ? ['ok', 'can be restored'] : ['warn', 'original place is taken'];
      var btns = h('td', { class: 'acts' });
