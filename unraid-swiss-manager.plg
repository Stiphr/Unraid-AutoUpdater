<FILE Name="&emhttp;/include/discord.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - Discord webhook notifications.
 *  - The URL is read from secrets.json only at send time; it is never logged, never returned by the API and is
 *    scrubbed from every message by dau_redact().
 *  - Only https://discord.com/api/webhooks/... style URLs are ever contacted (see dau_webhook_valid()).
 *  - Certificates are always verified. There is no option to turn that off.
 */

/* Default avatar: an original icon (orange glyph on grey) published in this repository. Replace it in Settings with any https image. */
const DAU_DEFAULT_ICON = 'https://raw.githubusercontent.com/Stiphr/Unraid-Swiss-Manager/main/assets/icon.png';
const DAU_DISCORD_EMBEDS_PER_MSG = 10;
const DAU_DISCORD_CHARS_PER_MSG  = 5600;   // hard limit is 6000 characters across all embeds of a message

function dau_type_label($t) {
  return ['docker' => 'Docker container', 'plugin' => 'Unraid plugin', 'os' => 'Unraid OS', 'cleanup' => 'Cleanup', 'backup' => 'Backup'][$t] ?? $t;
}

/* ---------- transport ---------- */

/** POST JSON. Returns ['code'=>int(0 on network error),'headers'=>[lowercase=>value],'body'=>string,'error'=>string]. */
function dau_http_post($url, $body, $timeout = 10) {
  if (isset($GLOBALS['DAU_HTTP_MOCK']) && is_callable($GLOBALS['DAU_HTTP_MOCK'])) {
    $r = call_user_func($GLOBALS['DAU_HTTP_MOCK'], $url, $body);
    return $r + ['code' => 0, 'headers' => [], 'body' => '', 'error' => ''];
  }
  $res = ['code' => 0, 'headers' => [], 'body' => '', 'error' => ''];
  $ca = is_file('/etc/ssl/certs/ca-certificates.crt') ? '/etc/ssl/certs/ca-certificates.crt' : null;
  $ua = 'UnraidSwissManager/' . DAU_VERSION;
  if (function_exists('curl_init')) {
    $ch = curl_init($url);
    $opts = [
      CURLOPT_POST => true, CURLOPT_POSTFIELDS => $body, CURLOPT_RETURNTRANSFER => true,
      CURLOPT_HTTPHEADER => ['Content-Type: application/json', 'User-Agent: ' . $ua],
      CURLOPT_TIMEOUT => $timeout, CURLOPT_CONNECTTIMEOUT => 5,
      CURLOPT_SSL_VERIFYPEER => true, CURLOPT_SSL_VERIFYHOST => 2, CURLOPT_FOLLOWLOCATION => false,
      CURLOPT_HEADERFUNCTION => function ($c, $h) use (&$res) {
        $p = explode(':', $h, 2);
        if (count($p) === 2) $res['headers'][strtolower(trim($p[0]))] = trim($p[1]);
        return strlen($h);
      },
    ];
    if (defined('CURLOPT_PROTOCOLS') && defined('CURLPROTO_HTTPS')) $opts[CURLOPT_PROTOCOLS] = CURLPROTO_HTTPS;
    if ($ca) $opts[CURLOPT_CAINFO] = $ca;
    curl_setopt_array($ch, $opts);
    $out = curl_exec($ch);
    $res['code'] = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    if ($out === false) $res['error'] = curl_error($ch); else $res['body'] = (string)$out;
    curl_close($ch);
    return $res;
  }
  $ssl = ['verify_peer' => true, 'verify_peer_name' => true];
  if ($ca) $ssl['cafile'] = $ca;
  $ctx = stream_context_create(['http' => ['method' => 'POST', 'timeout' => $timeout, 'ignore_errors' => true, 'follow_location' => 0,
      'header' => "Content-Type: application/json\r\nUser-Agent: $ua\r\n", 'content' => $body], 'ssl' => $ssl]);
  $out = @file_get_contents($url, false, $ctx);
  foreach (($http_response_header ?? []) as $h) {
    if (preg_match('#^HTTP/\S+\s+(\d{3})#', $h, $m)) $res['code'] = (int)$m[1];
    elseif (strpos($h, ':') !== false) { $p = explode(':', $h, 2); $res['headers'][strtolower(trim($p[0]))] = trim($p[1]); }
  }
  if ($out === false && !$res['code']) $res['error'] = 'connection failed'; else $res['body'] = (string)$out;
  return $res;
}

/**
 * Send one webhook payload with bounded retries.
 * 429 -> wait the server-provided time (max 30 s) and retry; 5xx/network -> short backoff; other 4xx -> permanent.
 * Returns ['ok'=>bool,'code'=>int,'error'=>string,'permanent'=>bool].
 */
function dau_discord_post($url, array $payload) {
  $body = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR);
  $backoff = [2, 5];
  $r = ['ok' => false, 'code' => 0, 'error' => 'not sent', 'permanent' => false];
  for ($try = 0; $try < 4; $try++) {
    $h = dau_http_post($url, $body);
    $code = (int)$h['code'];
    if ($code >= 200 && $code < 300) return ['ok' => true, 'code' => $code, 'error' => '', 'permanent' => false];
    if ($code === 429) {
      $j = json_decode((string)$h['body'], true);
      $wait = is_array($j) && isset($j['retry_after']) ? (float)$j['retry_after'] : (float)($h['headers']['retry-after'] ?? 2);
      $r = ['ok' => false, 'code' => 429, 'error' => 'rate limited by Discord', 'permanent' => false];
      if ($wait > 30 || $try >= 3) break;                 // do not stall a job for long; give up and log
      dau_sleep(max(0.5, $wait) + 0.2);
      continue;
    }
    if ($code === 0 || $code >= 500) {
      $r = ['ok' => false, 'code' => $code, 'error' => $code ? "Discord server error $code" : ('network error' . ($h['error'] !== '' ? ': ' . $h['error'] : '')), 'permanent' => false];
      if ($try < count($backoff)) { dau_sleep($backoff[$try]); continue; }
      break;
    }
    $j = json_decode((string)$h['body'], true);
    $detail = is_array($j) && isset($j['message']) ? ': ' . $j['message'] : '';
    $perm = in_array($code, [401, 403, 404], true);
    return ['ok' => false, 'code' => $code, 'permanent' => $perm,
            'error' => ($perm ? 'webhook rejected (' . $code . ')' : 'Discord refused the message (' . $code . ')') . dau_clip(dau_redact($detail), 160)];
  }
  return $r;
}

/* ---------- embeds ---------- */

function dau_embed_size(array $e) {
  $n = strlen($e['title'] ?? '') + strlen($e['description'] ?? '') + strlen($e['footer']['text'] ?? '') + strlen($e['author']['name'] ?? '');
  foreach (($e['fields'] ?? []) as $f) $n += strlen($f['name']) + strlen($f['value']);
  return $n;
}

function dau_field($name, $value, $inline = true) {
  $value = trim((string)$value);
  return ['name' => dau_clip($name, 256), 'value' => dau_clip($value === '' ? '-' : $value, 1024), 'inline' => $inline];
}

function dau_clean_text($s, $max) { return dau_clip(dau_redact((string)$s), $max); }

/** Icon used for the webhook avatar and the embed header: the configured https URL, else the bundled default. */
function dau_discord_icon(?array $cfg = null) {
  $u = $cfg['discord']['icon_url'] ?? '';
  return dau_icon_url_valid($u) ? $u : DAU_DEFAULT_ICON;
}

/** Brand fields shared by every embed (author line with the icon, footer with the version). */
function dau_discord_brand(array $e, $extraFooter = '') {
  $icon = $GLOBALS['DAU_ICON'] ?? DAU_DEFAULT_ICON;
  $e['author'] = ['name' => DAU_NAME, 'icon_url' => $icon];
  $e['footer'] = ['text' => DAU_NAME . ' ' . DAU_VERSION . $extraFooter, 'icon_url' => $icon];
  return $e;
}

/** Embed for one event. Never includes secrets (values pass through dau_redact). */
function dau_discord_event_embed(array $ev, $server) {
  $kind = $ev['kind'];
  $style = [
    'available'       => ['🔔', 'Update available', 0xF1C40F],
    'updated'         => ['✅', 'Update successful', 0x2ECC71],
    'failed'          => ['❌', 'Update failed', 0xE74C3C],
    'retrying'        => ['🔁', 'Retry scheduled', 0xE67E22],
    'retry_exhausted' => ['❌', 'Retries exhausted', 0xE74C3C],
    'blocked'         => ['⚠️', 'Update not installed', 0xE67E22],
    'skipped'         => ['⚠️', 'Update skipped', 0xE67E22],
    'os_withdrawn'    => ['ℹ️', 'OS update no longer offered', 0x3498DB],
    'os_check_failed' => ['⚠️', 'OS update check failed', 0xE67E22],
    'os_installed'    => ['✅', 'Unraid OS updated', 0x2ECC71],
    'os_staged'       => ['📦', 'OS update installed, reboot needed', 0xF1C40F],
    'os_rebooting'    => ['🔄', 'Rebooting to finish the OS update', 0xE67E22],
    'os_reboot_blocked' => ['⚠️', 'Reboot postponed', 0xE67E22],
    'os_install_failed' => ['❌', 'OS update failed', 0xE74C3C],
    'os_workflow_started' => ['🧰', 'Pre-OS maintenance started', 0x3498DB],
    'os_workflow_done' => ['✅', 'Pre-OS checks passed', 0x2ECC71],
    'os_awaiting'     => ['⏸️', 'OS update waiting for your confirmation', 0xF1C40F],
    'os_prereq_failed' => ['❌', 'OS update stopped: a prerequisite failed', 0xE74C3C],
    'os_aborted'      => ['⏹️', 'OS update aborted', 0xE67E22],
    'os_verified'     => ['✅', 'OS update verified after reboot', 0x2ECC71],
    'os_unverified'   => ['❌', 'OS update not active after reboot', 0xE74C3C],
    'backup_done'     => ['💾', 'Backup completed', 0x2ECC71],
    'backup_failed'   => ['❌', 'Backup FAILED', 0xE74C3C],
    'cleanup_report'  => ['🧹', 'Cleanup: things you can free', 0x3498DB],
    'major_jump'      => ['🛑', 'Major version update held back', 0xE67E22],
    'rolled_back'     => ['⏪', 'Rolled back to the earlier image', 0xE67E22],
    'rollback_failed' => ['❌', 'Rollback failed', 0xE74C3C],
  ][$kind] ?? ['ℹ️', $kind, 0x95A5A6];
  $name = dau_clean_text($ev['name'] ?? '', 120);
  $f = [dau_field('Server', $server), dau_field('Component', dau_type_label($ev['type']))];
  if (!in_array($ev['type'], ['cleanup', 'backup'], true)) $f[] = dau_field(ucfirst($ev['type'] === 'os' ? 'System' : $ev['type']), $name);
  if (isset($ev['installed']) && $ev['installed'] !== '') $f[] = dau_field(in_array($kind, ['updated', 'os_installed', 'os_verified', 'os_staged', 'os_rebooting'], true) ? 'Previous' : 'Installed', dau_clean_text($ev['installed'], 200));
  if (isset($ev['available']) && $ev['available'] !== '') $f[] = dau_field(in_array($kind, ['updated', 'os_installed', 'os_verified', 'os_staged', 'os_rebooting'], true) ? 'New' : 'Available', dau_clean_text($ev['available'], 200));
  if (isset($ev['duration'])) $f[] = dau_field('Duration', dau_duration_text($ev['duration']));
  if (!empty($ev['versions'])) $f[] = dau_field('Version', dau_clean_text($ev['versions'], 120));
  if (!empty($ev['notes'])) $f[] = dau_field('What changed', "```\n" . str_replace('```', "'''", dau_clean_text($ev['notes'], 600)) . "\n```", false);
  if (!empty($ev['verification'])) $f[] = dau_field('Verification', dau_clean_text($ev['verification'], 300), false);
  if (!empty($ev['stage'])) $f[] = dau_field('Failed at', dau_clean_text($ev['stage'], 100));
  if (!empty($ev['reason'])) $f[] = dau_field($kind === 'available' ? 'Pending because' : 'Reason', dau_clean_text($ev['reason'], 500), false);
  if (!empty($ev['detail'])) $f[] = dau_field('Components', "```\n" . str_replace('```', "'''", dau_clean_text($ev['detail'], 700)) . "\n```", false);
  if (!empty($ev['error'])) $f[] = dau_field('Error', "```\n" . str_replace('```', "'''", dau_clean_text($ev['error'], 700)) . "\n```", false);
  if (!empty($ev['retry'])) $f[] = dau_field('Retry', dau_clean_text($ev['retry'], 200), false);
  if (!empty($ev['log'])) $f[] = dau_field('Log', "```\n" . str_replace('```', "'''", dau_clean_text($ev['log'], 600)) . "\n```", false);
  if (!empty($ev['next'])) $f[] = dau_field('Suggested next steps', dau_clean_text($ev['next'], 500), false);
  $links = dau_action_links($GLOBALS['DAU_CFG_NOW'] ?? dau_load_config(), $ev);
  if ($links !== '') $f[] = dau_field('Actions', $links, false);
  return dau_discord_brand([
    'title' => dau_clip($style[0] . ' ' . $style[1] . ' — ' . $name, 256),
    'color' => $style[2],
    'fields' => array_slice($f, 0, 25),
    'timestamp' => dau_ts_iso($ev['ts'] ?? dau_now()),
  ]);
}

function dau_duration_text($s) {
  $s = (int)$s;
  if ($s < 60) return $s . ' s';
  return floor($s / 60) . ' min ' . ($s % 60) . ' s';
}

/** Combined run summary, modelled on the example in the requirements. */
function dau_discord_summary_embed(array $sum, $server) {
  $lines = [];
  $row = function ($label, $a) {
    $parts = [];
    foreach (['updated' => 'Updated', 'failed' => 'Failed', 'skipped' => 'Skipped', 'available' => 'Update available'] as $k => $t) {
      if (!empty($a[$k]) || $k !== 'available') $parts[] = "$t: " . (int)($a[$k] ?? 0);
    }
    return "**$label**\n" . implode("\n", array_map(function ($p) { return '- ' . $p; }, $parts));
  };
  if (isset($sum['docker'])) $lines[] = $row('Docker', $sum['docker']);
  if (isset($sum['plugins'])) $lines[] = $row('Unraid Plugins', $sum['plugins']);
  if (isset($sum['os'])) {
    $o = $sum['os'];
    $lines[] = "**Unraid OS**\n- Update available: " . (($o['available'] ?? null) === null ? 'Unknown' : ($o['available'] ? 'Yes' . (!empty($o['version']) ? ' (' . dau_clean_text($o['version'], 40) . ')' : '') : 'No'))
             . "\n- Installed automatically: " . (!empty($o['installed']) ? 'Yes' : 'No');
  }
  $status = $sum['status'] ?? 'ok';
  $text = ['ok' => 'Completed', 'warnings' => 'Completed with warnings', 'failed' => 'Completed with failures'][$status] ?? 'Completed';
  $color = ['ok' => 0x2ECC71, 'warnings' => 0xF1C40F, 'failed' => 0xE74C3C][$status] ?? 0x3498DB;
  $lines[] = '**Status:** ' . $text;
  return dau_discord_brand([
    'title' => 'UNRAID AUTOUPDATER — UPDATE SUMMARY',
    'description' => dau_clip("**Server:** " . dau_clean_text($server, 64) . "\n\n" . implode("\n\n", $lines), 4000),
    'color' => $color,
    'timestamp' => dau_ts_iso(dau_now()),
  ], !empty($sum['trigger']) ? ' · ' . $sum['trigger'] . ' run' : '');
}

/** Split embeds into messages that respect Discord's limits (10 embeds, ~6000 characters). */
function dau_discord_chunk(array $embeds, $separate = false) {
  $msgs = []; $cur = []; $size = 0;
  foreach ($embeds as $e) {
    $s = dau_embed_size($e);
    if ($cur && ($separate || count($cur) >= DAU_DISCORD_EMBEDS_PER_MSG || $size + $s > DAU_DISCORD_CHARS_PER_MSG)) { $msgs[] = $cur; $cur = []; $size = 0; }
    $cur[] = $e; $size += $s;
  }
  if ($cur) $msgs[] = $cur;
  return $msgs;
}

/* ---------- which events go to Discord ---------- */

function dau_event_toggle($kind) {
  switch ($kind) {
    case 'updated': case 'os_installed': case 'os_verified': case 'rolled_back': return 'success';
    case 'failed': case 'os_prereq_failed': case 'retry_exhausted': case 'os_check_failed': case 'retrying': case 'os_install_failed': case 'os_unverified': case 'rollback_failed': return 'failed';
    default: return 'available';          // available, blocked, skipped, os_withdrawn
  }
}

function dau_discord_wants(array $dc, array $ev) {
  if (empty($dc['enabled']) || !empty($ev['silent'])) return false;
  $cat = ['docker' => 'docker', 'plugin' => 'plugins', 'os' => 'os', 'cleanup' => 'docker', 'backup' => 'docker'][$ev['type']] ?? null;
  if (!$cat || empty($dc['events'][$cat])) return false;
  if (in_array($ev['kind'], ['os_staged', 'os_rebooting', 'os_reboot_blocked', 'os_workflow_started', 'os_workflow_done', 'os_awaiting', 'os_aborted'], true)) return true;   // a pending reboot must never be missed
  return !empty($dc['types'][dau_event_toggle($ev['kind'])]);
}

function dau_summary_has_activity(array $sum) {
  foreach (['docker', 'plugins'] as $k) if (isset($sum[$k])) foreach ($sum[$k] as $n) if ((int)$n > 0) return true;
  if (isset($sum['os']) && (($sum['os']['available'] ?? false) === true)) return true;
  return false;
}

/**
 * Send notifications for one run. Never throws, never makes a job fail.
 * Returns ['messages'=>n sent,'error'=>string]. Updates state['discord'] (not saved here).
 */
function dau_discord_dispatch(array $cfg, array &$st, array $events, array $summary) {
  $dc = $cfg['discord'];
  $out = ['messages' => 0, 'error' => ''];
  if (empty($dc['enabled'])) return $out;
  $url = dau_secret_get('discord_url');
  if (!dau_webhook_valid($url)) { $out['error'] = 'no valid webhook URL saved'; return $out; }
  if (!empty($st['discord']['invalid'])) { $out['error'] = 'webhook was rejected earlier; save the URL again to retry'; return $out; }
  $server = dau_server_name();
  $GLOBALS['DAU_ICON'] = dau_discord_icon($cfg);
  $GLOBALS['DAU_CFG_NOW'] = $cfg;

  $embeds = [];
  if (!empty($dc['types']['summary']) && dau_summary_has_activity($summary)) $embeds[] = dau_discord_summary_embed($summary, $server);
  $prio = ['rollback_failed' => 0, 'major_jump' => 2, 'failed' => 0, 'os_prereq_failed' => 0, 'retry_exhausted' => 0, 'os_install_failed' => 0, 'os_unverified' => 0, 'os_check_failed' => 1, 'retrying' => 1, 'blocked' => 2, 'skipped' => 2, 'available' => 3];
  $wanted = array_values(array_filter($events, function ($e) use ($dc) { return dau_discord_wants($dc, $e); }));
  /* failures first; array_multisort with the original index keeps the order stable on PHP 7.4 */
  $keys = []; $idx = [];
  foreach ($wanted as $i => $e) { $keys[] = $prio[$e['kind']] ?? 4; $idx[] = $i; }
  array_multisort($keys, SORT_ASC, $idx, SORT_ASC, $wanted);
  foreach ($wanted as $e) $embeds[] = dau_discord_event_embed($e, $server);
  if (!$embeds) return $out;

  $msgs = dau_discord_chunk($embeds, ($dc['batching'] ?? 'combine') === 'separate');
  $max = max(1, (int)$dc['max_messages']);
  $dropped = 0;
  if (count($msgs) > $max) { foreach (array_slice($msgs, $max) as $m) $dropped += count($m); $msgs = array_slice($msgs, 0, $max); }

  foreach ($msgs as $i => $m) {
    $payload = ['username' => DAU_NAME, 'avatar_url' => $GLOBALS['DAU_ICON'], 'embeds' => $m, 'allowed_mentions' => ['parse' => []]];
    if ($dropped && $i === count($msgs) - 1) $payload['content'] = "+$dropped more notification(s) were not sent to stay under the message limit. See the plugin log.";
    $r = dau_discord_post($url, $payload);
    $st['discord']['last_attempt'] = dau_now();
    if ($r['ok']) { $out['messages']++; $st['discord']['last_ok'] = dau_now(); $st['discord']['last_error'] = ''; if ($i < count($msgs) - 1) dau_sleep(0.6); continue; }
    $out['error'] = $r['error'];
    $st['discord']['last_error'] = $r['error'];
    if ($r['permanent']) $st['discord']['invalid'] = true;
    dau_log('warn', 'discord', '-', 'send', 'fail', $r['error']);
    break;
  }
  if ($out['messages']) dau_log('info', 'discord', '-', 'send', 'ok', $out['messages'] . ' message(s)' . ($dropped ? ", $dropped dropped (limit)" : ''));
  return $out;
}

/** "Send test message" button. */
function dau_discord_test(array &$st, $urlOverride = null) {
  $url = $urlOverride !== null && $urlOverride !== '' ? $urlOverride : dau_secret_get('discord_url');
  if (!dau_webhook_valid($url)) return ['ok' => false, 'error' => 'That is not a valid Discord webhook URL (https://discord.com/api/webhooks/<id>/<token>).'];
  $server = dau_server_name();
  $e = ['title' => '🧪 Test message', 'color' => 0x3498DB, 'description' => "Webhook is working for **" . dau_clean_text($server, 64) . "**.\nNo update was installed.",
        'timestamp' => dau_ts_iso(dau_now())];
  $GLOBALS['DAU_ICON'] = dau_discord_icon(dau_load_config());
  $e = dau_discord_brand($e);
  $r = dau_discord_post($url, ['username' => DAU_NAME, 'avatar_url' => $GLOBALS['DAU_ICON'], 'embeds' => [$e], 'allowed_mentions' => ['parse' => []]]);
  $st['discord']['last_attempt'] = dau_now();
  if ($r['ok']) { $st['discord']['last_ok'] = dau_now(); $st['discord']['last_error'] = ''; $st['discord']['invalid'] = false; return ['ok' => true, 'error' => '']; }
  $st['discord']['last_error'] = $r['error'];
  if ($r['permanent']) $st['discord']['invalid'] = true;
  return ['ok' => false, 'error' => $r['error']];
}
]]></INLINE>
<SHA256>90d5fd4dd28c59e3c83c5b40bbf855522b394219dfc958408c2234d078def2d3</SHA256>
</FILE>

<FILE Name="&emhttp;/include/backup.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - optional pre-update backups.
 * Three DIFFERENT things, never conflated:
 *   config  = the container's Unraid template (my-NAME.xml) + `docker inspect` JSON. Small, enough to recreate the container.
 *   image   = `docker save` of the image currently in use (lets you go back to the exact old version offline). Large.
 *   appdata = tar of the container's bind-mounted host paths under /mnt. NOT application-consistent: the container
 *             is not stopped for it, so databases may be captured mid-write. Use a proper backup plugin for those.
 * The flash drive is FAT: file permissions cannot be enforced there, which is why no secrets are ever put in a backup.
 */

function dau_backup_dir_for($dest, $name) { return rtrim($dest, '/') . '/' . $name; }

function dau_backup_free($dest) { $f = @disk_free_space($dest); return $f === false ? null : (float)$f; }

/** @return array ['ok'=>bool,'error'=>string,'files'=>[],'kinds'=>[...],'skipped'=>[reason,...]] */
function dau_backup_run(array $cfg, $name, array $inspect) {
  $b = $cfg['global']['backup'];
  $res = ['ok' => false, 'error' => '', 'files' => [], 'kinds' => [], 'skipped' => []];
  if (!dau_valid_name($name)) { $res['error'] = 'invalid container name'; return $res; }
  if (!dau_valid_dest($b['dest'] ?? '')) { $res['error'] = 'backup destination is not set to a valid path under /mnt'; return $res; }
  $dir = dau_backup_dir_for($b['dest'], $name);
  if (!is_dir($dir) && !@mkdir($dir, 0700, true)) { $res['error'] = "cannot create $dir"; return $res; }
  $stamp = date('Ymd-His', dau_now());
  $free = dau_backup_free($dir);

  $need = function ($bytes, $what) use ($free, &$res) {
    if ($free !== null && $bytes * 1.2 > $free) { $res['skipped'][] = "$what: not enough free space at the destination"; return false; }
    return true;
  };

  if (!empty($b['config'])) {
    $f = "$dir/$stamp-config.json";
    $tpl = DAU_TEMPLATES . "/my-$name.xml";
    $payload = ['container' => $name, 'time' => dau_ts_iso(dau_now()), 'template_xml' => is_file($tpl) ? (string)@file_get_contents($tpl) : null, 'inspect' => $inspect];
    // environment variables can hold passwords: strip values from the inspect copy; the template keeps what the user configured
    if (isset($payload['inspect']['Config']['Env'])) $payload['inspect']['Config']['Env'] = array_map(function ($e) { return preg_replace('/=.*/s', '=<omitted>', $e); }, $payload['inspect']['Config']['Env']);
    if (dau_write_json($f, $payload, true)) { $res['files'][] = $f; $res['kinds'][] = 'config'; } else $res['skipped'][] = 'config: write failed';
  }
  if (!empty($b['image'])) {
    $img = (string)($inspect['Image'] ?? '');
    $r = dau_docker(['image', 'inspect', '--format', '{{.Size}}', $img], 30);
    $size = (float)trim($r['out']);
    if ($need($size, 'image') && $img !== '') {
      $f = "$dir/$stamp-image.tar";
      $tmp = "$dir/.$stamp-image.tar.partial";
      $s = dau_docker(['save', '-o', $tmp, $img], 1800);
      if ($s['code'] === 0 && !$s['timeout'] && is_file($tmp) && @rename($tmp, $f)) { $res['files'][] = $f; $res['kinds'][] = 'image'; }
      else { @unlink($tmp); $res['skipped'][] = 'image: docker save failed'; }
    }
  }
  if (!empty($b['appdata'])) {
    $paths = [];
    foreach (($inspect['Mounts'] ?? []) as $m) {
      $src = (string)($m['Source'] ?? '');
      if (($m['Type'] ?? '') === 'bind' && preg_match('#^/mnt/[^\x00-\x1F]+$#', $src) && !dau_has($src, '..') && strpos($src . '/', rtrim($b['dest'], '/') . '/') !== 0 && is_dir($src)) $paths[] = $src;
    }
    if (!$paths) $res['skipped'][] = 'appdata: this container has no host folders under /mnt';
    else {
      $size = 0.0;
      foreach ($paths as $p) { $r = dau_run([dau_bin('du'), '-sb', $p], 600); $size += (float)preg_replace('/\s.*/s', '', trim($r['out'])); }
      if ($need($size, 'appdata')) {
        $f = "$dir/$stamp-appdata.tar.gz"; $tmp = "$dir/.$stamp-appdata.tar.gz.partial";   // renamed only when complete: an interrupted tar never looks like a backup
        $t = dau_run(array_merge([dau_bin('tar'), '-czf', $tmp, '--'], $paths), 3600);
        if (($t['code'] === 0 || $t['code'] === 1) && !$t['timeout'] && is_file($tmp) && @rename($tmp, $f)) { $res['files'][] = $f; $res['kinds'][] = 'appdata'; }   // 1 = files changed while reading (expected, container is running)
        else { @unlink($tmp); $res['skipped'][] = 'appdata: tar failed'; }
      }
    }
  }
  $wanted = array_filter([!empty($b['config']) ? 'config' : null, !empty($b['image']) ? 'image' : null, !empty($b['appdata']) ? 'appdata' : null]);
  $missing = array_diff($wanted, $res['kinds']);
  $res['ok'] = !$missing && $res['kinds'];
  if ($res['ok']) dau_backup_prune($dir, (int)$b['retention']);   // only a complete new set may push an older one out
  if (!$res['ok']) $res['error'] = $res['skipped'] ? implode('; ', $res['skipped']) : 'no backup type selected';
  return $res;
}

/** Keep the newest $keep backup sets (a set = all files sharing one timestamp prefix). */
function dau_backup_prune($dir, $keep) {
  if ($keep < 1) return;
  $sets = [];
  foreach (glob($dir . '/*') ?: [] as $f) if (preg_match('#/(\d{8}-\d{6})-(config\.json|image\.tar|appdata\.tar\.gz)$#', $f, $m)) $sets[$m[1]][] = $f;
  krsort($sets);
  foreach (array_slice($sets, $keep, null, true) as $files) foreach ($files as $f) @unlink($f);
}
]]></INLINE>
<SHA256>6fe859282d1655a1b08ee0f2c599b19b4467c03fb0de6edde010e157aef12974</SHA256>
</FILE>

<FILE Name="&emhttp;/include/backups.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - scheduled backups of the appdata folders and of the boot drive (flash).
 * One archive per run: <destination>/Unraid-Swiss-Manager/<appdata|flash>/<kind>-YYYYmmdd-HHMMSS.tar.gz.
 *  - An archive is written under a temporary name and renamed only when it is complete, so a half-written file is never
 *    mistaken for a backup. Old archives are removed only AFTER the new one succeeded, and the newest is never removed.
 *  - Appdata is NOT application-consistent unless "stop_containers" is on: then the running containers that use the appdata folders
 *    are stopped (dependants first) for the archive and started again afterwards (dependencies first), also when the archive fails.
 *  - The archives hold your own data and keys, so they are created private (0600). Keep them off the flash drive.
 * Separate from backup.php, which keeps small per-container safety copies right before a container update.
 */

const DAU_BK_KINDS = ['appdata', 'flash'];

function dau_bk_label($kind) { return $kind === 'flash' ? 'Boot drive (flash)' : 'Appdata'; }

function dau_bk_spec() {
  $one = ['schedule' => ['enum', ['off', 'weekly', 'monthly']], 'weekday' => ['int', 0, 6], 'monthday' => ['int', 1, 28], 'time' => ['time'],
          'dest' => ['path'], 'keep' => ['int', 1, 3]];
  return ['appdata' => ['obj', $one + ['before_update' => ['bool'], 'required' => ['bool'], 'stop_containers' => ['bool'], 'exclude' => ['folders']]], 'flash' => ['obj', $one]];
}

function dau_bk_defaults() {
  $one = ['schedule' => 'off', 'weekday' => 0, 'monthday' => 1, 'dest' => '', 'keep' => 2];
  return ['appdata' => $one + ['time' => '03:00', 'before_update' => false, 'required' => false, 'stop_containers' => false, 'exclude' => []], 'flash' => $one + ['time' => '03:30']];
}

/** Running containers that map something inside the appdata folders, in the order they should be started again ("update after" first). */
function dau_bk_users(array $cfg, array $srcs) {
  $m = dau_appdata_mounts(); if (!$m) return [];
  $todo = [];
  foreach ($m as $c) {
    if ($c['state'] !== 'running' || !dau_valid_name($c['name'])) continue;
    foreach ($c['sources'] as $s) {
      $sr = @realpath($s) ?: $s; $hit = false;
      foreach ($srcs as $root) { $rr = @realpath($root) ?: $root; if (dau_path_in($sr, $rr) || dau_path_in(dau_path_tail($sr), dau_path_tail($rr))) { $hit = true; break; } }
      if ($hit) { $todo[] = [['name' => $c['name']]]; break; }
    }
  }
  return array_map(function ($t) { return $t[0]['name']; }, dau_docker_order($todo, $cfg));
}

/** Stop these containers (dependants first). Returns the ones that were stopped; stops early and reports when one refuses. */
function dau_bk_stop(array $names, array &$res) {
  $stopped = [];
  foreach (array_reverse($names) as $n) {
    dau_phase('Stopping ' . $n . ' for the backup', ['current' => $n]);
    $r = dau_docker(['stop', '-t', '60', $n], 120);
    if ($r['code'] !== 0 || $r['timeout']) { $res['error'] = $n . ' could not be stopped, so the backup was not made.'; break; }
    $stopped[] = $n;
  }
  return $stopped;
}

/** Start them again in dependency order. Never throws; each failure is reported. */
function dau_bk_start(array $stopped, array &$res) {
  $failed = [];
  foreach (array_reverse($stopped) as $n) {
    dau_phase('Starting ' . $n . ' again', ['current' => $n]);
    $r = dau_docker(['start', $n], 120);
    if ($r['code'] !== 0 || $r['timeout']) $failed[] = $n;
  }
  if ($failed) {
    $res['restart_failed'] = $failed;
    $msg = 'These containers did not start again after the backup: ' . implode(', ', $failed) . '. Start them on the Docker tab.';
    $res['error'] = $res['error'] !== '' ? $res['error'] . ' ' . $msg : $msg;
  }
}

/** Folders that will be archived: the appdata roots that exist (flash is always /boot). */
function dau_bk_sources($kind, array $cfg) {
  if ($kind === 'flash') return is_dir('/boot') ? ['/boot'] : [];
  $o = [];
  foreach ((array)($cfg['appdata']['roots'] ?? []) as $r) { $r = rtrim((string)$r, '/'); if ($r !== '' && dau_valid_dest($r) && is_dir($r) && !in_array($r, $o, true)) $o[] = $r; }
  return $o;
}

function dau_bk_dir($kind, $dest) { return rtrim($dest, '/') . '/Unraid-Swiss-Manager/' . $kind; }

/** Empty string = destination is usable, otherwise a sentence that says why not. */
function dau_bk_check_dest($kind, array $cfg) {
  $b = $cfg['backups'][$kind] ?? null; if (!$b) return 'Unknown backup type.';
  $d = rtrim((string)$b['dest'], '/');
  if ($d === '') return 'Choose where the backups go.';
  if (!dau_valid_dest($d)) return 'The destination must be a folder under /mnt, for example /mnt/user/backups.';
  if (!is_dir($d) && !is_dir(dirname($d))) return 'The destination folder (' . dirname($d) . ') does not exist. Is the disk or share mounted?';
  $real = is_dir($d) ? (realpath($d) ?: $d) : $d;
  foreach (dau_bk_sources($kind, $cfg) as $s) {
    $rs = realpath($s) ?: $s;
    if ($real === $rs || strpos($real . '/', rtrim($rs, '/') . '/') === 0) return 'The destination is inside the folder that is backed up (' . $s . '). Choose a folder outside it.';
  }
  if (!dau_bk_sources($kind, $cfg)) return $kind === 'flash' ? 'The boot drive (/boot) was not found.' : 'No appdata folder was found. Check Settings > Cleanup > appdata folders.';
  return '';
}

/** Existing archives of this kind, newest first. */
function dau_bk_list($kind, $dest) {
  $out = [];
  if (!is_string($dest) || !dau_valid_dest($dest)) return $out;
  foreach (glob(dau_bk_dir($kind, $dest) . '/' . $kind . '-*.tar.gz') ?: [] as $f) {
    if (!preg_match('#/' . $kind . '-(\d{8})-(\d{6})\.tar\.gz$#', $f, $m)) continue;
    $t = DateTime::createFromFormat('Ymd-His', $m[1] . '-' . $m[2], new DateTimeZone(date_default_timezone_get()));
    $out[] = ['file' => $f, 'name' => basename($f), 'size' => (int)@filesize($f), 'ts' => $t ? $t->getTimestamp() : (int)@filemtime($f)];
  }
  usort($out, function ($a, $b) { return $b['ts'] <=> $a['ts'] ?: strcmp($b['name'], $a['name']); });
  return $out;
}

/** Keep the newest $keep archives (at least 1: the fresh copy is never removed). Returns how many were removed. */
function dau_bk_prune($kind, $dest, $keep) {
  $keep = max(1, (int)$keep); $n = 0;
  foreach (array_slice(dau_bk_list($kind, $dest), $keep) as $e) if (@unlink($e['file'])) $n++;
  foreach (glob(dau_bk_dir($kind, $dest) . '/.' . $kind . '-*.partial') ?: [] as $p) if (@filemtime($p) < dau_now() - 86400) @unlink($p);   // leftovers of an interrupted run
  return $n;
}

/**
 * Make one backup now.
 * @return array ['ok','error','file','size','pruned','kept','seconds','skipped'=>[...]]
 */
function dau_bk_run($kind, array $cfg) {
  $res = ['ok' => false, 'error' => '', 'file' => '', 'size' => 0, 'pruned' => 0, 'kept' => 0, 'seconds' => 0, 'notes' => []];
  if (!in_array($kind, DAU_BK_KINDS, true)) { $res['error'] = 'Unknown backup type.'; return $res; }
  $b = $cfg['backups'][$kind];
  $why = dau_bk_check_dest($kind, $cfg); if ($why !== '') { $res['error'] = $why; return $res; }
  $t0 = dau_now(); $srcs = dau_bk_sources($kind, $cfg); $dir = dau_bk_dir($kind, $b['dest']);
  if (!is_dir($dir) && !@mkdir($dir, 0700, true)) { $res['error'] = 'Cannot create ' . $dir . '.'; return $res; }
  /* enough room? (the archive is compressed, so this is a safe upper bound; old archives are only removed afterwards) */
  $size = 0.0;
  foreach ($srcs as $s) { $r = dau_run([dau_bin('du'), '-sb', $s], 900); $size += (float)preg_replace('/\s.*/s', '', trim($r['out'])); }
  $free = dau_backup_free($dir);
  if ($free !== null && $size > 0 && $size > $free) { $res['error'] = 'Not enough free space at the destination: about ' . dau_bytes_text($size) . ' to back up, ' . dau_bytes_text($free) . ' free. Nothing was changed.'; return $res; }
  $stamp = date('Ymd-His', $t0);
  $final = "$dir/$kind-$stamp.tar.gz"; $tmp = "$dir/.$kind-$stamp.tar.gz.partial";
  $argv = [dau_bin('tar'), '-czf', $tmp, '--warning=no-file-changed', '-C', '/'];
  if ($kind === 'appdata') foreach ($srcs as $s) {
    foreach ((array)$b['exclude'] as $x) $argv[] = '--exclude=' . ltrim($s, '/') . '/' . $x;
    $argv[] = '--exclude=' . ltrim($s, '/') . '/' . DAU_QDIR_NAME;    // folders already set aside by Cleanup are not worth backing up again
  }
  $argv[] = '--';
  foreach ($srcs as $s) $argv[] = ltrim($s, '/');
  $stopped = [];
  if ($kind === 'appdata' && !empty($b['stop_containers'])) {
    $stopped = dau_bk_stop(dau_bk_users($cfg, $srcs), $res);
    if ($res['error'] !== '') { dau_bk_start($stopped, $res); return $res; }
    if ($stopped) $res['notes'][] = 'Stopped during the backup: ' . implode(', ', $stopped) . '.';
  }
  $old = umask(0077);
  try { $r = dau_run($argv, 6 * 3600, null, 4096); }
  finally { umask($old); dau_bk_start($stopped, $res); }      // containers come back even when tar fails
  if (!empty($res['restart_failed'])) { $err = $res['error']; $res['error'] = ''; }
  $okCode = $r['code'] === 0 || ($r['code'] === 1 && $kind === 'appdata');       // 1 = a file changed while it was read (the containers run)
  if (!$okCode || $r['timeout'] || !is_file($tmp) || (int)@filesize($tmp) < 1) {
    @unlink($tmp);
    $res['error'] = trim(($r['timeout'] ? 'The backup took longer than 6 hours and was stopped.' : 'The archive could not be written' . (trim($r['err']) !== '' ? ': ' . dau_clip(dau_redact(trim($r['err'])), 160) : '.')) . ' ' . ($err ?? ''));
    return $res;
  }
  if ($kind === 'flash') {      // the boot drive is small: prove the archive can be read back
    $g = dau_run([dau_bin('gzip'), '-t', $tmp], 600);
    if ($g['code'] !== 0) { @unlink($tmp); $res['error'] = 'The archive failed its integrity check and was discarded.'; return $res; }
  }
  if (!@rename($tmp, $final)) { @unlink($tmp); $res['error'] = 'The finished archive could not be moved into place.'; return $res; }
  @chmod($final, 0600);
  $res['ok'] = true; $res['file'] = $final; $res['size'] = (int)@filesize($final); $res['seconds'] = max(0, dau_now() - $t0);
  if ($r['code'] === 1) $res['notes'][] = 'Some files changed while they were read (normal while containers run).';
  $res['pruned'] = dau_bk_prune($kind, $b['dest'], $b['keep']);
  $res['kept'] = count(dau_bk_list($kind, $b['dest']));
  if (isset($err)) { $res['ok'] = false; $res['error'] = $err; }    // the archive is good, but a container is down: that must not look like success
  return $res;
}

/* ---------- schedule ---------- */

function dau_bk_sched(array $b) {
  return dau_clean_schedule(['frequency' => $b['schedule'], 'time' => $b['time'], 'weekday' => $b['weekday'], 'monthday' => $b['monthday']]);
}

/** Slots for the dispatcher: 'b:appdata' / 'b:flash' (only kinds that are scheduled and have a usable destination). */
function dau_bk_slots(array $cfg) {
  $o = [];
  foreach (DAU_BK_KINDS as $k) {
    $b = $cfg['backups'][$k];
    if ($b['schedule'] === 'off' || dau_bk_check_dest($k, $cfg) !== '') continue;
    $s = dau_bk_sched($b); if ($s) $o[$k] = ['sched' => $s];
  }
  return $o;
}

/* ---------- jobs ---------- */

/** Run one backup as part of a job: history entry, state, notification event. Returns the result. */
function dau_job_backup(array &$J, $kind, $reason) {
  $cfg = $J['cfg'];
  dau_phase('Backing up ' . strtolower(dau_bk_label($kind)));
  $t0 = dau_now();
  try { $r = dau_bk_run($kind, $cfg); }
  catch (Throwable $e) { $r = ['ok' => false, 'error' => 'Unexpected error: ' . $e->getMessage(), 'file' => '', 'size' => 0, 'pruned' => 0, 'kept' => 0, 'seconds' => 0, 'notes' => []]; }
  $J['st']['backups'][$kind] = ['at' => dau_now(), 'ok' => $r['ok'], 'file' => $r['ok'] ? basename($r['file']) : '', 'size' => $r['size'], 'error' => $r['error'], 'reason' => $reason, 'kept' => $r['kept']];
  $msg = $r['ok'] ? basename($r['file']) . ', ' . dau_bytes_text($r['size']) . ', ' . $r['kept'] . ' kept' . ($r['pruned'] ? ', ' . $r['pruned'] . ' older removed' : '') : '';
  dau_history_add(['type' => 'backup', 'name' => dau_bk_label($kind), 'action' => 'backup', 'result' => $r['ok'] ? 'completed' : 'failed', 'started' => $t0, 'finished' => dau_now(),
    'trigger' => $J['trigger'], 'error' => $r['error'], 'message' => $msg . ($reason ? ' (' . $reason . ')' : '')], (int)$cfg['history']['max_entries']);
  dau_log($r['ok'] ? 'info' : 'error', 'backup', $kind, 'backup', $r['ok'] ? 'ok' : 'fail', $r['ok'] ? $msg : $r['error']);
  $J['events'][] = dau_ev('backup', dau_bk_label($kind), $r['ok'] ? 'backup_done' : 'backup_failed',
    ['detail' => $msg, 'error' => $r['error'], 'reason' => $reason, 'silent' => $r['ok'], 'next' => $r['ok'] ? '' : 'Open the Backups tab to check the destination, then run it again.']);
  return $r;
}

/**
 * Right before updates are installed. Returns false when the backup is "required" and failed: the caller must then install nothing.
 * Runs at most once per job, and only when there really is something to install.
 */
function dau_bk_before_update(array &$J, $what) {
  $b = $J['cfg']['backups']['appdata'];
  if (!empty($J['bk_pre']) || empty($b['before_update'])) return true;
  $J['bk_pre'] = true;
  $r = dau_job_backup($J, 'appdata', 'before ' . $what . ' updates');
  if (!$r['ok'] && !empty($b['required'])) {
    dau_log('warn', 'backup', 'appdata', 'before-update', 'blocked', 'Updates were not installed because the required backup failed.');
    return false;
  }
  return true;
}
]]></INLINE>
<SHA256>4fec2760fb51c108ca65010f58816d490ecda3b28da9f825dd302f021b4d6e41</SHA256>
</FILE>

<FILE Name="&emhttp;/include/docker.php" Mode="0644">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - Docker containers.
 *
 * Update flow (per container), every step verified on its own; exit codes are never trusted alone:
 *   disk check -> optional backups -> docker pull (classified) -> compare image ids -> Unraid's update_container
 *   -> verify (image id, state, health) -> targeted removal of the one replaced image.
 * A failed pull leaves the container untouched, so only pull failures are ever retried automatically.
 */

const DAU_PULL_TIMEOUT   = 1800;
const DAU_APPLY_TIMEOUT  = 900;
const DAU_MIN_FREE_BYTES = 536870912;   // below 512 MB free we do not even try to pull

function dau_docker(array $args, $timeout = 60) {
  return dau_run(array_merge([dau_bin('docker')], $args), $timeout);
}

/* ---------- update status (Unraid's own data) ---------- */

function dau_image_key($img) {
  if (strpos($img, '@') !== false) return $img;
  $pos = strrpos($img, '/');
  $last = $pos === false ? $img : substr($img, $pos + 1);
  return strpos($last, ':') === false ? $img . ':latest' : $img;
}

/** ['flag'=>true (update available)|false (up to date)|null (unknown), 'local'=>digest|null, 'remote'=>digest|null] */
function dau_update_info($img, array $map) {
  $k = dau_image_key($img);
  $nodocker = preg_replace('#^docker\.io/#', '', $k);
  foreach (array_unique([$k, $nodocker, preg_replace('#^library/#', '', $nodocker)]) as $cand) {
    if (!isset($map[$cand]) || !is_array($map[$cand])) continue;
    $e = $map[$cand];
    $local = !empty($e['local']) ? (string)$e['local'] : null;
    $remote = !empty($e['remote']) ? (string)$e['remote'] : null;
    $status = $e['status'] ?? null;
    if ($status === 'undef') return ['flag' => null, 'local' => $local, 'remote' => $remote];
    if ($local && $remote) return ['flag' => $local !== $remote, 'local' => $local, 'remote' => $remote];
    return ['flag' => null, 'local' => $local, 'remote' => $remote];
  }
  return ['flag' => null, 'local' => null, 'remote' => null];
}

/** Ask Unraid to re-check every image against its registry. nonotify: our own notifications replace the native ones. */
function dau_docker_refresh() {
  $p = DAU_DM . '/scripts/dockerupdate';
  if (!is_file($p)) return false;
  $r = dau_run([DAU_PHP, $p, 'check', 'nonotify'], 900);
  return !$r['timeout'] && $r['code'] === 0;
}

/* ---------- containers ---------- */

/** Returns the list of containers, or null when the Docker service is not running. */
function dau_containers() {
  $r = dau_docker(['ps', '-aq', '--no-trunc'], 30);
  if ($r['code'] !== 0) return null;
  $ids = array_values(array_filter(preg_split('/\s+/', trim($r['out']))));
  if (!$ids) return [];
  $r = dau_docker(array_merge(['inspect'], $ids), 90);
  $data = json_decode($r['out'], true);
  if (!is_array($data)) return [];
  $map = dau_read_json(DAU_UPDSTATUS, []);
  $out = [];
  foreach ($data as $c) {
    $name = ltrim($c['Name'] ?? '', '/');
    if ($name === '') continue;
    $labels = $c['Config']['Labels'] ?? [];
    $img = $c['Config']['Image'] ?? '';
    $u = dau_update_info($img, $map);
    $out[] = [
      'name'     => $name,
      'image'    => $img,
      'image_id' => (string)($c['Image'] ?? ''),
      'state'    => $c['State']['Status'] ?? 'unknown',
      'health'   => $c['State']['Health']['Status'] ?? null,
      'icon'     => $labels['net.unraid.docker.icon'] ?? '',
      'managed'  => dau_valid_name($name) && is_file(DAU_TEMPLATES . "/my-$name.xml") && (($labels['net.unraid.docker.managed'] ?? '') !== 'composeman'),
      'update'   => $u['flag'], 'local' => $u['local'], 'remote' => $u['remote'],
    ];
  }
  usort($out, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
  return $out;
}

function dau_inspect_one($name) {
  if (!dau_valid_name($name)) return null;
  $r = dau_docker(['inspect', $name], 30);
  if ($r['code'] !== 0) return null;
  $d = json_decode($r['out'], true);
  return is_array($d) && isset($d[0]) ? $d[0] : null;
}

function dau_short_id($id) { return substr(preg_replace('/^sha256:/', '', (string)$id), 0, 12); }
function dau_short_digest($d) { return $d ? 'sha256:' . substr(preg_replace('/^sha256:/', '', (string)$d), 0, 12) : ''; }

/* ---------- delay tracking ---------- */

/**
 * Remember WHEN each distinct remote image was first seen. The same digest never restarts its delay; a new digest does.
 * Containers whose update is gone (updated by hand, image removed) are forgotten so the maps stay small.
 */
function dau_docker_track(array &$st, array $containers, $now) {
  $names = [];
  foreach ($containers as $c) {
    $names[$c['name']] = true;
    $n = $c['name'];
    if ($c['update'] === true && $c['remote']) {
      $rec = $st['docker']['seen'][$n] ?? null;
      if (!is_array($rec) || ($rec['remote'] ?? '') !== $c['remote']) {
        $st['docker']['seen'][$n] = ['remote' => $c['remote'], 'local' => $c['local'], 'first' => $now, 'last' => $now];
        unset($st['docker']['retry'][$n], $st['docker']['deferred'][$n]);       // a different image: old retry/approval state is void
        if (($st['docker']['skipped'][$n] ?? '') !== $c['remote']) unset($st['docker']['skipped'][$n]);
        unset($st['docker']['major'][$n]);
        if (($st['docker']['approved'][$n] ?? '') !== $c['remote']) unset($st['docker']['approved'][$n]);
      } else {
        $st['docker']['seen'][$n]['last'] = $now;
      }
    } elseif ($c['update'] === false) {
      foreach (['seen', 'retry', 'approved', 'notified', 'deferred', 'skipped', 'major'] as $k) unset($st['docker'][$k][$n]);
    }
  }
  foreach (['seen', 'retry', 'approved', 'notified', 'deferred', 'skipped', 'rollback', 'pinned', 'major'] as $k) {
    foreach (array_keys($st['docker'][$k]) as $n) if (!isset($names[$n])) unset($st['docker'][$k][$n]);
  }
}

/* ---------- eligibility ---------- */

/**
 * Decide what may happen to one container right now.
 * state: external | unknown | up_to_date | pinned | skipped | ignored | notify_only | stopped | approval | no_identity |
 *        waiting_delay | retry_wait | retry_exhausted | window_closed | ready
 * $manual = the user asked for it explicitly: policy, delay, approval and window are overridden (never "external").
 */
function dau_docker_eval(array $cfg, array $st, array $c, $now, $manual = false) {
  $cc = dau_container_cfg($cfg, $c['name']);
  $g = $cfg['global'];
  $r = ['state' => 'ready', 'reason' => '', 'eta' => null, 'delay_hours' => dau_container_delay_hours($cfg, $c['name'])];
  if (!$c['managed']) return ['state' => 'external', 'reason' => 'Not created from an Unraid template, so Unraid cannot update it from here.'] + $r;
  if ($c['update'] === null) return ['state' => 'unknown', 'reason' => 'Update status not available yet. Run a check.'] + $r;
  if ($c['update'] === false) return ['state' => 'up_to_date', 'reason' => ''] + $r;
  if ($manual) return $r;
  if (isset($st['docker']['pinned'][$c['name']])) return ['state' => 'pinned', 'reason' => 'Pinned to the previous image after a rollback. Unpin it on the Docker tab to resume updates.'] + $r;
  if ($c['remote'] && ($st['docker']['skipped'][$c['name']] ?? '') === (string)$c['remote']) return ['state' => 'skipped', 'reason' => 'You chose to skip this version. It is ignored until a newer one appears.'] + $r;
  if ($cc['policy'] === 'ignore') return ['state' => 'ignored', 'reason' => 'Policy is "ignore": no automatic action.'] + $r;
  if ($cc['policy'] === 'notify') return ['state' => 'notify_only', 'reason' => 'Policy is "notify only".'] + $r;
  if (!empty($g['skip_stopped']) && $c['state'] !== 'running') return ['state' => 'stopped', 'reason' => 'Container is not running and "skip stopped containers" is on.'] + $r;
  if (!empty($cc['critical']) && ($st['docker']['approved'][$c['name']] ?? '') !== (string)$c['remote']) {
    return ['state' => 'approval', 'reason' => 'Marked critical: waiting for your approval of this specific image.'] + $r;
  }
  $hours = $r['delay_hours'];
  if ($hours > 0) {
    $seen = $st['docker']['seen'][$c['name']] ?? null;
    if (!$c['remote'] || !is_array($seen) || ($seen['remote'] ?? '') !== $c['remote']) {
      return ['state' => 'no_identity', 'reason' => 'An update delay is set but this image\'s digest is not available, so the update is not applied automatically.'] + $r;
    }
    $eta = (int)$seen['first'] + $hours * 3600;
    if ($now < $eta) return ['state' => 'waiting_delay', 'reason' => "Waiting for the $hours h update delay.", 'eta' => $eta] + $r;
  }
  $rt = $st['docker']['retry'][$c['name']] ?? null;
  if (is_array($rt) && ($rt['digest'] ?? '') === (string)$c['remote']) {
    if (!empty($rt['exhausted'])) return ['state' => 'retry_exhausted', 'reason' => 'Automatic retries are used up for this image. Update manually or change the policy.'] + $r;
    if ($now < (int)($rt['next_at'] ?? 0)) return ['state' => 'retry_wait', 'reason' => 'A retry is scheduled.', 'eta' => (int)$rt['next_at']] + $r;
  }
  if (!dau_window_open($g['window'], $now)) return ['state' => 'window_closed', 'reason' => 'Outside the maintenance window (' . dau_window_text($g['window']) . ').'] + $r;
  return $r;
}

/** Slots (distinct schedules) of the Docker category: slot => ['sched'=>..., 'names'=>[...]]. Containers with policy ignore are not scheduled. */
function dau_docker_slots(array $cfg) {
  $slots = [];
  $def = dau_clean_schedule($cfg['global']);
  foreach ($cfg['containers'] as $name => $c) {
    $name = (string)$name;
    $cc = dau_container_cfg($cfg, $name);
    if ($cc['policy'] === 'ignore') continue;
    $own = dau_clean_schedule($cc['schedule']);
    if ($own) { $k = dau_slot_key($own); $s = $own; }
    elseif (!empty($cfg['global']['enabled'])) { $k = 'global'; $s = $def; }
    else continue;
    if (!isset($slots[$k])) $slots[$k] = ['sched' => $s, 'names' => []];
    $slots[$k]['names'][] = $name;
  }
  return $slots;
}

/* ---------- pull error classification ---------- */

/** @return array [class('transient'|'permanent'), friendly text, suggested next step] */
function dau_classify_pull_error($text) {
  $t = strtolower($text);
  foreach (['unauthorized', 'denied', 'manifest unknown', 'not found', 'no such image', 'invalid reference', 'repository does not exist', 'no matching manifest', 'authentication required'] as $p) {
    if (strpos($t, $p) !== false) {
      return ['permanent', 'The registry rejected the pull (' . $p . ').', 'Check the image name and tag in the container\'s settings, and registry credentials if the image is private. The container was not touched.'];
    }
  }
  foreach (['toomanyrequests', 'rate limit'] as $p) if (strpos($t, $p) !== false) return ['transient', 'The registry rate limit was reached.', 'Wait, or sign in to the registry. The container was not touched.'];
  foreach (['timeout', 'timed out', 'tls handshake', 'connection refused', 'connection reset', 'no such host', 'temporary failure', 'eof', 'network is unreachable', 'context deadline', '502', '503', '504', 'unexpected status'] as $p) {
    if (strpos($t, $p) !== false) return ['transient', 'Network or registry problem while pulling (' . $p . ').', 'Usually temporary. The container was not touched.'];
  }
  return ['transient', 'The image could not be pulled.', 'The container was not touched. Check the log for details.'];
}

/* ---------- verification ---------- */

/**
 * Verify a container after the update. Distinguishes: healthy, running_no_healthcheck (no health check configured -
 * NOT a failure), not_running_expected (it was stopped before), timeout (still starting), and the failures
 * image_mismatch, not_found, failed_to_start, restart_loop, unhealthy.
 * @return array ['result'=>string,'ok'=>bool,'detail'=>string]
 */
function dau_docker_verify($name, $expectedImageId, $expectRunning, $timeout) {
  $start = dau_now(); $deadline = $start + max(5, (int)$timeout);
  $stable = min(10, max(3, (int)($timeout / 6)));
  $runningSince = null; $firstRestarts = null; $startedAt = null; $lastHealth = null; $lastStatus = '';
  while (true) {
    $i = dau_inspect_one($name);
    if ($i === null) {
      if (dau_now() >= $deadline) return ['result' => 'not_found', 'ok' => false, 'detail' => 'The container does not exist after the update.'];
      dau_sleep(2); continue;
    }
    $now = dau_now();
    if ($expectedImageId && (string)($i['Image'] ?? '') !== $expectedImageId) {
      return ['result' => 'image_mismatch', 'ok' => false, 'detail' => 'The container is not using the new image (' . dau_short_id($i['Image'] ?? '') . ' instead of ' . dau_short_id($expectedImageId) . ').'];
    }
    $status = $i['State']['Status'] ?? 'unknown';
    $health = $i['State']['Health']['Status'] ?? null;
    $restarts = (int)($i['RestartCount'] ?? 0);
    $lastHealth = $health; $lastStatus = $status;
    if (!$expectRunning) {
      if (in_array($status, ['created', 'exited'], true)) return ['result' => 'not_running_expected', 'ok' => true, 'detail' => 'The container was stopped before the update and was left stopped.'];
      if ($status === 'running') return ['result' => 'running_no_healthcheck', 'ok' => true, 'detail' => 'The container is running.'];
    }
    if (in_array($status, ['exited', 'dead'], true)) {
      return ['result' => 'failed_to_start', 'ok' => false, 'detail' => "The container stopped right after the update (status $status, exit code " . (int)($i['State']['ExitCode'] ?? 0) . ').'];
    }
    if ($status === 'restarting') {
      if ($firstRestarts === null) $firstRestarts = $restarts;
      if ($restarts - $firstRestarts >= 2) return ['result' => 'restart_loop', 'ok' => false, 'detail' => 'The container keeps restarting.'];
      $runningSince = null;
    } elseif ($status === 'running') {
      if ($health === 'healthy') return ['result' => 'healthy', 'ok' => true, 'detail' => 'The container reports healthy.'];
      if ($health === 'unhealthy') return ['result' => 'unhealthy', 'ok' => false, 'detail' => 'The container health check reports unhealthy.'];
      $sa = $i['State']['StartedAt'] ?? '';
      if ($startedAt !== $sa) { $startedAt = $sa; $runningSince = $now; if ($firstRestarts === null) $firstRestarts = $restarts; }
      if ($health === null && $runningSince !== null && $now - $runningSince >= $stable && $restarts === $firstRestarts) {
        return ['result' => 'running_no_healthcheck', 'ok' => true, 'detail' => 'Running and stable for ' . $stable . ' s. This container has no health check, so health could not be confirmed.'];
      }
    }
    if ($now >= $deadline) {
      $d = $health === 'starting' ? 'The health check is still "starting" after ' . (int)$timeout . ' s.' : "Status \"$lastStatus\" after " . (int)$timeout . ' s.';
      return ['result' => 'timeout', 'ok' => false, 'detail' => $d . ' The update was applied; verification could not finish in time.'];
    }
    dau_sleep(2);
  }
}

/* ---------- the update ---------- */

function dau_docker_free_bytes() {
  $p = is_dir('/var/lib/docker') ? '/var/lib/docker' : '/';
  $f = @disk_free_space($p);
  return $f === false ? null : (float)$f;
}

/**
 * Update one container. Returns:
 *  result: updated | unchanged | failed | blocked      stage: precheck|disk|backup|pull|apply|verify
 *  transient: bool (safe to retry automatically; only ever true when the container was not touched)
 *  verification: ['result','ok','detail'] | null      prev/new: ['id','digest']      warnings: [...]
 */
function dau_docker_update(array $cfg, $name, array $c) {
  $g = $cfg['global'];
  $out = ['result' => 'failed', 'stage' => 'precheck', 'error' => '', 'transient' => false, 'verification' => null, 'next' => '', 'warnings' => [],
          'prev' => ['id' => dau_short_id($c['image_id']), 'digest' => $c['local']], 'new' => ['id' => '', 'digest' => $c['remote']],
          'backup' => null, 'cleanup' => null, 'started' => dau_now(), 'finished' => 0];
  $done = function () use (&$out) { $out['finished'] = dau_now(); return $out; };

  if (!dau_valid_name($name) || empty($c['managed'])) { $out['error'] = 'Not an Unraid-managed container.'; $out['result'] = 'blocked'; return $done(); }
  $script = DAU_DM . '/scripts/update_container';
  if (!is_file($script)) { $out['error'] = 'Unraid\'s update_container script was not found.'; $out['result'] = 'blocked'; return $done(); }
  $before = dau_inspect_one($name);
  if ($before === null) { $out['error'] = 'The container does not exist.'; $out['result'] = 'blocked'; return $done(); }
  $wasRunning = !empty($before['State']['Running']);
  $oldId = (string)($before['Image'] ?? '');
  $image = (string)($before['Config']['Image'] ?? $c['image']);
  $out['prev']['id'] = dau_short_id($oldId);
  $r = dau_docker(['image', 'inspect', '--format', '{{json .RepoDigests}}', $oldId], 30);
  $rd = json_decode($r['out'], true);
  if (is_array($rd) && $rd) $out['prev']['digest'] = preg_replace('/^.*@/', '', $rd[0]);

  /* disk space */
  if (!empty($g['disk_check'])) {
    $free = dau_docker_free_bytes();
    if ($free !== null) {
      if ($free < DAU_MIN_FREE_BYTES) { $out['stage'] = 'disk'; $out['result'] = 'blocked'; $out['error'] = 'Only ' . round($free / 1048576) . ' MB free for Docker; not pulling.'; $out['next'] = 'Free up space on the cache/docker.img, then update again.'; return $done(); }
      if ($free < (float)$g['min_free_gb'] * 1073741824) $out['warnings'][] = 'Low disk space for Docker: ' . round($free / 1073741824, 1) . ' GB free (warning level ' . (int)$g['min_free_gb'] . ' GB).';
    }
  }

  /* backups (optional) */
  $cc = dau_container_cfg($cfg, $name);
  if (!empty($g['backup']['enabled']) && !empty($cc['backup'])) {
    $b = dau_backup_run($cfg, $name, $before);
    $out['backup'] = $b;
    if (!$b['ok']) {
      if (!empty($g['backup']['required'])) { $out['stage'] = 'backup'; $out['result'] = 'blocked'; $out['error'] = 'Required backup failed: ' . $b['error']; $out['next'] = 'The container was not touched. Fix the backup destination or turn "backup required" off.'; return $done(); }
      $out['warnings'][] = 'Backup failed, updating anyway (backup is not required): ' . $b['error'];
    }
  }

  /* pull. A failure here leaves the container untouched. */
  $out['stage'] = 'pull';
  $p = dau_docker(['pull', $image], DAU_PULL_TIMEOUT);
  if ($p['timeout'] || $p['code'] !== 0) {
    $text = $p['timeout'] ? 'pull timed out' : trim($p['err'] . "\n" . $p['out']);
    list($class, $why, $next) = $p['timeout'] ? ['transient', 'The pull took too long and was stopped.', 'The container was not touched.'] : dau_classify_pull_error($text);
    $out['error'] = $why . ' ' . dau_clip(dau_redact($text), 300);
    $out['transient'] = $class === 'transient'; $out['next'] = $next;
    return $done();
  }
  $r = dau_docker(['image', 'inspect', '--format', '{{.Id}}', $image], 30);
  $newId = trim($r['out']);
  if ($r['code'] !== 0 || $newId === '') { $out['error'] = 'The image was pulled but cannot be inspected.'; $out['transient'] = true; return $done(); }
  $out['new']['id'] = dau_short_id($newId);
  if ($newId === $oldId) { $out['result'] = 'unchanged'; $out['stage'] = ''; return $done(); }   // already running the newest image: do not restart it for nothing

  /* versions of both images; a jump to a new major version is held back for containers marked "watch major versions" */
  $verFrom = dau_image_version($oldId); $verTo = dau_image_version($newId);
  $out['versions'] = ['from' => $verFrom['version'], 'to' => $verTo['version']];
  if (!empty($cc['watch_major']) && dau_major_jump($verFrom, $verTo) && empty($c['allow_major'])) {
    $out['stage'] = 'impact'; $out['result'] = 'blocked'; $out['major'] = ['from' => $verFrom['version'], 'to' => $verTo['version']];
    $out['error'] = 'Major version change (' . $verFrom['version'] . ' -> ' . $verTo['version'] . '): the update was not applied. The new image is downloaded, the container was not touched.';
    $out['next'] = 'Read the release notes and back up first (databases often need a migration). Then use "Update anyway" on the Docker tab.';
    return $done();
  }

  /* apply with Unraid's own routine (keeps the template, network and extra settings). From here on, never auto-retry. */
  $out['stage'] = 'apply';
  $a = dau_run([DAU_PHP, $script, rawurlencode($name)], DAU_APPLY_TIMEOUT);
  if ($a['timeout']) { $out['error'] = 'Unraid\'s update routine did not finish in ' . DAU_APPLY_TIMEOUT . ' s.'; $out['next'] = 'Check the container in the Docker tab before doing anything else.'; }

  /* verify, independent of the exit code */
  $out['stage'] = 'verify';
  $vt = !empty($g['verify']['enabled']) ? (int)$g['verify']['timeout'] : 10;
  $v = dau_docker_verify($name, $newId, $wasRunning, $vt);
  $out['verification'] = $v;
  if (empty($g['verify']['enabled']) && $v['ok']) $out['verification']['detail'] = 'Health verification is switched off; only the image and container state were checked. ' . $v['detail'];

  $prevRef = $image . ($out['prev']['digest'] ? '@' . $out['prev']['digest'] : '');
  if ($v['ok'] || $v['result'] === 'timeout') {
    $out['result'] = 'updated'; $out['stage'] = '';
    /* how to go back: the digest reference of the image that was running before */
    $out['rollback'] = is_array($rd) && !empty($rd[0]) && dau_valid_image_ref($rd[0]) ? ['ref' => $rd[0], 'prev_id' => $oldId, 'prev_digest' => $out['prev']['digest'], 'new_digest' => (string)$c['remote'], 'image' => $image, 'at' => dau_now(), 'from' => $verFrom['version'], 'to' => $verTo['version']] : null;
    if ($v['result'] === 'timeout') $out['next'] = 'Check the container\'s logs; it may simply need longer to become healthy. Increase the verification timeout in Settings if this is normal.';
    /* targeted cleanup: only the replaced image, never forced, so Docker itself refuses if anything still uses it */
    if (!empty($g['cleanup']) && $v['ok'] && $oldId !== '' && $oldId !== $newId) {
      $rm = dau_docker(['image', 'rm', $oldId], 120);
      $out['cleanup'] = $rm['code'] === 0 ? 'removed' : 'kept (still in use or already removed)';
    }
    return $done();
  }
  $out['result'] = 'failed';
  $out['error'] = $v['detail'];
  $out['next'] = 'The previous image was kept. Check the container\'s logs. To go back: edit the container, set Repository to "' . $prevRef . '" and apply. See the README section on recovery.';
  return $done();
}

/** Remove the retry record for a container that has finished (or whose image changed). */
function dau_docker_retry_clear(array &$st, $name) { unset($st['docker']['retry'][$name]); }

/**
 * Decide retry behaviour after a failure. Only a failure that left the container untouched (transient pull error)
 * is retried, at most retry.max times, retry.interval_min apart. Returns 'scheduled' | 'exhausted' | 'none'.
 */
function dau_docker_retry_after_failure(array $cfg, array &$st, $name, array $c, array $res, $now) {
  $max = (int)$cfg['global']['retry']['max'];
  if (!$res['transient'] || $max <= 0) return 'none';
  $rt = $st['docker']['retry'][$name] ?? null;
  if (!is_array($rt) || ($rt['digest'] ?? '') !== (string)$c['remote']) $rt = ['digest' => (string)$c['remote'], 'attempts' => 0];
  $rt['attempts'] = (int)$rt['attempts'] + 1;
  $rt['error'] = dau_clip($res['error'], 200);
  if ($rt['attempts'] > $max) { $rt['exhausted'] = true; unset($rt['next_at']); $st['docker']['retry'][$name] = $rt; return 'exhausted'; }
  $rt['next_at'] = $now + (int)$cfg['global']['retry']['interval_min'] * 60;
  $st['docker']['retry'][$name] = $rt;
  return 'scheduled';
}
]]></INLINE>
<SHA256>29637daf8819beacc470af5ddc8e3eb602d26e4260cf62694bfe865677b7a924</SHA256>
