<FILE Name="&emhttp;/include/api.php" Mode="0644">
<INLINE><![CDATA[<?php
/* Unraid Swiss Manager - JSON API. Reads are GET/POST; EVERY change requires POST (Unraid validates the CSRF token of every POST itself). */
require_once '/usr/local/emhttp/plugins/unraid-swiss-manager/include/lib.php';

header('Content-Type: application/json');
header('Cache-Control: no-store');
header('X-Content-Type-Options: nosniff');

function out($d, $code = 200) { http_response_code($code); echo json_encode($d, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR); exit; }
function fail($m, $code = 400) { out(['error' => $m], $code); }

$action = (string)($_POST['action'] ?? $_GET['action'] ?? '');
$READ = ['overview', 'docker', 'plugins', 'os', 'history', 'log', 'status', 'export', 'preview', 'notes', 'cleanup_scan', 'widget', 'appdata_scan', 'quarantine_list', 'tpl_scan', 'appdata_peek', 'channel_check'];
if (!in_array($action, $READ, true)) {
  if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') fail('This action requires POST.', 405);
  /* The CSRF token is checked (and then removed from $_POST) by Unraid's own auto-prepended local_prepend.php for every POST,
     so it must not be re-checked here: it is already gone. Mutations are POST-only. */
}
$json = function ($k) { $v = json_decode((string)($_POST[$k] ?? ''), true); return is_array($v) ? $v : null; };

/** One line in the Activity tab for a cleanup action (the details are in the log). */
function api_clean_hist($what, $result, $message = '') {
  dau_history_add(['type' => 'cleanup', 'name' => $what, 'action' => 'cleanup', 'result' => $result, 'started' => dau_now(), 'finished' => dau_now(), 'trigger' => 'manual', 'message' => $message, 'error' => $result === 'failed' ? $message : ''], dau_load_config()['history']['max_entries']);
}

/** Row data for the Docker table. */
function api_docker_rows($cfg, $st) {
  $cs = dau_containers(); if ($cs === null) return null;
  $now = dau_now(); $last = dau_history_last_by_name('docker'); $rows = [];
  foreach ($cs as $c) {
    $cc = dau_container_cfg($cfg, $c['name']); $ev = dau_docker_eval($cfg, $st, $c, $now, false);
    $sched = dau_clean_schedule($cc['schedule']);
    $rows[] = ['run_state' => $c['state']] + array_diff_key($c, ['state' => 1]) + ['cfg' => $cc, 'state' => $ev['state'], 'reason' => $ev['reason'], 'eta' => $ev['eta'], 'delay_hours' => $ev['delay_hours'],
      'schedule_text' => $sched ? dau_sched_text($sched) : null, 'last' => $last[$c['name']] ?? null,
      'first_seen' => $st['docker']['seen'][$c['name']]['first'] ?? null, 'approved' => ($st['docker']['approved'][$c['name']] ?? '') === (string)$c['remote'] && $c['remote'],
      'retry' => $st['docker']['retry'][$c['name']] ?? null,
      'skipped' => $c['remote'] && ($st['docker']['skipped'][$c['name']] ?? '') === (string)$c['remote'],
      'pinned' => $st['docker']['pinned'][$c['name']] ?? null,
      'rollback' => isset($st['docker']['rollback'][$c['name']]) ? ['at' => $st['docker']['rollback'][$c['name']]['at'], 'from' => $st['docker']['rollback'][$c['name']]['from'] ?? '', 'to' => $st['docker']['rollback'][$c['name']]['to'] ?? '', 'ref' => $st['docker']['rollback'][$c['name']]['ref'] ?? ''] : null,
      'major' => ($st['docker']['major'][$c['name']]['remote'] ?? '') === (string)$c['remote'] && $c['remote'] ? $st['docker']['major'][$c['name']] : null];
  }
  return $rows;
}

function api_plugin_rows($cfg, $st) {
  $rows = []; $now = dau_now(); $last = dau_history_last_by_name('plugin');
  foreach (dau_plugins_installed() as $f => $p) {
    $latest = $st['plugins']['available'][$f] ?? null;
    $ev = $latest ? dau_plugin_eval($cfg, $st, $p, $latest, $now, false) : ['state' => 'up_to_date', 'reason' => '', 'eta' => null];
    $rows[] = ['file' => $f, 'name' => $p['name'], 'version' => $p['version'], 'latest' => $latest, 'self' => $p['self'], 'policy' => dau_plugin_policy($cfg, $f),
      'explicit' => $cfg['plugins']['items'][$f]['policy'] ?? null, 'state' => $ev['state'], 'reason' => $ev['reason'], 'eta' => $ev['eta'], 'last' => $last[$p['name']] ?? null,
      'first_seen' => $st['plugins']['seen'][$f]['first'] ?? null, 'skipped' => $latest && ($st['plugins']['skipped'][$f] ?? '') === $latest];
  }
  return $rows;
}

function api_next_runs($cfg, $st) {
  $now = dau_now(); $o = [];
  $add = function ($label, $slots) use (&$o, $st, $now) { foreach ($slots as $k => $s) $o[] = ['label' => $label, 'text' => dau_sched_text($s['sched']), 'next' => dau_next_run($s['sched'], dau_slot_rec($st, $k), $now), 'count' => count($s['names'])]; };
  $d = []; foreach (dau_docker_slots($cfg) as $k => $s) $d['d:' . $k] = $s;
  $add('Docker', $d);
  $p = []; foreach (dau_plugin_slots($cfg) as $k => $s) $p['p:' . $k] = $s; $add('Plugins', $p);
  $x = []; foreach (dau_os_slots($cfg) as $k => $s) $x['o:' . $k] = $s; $add('Unraid OS', $x);
  foreach (dau_bk_slots($cfg) as $k => $s) $o[] = ['label' => $k === 'flash' ? 'Boot drive backup' : 'Appdata backup', 'text' => dau_sched_text($s['sched']), 'next' => dau_next_run($s['sched'], dau_slot_rec($st, 'b:' . $k), $now), 'count' => 1];
  return $o;
}

function api_config_view($cfg) {
  $v = $cfg; $v['discord']['webhook_set'] = dau_webhook_valid(dau_secret_get('discord_url')); $v['discord']['icon_default'] = DAU_DEFAULT_ICON;   // the URL itself is never sent to the browser
  return $v;
}

function api_save($cfg) { dau_save_config($cfg); dau_cron_apply($cfg); }

switch ($action) {

  case 'overview': {
    $cfg = dau_load_config($s); $st = dau_state_load();
    $rows = api_docker_rows($cfg, $st); $prow = api_plugin_rows($cfg, $st);
    $cnt = function ($r, $f) { return count(array_filter($r ?? [], $f)); };
    out([
      'config' => api_config_view($cfg), 'config_status' => $s, 'run' => dau_run_info(), 'now' => dau_now(), 'version' => DAU_VERSION, 'name' => DAU_NAME,
      'docker_up' => $rows !== null,
      'cards' => [
        'containers' => count($rows ?? []), 'docker_updates' => $cnt($rows, function ($r) { return $r['update'] === true; }),
        'docker_auto' => $cnt($rows, function ($r) { return $r['cfg']['policy'] === 'auto'; }),
        'plugins' => count($prow), 'plugin_updates' => $cnt($prow, function ($r) { return !empty($r['latest']); }),
        'os_installed' => dau_os_version(), 'os_available' => $st['os']['available'], 'os_error' => $st['os']['last_error'],
        'last_run' => $st['last_run'], 'last_result' => $st['last_result'], 'next' => api_next_runs($cfg, $st), 'queued' => count($st['queue']), 'quiet_now' => dau_quiet_now($cfg),
        'cleanup' => array_merge($st['cleanup'], ['quarantine' => count(dau_quarantine_load())]), 'failures' => count(array_filter(array_slice(dau_history_load(), 0, 20), function ($e) { return $e['result'] === 'failed'; })),
      ],
      'stats' => dau_stats_summary($st), 'discord' => ['last_ok' => $st['discord']['last_ok'], 'last_error' => $st['discord']['last_error'], 'invalid' => $st['discord']['invalid']],
      'checked' => ['docker' => is_file(DAU_UPDSTATUS) ? filemtime(DAU_UPDSTATUS) : 0, 'plugins' => $st['plugins']['last_check'], 'os' => $st['os']['last_check']],
      'tick_installed' => is_file(DAU_CRON), 'channel' => dau_channel_current(),
    ]);
  }

  case 'docker': { $cfg = dau_load_config(); $st = dau_state_load(); $r = api_docker_rows($cfg, $st); out(['docker_up' => $r !== null, 'rows' => $r ?? []]); }
  case 'plugins': { $cfg = dau_load_config(); $st = dau_state_load(); out(['rows' => api_plugin_rows($cfg, $st), 'auto_update' => !empty($cfg['plugins']['auto_update'])]); }
  case 'os': {
    $cfg = dau_load_config(); $st = dau_state_load(); $now = dau_now();
    $ev = dau_os_eval($cfg, $st, $now, false); $man = dau_os_eval($cfg, $st, $now, true);
    $av = $st['os']['available'];
    out(['os' => $st['os'], 'installed' => dau_os_version(), 'mode' => $cfg['os']['mode'], 'eval' => $ev, 'manual' => $man, 'stable' => $av ? dau_os_is_stable($av) : null,
         'reboot' => dau_os_reboot_safe(), 'array' => dau_os_array_state(), 'free_mb' => dau_os_boot_free_mb(), 'window_text' => dau_window_text($cfg['os']['window']),
         'skipped' => $av && ($st['os']['skipped'] ?? '') === $av, 'pending' => $st['os']['pending'], 'workflow' => $st['os']['workflow'], 'report' => $st['os']['last_report'], 'pre' => $cfg['os']['pre'],
         'pre_containers' => !empty($cfg['os']['pre']['docker']) ? count(dau_os_pre_containers($cfg)) : 0]);
  }
  case 'notes': {
    $type = (string)($_GET['type'] ?? $_POST['type'] ?? ''); $n = (string)($_GET['name'] ?? $_POST['name'] ?? ''); $st = dau_state_load();
    if ($type === 'os') out(['text' => (string)$st['os']['notes'], 'version' => (string)$st['os']['available']]);
    if ($type === 'plugin') {
      foreach (dau_plugins_installed() as $f => $p) if ($f === $n || $p['name'] === $n) out(['text' => $st['plugins']['notes'][$f] ?? dau_plugin_notes($f, $p['version']), 'version' => (string)($st['plugins']['available'][$f] ?? '')]);
      out(['text' => '']);
    }
    if ($type === 'docker' && dau_valid_name($n)) { foreach (dau_containers() ?? [] as $c) if ($c['name'] === $n) out(dau_docker_notes($c)); out(['text' => '']); }
    fail('Unknown type');
  }
  case 'widget': {       // light: state files only, no Docker call (used by the Dashboard tile)
    $st = dau_state_load(); $cfg = dau_load_config();
    out(['containers' => (int)$st['summary']['containers'], 'docker' => (int)$st['summary']['docker_updates'], 'plugins' => (int)$st['summary']['plugin_updates'], 'at' => (int)$st['summary']['at'],
         'os_update' => !empty($st['os']['available']) && ($st['os']['skipped'] ?? '') !== (string)$st['os']['available'],   // only whether one is waiting: the tile never shows a version number
         'failures' => count(array_filter(array_slice(dau_history_load(), 0, 20), function ($e) { return $e['result'] === 'failed'; })),
         'next' => (function () use ($cfg, $st) { $t = array_filter(array_column(api_next_runs($cfg, $st), 'next')); return $t ? min($t) : null; })(),
         'last_run' => $st['last_run'], 'last_status' => $st['last_result']['status'] ?? '',
         'queued' => count($st['queue']), 'pinned' => count($st['docker']['pinned']), 'running' => dau_run_info()['running'], 'now' => dau_now(), 'name' => DAU_NAME, 'version' => DAU_VERSION]);
  }
  case 'cleanup_scan': { out(dau_cleanup_scan()); }
  case 'appdata_scan': { out(dau_appdata_scan()); }
  case 'quarantine_list': { out(dau_quarantine_list()); }
  case 'tpl_scan': { out(dau_tpl_scan()); }
  case 'channel_check': { out(['ok' => true, 'current' => dau_channel_current(), 'versions' => dau_channel_versions(), 'installed' => DAU_VERSION]); }
  case 'appdata_peek': { out(dau_appdata_peek((string)($_POST['id'] ?? $_GET['id'] ?? ''))); }
  case 'history': { out(['rows' => array_slice(dau_history_load(), 0, 200)]); }
  case 'log': { out(['log' => dau_log_tail(300)]); }
  case 'status': { out(['run' => dau_run_info()]); }

  /* what a bulk update WILL do, shown before the user confirms */
  case 'preview': {
    $cfg = dau_load_config(); $st = dau_state_load();
    $names = array_filter(explode(',', (string)($_POST['names'] ?? $_GET['names'] ?? '')), 'dau_valid_name');
    $rows = api_docker_rows($cfg, $st) ?? []; $out = [];
    foreach ($rows as $r) {
      if ($names && !in_array($r['name'], $names, true)) continue;
      if ($r['update'] !== true) continue;
      $out[] = ['name' => $r['name'], 'image' => $r['image'], 'current' => dau_short_digest($r['local']), 'new' => dau_short_digest($r['remote']), 'state' => $r['state'], 'was_running' => $r['run_state'] === 'running',
        'managed' => $r['managed'], 'critical' => !empty($r['cfg']['critical']),
        'backup' => !empty($cfg['global']['backup']['enabled']) && !empty($r['cfg']['backup'])];
    }
    out(['rows' => $out, 'verify' => !empty($cfg['global']['verify']['enabled'])]);
  }

  case 'export': {
    header('Content-Disposition: attachment; filename="unraid-swiss-manager-config.json"');
    echo json_encode(dau_export_config(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES); exit;
  }

  /* ---- changes (POST + CSRF) ---- */

  case 'save_config': {
    $in = $json('config'); if ($in === null) fail('Invalid settings payload');
    unset($in['containers']);
    $cfg = dau_sanitize_config($in, dau_load_config());
    if (!empty($in['discord']['webhook_url'])) {
      $u = (string)$in['discord']['webhook_url'];
      if (!dau_webhook_valid($u)) fail('That is not a valid Discord webhook URL.');
      dau_secret_set('discord_url', $u);
      $st = dau_state_load(); $st['discord']['invalid'] = false; dau_state_save($st);
    }
    api_save($cfg);
    out(['ok' => true, 'config' => api_config_view($cfg)]);
  }

  case 'set_container': {
    $in = $json('data'); $names = $json('names');
    if ($in === null || !$names) fail('Invalid request');
    $cfg = dau_load_config();
    foreach ($names as $n) {
      if (!dau_valid_name($n)) continue;
      $cfg = dau_sanitize_config(['containers' => [$n => $in]], $cfg);
    }
    api_save($cfg); out(['ok' => true]);
  }

  case 'set_plugin': {
    $in = $json('data'); $files = $json('files');
    if ($in === null || !$files) fail('Invalid request');
    $cfg = dau_load_config();
    $items = [];
    foreach ($files as $f) if (dau_valid_plg($f)) $items[$f] = ['policy' => $in['policy'] ?? null];
    $cfg = dau_sanitize_config(['plugin_items' => $items], $cfg);
    api_save($cfg); out(['ok' => true]);
  }

  case 'approve': {
    $n = (string)($_POST['name'] ?? ''); if (!dau_valid_name($n)) fail('Invalid name');
    $cs = dau_containers() ?? []; $st = dau_state_load();
    foreach ($cs as $c) if ($c['name'] === $n && $c['remote']) { $st['docker']['approved'][$n] = (string)$c['remote']; dau_state_save($st); out(['ok' => true]); }
    fail('No pending update with a known image to approve for this container.');
  }

  /* backups: settings, last result, next run and the archives that exist (reads only) */
  case 'backups': {
    $st = dau_state_load(); $cfg = dau_load_config(); $now = dau_now(); $o = [];
    foreach (DAU_BK_KINDS as $k) {
      $b = $cfg['backups'][$k]; $why = dau_bk_check_dest($k, $cfg); $sched = dau_bk_sched($b);
      $next = ($b['schedule'] !== 'off' && $why === '' && $sched) ? dau_next_run($sched, dau_slot_rec($st, 'b:' . $k), $now) : null;
      $dir = dau_bk_dir($k, (string)$b['dest']);
      $o[$k] = ['label' => dau_bk_label($k), 'cfg' => $b, 'problem' => $why, 'sources' => dau_bk_sources($k, $cfg), 'last' => $st['backups'][$k] ?? null, 'next' => $next,
        'text' => $b['schedule'] === 'off' ? '' : dau_sched_text($sched), 'files' => $b['dest'] !== '' && dau_valid_dest($b['dest']) ? dau_bk_list($k, $b['dest']) : [],
        'folder' => $b['dest'] !== '' ? $dir : '', 'free' => $why === '' && is_dir($b['dest']) ? dau_backup_free($b['dest']) : null];
    }
    out(['ok' => true, 'backups' => $o, 'running' => (bool)(dau_read_json(DAU_PROGRESS, [])['running'] ?? false), 'now' => $now]);
  }

  case 'run': {
    $what = (string)($_POST['what'] ?? '');
    if ($what === 'check') $args = ['--check'];
    elseif ($what === 'os') $args = ['--os-check'];
    elseif ($what === 'os_install') {
      if (($_POST['confirm'] ?? '') !== '1') fail('Installing an OS update needs an explicit confirmation.');
      $args = [!empty($_POST['reboot']) && $_POST['reboot'] === '1' ? '--os-install-reboot' : '--os-install'];
      foreach (['pre_plugins' => '--pre-plugins=', 'pre_docker' => '--pre-docker='] as $k => $flag) if (isset($_POST[$k]) && in_array($_POST[$k], ['0', '1'], true)) $args[] = $flag . $_POST[$k];
    }
    elseif ($what === 'os_confirm') {
      if (($_POST['confirm'] ?? '') !== '1') fail('Installing an OS update needs an explicit confirmation.');
      $st = dau_state_load(); $wf = $st['os']['workflow'] ?? null;
      if (!is_array($wf) || ($wf['state'] ?? '') !== 'awaiting_confirmation') fail('No OS update is waiting for a confirmation.');
      $args = ['--os-confirm'];
    }
    elseif ($what === 'docker' || $what === 'plugins') {
      $names = $json('names'); if (!$names) fail('Nothing selected');
      $ok = array_values(array_filter($names, $what === 'docker' ? 'dau_valid_name' : 'dau_valid_plg'));
      if (!$ok) fail('Invalid names');
      $args = ['--update-' . $what . '=' . implode(',', $ok)];
      if ($what === 'docker' && ($_POST['allow_major'] ?? '') === '1') $args[] = '--allow-major=' . implode(',', $ok);
    } elseif ($what === 'backup') {
      $k = (string)($_POST['kind'] ?? ''); $kinds = $k === 'all' ? DAU_BK_KINDS : (in_array($k, DAU_BK_KINDS, true) ? [$k] : []);
      if (!$kinds) fail('Unknown backup type');
      $cfg = dau_load_config();
      foreach ($kinds as $kk) { $why = dau_bk_check_dest($kk, $cfg); if ($why !== '') fail(dau_bk_label($kk) . ': ' . $why); }
      $args = ['--backup=' . $k];
    } elseif ($what === 'channel') {
      $ch = (string)($_POST['channel'] ?? ''); if (!in_array($ch, ['stable', 'beta'], true)) fail('Unknown channel');
      if (($_POST['confirm'] ?? '') !== '1') fail('Changing the plugin branch needs an explicit confirmation.');
      if ($ch === 'beta' && ($_POST['beta_ok'] ?? '') !== '1') fail('The beta branch needs the test-server warning to be accepted.');
      $force = ($_POST['force'] ?? '') === '1';
      if ($ch === dau_channel_current() && !$force) fail('This server already follows that channel. Use Force update to reinstall it.');
      $args = ['--channel=' . $ch]; if ($force) $args[] = '--force';
    } elseif ($what === 'rollback') {
      $n = (string)($_POST['name'] ?? ''); if (!dau_valid_name($n)) fail('Invalid name');
      if (($_POST['confirm'] ?? '') !== '1') fail('A rollback needs an explicit confirmation.');
      $st = dau_state_load(); if (empty($st['docker']['rollback'][$n])) fail('There is no earlier image recorded for this container.');
      $args = ['--rollback=' . $n];
    } else fail('Unknown job');
    if (!dau_spawn($args)) fail('Another job is already running.', 409);
    out(['ok' => true]);
  }

  /* skip one specific version (a newer one is announced again) */
  case 'skip': case 'unskip': {
    $type = (string)($_POST['type'] ?? ''); $n = (string)($_POST['name'] ?? ''); $st = dau_state_load(); $skip = $action === 'skip';
    if ($type === 'docker') {
      if (!dau_valid_name($n)) fail('Invalid name');
      $rem = ''; foreach (dau_containers() ?? [] as $c) if ($c['name'] === $n) $rem = (string)$c['remote'];
      if ($skip && $rem === '') fail('No pending update with a known image to skip for this container.');
      if ($skip) $st['docker']['skipped'][$n] = $rem; else unset($st['docker']['skipped'][$n]);
    } elseif ($type === 'plugin') {
      $f = $n; if (!dau_valid_plg($f)) { $f = ''; foreach (dau_plugins_installed() as $pf => $p) if ($p['name'] === $n) $f = $pf; }
      $latest = $f !== '' ? ($st['plugins']['available'][$f] ?? null) : null;
      if ($skip && !$latest) fail('No pending update to skip for this plugin.');
      if ($f === '') fail('Unknown plugin');
      if ($skip) $st['plugins']['skipped'][$f] = $latest; else unset($st['plugins']['skipped'][$f]);
    } elseif ($type === 'os') {
      if ($skip && empty($st['os']['available'])) fail('No OS update to skip.');
      $st['os']['skipped'] = $skip ? (string)$st['os']['available'] : '';
    } else fail('Unknown type');
    dau_state_save($st); out(['ok' => true]);
  }

  case 'unpin': {
    $n = (string)($_POST['name'] ?? ''); if (!dau_valid_name($n)) fail('Invalid name');
    $lock = dau_lock_try(); if (!$lock) fail('Another job is running.', 409);
    $st = dau_state_load(); $r = dau_docker_unpin($st, $n); if ($r['ok']) dau_state_save($st);
    dau_lock_release($lock);
    if (!$r['ok']) fail($r['error']);
    out(['ok' => true]);
  }

  case 'cleanup_run': {
    if (($_POST['confirm'] ?? '') !== '1' && ($_POST['dry'] ?? '') !== '1') fail('Cleanup needs an explicit confirmation.');
    $imgs = $json('images') ?? []; $cons = $json('containers') ?? []; $vols = array_values(array_filter($json('volumes') ?? [], 'dau_valid_name'));
    $imgs = array_values(array_filter($imgs, function ($i) { return is_string($i) && preg_match('/^sha256:[0-9a-f]{64}$/', $i); }));
    $cons = array_values(array_filter($cons, 'dau_valid_name'));
    if (!$imgs && !$cons && !$vols) fail('Nothing selected');
    $dry = ($_POST['dry'] ?? '') === '1';
    $lock = dau_lock_try(); if (!$lock) fail('Another job is running.', 409);
    try { $r = dau_cleanup_run($imgs, $cons, $vols, $dry); } finally { dau_lock_release($lock); }
    if (!$dry) dau_log('info', 'cleanup', '-', 'remove', empty($r['failed']) ? 'ok' : 'partial', count($r['removed'] ?? []) . ' removed, ' . ($r['freed_text'] ?? '0'));
    if (!$dry && !empty($r['removed'])) api_clean_hist(count($r['removed']) . ' image / container / volume item(s) removed', 'cleaned', 'Freed about ' . ($r['freed_text'] ?? ''));
    out($r);
  }

  case 'cleanup_all': {
    /* one scan of everything: Docker images / containers / volumes and appdata; the counts are stored for the tab badge */
    $lock = dau_lock_try(); if (!$lock) fail('Another job is running.', 409);
    try {
      $a = dau_appdata_scan(); $d = dau_cleanup_scan(); $st = dau_state_load();
      $prev = $st['cleanup']; $st['cleanup'] = dau_cleanup_summary($a, $d); $st['cleanup']['reported'] = $prev['reported'] ?? ''; $st['cleanup']['reported_at'] = (int)($prev['reported_at'] ?? 0);
      dau_state_save($st);
    } finally { dau_lock_release($lock); }
    out(['appdata' => $a, 'docker' => $d, 'summary' => $st['cleanup']]);
  }

  case 'appdata_ignore': {
    $lock = dau_lock_try(); if (!$lock) fail('Another job is running.', 409);
    try { $r = dau_appdata_ignore((string)($_POST['name'] ?? ''), ($_POST['add'] ?? '1') === '1'); } finally { dau_lock_release($lock); }
    out($r);
  }

  case 'appdata_run': {
    $ids = array_values(array_filter($json('ids') ?? [], function ($i) { return is_string($i) && preg_match('/^\d:[^\/\x00-\x1F]{1,255}$/', $i); }));
    $dry = ($_POST['dry'] ?? '') === '1';
    if (!$dry && ($_POST['confirm'] ?? '') !== '1') fail('This needs an explicit confirmation.');
    if (!$ids) fail('Nothing selected');
    $lock = dau_lock_try(); if (!$lock) fail('Another job is running.', 409);
    try { $r = dau_appdata_run($ids, (string)($_POST['mode'] ?? 'quarantine'), $dry, ($_POST['confirm_delete'] ?? '') === '1'); } finally { dau_lock_release($lock); }
    if (!$dry && !empty($r['ok'])) dau_log('info', 'cleanup', '-', $r['mode'] === 'delete' ? 'appdata delete' : 'appdata quarantine', empty($r['failed']) ? 'ok' : 'partial', count($r['done']) . ' folder(s)' . ($r['mode'] === 'delete' ? ', ' . $r['freed_text'] : ''));
    if (!$dry && !empty($r['ok']) && !empty($r['done'])) api_clean_hist(count($r['done']) . ' appdata folder(s) ' . ($r['mode'] === 'delete' ? 'deleted' : 'moved to quarantine'), 'cleaned', implode(', ', array_slice($r['done'], 0, 10)));
    out($r);
  }

  case 'quarantine_act': {
    $act = (string)($_POST['act'] ?? ''); $id = (string)($_POST['id'] ?? '');
    if (!in_array($act, ['restore', 'purge'], true) || !preg_match('/^[0-9a-f]{12}$/', $id)) fail('Bad request');
    if (($_POST['confirm'] ?? '') !== '1') fail('This needs an explicit confirmation.');
    $lock = dau_lock_try(); if (!$lock) fail('Another job is running.', 409);
    try { $r = dau_quarantine_act($id, $act, ($_POST['suffix'] ?? '') === '1'); } finally { dau_lock_release($lock); }
    if (!empty($r['ok'])) { dau_log('info', 'cleanup', '-', 'quarantine ' . $act, 'ok', $id); api_clean_hist('Quarantine: folder ' . ($act === 'purge' ? 'deleted' : 'restored'), 'cleaned', $id); }
    out($r);
  }

  case 'tpl_act': {
    $act = (string)($_POST['act'] ?? '');
    if (!in_array($act, ['archive', 'restore', 'drop'], true)) fail('Bad request');
    if (($_POST['confirm'] ?? '') !== '1') fail('This needs an explicit confirmation.');
    $name = (string)($_POST['name'] ?? ''); if ($act === 'archive' && !dau_valid_name($name)) fail('Bad name');
    $lock = dau_lock_try(); if (!$lock) fail('Another job is running.', 409);
    try { $r = dau_tpl_act($act, $name, (string)($_POST['file'] ?? '')); } finally { dau_lock_release($lock); }
    if (!empty($r['ok'])) { dau_log('info', 'cleanup', $name, 'template ' . $act, 'ok', (string)($_POST['file'] ?? '')); api_clean_hist('Saved template ' . ($act === 'archive' ? 'archived' : ($act === 'restore' ? 'restored' : 'backup deleted')), 'cleaned', $name); }
    out($r);
  }

  case 'os_abort': {
    /* abort the pre-OS workflow: a running job stops after its current step, a paused one is cancelled here */
    if (dau_run_info()['running']) { @touch(DAU_STOPFLAG); out(['ok' => true, 'running' => true]); }
    $st = dau_state_load(); $wf = $st['os']['workflow'] ?? null;
    if (is_array($wf)) {
      dau_history_add(['type' => 'os', 'name' => 'Unraid OS', 'action' => 'prerequisites', 'result' => 'aborted', 'started' => (int)$wf['started'], 'finished' => dau_now(), 'trigger' => 'manual', 'error' => 'Aborted by the user. Nothing was installed.'], dau_load_config()['history']['max_entries']);
      $st['os']['workflow'] = null; dau_state_save($st);
    }
    out(['ok' => true, 'running' => false]);
  }

  case 'stop': { @touch(DAU_STOPFLAG); out(['ok' => true]); }

  case 'test_discord': {
    $st = dau_state_load(); $u = (string)($_POST['url'] ?? '');
    $r = dau_discord_test($st, $u !== '' ? $u : null); dau_state_save($st); out($r);
  }

  case 'clear_webhook': { dau_secret_set('discord_url', ''); $cfg = dau_load_config(); $cfg['discord']['enabled'] = false; api_save($cfg); out(['ok' => true]); }

  case 'import': {
    $in = $json('config'); if ($in === null) fail('Invalid file');
    if (isset($in['config']) && is_array($in['config'])) $in = $in['config'];
    $cur = dau_load_config();
    $cfg = dau_sanitize_config($in, dau_defaults());
    dau_write_json(DAU_DIR . '/config.before-import.json', $cur);
    api_save($cfg); out(['ok' => true]);
  }

  case 'clear_history': { dau_write_json(DAU_HIST, []); out(['ok' => true]); }

  default: fail('Unknown action', 404);
}
]]></INLINE>
<SHA256>50b6f4b98958d3ab2874324d105133a5ca7f067e51849adf7597146142c766cc</SHA256>
</FILE>

<FILE Name="&emhttp;/scripts/run.php" Mode="0755">
<INLINE><![CDATA[<?php
/*
 * Unraid Swiss Manager - command line runner.
 *   --tick                    cron dispatcher: runs whatever is due (called every 5 minutes)
 *   --check                   refresh Docker/plugin/OS update information, update nothing
 *   --update-docker=a,b       update these containers now (manual: policy, delay and window are bypassed)
 *   --allow-major=a,b         with --update-docker: also allow a major-version jump for these containers
 *   --channel=stable|beta     install the plugin from that branch now (--force reinstalls the branch it is already on)
 *   --rollback=name           go back to the image before the container's last update
 *   --update-plugins=a.plg,b  update these plugins now (after the usual safety validation)
 *   --os-check                check for an Unraid OS update (notify only)
 *   --os-install[-reboot]     install the available Unraid OS update now (manual; optionally reboot afterwards); --pre-plugins=0|1 --pre-docker=0|1 override the pre-OS steps
 *   --os-confirm              continue an OS update that is waiting for its confirmation
 *   --install / --uninstall   boot-time setup / removal
 */
if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
require_once '/usr/local/emhttp/plugins/unraid-swiss-manager/include/lib.php';
set_time_limit(0);
ini_set('display_errors', '0');

$o = getopt('', ['tick', 'check', 'update-docker:', 'backup:', 'allow-major:', 'rollback:', 'update-plugins:', 'channel:', 'force', 'os-check', 'os-install', 'os-install-reboot', 'os-confirm', 'pre-plugins:', 'pre-docker:', 'install', 'uninstall']);
$list = function ($k) use ($o) { return isset($o[$k]) ? array_values(array_filter(array_map('trim', explode(',', (string)$o[$k])))) : []; };

if (isset($o['install']))   { dau_install(); exit(0); }
if (isset($o['uninstall'])) { dau_uninstall(); exit(0); }
if (isset($o['tick']))      exit(dau_job_main('tick'));
if (isset($o['check']))     exit(dau_job_main('check'));
if (isset($o['os-check']))  exit(dau_job_main('os'));
$flag = function ($k) use ($o) { return isset($o[$k]) ? ($o[$k] === '1') : null; };     // absent = use the setting
if (isset($o['os-confirm']))        exit(dau_job_main('os_confirm'));
if (isset($o['os-install']))        exit(dau_job_main('os_install', ['reboot' => false, 'pre_plugins' => $flag('pre-plugins'), 'pre_docker' => $flag('pre-docker')]));
if (isset($o['os-install-reboot'])) exit(dau_job_main('os_install', ['reboot' => true, 'pre_plugins' => $flag('pre-plugins'), 'pre_docker' => $flag('pre-docker')]));
if (isset($o['channel']))        { $r = dau_channel_install((string)$o['channel'], isset($o['force'])); exit(!empty($r['ok']) ? 0 : 1); }
if (isset($o['rollback']))       exit(dau_job_main('rollback', ['name' => dau_valid_name((string)$o['rollback']) ? (string)$o['rollback'] : '']));
if (isset($o['backup'])) exit(dau_job_main('backup', ['kinds' => $o['backup'] === 'all' ? DAU_BK_KINDS : [$o['backup']]]));
if (isset($o['update-docker']))  exit(dau_job_main('docker',  ['names' => array_values(array_filter($list('update-docker'), 'dau_valid_name')), 'allow_major' => array_values(array_filter($list('allow-major'), 'dau_valid_name'))]));
if (isset($o['update-plugins'])) exit(dau_job_main('plugins', ['names' => array_values(array_filter($list('update-plugins'), 'dau_valid_plg'))]));
fwrite(STDERR, "usage: run.php --tick | --check | --update-docker=a,b | --update-plugins=a.plg | --os-check | --os-install | --os-install-reboot | --install | --uninstall\n");
exit(64);
]]></INLINE>
<SHA256>28e4078d73908203d92dca2de96c11d0a1733c8077b28e7e5833733593f43391</SHA256>
</FILE>

<FILE Name="&emhttp;/assets/app.css" Mode="0644">
<INLINE><![CDATA[/* Unraid Swiss Manager - dark grey UI matching the Unraid theme. Scoped to .dau so it never leaks into the page. */
.dau{--bg:#1d1b1b;--panel:#222020;--bar:#262626;--field:#181616;--line:#333030;--line-2:#433f3f;--text:#e8e6e6;--muted:#9b9797;--accent:#f15a2c;--accent-hi:#ff7447;--accent-btn:#d4431a;--accent-btn-hi:#bd3a14;--accent-text:#ff7447;--amber:#e8b33c;--info:#6f93e0;--ok:#4ec38b;--bad:#ff6b5e;--link:#6f93e0;
  --hover:#252323;--open:#201e1e;--banner:#2a2620;--banner-bad:#2a2120;--banner-ok:#202823;--pre:#cfcaca;--title:#fff;
  --font:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;color:var(--text);font:14px/1.5 var(--font);padding:4px 0 24px;margin:0;text-align:left;position:relative}
.dau *,.dau *::before,.dau *::after{box-sizing:border-box}
.dau .grow{flex:1 1 auto;min-width:0}.dau .muted{color:var(--muted)}.dau .sm{font-size:12.5px}.dau b{font-weight:600;color:var(--text)}
.dau-loading{padding:40px;text-align:center;color:var(--muted)}
.dau .head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}
/* themes: dark follows Unraid's own page; light and midnight paint their own background */
.dau[data-theme=light]{--bg:#f4f4f5;--panel:#fff;--bar:#ececee;--field:#fff;--line:#dcdce0;--line-2:#c3c3c9;--text:#1f1f23;--muted:#62626c;--ok:#16794c;--bad:#c4332a;--amber:#7a5400;--accent-text:#b23d17;--info:#2457c5;--link:#2457c5;--hover:#f0f0f3;--open:#f7f7f9;--banner:#fff6e0;--banner-bad:#fdeceb;--banner-ok:#e9f6ef;--pre:#33333a;--title:#1f1f23}
.dau[data-theme=midnight]{--bg:#12151c;--panel:#181c25;--bar:#1e2330;--field:#10131a;--line:#262c3a;--line-2:#333b4d;--text:#e6e9f0;--muted:#8d96aa;--link:#7fa0ee;--hover:#1c2130;--open:#161a24;--banner:#262418;--banner-bad:#2a1d20;--banner-ok:#17261f;--pre:#cdd3e0}
.dau[data-theme=light],.dau[data-theme=midnight]{background:var(--bg);padding:14px;border-radius:8px}
.dau[data-theme=light] .badge.ok{border-color:#9bd3b8}.dau[data-theme=light] .badge.bad{border-color:#e6aaa5}.dau[data-theme=light] .badge.warn{border-color:#e4c776}.dau[data-theme=light] .btn.danger{color:var(--bad)!important}
/* header: logo + title + orange version line */
.dau .brand{display:flex;align-items:center;gap:16px;min-width:0}
.dau .logo{width:64px;height:64px;border-radius:14px;flex:none;display:block}
.dau .dau-name{font-family:Poppins,"Segoe UI",system-ui,-apple-system,sans-serif;font-size:28px;font-weight:600;line-height:1.15;letter-spacing:0;color:var(--title);background:none;border:0;padding:0;margin:0;text-shadow:none}
.dau .ver{font-size:15px;font-weight:500;color:var(--accent);margin-top:4px}
@media (max-width:600px){.dau .brand{gap:12px}.dau .logo{width:48px;height:48px;border-radius:11px}.dau .dau-name{font-size:21px}.dau .ver{font-size:13px}}
.dau .actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.dau .tabs{display:flex;gap:2px;border-bottom:1px solid var(--line);margin-bottom:16px;overflow-x:auto}
.dau .tab{background:none!important;border:0!important;border-bottom:2px solid transparent!important;color:var(--muted)!important;padding:8px 14px!important;margin:0!important;cursor:pointer;font:inherit!important;white-space:nowrap;border-radius:0!important;text-transform:none!important;letter-spacing:0!important}
.dau .tab:hover{color:var(--text)!important}.dau .tab.on{color:var(--text)!important;border-bottom-color:var(--accent)!important}
.dau .tab .n{background:var(--accent);color:#fff;border-radius:9px;font-size:11px;padding:0 6px;margin-left:6px}
.dau button.btn,.dau .btn{background:var(--bar)!important;color:var(--text)!important;border:1px solid var(--line-2)!important;border-radius:4px!important;padding:6px 12px!important;margin:0!important;font:inherit!important;font-size:13px!important;cursor:pointer;text-transform:none!important;letter-spacing:0!important;line-height:1.3!important;min-height:0!important;box-shadow:none!important}
.dau .btn:hover:not(:disabled){border-color:var(--accent)!important}.dau .btn:disabled,.dau .btn.pri:disabled,.dau .btn.danger:disabled,.dau .btn.warn:disabled{opacity:1;cursor:not-allowed;background:var(--bar)!important;color:var(--muted)!important;border:1px dashed var(--line-2)!important}
.dau :focus-visible{outline:2px solid var(--accent-text);outline-offset:2px}.dau .tab:focus-visible,.dau summary:focus-visible{outline-offset:-2px}
.dau .btn.pri{background:var(--accent-btn)!important;border-color:var(--accent-btn)!important;color:#fff!important}.dau .btn.pri:hover:not(:disabled){background:var(--accent-btn-hi)!important;border-color:var(--accent-btn-hi)!important}
.dau .btn.danger{color:var(--bad)!important}.dau .btn.sm{padding:3px 8px!important;font-size:12px!important}
.dau input[type=text],.dau input[type=number],.dau input[type=time],.dau input[type=url],.dau input[type=password],.dau input[type=search],.dau select,.dau textarea{background:var(--field)!important;color:var(--text)!important;border:1px solid var(--line-2)!important;border-radius:4px!important;padding:5px 8px!important;margin:0!important;font:inherit!important;font-size:13px!important;height:auto!important;min-height:30px;width:auto;max-width:100%;box-shadow:none!important}
.dau input:focus,.dau select:focus{border-color:var(--accent)!important;outline:0}
.dau input[type=checkbox]{accent-color:var(--accent);width:16px;height:16px;margin:0 6px 0 0;vertical-align:middle}
.dau .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-bottom:16px}
.dau .card{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:12px 14px}
.dau .card .k{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.06em}.dau .card .v{font-size:24px;font-weight:600;line-height:1.3}.dau .card .s{color:var(--muted);font-size:12.5px}
.dau .card.hot .v{color:var(--accent)}.dau .card.bad .v{color:var(--bad)}
.dau .panel{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:14px 16px;margin-bottom:14px}
.dau .panel h3{margin:0 0 10px;font-size:14px;font-weight:600;color:var(--text);text-transform:uppercase;letter-spacing:.05em}
.dau .panel h4{margin:14px 0 6px;font-size:13px;color:var(--muted);font-weight:600}
.dau .tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
.dau table{width:100%;border-collapse:collapse;background:transparent;margin:0}
.dau th{background:var(--bar)!important;color:var(--muted)!important;font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:8px 10px!important;border-bottom:1px solid var(--line)!important;white-space:nowrap}
.dau td{padding:8px 10px!important;border-bottom:1px solid var(--line)!important;vertical-align:middle;background:transparent!important;color:var(--text)}
.dau tr.row:hover td{background:var(--hover)!important}.dau tr.open td{background:var(--open)!important}
.dau td.name .nm{font-weight:600}.dau td.name .img{color:var(--muted);font-size:12px;word-break:break-all}
.dau .ico{width:26px;height:26px;border-radius:4px;vertical-align:middle;margin-right:8px;background:var(--field)}
.dau .badge{display:inline-block;border-radius:10px;padding:1px 9px;font-size:11.5px;border:1px solid var(--line-2);color:var(--muted);white-space:nowrap}
.dau .badge.ok{color:var(--ok);border-color:#2c5e48}.dau .badge.bad{color:var(--bad);border-color:#6b3a35}.dau .badge.warn{color:var(--amber);border-color:#6b5a2a}.dau .badge.acc{color:var(--accent-text);border-color:#7a3a25}
.dau .badge.info{color:var(--info);border-color:var(--line-2)}.dau .badge.off{color:var(--muted);border-color:var(--line-2)}
/* Unraid's own stylesheet paints every span.warn pale yellow and full width (default-base.css); our badges must not inherit that */
.dau .badge,.dau span.badge{background:transparent!important;background-color:transparent!important;width:auto!important;display:inline-block;opacity:1}
.dau tr.warn,.dau tr.ok,.dau tr.bad{color:inherit}
/* the state is also written in symbols, so colour is never the only cue */
.dau .badge.ok::before{content:'\2713\00a0'}.dau .badge.bad::before{content:'\2715\00a0'}.dau .badge.warn::before{content:'!\00a0';font-weight:700}.dau .badge.info::before{content:'\25CF\00a0'}
.dau .digest{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;color:var(--muted)}
.dau .drawer td{padding:0!important}.dau .drawer .in{padding:12px 14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.dau .fld{display:flex;flex-direction:column;gap:4px;margin-bottom:8px}.dau .fld>label,.dau .lbl{color:var(--muted);font-size:12.5px}
.dau .fld .hint{color:var(--muted);font-size:12px}
.dau .inl{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.dau .grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:4px 24px}
.dau .switch{display:flex;align-items:center;gap:8px;cursor:pointer;margin:4px 0}
.dau .banner{border:1px solid var(--line-2);border-left:3px solid var(--amber);background:var(--banner);border-radius:4px;padding:8px 12px;margin-bottom:12px}
.dau .banner.bad{border-left-color:var(--bad);background:var(--banner-bad)}.dau .banner.ok{border-left-color:var(--ok);background:var(--banner-ok)}.dau .banner.warn{border-left-color:var(--amber)}
.dau .progress{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin:6px 0}.dau .progress i{display:block;height:100%;background:var(--accent);animation:dau-slide 1.2s infinite linear;width:30%}
@keyframes dau-slide{0%{margin-left:-30%}100%{margin-left:100%}}
.dau .modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:10000;display:flex;align-items:center;justify-content:center;padding:16px}
.dau .modal{background:var(--panel);border:1px solid var(--line-2);border-radius:8px;max-width:760px;width:100%;max-height:88vh;overflow:auto;padding:18px}
.dau .modal h3{margin:0 0 10px;font-size:16px}.dau .modal .foot{display:flex;gap:8px;justify-content:flex-end;margin-top:14px;flex-wrap:wrap}
.dau pre.log{background:var(--field);border:1px solid var(--line);border-radius:4px;padding:10px;max-height:460px;overflow:auto;font-size:12px;line-height:1.45;white-space:pre-wrap;word-break:break-word;color:var(--pre)}
.dau .toast{position:fixed;right:18px;bottom:18px;background:var(--bar);border:1px solid var(--line-2);border-left:3px solid var(--accent);padding:10px 14px;border-radius:4px;z-index:10001;max-width:420px}
.dau .toast.bad{border-left-color:var(--bad)}
.dau a{color:var(--link)}
@media (max-width:820px){
  .dau table.resp thead{display:none}
  .dau table.resp,.dau table.resp tbody,.dau table.resp tr,.dau table.resp td{display:block;width:100%}
  .dau table.resp tr.row{border:1px solid var(--line);border-radius:6px;margin-bottom:8px;padding:6px 4px;background:var(--panel)}
  .dau table.resp td{border:0!important;padding:4px 10px!important}
  .dau table.resp td[data-l]::before{content:attr(data-l);display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.05em}
  .dau .drawer td{padding:0!important}
}

/* statistics chart */
.dau .chart{display:flex;align-items:stretch;gap:3px;height:72px;margin:6px 0 4px}
.dau .chart .bar{flex:1 1 0;min-width:0;display:flex;flex-direction:column-reverse;background:var(--field);border-radius:2px;overflow:hidden}
.dau .chart .bar i{display:block;width:100%}.dau .chart .bar .o{background:var(--ok)}.dau .chart .bar .f{background:var(--bad)}
.dau .key{display:inline-block;width:10px;height:10px;border-radius:2px;margin:0 4px 0 10px}.dau .key.o{background:var(--ok)}.dau .key.f{background:var(--bad)}
.dau .btn.warn{color:var(--amber)!important}
.dau textarea{resize:vertical}
.dau input[type=color]{padding:0!important;width:44px;height:32px;min-height:32px;cursor:pointer}
.dau select[multiple]{width:100%;max-width:320px}

/* phones and small tablets: bigger touch targets, one column, nothing wider than the screen */
@media (max-width:820px){
  .dau{padding-bottom:40px}
  .dau .tabs{margin-left:-4px;margin-right:-4px;-webkit-overflow-scrolling:touch;scrollbar-width:none}.dau .tabs::-webkit-scrollbar{display:none}
  .dau .tab{padding:10px 12px!important}
  .dau .head{align-items:flex-start}.dau .head .actions{width:100%}.dau .head .actions .btn{flex:1}
  .dau .cards{grid-template-columns:repeat(2,minmax(0,1fr))}
  .dau .card .v{font-size:21px;overflow-wrap:anywhere}
  .dau .tools{flex-direction:column;align-items:stretch}.dau .tools>*{width:100%!important;max-width:none}.dau .tools .grow{display:none}
  .dau .tools .btn,.dau .tools select,.dau .tools input{min-height:42px!important}
  .dau button.btn,.dau .btn{padding:9px 14px!important;font-size:14px!important;min-height:40px!important}
  .dau .btn.sm{padding:7px 11px!important;font-size:13px!important;min-height:36px!important}
  .dau input[type=text],.dau input[type=number],.dau input[type=time],.dau input[type=url],.dau input[type=password],.dau input[type=search],.dau select,.dau textarea{font-size:16px!important;min-height:42px;width:100%}
  .dau input[type=number]{width:120px}.dau input[type=time]{width:auto}.dau input[type=color]{width:56px;min-height:42px}
  .dau input[type=checkbox]{width:20px;height:20px}
  .dau .switch{min-height:36px;margin:6px 0}
  .dau .grid2{grid-template-columns:1fr}
  .dau .inl{gap:8px}
  .dau .panel{padding:12px}
  .dau table.resp td.name{padding-top:8px!important}
  .dau table.resp td:last-child .inl{padding-top:6px}
  .dau .modal-bg{align-items:flex-end;padding:0}
  .dau .modal{max-width:none;border-radius:14px 14px 0 0;max-height:92vh;padding:16px 14px 20px}
  .dau .modal .foot .btn{flex:1}
  .dau .toast{left:12px;right:12px;bottom:12px;max-width:none}
  .dau .chart{height:60px;gap:2px}
  .dau pre.log{max-height:320px}
}
@media (max-width:420px){
  .dau .brand{gap:10px}.dau .logo{width:42px;height:42px;border-radius:10px}.dau .dau-name{font-size:19px}.dau .ver{font-size:12.5px}
  .dau .cards{gap:8px}.dau .card{padding:10px 11px}
}
@media (prefers-reduced-motion:reduce){.dau .progress i{animation:none}}

/* cleanup sections: same page, same panels as the other tabs */
.dau h3.csec{margin:26px 0 10px;padding-top:6px}.dau h3.csec:first-child{margin-top:4px}
.dau td.acts{white-space:nowrap}.dau td.acts .btn{margin:0 6px 4px 0}
@media (max-width:820px){.dau td.acts{white-space:normal}}

/* cleanup: folding sections and summary */
.dau details.csec{margin:14px 0;border:1px solid var(--line);border-radius:10px;background:transparent}
.dau details.csec>summary{cursor:pointer;list-style:none;display:flex;gap:12px;align-items:baseline;justify-content:space-between;padding:12px 16px;min-height:44px}
.dau details.csec>summary::-webkit-details-marker{display:none}
.dau details.csec>summary::before{content:'▸';margin-right:8px;color:var(--muted)}.dau details.csec[open]>summary::before{content:'▾'}
.dau details.csec>summary b{flex:1}.dau details.csec .cbody{padding:0 16px 14px}
.dau .big{font-size:30px;font-weight:700;line-height:1.2}.dau .rules{margin:6px 0 10px;flex-wrap:wrap}
.dau .btn.sm{padding:4px 10px;min-height:30px;font-size:12px}
@media (max-width:820px){.dau details.csec>summary{flex-wrap:wrap}.dau details.csec .cbody{padding:0 10px 12px}.dau .btn.sm{min-height:40px}}
/* Cleanup: steps, category cards, review rows, action bar */
.dau .steps{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.dau .step{padding:4px 12px;border:1px solid var(--line-2);border-radius:999px;color:var(--muted);font-size:.9em}
.dau .step.on{color:var(--text);border-color:var(--accent-text);font-weight:600}.dau .step.done{color:var(--text)}
.dau .step.done::before{content:'\2713\00a0'}
.dau .ccats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin:12px 0}
.dau .ccat{border:1px solid var(--line);border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:4px}
.dau .ccat h4{margin:0;font-size:1em}.dau .ccat .cn{font-size:1.6em;font-weight:600}.dau .ccat .cdesc{flex:1}
.dau .mono{font-family:ui-monospace,Menlo,Consolas,monospace;word-break:break-all}
.dau details.more{margin-top:4px}.dau details.more>summary{cursor:pointer;color:var(--muted);font-size:.85em}
.dau .cops{margin:0 0 10px;padding-left:18px}.dau .cops li{margin:6px 0}
.dau .cbar{position:sticky;bottom:0;z-index:5;display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:10px 12px;margin-top:14px;background:var(--bg,Canvas);border:1px solid var(--line-2);border-radius:10px}
.dau .cbar .grow{flex:1;min-width:160px}
@media (max-width:820px){.dau .cbar .btn{flex:1 1 45%}}
]]></INLINE>
<SHA256>b16567c8663232430d8a6cf99de5a1a927f26bccbe603ed60d3b699ded1ada56</SHA256>
</FILE>

<FILE Name="&emhttp;/assets/app.js" Mode="0644">
<INLINE><![CDATA[/* Unraid Swiss Manager UI. Plain JS, no libraries; every string is inserted as text (never as HTML). */
(function () {
  'use strict';
  var API = '/plugins/unraid-swiss-manager/include/api.php';
  var root = document.getElementById('dau');
  var S = { copen: {}, hist: null, ad: null, cs: null, cresult: null, cerr: {}, qr: null, tp: null, clean: null, csel: { img: {}, con: {} }, tab: 'overview', ov: null, docker: null, plugins: null, os: null, hist: null, log: null, draft: null, sel: {}, psel: {}, open: {}, q: '', filter: 'all', sort: 'name', pq: '', pfilter: 'all', busy: false, poll: null };
  var DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  var FREQ = [['6h', 'Every 6 hours'], ['12h', 'Every 12 hours'], ['daily', 'Daily'], ['weekly', 'Weekly'], ['biweekly', 'Every two weeks'], ['monthly', 'Monthly']];
  var POL = [['auto', 'Auto update'], ['notify', 'Notify only'], ['ignore', 'Ignore']];
  var DELAYS = [[0, 'Immediately'], [24, '24 hours'], [72, '3 days'], [168, '7 days']];
  var STATE = {
    external: ['Not managed by Unraid', ''], unknown: ['Status unknown', ''], up_to_date: ['Up to date', 'ok'], ignored: ['Ignored', ''], notify_only: ['Update available', 'acc'],
    stopped: ['Skipped: stopped', 'warn'], approval: ['Needs your approval', 'warn'], no_identity: ['Waiting: digest unknown', 'warn'], waiting_delay: ['Waiting for delay', 'warn'],
    retry_wait: ['Retry scheduled', 'warn'], retry_exhausted: ['Retries used up', 'bad'], window_closed: ['Waiting for window', 'warn'], ready: ['Ready to update', 'acc'],
    blocked: ['Blocked', 'bad'], self: ['This plugin', ''], pinned: ['Pinned (rolled back)', 'warn'], skipped: ['Version skipped', '']
  };

  function h(tag, p) {
    var e = document.createElement(tag); p = p || {};
    for (var k in p) {
      if (k === 'class') e.className = p[k];
      else if (k.slice(0, 2) === 'on') e.addEventListener(k.slice(2), p[k]);
      else if (k === 'value') e.value = p[k];
      else if (k === 'checked' || k === 'disabled' || k === 'selected') e[k] = !!p[k];
      else if (p[k] !== null && p[k] !== undefined && p[k] !== false) e.setAttribute(k, p[k]);
    }
    for (var i = 2; i < arguments.length; i++) add(e, arguments[i]);
    return e;
  }
  function add(e, c) {
    if (c === null || c === undefined || c === false) return;
    if (Array.isArray(c)) { c.forEach(function (x) { add(e, x); }); return; }
    e.appendChild(c.nodeType ? c : document.createTextNode(String(c)));
  }
  function clear(e) { while (e.firstChild) e.removeChild(e.firstChild); }
  function ago(ts) { if (!ts) return 'never'; var s = Math.max(0, S.ov ? S.ov.now - ts : Date.now() / 1000 - ts); if (s < 90) return 'just now'; if (s < 5400) return Math.round(s / 60) + ' min ago'; if (s < 129600) return Math.round(s / 3600) + ' h ago'; return Math.round(s / 86400) + ' d ago'; }
  function when(ts) { return ts ? new Date(ts * 1000).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) : '-'; }
  function dur(s) { s = Math.round(s || 0); return s < 60 ? s + ' s' : Math.floor(s / 60) + ' min ' + (s % 60) + ' s'; }
  function toast(msg, bad) { var t = h('div', { class: 'toast' + (bad ? ' bad' : '') }, msg); root.appendChild(t); setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, bad ? 7000 : 3500); }

  function api(action, data, post) {
    var fd = new URLSearchParams(); fd.append('action', action);   // urlencoded, not multipart: multipart POSTs hang on Unraid's web server
    fd.append('csrf_token', window.DAU_CSRF || '');   // Unraid rejects any POST without it, reads included
    for (var k in (data || {})) fd.append(k, typeof data[k] === 'object' ? JSON.stringify(data[k]) : data[k]);
    return fetch(API, { method: post ? 'POST' : 'POST', body: fd, credentials: 'same-origin' }).then(function (r) {
      return r.json().catch(function () { return { error: 'Unexpected response (' + r.status + ')' }; }).then(function (j) { if (!r.ok && !j.error) j.error = 'Request failed (' + r.status + ')'; return j; });
    }).catch(function () { return { error: 'Could not reach the server.' }; });
  }
  function act(action, data, okMsg) { return api(action, data, true).then(function (j) { if (j.error) toast(j.error, true); else if (okMsg) toast(okMsg); return j; }); }

  /* ---------- loading ---------- */
  function load(which) {
    var jobs = [];
    var want = which || S.tab;
    jobs.push(api('overview').then(function (j) { if (!j.error) { S.ov = j; if (!S.draft) S.draft = JSON.parse(JSON.stringify(j.config)); } else S.err = j.error; }));
    if (want === 'docker') jobs.push(api('docker').then(function (j) { S.docker = j; }));
    if (want === 'plugins') jobs.push(api('plugins').then(function (j) { S.plugins = j; }));
    if (want === 'os') jobs.push(api('os').then(function (j) { S.os = j; }));
    if (want === 'backups') jobs.push(api('backups').then(function (j) { S.bk = j.error ? null : j; }));
    if (want === 'cleanup') jobs.push(api('history').then(function (j) { S.hist = j.rows || []; }));
    if (want === 'activity') { jobs.push(api('history').then(function (j) { S.hist = j.rows || []; })); jobs.push(api('log').then(function (j) { S.log = j.log || ''; })); }
    return Promise.all(jobs).then(render);
  }
  function startPoll() {
    if (S.poll) return;
    S.poll = setInterval(function () {
      api('status').then(function (j) {
        if (!j.run) return;
        var was = S.ov && S.ov.run.running; S.ov.run = j.run;
        if (!j.run.running && was) { clearInterval(S.poll); S.poll = null; toast('Finished.'); if (S.reloadAfter) { setTimeout(function () { location.reload(); }, 1500); return; } load(); }
        else renderRunBar();
      });
    }, 2000);
  }
  function runJob(what, names, okMsg, extra) {
    var d = { what: what, names: names || [] }; for (var k in (extra || {})) d[k] = extra[k];
    return act('run', d, okMsg || 'Started.').then(function (j) {
      if (j.ok) { S.ov.run = { running: true, progress: { phase: 'Starting' } }; render(); startPoll(); }
    });
  }

  /* ---------- appearance: theme, accent colour, custom CSS ---------- */
  function applyTheme(ui) {
    ui = ui || {};
    root.setAttribute('data-theme', ui.theme || 'dark');
    var st = document.getElementById('dau-user-css');
    if (!st) { st = document.createElement('style'); st.id = 'dau-user-css'; document.head.appendChild(st); }
    var acc = /^#[0-9a-f]{6}$/i.test(ui.accent || '') ? ui.accent : '#f15a2c';
    st.textContent = '.dau{--accent:' + acc + ';--accent-hi:' + acc + '}\n' + String(ui.css || '').replace(/<\/?style/gi, '');
  }

  /* ---------- shared actions ---------- */
  function skipAct(type, name, label, undo) {
    act(undo ? 'unskip' : 'skip', { type: type, name: name }, undo ? 'Will be offered again: ' + label : 'Skipping this version of ' + label + '. A newer one is announced again.').then(function () { load(); });
  }
  function notesModal(type, name, title) {
    var m = modal('What changed: ' + title);
    var body = h('pre', { class: 'log' }, 'Loading…'); m.body.appendChild(body); m.foot.appendChild(h('button', { class: 'btn', onclick: m.close }, 'Close'));
    api('notes', { type: type, name: name }).then(function (j) {
      if (j.error) { body.textContent = j.error; return; }
      body.textContent = j.text || (type === 'docker' ? '' : 'No release notes were published with this update.');
      if (j.version) m.body.insertBefore(h('p', { class: 'muted' }, 'Version: ' + j.version), body);
      if (type === 'docker') {
        if (j.link) { body.textContent = 'This image publishes its notes with the project\'s releases.'; m.body.appendChild(h('p', null, h('a', { href: j.link, target: '_blank', rel: 'noopener noreferrer' }, 'Open the release notes'))); }
        else if (!j.text) body.textContent = 'This image does not say where its release notes are.';
      }
      if (type === 'os') m.body.appendChild(h('p', { class: 'muted sm' }, 'Back up your flash drive first and read the full release notes under Tools > Update OS.'));
    });
  }
  function rollbackConfirm(r) {
    var m = modal('Roll back ' + r.name + '?');
    m.body.appendChild(h('p', null, 'The container is recreated with the image it used before its last update' + (r.rollback.from || r.rollback.to ? ' (' + (r.rollback.to || '?') + ' → ' + (r.rollback.from || '?') + ')' : '') + '.'));
    m.body.appendChild(h('p', { class: 'muted' }, 'It restarts briefly. Afterwards it is pinned to that image and the newer version is skipped, so nothing updates it again until you click "Unpin". Data in its appdata folders is not changed, so after a major version jump an older program may not be able to read newer data: restore a backup if that happens.'));
    var cb = h('input', { type: 'checkbox' }); m.body.appendChild(h('label', { class: 'switch' }, cb, 'I understand and want to roll back'));
    var go = h('button', { class: 'btn pri', disabled: true, onclick: function () { m.close(); runJob('rollback', [], 'Rollback started', { name: r.name, confirm: '1' }); } }, 'Roll back');
    cb.addEventListener('change', function () { go.disabled = !cb.checked; });
    m.foot.appendChild(h('button', { class: 'btn', onclick: m.close }, 'Cancel')); m.foot.appendChild(go);
  }

  /* links from notifications: ?act=update|skip|approve|open&type=docker|plugin|os&name=… */
  function deepLink() {
    var q = new URLSearchParams(location.search), a = q.get('act'), tab = q.get('tab');
    if (!a && tab && TABS.some(function (t) { return t[0] === tab; })) {      // ?tab=docker|plugins|os|activity|… (Dashboard tile rows)
      try { history.replaceState(null, '', location.pathname); } catch (e) { /* ignore */ }
      S.tab = tab; return load(tab);
    }
    if (!a) return;
    var type = q.get('type') || '', name = q.get('name') || '';
    try { history.replaceState(null, '', location.pathname); } catch (e) { /* ignore */ }
    if (type === 'os') { S.tab = 'os'; if (a === 'skip') return load('os').then(function () { var m = modal('Skip this Unraid release?'); m.body.appendChild(h('p', null, 'No automatic action is taken for this release. A newer one is announced again.')); m.foot.appendChild(h('button', { class: 'btn', onclick: m.close }, 'Cancel')); m.foot.appendChild(h('button', { class: 'btn pri', onclick: function () { m.close(); skipAct('os', '', 'Unraid OS'); } }, 'Skip')); }); return load('os'); }
    if (type === 'docker') {
      S.tab = 'docker';
      return load('docker').then(function () {
        if (a === 'update') previewUpdate([name]);
        else if (a === 'approve') act('approve', { name: name }, 'Approved this image for ' + name).then(function () { load('docker'); });
        else if (a === 'skip') { var m = modal('Skip this version of ' + name + '?'); m.body.appendChild(h('p', null, 'This image is ignored; a newer one is announced again.')); m.foot.appendChild(h('button', { class: 'btn', onclick: m.close }, 'Cancel')); m.foot.appendChild(h('button', { class: 'btn pri', onclick: function () { m.close(); skipAct('docker', name, name); } }, 'Skip')); }
      });
    }
    if (type === 'plugin') {
      S.tab = 'plugins';
      return load('plugins').then(function () {
        var r = (S.plugins.rows || []).filter(function (x) { return x.name === name || x.file === name; })[0]; if (!r) return;
        if (a === 'update') confirmPlugins([r.file]);
        else if (a === 'skip') { var m = modal('Skip this version of ' + r.name + '?'); m.body.appendChild(h('p', null, 'This version is ignored; a newer one is announced again.')); m.foot.appendChild(h('button', { class: 'btn', onclick: m.close }, 'Cancel')); m.foot.appendChild(h('button', { class: 'btn pri', onclick: function () { m.close(); skipAct('plugin', r.file, r.name); } }, 'Skip')); }
      });
    }
  }

  /* ---------- shell ---------- */
  var TABS = [['overview', 'Overview'], ['docker', 'Docker'], ['plugins', 'Plugins'], ['os', 'Unraid OS'], ['cleanup', 'Cleanup'], ['backups', 'Backups'], ['settings', 'Settings'], ['activity', 'Activity']];
  var runBar = h('div');
  function renderRunBar() {
    clear(runBar);
    var r = S.ov && S.ov.run; if (!r || !r.running) return;
    var p = r.progress || {};
    runBar.appendChild(h('div', { class: 'banner' }, h('div', { class: 'inl' }, h('b', null, 'Working: '), h('span', { class: 'grow' }, (p.phase || 'Running') + (p.total ? ' (' + (p.done || 0) + '/' + p.total + ')' : '')),
      h('button', { class: 'btn sm danger', onclick: function () { act('stop', {}, 'Stop requested: the job ends after the current step.'); } }, 'Stop after current step')), h('div', { class: 'progress' }, h('i'))));
  }
  function render() {
    clear(root);
    if (!S.ov) { root.appendChild(h('div', { class: 'dau-loading' }, S.err || 'Loading')); return; }
    var c = S.ov.cards, busy = S.ov.run.running;
    root.appendChild(h('div', { class: 'head' }, h('div', { class: 'brand' }, h('img', { class: 'logo', src: '/plugins/unraid-swiss-manager/images/unraid-swiss-manager.png' + (window.DAU_IMGV || ''), alt: '', onerror: function () { this.style.display = 'none'; } }), h('div', null, h('div', { class: 'dau-name' }, S.ov.name || 'Unraid Swiss Manager'), h('div', { class: 'ver' }, 'Plugin version ' + S.ov.version, S.ov.tick_installed ? null : h('span', { class: 'muted' }, ' · no schedule is active')))),
      h('div', { class: 'actions' }, h('button', { class: 'btn', disabled: busy, onclick: function () { runJob('check', [], 'Checking for updates'); } }, 'Check now'))));
    if (S.ov.config_status === 'corrupt') root.appendChild(h('div', { class: 'banner bad' }, 'The saved settings file could not be read, so safe defaults are shown. The damaged file was kept next to it as config.corrupt-*.json.'));
    if (!S.ov.docker_up && S.tab !== 'settings') root.appendChild(h('div', { class: 'banner' }, 'The Docker service is not running. Docker features are unavailable until it is started.'));
    root.appendChild(runBar); renderRunBar();
    var tabs = h('div', { class: 'tabs' });
    TABS.forEach(function (t) {
      var n = t[0] === 'docker' ? c.docker_updates : t[0] === 'plugins' ? c.plugin_updates : t[0] === 'os' && c.os_available ? 1 : t[0] === 'cleanup' ? cleanCount(c.cleanup) : 0;
      tabs.appendChild(h('button', { class: 'tab' + (S.tab === t[0] ? ' on' : ''), onclick: function () { S.tab = t[0]; if (t[0] === 'cleanup') { S.qr = null; S.tp = null; } load(t[0]); } }, t[1], n ? h('span', { class: 'n' }, n) : null));
    });
    root.appendChild(tabs);
    applyTheme(S.tab === 'settings' && S.draft ? S.draft.ui : S.ov.config.ui);
    var body = { overview: vOverview, docker: vDocker, plugins: vPlugins, os: vOS, cleanup: vCleanup, backups: vBackups, settings: vSettings, activity: vActivity }[S.tab]();
    root.appendChild(body);
  }

  /* ---------- overview ---------- */
  function card(k, v, s, cls) { return h('div', { class: 'card ' + (cls || '') }, h('div', { class: 'k' }, k), h('div', { class: 'v' }, v), h('div', { class: 's' }, s || '')); }
  /* last 30 days: green = updated, red = failed (plain bars; every bar has a text alternative) */
  function chart(days) {
    var max = 1; days.forEach(function (d) { max = Math.max(max, d.ok + d.failed); });
    var box = h('div', { class: 'chart', role: 'img', 'aria-label': 'Updates per day over the last 30 days' });
    days.forEach(function (d) {
      var tot = d.ok + d.failed;
      box.appendChild(h('div', { class: 'bar', title: d.day + ': ' + d.ok + ' updated, ' + d.failed + ' failed' },
        h('i', { class: 'f', style: 'height:' + (d.failed ? Math.max(4, d.failed / max * 100) : 0) + '%' }), h('i', { class: 'o', style: 'height:' + (d.ok ? Math.max(4, d.ok / max * 100) : 0) + '%' })));
    });
    return h('div', null, h('h4', null, 'Updates per day (last 30 days)'), box, h('div', { class: 'inl sm muted' }, h('span', { class: 'key o' }), 'updated', h('span', { class: 'key f' }), 'failed'));
  }
  function vOverview() {
    var c = S.ov.cards, w = h('div');
    w.appendChild(h('div', { class: 'cards' },
      card('Containers', c.containers, c.docker_auto + ' auto-update'),
      card('Docker updates', c.docker_updates, 'available now', c.docker_updates ? 'hot' : ''),
      card('Plugins', c.plugins, c.plugin_updates + ' with updates', c.plugin_updates ? 'hot' : ''),
      card('Unraid OS', c.os_installed || '?', c.os_available ? 'Update available: ' + c.os_available : (c.os_error ? 'Check failed' : 'Up to date'), c.os_available ? 'hot' : ''),
      card('Recent failures', c.failures, 'in the last 20 actions', c.failures ? 'bad' : ''),
      card('Last run', ago(c.last_run), c.last_result && c.last_result.status ? 'Result: ' + c.last_result.status : '')));
    var nx = h('div');
    if (!c.next.length) nx.appendChild(h('div', { class: 'muted' }, 'Nothing is scheduled. Turn on a schedule in Settings, or set a container to "Auto update".'));
    c.next.forEach(function (n) { nx.appendChild(h('div', { class: 'inl' }, h('b', null, n.label), h('span', { class: 'muted' }, n.text + (n.count > 1 || n.label === 'Docker' ? ' · ' + n.count + ' container(s)' : '')), h('span', { class: 'grow' }), h('span', null, n.next ? when(n.next) : '-'))); });
    w.appendChild(h('div', { class: 'panel' }, h('h3', null, 'Next scheduled checks'), nx));
    if (c.queued) w.appendChild(h('div', { class: 'banner' }, c.queued + ' notification(s) are on hold' + (c.quiet_now ? ' during quiet hours and will be sent afterwards.' : ' and will go out with the next run.')));
    var st = S.ov.stats;
    w.appendChild(h('div', { class: 'panel' }, h('h3', null, 'Statistics'), h('div', { class: 'grid2' }, ['docker', 'plugin'].map(function (t) {
